<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Discover. Shop. Enjoy.</title>
    <link rel="stylesheet" th:href="@{/css/home.css}">
</head>

<body th:attr="data-role=${userRole}">
<header>
    <div class="announcement">
        <span>Welcome to OneCart — discover something worth keeping.</span>
        <div>
            <a th:href="@{/contact}">Help &amp; Support</a>
            <a th:href="@{/about}">About OneCart</a>
						<a th:href="@{/products}">Products</a>
        </div>
    </div>

    <div class="main-header">
        <a class="brand" th:href="@{/}">
            <span class="brand-mark">O</span>
            <span>One<span>Cart</span><small>Discover. Shop. Enjoy.</small></span>
        </a>

        <form class="search-form" th:action="@{/products}" method="get" id="searchForm">
            <select name="category" id="categorySelect" aria-label="Choose category">
                <option value="">All categories</option>
                <option th:each="category : ${categories}"
                        th:value="${category}"
                        th:text="${category}"></option>
            </select>

            <input type="search" name="q" id="productSearch"
                   placeholder="Search products, brands and more..."
                   aria-label="Search products">

            <button type="submit" aria-label="Search">⌕</button>
        </form>

        <div class="header-actions">
            <a th:href="@{/login}" class="header-action guest-only">
                ♙ <span>Login / Sign up</span>
            </a>

            <a th:href="@{/wishlist}" class="header-action">
                ♡ <span>Wishlist</span>
                <b id="wishlistCount">0</b>
            </a>

            <a th:href="@{/cart}" class="header-action">
                🛒 <span>Cart</span>
                <b id="cartCount">0</b>
            </a>
        </div>

        <button class="menu-toggle" id="menuToggle"
                type="button" aria-label="Open navigation" aria-expanded="false">☰</button>
    </div>

    <nav class="navigation" id="mainNavigation">
        <a th:href="@{/}" class="active">Home</a>
        <a th:href="@{/products}">Shop Products</a>
        <a th:href="@{/vendors}">Our Vendors</a>
        <a th:href="@{/about}">About Us</a>
        <a th:href="@{/contact}">Contact</a>
        <a th:href="@{/customer/dashboard}" class="customer-only">My Dashboard</a>
        <a th:href="@{/vendor/dashboard}" class="vendor-only">Vendor Dashboard</a>
        <a th:href="@{/admin/dashboard}" class="admin-only">Admin Dashboard</a>
    </nav>
</header>

<main>
    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">THE ONECART EDIT</p>
            <h1>Good finds.<br><em>Great stores.</em><br>All in one place.</h1>

            <p class="hero-description">
                Explore products from independent sellers and discover your next favourite.
            </p>

            <div class="hero-buttons">
                <a class="button button-primary" th:href="@{/products}">Explore products</a>
                <a class="button button-secondary" th:href="@{/vendors}">Meet our vendors</a>
            </div>

            <div class="hero-note">
                <span>✓</span> One marketplace. Many ways to find something special.
            </div>
        </div>

        <div class="hero-art" aria-label="OneCart shopping illustration">
            <div class="art-circle"></div>
            <div class="art-card art-card-one">✦<small>Little things</small></div>
            <div class="art-card art-card-two">O<small>OneCart finds</small></div>

            <div class="shopping-bag">
                <div class="bag-handle"></div>
                <strong>one<br>cart</strong>
            </div>

            <div class="art-spark spark-one">✦</div>
            <div class="art-spark spark-two">✧</div>
        </div>
    </section>

    <section class="benefits" aria-label="Shopping benefits">
        <article>
            <span class="benefit-icon">↗</span>
            <div>
                <strong>Discover great stores</strong>
                <small>Shop from independent vendors</small>
            </div>
        </article>

        <article>
            <span class="benefit-icon">◇</span>
            <div>
                <strong>Shop with confidence</strong>
                <small>Secure checkout experience</small>
            </div>
        </article>

        <article>
            <span class="benefit-icon">↺</span>
            <div>
                <strong>Easy order support</strong>
                <small>Help when you need it</small>
            </div>
        </article>

        <article>
            <span class="benefit-icon">♡</span>
            <div>
                <strong>Find your favourites</strong>
                <small>Save items for later</small>
            </div>
        </article>
    </section>

    <section class="section" id="categories">
        <div class="section-heading">
            <div>
                <p class="eyebrow">A WORLD TO EXPLORE</p>
                <h2>Shop by category</h2>
            </div>
            <a th:href="@{/categories}" class="text-link">View all categories ↗</a>
        </div>

        <div class="category-grid">
            <a class="category-card category-fashion" th:href="@{/products(category='Fashion')}">
                <span>✦</span><strong>Fashion</strong><small>Everyday style</small>
            </a>

            <a class="category-card category-tech" th:href="@{/products(category='Electronics')}">
                <span>⌁</span><strong>Electronics</strong><small>Smart discoveries</small>
            </a>

            <a class="category-card category-home" th:href="@{/products(category='Home')}">
                <span>⌂</span><strong>Home &amp; Living</strong><small>Make it yours</small>
            </a>

            <a class="category-card category-beauty" th:href="@{/products(category='Beauty')}">
                <span>✿</span><strong>Beauty</strong><small>Little luxuries</small>
            </a>

            <a class="category-card category-sport" th:href="@{/products(category='Sports')}">
                <span>◉</span><strong>Sports</strong><small>Move your way</small>
            </a>

            <a class="category-card category-gifts" th:href="@{/products(category='Gifts')}">
                <span>♧</span><strong>Gifts &amp; More</strong><small>Something special</small>
            </a>
        </div>
    </section>

    <section class="section product-section" id="featured">
        <div class="section-heading">
            <div>
                <p class="eyebrow">HANDPICKED FOR YOU</p>
                <h2>Featured finds</h2>
            </div>
            <a th:href="@{/products}" class="text-link">Explore all products ↗</a>
        </div>

        <div class="product-grid" id="productGrid">
            <article class="product-card"
                     th:each="product : ${products}"
                     th:attr="data-name=${product.productName},
                              data-category=${product.category},
                              data-product-id=${product.productId}">

                <div class="product-image">
                    <div class="image-placeholder" aria-label="Product image coming soon">✦</div>

                    <button class="wishlist-button" type="button"
                            th:attr="data-product-id=${product.productId}"
                            aria-label="Add to wishlist">♡</button>

                    <span class="discount-tag"
                          th:if="${product.discountPercentage != null and product.discountPercentage.compareTo(T(java.math.BigDecimal).ZERO) > 0}"
                          th:text="|-${#numbers.formatDecimal(product.discountPercentage, 1, 0)}%|"></span>
                </div>

                <div class="product-info">
                    <p class="product-vendor" th:text="${product.brand}">Brand</p>

                    <h3>
                        <a th:href="@{/products/{id}(id=${product.productId})}"
                           th:text="${product.productName}">Product name</a>
                    </h3>

                    <p class="product-category" th:text="${product.category}">Category</p>

                    <div class="product-meta">
                        <strong th:text="|₹${#numbers.formatDecimal(product.price, 1, 2)}|">₹0.00</strong>
                        <span class="rating"
                              th:if="${product.discountPercentage != null}"
                              th:text="|${#numbers.formatDecimal(product.discountPercentage, 1, 0)}% off|"></span>
                    </div>

                    <button class="add-cart-button" type="button"
                            th:attr="data-product-id=${product.productId},
                                     data-product-name=${product.productName}">
                        Add to cart
                    </button>
                </div>
            </article>
        </div>

        <div class="empty-state" th:if="${#lists.isEmpty(products)}">
            <span>✦</span>
            <h3>Your next favourite will be here</h3>
            <p>No products are available right now. Please check back soon.</p>
        </div>
    </section>

    <section class="promo-banner">
        <div>
            <p class="eyebrow">GOOD THINGS, FROM GREAT STORES</p>
            <h2>Find a store.<br>Find something <em>you love.</em></h2>
            <p>Explore independent vendors and their unique collections.</p>
            <a class="button button-light" th:href="@{/vendors}">Explore vendors</a>
        </div>

        <div class="promo-decoration" aria-hidden="true">
            <span>O</span><small>ONE<br>CART</small>
        </div>
    </section>

    <section class="section vendor-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">MEET THE MAKERS &amp; SELLERS</p>
                <h2>Stores to discover</h2>
            </div>
            <a th:href="@{/vendors}" class="text-link">View all stores ↗</a>
        </div>

        <div class="vendor-grid">
            <a class="vendor-card" th:each="vendor : ${vendors}"
               th:href="@{/vendors/{id}(id=${vendor.id})}">
                <div class="vendor-avatar"
                     th:text="${#strings.substring(vendor.name, 0, 1)}">S</div>

                <div>
                    <h3 th:text="${vendor.name}">Store name</h3>
                    <p th:text="${vendor.description}">A store on OneCart</p>
                    <span class="text-link">Visit store ↗</span>
                </div>
            </a>
        </div>

        <div class="empty-state compact" th:if="${#lists.isEmpty(vendors)}">
            <p>Vendor stores will appear here once connected to your database.</p>
        </div>
    </section>

    <section class="stats-strip">
        <div><strong>One</strong><span>easy place to shop</span></div>
        <div><strong>Many</strong><span>stores to discover</span></div>
        <div><strong>More</strong><span>reasons to come back</span></div>
    </section>
</main>

<!-- Footer -->
<footer class="footer">
    <div class="footer-main">
        <div class="footer-brand">
            <a class="brand brand-footer" th:href="@{/}">
                <span class="brand-mark">O</span>
                <span>OneCart<small>Discover. Shop. Enjoy.</small></span>
            </a>
            <p>A marketplace for great finds and the stores behind them.</p>
        </div>

        <div>
            <h3>Explore</h3>
            <a th:href="@{/products}">Products</a>
            <a th:href="@{/categories}">Categories</a>
            <a th:href="@{/vendors}">Our vendors</a>
        </div>

        <div>
            <h3>Help</h3>
            <a th:href="@{/contact}">Contact us</a>
            <a th:href="@{/about}">About OneCart</a>
            <a th:href="@{/login}">Login / Sign up</a>
        </div>

        <div>
            <h3>Stay in the loop</h3>
            <p>Discover new stores and fresh finds.</p>

            <form class="newsletter-form" id="newsletterForm">
                <input type="email" id="newsletterEmail"
                       placeholder="Your email address"
                       aria-label="Your email address" required>
                <button type="submit" aria-label="Subscribe">→</button>
            </form>

            <small id="newsletterMessage" role="status"></small>
        </div>
    </div>

    <div class="footer-bottom">
        <span>© <span id="currentYear"></span> OneCart. All rights reserved.</span>
        <span>Made for discovery.</span>
    </div>
</footer>

<script th:src="@{/js/home.js}"></script>
</body>
</html>