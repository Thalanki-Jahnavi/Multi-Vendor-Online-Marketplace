<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Shop Everything</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/guest/index.html" aria-label="OneCart home">
            <span class="brand-mark">O</span>
            <span>OneCart</span>
        </a>

        <form class="search-form" id="searchForm">
            <input
                type="search"
                id="searchInput"
                placeholder="Search products..."
                aria-label="Search products"
            >
            <button type="submit" aria-label="Search">⌕</button>
        </form>

        <div class="header-actions">
            <button class="text-button" id="accountButton" type="button">Sign in</button>
            <button class="cart-button" id="openCartButton" type="button">
                Cart <span id="cartCount">0</span>
            </button>
        </div>
    </header>

    <nav class="category-nav" aria-label="Product categories">
        <button class="category-button active" data-category="All" type="button">All</button>
        <button class="category-button" data-category="Electronics" type="button">Electronics</button>
        <button class="category-button" data-category="Fashion" type="button">Fashion</button>
        <button class="category-button" data-category="Home" type="button">Home</button>
        <button class="category-button" data-category="Beauty" type="button">Beauty</button>
        <button class="category-button" data-category="Fitness" type="button">Fitness</button>
        <button class="category-button" data-category="Books" type="button">Books</button>
    </nav>

    <main>
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">A little something for every day</p>
                <h1>Good finds.<br>Better prices.</h1>
                <p>Explore useful things from independent sellers, all in one place.</p>
                <a href="#products" class="hero-link">Explore products <span>→</span></a>
            </div>
            <div class="hero-art" aria-hidden="true">
                <span class="hero-circle"></span>
                <span class="hero-label">Your next<br>great find</span>
                <span class="hero-star">✳</span>
            </div>
        </section>

        <section class="products-section" id="products">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">The OneCart edit</p>
                    <h2>Popular right now</h2>
                    <p class="section-subtitle" id="resultSummary">Browse our picks.</p>
                </div>

                <label class="sort-control">
                    Sort by
                    <select id="sortSelect">
                        <option value="featured">Featured</option>
                        <option value="price-low">Price: low to high</option>
                        <option value="price-high">Price: high to low</option>
                        <option value="name">Name: A to Z</option>
                    </select>
                </label>
            </div>

            <div class="product-grid" id="productGrid"></div>
            <p class="empty-state" id="emptyState" hidden>No products match your search.</p>
        </section>
    </main>

    <footer class="site-footer">
        <a class="brand footer-brand" href="/guest/index.html">
            <span class="brand-mark">O</span>
            <span>OneCart</span>
        </a>
        <p>Good finds from more than one seller.</p>
    </footer>

    <div class="overlay" id="cartOverlay" hidden>
        <aside class="cart-panel" role="dialog" aria-modal="true" aria-labelledby="cartTitle">
            <div class="cart-heading">
                <div>
                    <p class="eyebrow">Your bag</p>
                    <h2 id="cartTitle">Shopping cart</h2>
                </div>
                <button class="icon-button" id="closeCartButton" type="button" aria-label="Close cart">×</button>
            </div>

            <div class="cart-items" id="cartItems"></div>

            <div class="cart-bottom">
                <div class="cart-total-row">
                    <span>Subtotal</span>
                    <strong id="cartSubtotal">₹0</strong>
                </div>
                <p class="cart-note">Delivery charges, if any, are calculated at checkout.</p>
                <button class="checkout-button" id="checkoutButton" type="button">Continue to checkout</button>
                <button class="continue-button" id="continueShoppingButton" type="button">Continue shopping</button>
            </div>
        </aside>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script src="/js/script.js" defer></script>
</body>
</html>