<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Shop from Multiple Vendors</title>
    <link rel="stylesheet" href="../css/style.css">
    <script src="../js/script.js" defer></script>
</head>
<body>
    <header class="site-header">
        <a class="logo" href="index.html">One<span>Cart</span></a>

        <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation">
            ☰
        </button>

        <nav class="nav-links" id="navLinks">
            <a href="index.html" class="active">Home</a>
            <a href="about.html">About</a>
            <a href="contact.html">Contact</a>
        </nav>

        <div class="header-actions">
            <a class="login-link" href="login.html">Login</a>
            <a class="button button-small" href="signup.html">Sign Up</a>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="hero-content">
                <p class="eyebrow">ONE PLACE. MANY STORES.</p>
                <h1>Everything you love,<br><span>all in OneCart.</span></h1>
                <p class="hero-description">
                    Discover products from multiple vendors and enjoy a simple,
                    convenient shopping experience.
                </p>
                <a class="button" href="#featured">Explore Products</a>
            </div>

            <div class="hero-art" aria-label="Shopping bags illustration">
                <div class="art-circle"></div>
                <div class="shopping-bag bag-back">✦</div>
                <div class="shopping-bag bag-front">
                    <span>One</span>
                    <strong>Cart</strong>
                </div>
                <div class="floating-tag">Find your next favourite</div>
            </div>
        </section>

        <section class="section categories-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">EXPLORE</p>
                    <h2>Shop by category</h2>
                </div>
                <p class="section-note">A little something for everyone.</p>
            </div>

            <div class="category-grid">
                <a class="category-card" href="#featured" data-category="Electronics">
                    <span class="category-icon">⌘</span>
                    <span>Electronics</span>
                </a>
                <a class="category-card" href="#featured" data-category="Fashion">
                    <span class="category-icon">♧</span>
                    <span>Fashion</span>
                </a>
                <a class="category-card" href="#featured" data-category="Home">
                    <span class="category-icon">⌂</span>
                    <span>Home & Living</span>
                </a>
                <a class="category-card" href="#featured" data-category="Beauty">
                    <span class="category-icon">✿</span>
                    <span>Beauty</span>
                </a>
            </div>
        </section>

        <section class="section featured-section" id="featured">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">HANDPICKED FOR YOU</p>
                    <h2>Featured finds</h2>
                </div>
                <label class="search-box">
                    <span aria-hidden="true">⌕</span>
                    <input id="productSearch" type="search" placeholder="Search products"
                           aria-label="Search products">
                </label>
            </div>

            <div class="filter-row" aria-label="Filter products">
                <button class="filter-button active" data-filter="All">All</button>
                <button class="filter-button" data-filter="Electronics">Electronics</button>
                <button class="filter-button" data-filter="Fashion">Fashion</button>
                <button class="filter-button" data-filter="Home">Home</button>
                <button class="filter-button" data-filter="Beauty">Beauty</button>
            </div>

            <div class="product-grid" id="productGrid">
                <article class="product-card" data-category="Electronics" data-name="Wireless headphones">
                    <div class="product-image product-image-one">
                        <span class="product-badge">Popular</span>
                        <span class="product-emoji" aria-hidden="true">🎧</span>
                    </div>
                    <div class="product-info">
                        <p class="product-category">Electronics</p>
                        <h3>Wireless Headphones</h3>
                        <div class="product-bottom">
                            <strong>₹1,499</strong>
                            <button class="add-button" aria-label="Add Wireless Headphones to cart">+</button>
                        </div>
                    </div>
                </article>

                <article class="product-card" data-category="Fashion" data-name="Everyday tote bag">
                    <div class="product-image product-image-two">
                        <span class="product-emoji" aria-hidden="true">👜</span>
                    </div>
                    <div class="product-info">
                        <p class="product-category">Fashion</p>
                        <h3>Everyday Tote Bag</h3>
                        <div class="product-bottom">
                            <strong>₹799</strong>
                            <button class="add-button" aria-label="Add Everyday Tote Bag to cart">+</button>
                        </div>
                    </div>
                </article>

                <article class="product-card" data-category="Home" data-name="Ceramic coffee mug">
                    <div class="product-image product-image-three">
                        <span class="product-emoji" aria-hidden="true">☕</span>
                    </div>
                    <div class="product-info">
                        <p class="product-category">Home</p>
                        <h3>Ceramic Coffee Mug</h3>
                        <div class="product-bottom">
                            <strong>₹349</strong>
                            <button class="add-button" aria-label="Add Ceramic Coffee Mug to cart">+</button>
                        </div>
                    </div>
                </article>

                <article class="product-card" data-category="Beauty" data-name="Daily skincare set">
                    <div class="product-image product-image-four">
                        <span class="product-badge">New</span>
                        <span class="product-emoji" aria-hidden="true">🧴</span>
                    </div>
                    <div class="product-info">
                        <p class="product-category">Beauty</p>
                        <h3>Daily Skincare Set</h3>
                        <div class="product-bottom">
                            <strong>₹999</strong>
                            <button class="add-button" aria-label="Add Daily Skincare Set to cart">+</button>
                        </div>
                    </div>
                </article>
            </div>
            <p class="empty-message" id="emptyMessage" hidden>No matching products found.</p>
            <p class="demo-note">Sample products for the frontend preview. We'll connect real products later.</p>
        </section>

        <section class="benefits-section">
            <div class="section">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">THE ONECART DIFFERENCE</p>
                        <h2>Shopping made simpler</h2>
                    </div>
                </div>
                <div class="benefit-grid">
                    <article class="benefit">
                        <span class="benefit-icon">♡</span>
                        <h3>More choice</h3>
                        <p>Discover products from different sellers in one place.</p>
                    </article>
                    <article class="benefit">
                        <span class="benefit-icon">✓</span>
                        <h3>Easy shopping</h3>
                        <p>Browse, compare and find what you need with ease.</p>
                    </article>
                    <article class="benefit">
                        <span class="benefit-icon">↗</span>
                        <h3>Support sellers</h3>
                        <p>Explore unique finds from a growing community of vendors.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="seller-banner">
            <div>
                <p class="eyebrow">GROW WITH ONECART</p>
                <h2>Have products to sell?</h2>
                <p>Bring your store online and reach more customers.</p>
            </div>
            <a class="button button-light" href="signup.html">Become a Seller</a>
        </section>
    </main>

    <footer class="site-footer">
        <a class="logo footer-logo" href="index.html">One<span>Cart</span></a>
        <p>One place. Many stores. A simpler way to shop.</p>
        <div class="footer-links">
            <a href="about.html">About</a>
            <a href="contact.html">Contact</a>
            <a href="login.html">Login</a>
        </div>
        <small>© <span id="currentYear"></span> OneCart. All rights reserved.</small>
    </footer>
</body>
</html>