<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In | OneCart</title>
    <link rel="stylesheet" th:href="@{/css/login.css}">
</head>
<body>
<header class="site-header">
    <a class="brand" th:href="@{/}">One<span>Cart</span></a>
    <a class="back-link" th:href="@{/}">← Back to home</a>
</header>

<main class="login-layout">
    <section class="welcome-panel">
        <p class="eyebrow">WELCOME TO ONECART</p>
        <h1>Everything you love, all in one place.</h1>
        <p>Sign in to explore products, track orders, and enjoy a smoother shopping experience.</p>
        <div class="welcome-art" aria-hidden="true">
            <div class="art-circle"></div>
            <div class="art-card card-one">Your next favorite find</div>
            <div class="art-card card-two">OneCart <span>♥</span></div>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <p class="eyebrow">YOUR ACCOUNT</p>
            <h2>Welcome back</h2>
            <p class="intro">Enter your details to sign in.</p>

            <div class="alert error-alert" th:if="${param.error}">
                Email or password is incorrect.
            </div>
            <div class="alert success-alert" th:if="${param.logout}">
                You have been signed out.
            </div>

            <form th:action="@{/login}" method="post">
                <div class="form-group">
                    <label for="email">Email address</label>
                    <input
                        type="email"
                        id="email"
                        name="username"
                        placeholder="you@example.com"
                        autocomplete="username"
                        required>
                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label for="password">Password</label>
						<a class="forgot-password-link" th:href="@{/forgot-password}">
						    Forgot password?
						</a>
                    </div>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required>
                </div>

                <button type="submit" class="submit-button">Sign in</button>
            </form>

            <p class="signup-text">
                Don’t have an account?
                <a th:href="@{/signup}">Create an account</a>
            </p>

            <p class="login-note">
                Customer and vendor accounts can sign in here.
            </p>
        </div>
    </section>
</main>
</body>
</html>