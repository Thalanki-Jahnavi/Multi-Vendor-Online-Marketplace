select {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    color: var(--text);
    background: #fbfdfc;
    border: 1px solid var(--border);
    border-radius: 9px;
    font: inherit;
    font-size: 14px;
}

select:focus {
    outline: 2px solid rgba(8, 126, 120, 0.2);
    border-color: var(--emerald);
}

[hidden] {
    display: none !important;
}

form label {
    margin-top: 4px;
}