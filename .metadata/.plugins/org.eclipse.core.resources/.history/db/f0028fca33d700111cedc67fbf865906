:root {
    --emerald: #087e78;
    --deep: #123e3a;
    --mint: #e5f4f0;
    --white: #ffffff;
    --ink: #233b37;
    --muted: #788b86;
    --line: #e6eeea;
    --cream: #f8f8f3;
    --serif: "Playfair Display", Georgia, serif;
    --sans: "DM Sans", Arial, sans-serif;
    --page: min(1200px, calc(100% - 80px));
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
}

body {
    margin: 0;
    color: var(--ink);
    background: var(--white);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
}

body.menu-open {
    overflow: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
    outline: 3px solid #80c8bb;
    outline-offset: 3px;
}

img {
    max-width: 100%;
    display: block;
}

.announcement {
    min-height: 36px;
    padding: 8px 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    background: var(--deep);
    color: white;
    font-size: 11px;
    letter-spacing: .04em;
}

.announcement p {
    margin: 0;
}

.announcement a {
    color: #b9e7d9;
    font-weight: 600;
}

.announcement a span {
    margin-left: 5px;
}

.site-header {
    min-height: 82px;
    padding: 0 max(40px, calc((100% - 1200px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    background: white;
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 100;
}

.brand {
    flex-shrink: 0;
    font-size: 29px;
    font-weight: 700;
    letter-spacing: -.07em;
    color: var(--deep);
}

.brand span {
    color: var(--emerald);
}

.brand i {
    color: #b8a47c;
    font-style: normal;
}

.desktop-nav {
    display: flex;
    align-items: center;
    gap: 25px;
    white-space: nowrap;
}

.desktop-nav a {
    color: #687b76;
    font-size: 12px;
    transition: color .2s;
}

.desktop-nav a:hover,
.footer-column a:hover {
    color: var(--emerald);
}

.search-box {
    height: 40px;
    min-width: 180px;
    max-width: 270px;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 9px 0 13px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fbfcfa;
}

.search-icon {
    font-size: 24px;
    color: var(--muted);
    line-height: 1;
}

.search-box input {
    min-width: 0;
    width: 100%;
    border: 0;
    outline: none;
    background: transparent;
    font-size: 11px;
    color: var(--ink);
}

.search-box button {
    border: 0;
    background: transparent;
    color: var(--emerald);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 13px;
    white-space: nowrap;
}

.header-link {
    color: var(--deep);
    font-size: 12px;
}

.header-signup {
    padding: 11px 16px;
    background: var(--emerald);
    border-radius: 5px;
    color: white;
    font-size: 11px;
    font-weight: 600;
}

.icon-link {
    position: relative;
    font-size: 19px;
    color: var(--deep);
}

.count {
    position: absolute;
    top: -7px;
    right: -10px;
    display: grid;
    place-items: center;
    min-width: 15px;
    height: 15px;
    padding: 0 3px;
    border-radius: 50%;
    background: var(--emerald);
    color: white;
    font-size: 9px;
}

.customer-only,
.vendor-only,
.admin-only {
    display: none;
}

body[data-role="CUSTOMER"] .customer-only,
body[data-role="VENDOR"] .vendor-only,
body[data-role="ADMIN"] .admin-only {
    display: inline-flex;
}

body[data-role="CUSTOMER"] .guest-only,
body[data-role="VENDOR"] .guest-only,
body[data-role="ADMIN"] .guest-only {
    display: none;
}

.menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: white;
    border-radius: 5px;
    cursor: pointer;
}

.menu-toggle span {
    display: block;
    width: 17px;
    height: 1.5px;
    margin: 4px auto;
    background: var(--deep);
}

.mobile-menu {
    position: fixed;
    inset: 118px 0 0;
    z-index: 99;
    padding: 25px 7%;
    background: white;
    overflow-y: auto;
    box-shadow: 0 15px 25px #123e3a12;
}

.mobile-menu[hidden] {
    display: none;
}

.mobile-menu a {
    display: block;
    padding: 17px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
}

.hero {
    width: var(--page);
    min-height: 540px;
    margin: 0 auto;
    padding: 55px 0 65px;
    display: grid;
    grid-template-columns: 1.02fr 1fr;
    align-items: center;
    gap: 60px;
}

.hero-copy {
    padding: 10px 0;
    animation: rise-in .7s ease both;
}

.eyebrow {
    margin: 0 0 20px;
    color: var(--emerald);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .17em;
}

.hero .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
}

.eyebrow-line {
    width: 24px;
    height: 1px;
    background: var(--emerald);
}

.hero h1,
.section-heading h2,
.promo-copy h2,
.trust-heading h2,
.testimonials-section h2,
.newsletter-section h2 {
    margin: 0;
    color: var(--deep);
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -.045em;
}

.hero h1 {
    font-size: clamp(42px, 5vw, 67px);
    line-height: 1.12;
}

.hero h1 em,
.section-heading h2 em,
.promo-copy h2 em,
.trust-heading h2 em,
.testimonials-section h2 em,
.newsletter-section h2 em {
    color: var(--emerald);
    font-weight: 600;
}

.hero-description {
    max-width: 420px;
    margin: 24px 0 28px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
}

.hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    min-height: 46px;
    padding: 0 20px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    transition: transform .2s, background .2s;
}

.button:hover {
    transform: translateY(-2px);
}

.button-primary {
    background: var(--emerald);
    color: white;
}

.button-primary:hover {
    background: var(--deep);
}

.text-link {
    color: var(--deep);
    font-size: 11px;
    font-weight: 600;
}

.text-link span {
    margin-left: 8px;
    color: var(--emerald);
}

.hero-note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 38px;
    color: #84938f;
    font-size: 10px;
}

.note-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #9bc7b7;
}

.hero-visual {
    position: relative;
    min-width: 0;
    padding: 12px 25px 20px 0;
    animation: rise-in .8s .1s ease both;
}

.hero-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1.05;
    overflow: hidden;
    background: var(--mint);
    border-radius: 48% 48% 7px 7px;
}

.hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-image-fallback {
    display: none;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--deep);
    background:
        radial-gradient(circle at 25% 20%, #ffffff 0 8%, transparent 8.5%),
        radial-gradient(circle at 80% 70%, #c3e3d8 0 19%, transparent 19.5%),
        linear-gradient(145deg, #d4ebe2, #f3f8f2);
}

.hero-image-fallback span {
    font-size: 10px;
    letter-spacing: .2em;
    margin-bottom: 20px;
}

.hero-image-fallback strong {
    font-family: var(--serif);
    font-size: clamp(35px, 5vw, 60px);
    line-height: 1.1;
}

.hero-image-fallback small {
    margin-top: 20px;
    color: var(--muted);
    font-size: 10px;
}

.floating-note {
    position: absolute;
    bottom: 45px;
    left: -25px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 20px;
    background: white;
    box-shadow: 0 12px 40px #123e3a12;
    border-radius: 6px;
}

.floating-note-icon {
    color: var(--emerald);
    font-size: 26px;
}

.floating-note strong,
.floating-note small {
    display: block;
}

.floating-note strong {
    font-size: 11px;
    color: var(--deep);
}

.floating-note small {
    margin-top: 4px;
    color: var(--muted);
    font-size: 10px;
}

.hero-stamp {
    position: absolute;
    top: 22px;
    right: 0;
    display: grid;
    place-items: center;
    width: 77px;
    height: 77px;
    border: 1px solid #b6d4c9;
    border-radius: 50%;
    color: var(--emerald);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .08em;
    text-align: center;
    line-height: 1.4;
    transform: rotate(10deg);
}

.benefit-strip {
    min-height: 70px;
    padding: 20px 7%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 45px;
    background: var(--deep);
    color: #e6f4ef;
}

.benefit-strip div {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
}

.benefit-strip span {
    color: #a3d5c6;
    font-size: 15px;
}

.section {
    width: var(--page);
    margin: 0 auto;
    padding: 100px 0;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 35px;
}

.section-heading .eyebrow {
    margin-bottom: 14px;
}

.section-heading h2,
.trust-heading h2,
.testimonials-section h2,
.newsletter-section h2 {
    font-size: clamp(32px, 4vw, 46px);
    line-height: 1.2;
}

.section-intro {
    max-width: 340px;
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

.category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}

.category-card {
    min-width: 0;
}

.category-art {
    position: relative;
    aspect-ratio: .9;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: 6px;
    transition: transform .3s;
}

.category-card:hover .category-art {
    transform: translateY(-5px);
}

.art-fashion {
    background: linear-gradient(145deg, #eee6d9, #d6c7b5);
}

.art-tech {
    background: linear-gradient(145deg, #d9e8e7, #a5c6c0);
}

.art-home {
    background: linear-gradient(145deg, #e8e5d9, #d1d4bc);
}

.art-beauty {
    background: linear-gradient(145deg, #f0dfe2, #dfbfc8);
}

.art-shape {
    width: 58%;
    height: 65%;
    border-radius: 48% 48% 12% 12%;
    background: #ffffff50;
    border: 1px solid #ffffff90;
    box-shadow: 0 15px 40px #123e3a0c;
    transform: rotate(-7deg);
    transition: transform .4s;
}

.category-card:hover .art-shape {
    transform: rotate(0deg) scale(1.05);
}

.art-fashion .art-shape {
    border-radius: 40% 40% 8% 8%;
    background: linear-gradient(130deg, #f7eee0, #b49b83);
}

.art-tech .art-shape {
    width: 64%;
    height: 45%;
    border-radius: 15px;
    background: linear-gradient(140deg, #f7fbf8, #8eaaa6);
    transform: rotate(12deg);
}

.art-home .art-shape {
    width: 42%;
    height: 57%;
    border-radius: 50% 50% 10% 10%;
    background: linear-gradient(140deg, #f5f0df, #a9b39a);
}

.art-beauty .art-shape {
    width: 35%;
    height: 56%;
    border-radius: 12px 12px 8px 8px;
    background: linear-gradient(140deg, #fff4f4, #bd8292);
}

.art-caption {
    position: absolute;
    bottom: 18px;
    left: 18px;
    color: #ffffff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .12em;
    text-shadow: 0 1px 5px #123e3a40;
}

.category-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 17px 2px;
}

.category-info h3 {
    margin: 0;
    color: var(--deep);
    font-size: 13px;
    font-weight: 600;
}

.category-info p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 10px;
}

.round-arrow {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--emerald);
    transition: background .2s, color .2s;
}

.category-card:hover .round-arrow {
    background: var(--emerald);
    color: white;
}

.products-section {
    padding-top: 40px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}

.empty-state {
    grid-column: 1 / -1;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 35px 20px;
    text-align: center;
    border: 1px dashed #cbded6;
    border-radius: 7px;
    background: #fbfdfb;
}

.empty-icon {
    color: var(--emerald);
    font-size: 27px;
}

.empty-state h3 {
    margin: 14px 0 8px;
    color: var(--deep);
    font-family: var(--serif);
    font-size: 23px;
    font-weight: 600;
}

.empty-state p {
    max-width: 350px;
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

.promo-section {
    position: relative;
    width: var(--page);
    min-height: 350px;
    margin: 20px auto 60px;
    padding: 55px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    overflow: hidden;
    border-radius: 7px;
    background: var(--deep);
    color: white;
}

.promo-copy {
    position: relative;
    z-index: 2;
    max-width: 470px;
}

.promo-copy .eyebrow {
    color: #a3d5c6;
}

.promo-copy h2 {
    color: white;
    font-size: clamp(35px, 4vw, 50px);
    line-height: 1.15;
}

.promo-copy h2 em {
    color: #a3d5c6;
}

.promo-copy > p:not(.eyebrow) {
    max-width: 390px;
    margin: 20px 0 25px;
    color: #c4d9d2;
    font-size: 12px;
    line-height: 1.8;
}

.button-light {
    background: #e5f4f0;
    color: var(--deep);
}

.promo-art {
    position: relative;
    width: 290px;
    height: 250px;
    flex-shrink: 0;
}

.promo-circle {
    position: absolute;
    width: 210px;
    height: 210px;
    top: 20px;
    left: 35px;
    border-radius: 50%;
    background: linear-gradient(145deg, #b8ded1, #5ca69a);
}

.promo-orbit {
    position: absolute;
    width: 270px;
    height: 160px;
    top: 45px;
    left: 5px;
    border: 1px solid #b9e0d450;
    border-radius: 50%;
    transform: rotate(-35deg);
}

.promo-star {
    position: absolute;
    top: 15px;
    right: 10px;
    color: #c3e5d9;
    font-size: 35px;
}

.promo-word {
    position: absolute;
    top: 85px;
    left: 95px;
    color: var(--deep);
    font-family: var(--serif);
    font-size: 31px;
    font-weight: 700;
    line-height: 1;
    transform: rotate(-8deg);
}

.new-arrivals-section {
    padding-top: 40px;
}

.stores-section {
    padding-top: 70px;
}

.store-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.trust-section {
    width: 100%;
    padding: 85px max(40px, calc((100% - 1200px) / 2));
    background: var(--mint);
}

.trust-heading {
    text-align: center;
    margin-bottom: 40px;
}

.trust-heading .eyebrow {
    margin-bottom: 15px;
}

.trust-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
}

.trust-card {
    padding: 28px;
    background: #ffffffa8;
    border-radius: 6px;
}

.trust-icon {
    color: var(--emerald);
    font-size: 24px;
}

.trust-card h3 {
    margin: 18px 0 10px;
    color: var(--deep);
    font-size: 14px;
}

.trust-card p {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
}

.testimonials-section {
    text-align: center;
}

.testimonials-section .eyebrow {
    margin-bottom: 15px;
}

.testimonial-empty {
    max-width: 520px;
    margin: 30px auto 0;
    padding: 25px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

.testimonial-empty span {
    color: var(--emerald);
    font-size: 24px;
}

.newsletter-section {
    padding: 65px max(40px, calc((100% - 1200px) / 2));
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
    background: #f8faf7;
}

.newsletter-section .eyebrow {
    margin-bottom: 15px;
}

.newsletter-section h2 {
    font-size: clamp(30px, 4vw, 42px);
}

.newsletter-section > div > p:last-child {
    max-width: 430px;
    margin: 15px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

.newsletter-form label {
    display: block;
    margin-bottom: 10px;
    color: var(--deep);
    font-size: 11px;
    font-weight: 600;
}

.newsletter-input-row {
    display: flex;
    min-height: 48px;
    border: 1px solid #d9e5df;
    border-radius: 5px;
    background: white;
}

.newsletter-input-row input {
    width: 100%;
    min-width: 0;
    padding: 0 15px;
    border: 0;
    outline: none;
    background: transparent;
    font-size: 12px;
}

.newsletter-input-row button {
    margin: 4px;
    padding: 0 18px;
    border: 0;
    border-radius: 4px;
    background: var(--emerald);
    color: white;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
}

.newsletter-input-row button span {
    margin-left: 8px;
}

.form-message {
    min-height: 16px;
    margin: 8px 0 0;
    color: var(--emerald);
    font-size: 11px;
}

.form-message.error {
    color: #b64747;
}

.site-footer {
    padding: 55px max(40px, calc((100% - 1200px) / 2)) 20px;
    background: var(--deep);
    color: white;
}

.footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 45px;
}

.brand-light {
    color: white;
}

.footer-brand p {
    margin: 15px 0 0;
    color: #b5cec5;
    font-size: 12px;
    line-height: 1.8;
}

.footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
}

.footer-column h3 {
    margin: 5px 0 7px;
    color: #b5cec5;
    font-size: 11px;
    font-weight: 600;
}

.footer-column a {
    color: white;
    font-size: 11px;
    transition: color .2s;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid #ffffff25;
    color: #b5cec5;
    font-size: 10px;
}

.footer-bottom p {
    margin: 0;
}

.footer-bottom div {
    display: flex;
    gap: 25px;
}

.toast {
    position: fixed;
    bottom: 25px;
    left: 50%;
    z-index: 200;
    max-width: calc(100% - 32px);
    padding: 14px 20px;
    border-radius: 5px;
    background: var(--deep);
    color: white;
    font-size: 12px;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 15px);
    transition: opacity .2s, transform .2s;
}

.toast.visible {
    opacity: 1;
    transform: translate(-50%, 0);
}

@keyframes rise-in {
    from {
        opacity: 0;
        transform: translateY(18px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
    }
}

@media (max-width: 1100px) {
    :root {
        --page: min(100% - 48px, 900px);
    }

    .site-header {
        padding: 0 24px;
        gap: 15px;
    }

    .desktop-nav {
        gap: 15px;
    }

    .desktop-nav a {
        font-size: 11px;
    }

    .search-box {
        max-width: 210px;
    }

    .hero {
        gap: 30px;
    }

    .category-grid,
    .product-grid {
        gap: 14px;
    }

    .trust-section,
    .newsletter-section,
    .site-footer {
        padding-left: 24px;
        padding-right: 24px;
    }
}

@media (max-width: 820px) {
    .desktop-nav {
        display: none;
    }

    .search-box {
        max-width: none;
    }

    .menu-toggle {
        display: block;
    }

    .hero {
        min-height: auto;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        padding: 65px 0;
    }

    .hero h1 {
        font-size: clamp(37px, 6vw, 54px);
    }

    .hero-visual {
        padding-right: 10px;
    }

    .floating-note {
        left: -10px;
        bottom: 25px;
        padding: 12px;
    }

    .hero-stamp {
        width: 60px;
        height: 60px;
        font-size: 8px;
    }

    .category-grid,
    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .store-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .promo-art {
        transform: scale(.8);
        transform-origin: center right;
        margin-right: -25px;
    }

    .trust-section {
        padding-top: 65px;
        padding-bottom: 65px;
    }

    .trust-grid {
        gap: 12px;
    }

    .trust-card {
        padding: 20px;
    }
}

@media (max-width: 600px) {
    :root {
        --page: calc(100% - 36px);
    }

    .announcement {
        gap: 8px;
        padding: 9px 12px;
        font-size: 9px;
    }

    .site-header {
        min-height: 68px;
        padding: 0 18px;
        gap: 12px;
    }

    .brand {
        font-size: 25px;
    }

    .search-box {
        height: 36px;
        padding: 0 8px;
    }

    .search-box input {
        font-size: 10px;
    }

    .search-box button {
        display: none;
    }

    .header-actions {
        gap: 7px;
    }

    .header-link,
    .header-signup {
        display: none;
    }

    .menu-toggle {
        width: 34px;
        height: 36px;
    }

    .mobile-menu {
        inset-top: 104px;
        top: 104px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 55px 0 45px;
        gap: 30px;
    }

    .hero h1 {
        font-size: clamp(42px, 11vw, 58px);
    }

    .hero-description {
        margin: 18px 0 23px;
        font-size: 12px;
    }

    .hero-note {
        margin-top: 25px;
    }

    .hero-visual {
        width: 90%;
        margin: 0 auto;
    }

    .hero-image-wrap {
        aspect-ratio: 1.2;
    }

    .hero-stamp {
        right: -12px;
    }

    .benefit-strip {
        justify-content: flex-start;
        gap: 14px;
        padding: 18px;
    }

    .benefit-strip div {
        font-size: 10px;
    }

    .section {
        padding: 65px 0;
    }

    .section-heading {
        display: block;
        margin-bottom: 25px;
    }

    .section-heading h2,
    .trust-heading h2,
    .testimonials-section h2 {
        font-size: 35px;
    }

    .section-intro {
        margin-top: 15px;
    }

    .category-grid {
        gap: 12px;
    }

    .category-art {
        aspect-ratio: .95;
    }

    .category-info {
        padding: 12px 0;
    }

    .category-info h3 {
        font-size: 11px;
    }

    .category-info p {
        font-size: 9px;
    }

    .round-arrow {
        width: 25px;
        height: 25px;
    }

    .products-section,
    .new-arrivals-section {
        padding-top: 20px;
    }

    .empty-state {
        min-height: 200px;
        padding: 25px 15px;
    }

    .empty-state h3 {
        font-size: 21px;
    }

    .promo-section {
        width: calc(100% - 36px);
        min-height: 0;
        margin: 0 auto 25px;
        padding: 40px 25px;
    }

    .promo-copy {
        max-width: 100%;
    }

    .promo-copy h2 {
        font-size: 37px;
    }

    .promo-art {
        display: none;
    }

    .store-grid {
        grid-template-columns: 1fr;
    }

    .trust-section {
        padding: 60px 18px;
    }

    .trust-heading {
        margin-bottom: 25px;
    }

    .trust-grid {
        grid-template-columns: 1fr;
    }

    .trust-card {
        padding: 24px;
    }

    .testimonials-section {
        padding-top: 60px;
        padding-bottom: 60px;
    }

    .newsletter-section {
        padding: 50px 18px;
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .newsletter-section h2 {
        font-size: 35px;
    }

    .newsletter-input-row button {
        padding: 0 12px;
    }

    .site-footer {
        padding: 45px 18px 20px;
    }

    .footer-main {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px 20px;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-bottom {
        align-items: flex-start;
        flex-direction: column;
        font-size: 10px;
    }
}