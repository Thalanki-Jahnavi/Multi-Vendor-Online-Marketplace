:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --light-mint: #f4faf8;
    --text: #183b38;
    --muted: #627b77;
    --border: #dcebe7;
    --white: #ffffff;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    color: var(--text);
    background: var(--white);
    font-family: Arial, Helvetica, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

.topbar {
    padding: 12px 20px;
    color: var(--white);
    background: var(--deep-green);
    text-align: center;
    font-size: 14px;
}

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 24px max(7%, calc((100% - 1400px) / 2));
    border-bottom: 1px solid var(--border);
}

.logo {
    color: var(--emerald);
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -1px;
}

.search-form {
    display: flex;
    width: min(620px, 52%);
    min-width: 260px;
    height: 52px;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
}

.search-form input {
    flex: 1;
    min-width: 0;
    padding: 0 18px;
    border: 0;
    outline: none;
    font: inherit;
}

.search-form button {
    padding: 0 25px;
    color: var(--white);
    background: var(--emerald);
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
}

.header-links {
    display: flex;
    gap: 24px;
    white-space: nowrap;
    font-weight: 700;
}

.header-links a:hover,
.navigation a:hover,
.footer-column a:hover {
    color: var(--emerald);
}

.navigation {
    display: flex;
    justify-content: center;
    gap: 42px;
    padding: 22px 20px;
    border-bottom: 1px solid var(--border);
}

.hero,
.featured-section,
.vendors-section {
    width: min(1400px, 86%);
    margin: 0 auto;
}

.hero {
    display: flex;
    align-items: center;
    min-height: 470px;
    margin-top: 34px;
    padding: 60px 5%;
    border-radius: 24px;
    background: linear-gradient(110deg, var(--mint), var(--light-mint));
}

.hero-content {
    max-width: 650px;
}

.eyebrow {
    margin: 0 0 18px;
    color: var(--emerald);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 2px;
}

.hero h1 {
    max-width: 650px;
    margin: 0;
    color: var(--deep-green);
    font-size: clamp(42px, 5vw, 64px);
    line-height: 1.08;
}

.hero-description {
    max-width: 600px;
    margin: 24px 0 34px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
}

.primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 26px;
    color: var(--white);
    background: var(--emerald);
    border-radius: 10px;
    font-weight: 700;
    transition: background 0.2s, transform 0.2s;
}

.primary-button:hover {
    background: var(--deep-green);
    transform: translateY(-2px);
}

.featured-section,
.vendors-section {
    padding: 70px 0 20px;
}

.section-heading {
    margin-bottom: 26px;
}

.section-heading h2 {
    margin: 0 0 10px;
    color: var(--deep-green);
    font-size: 34px;
}

.section-heading p {
    margin: 0;
    color: var(--muted);
    font-size: 17px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
}

.product-card {
    overflow: hidden;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--white);
    transition: box-shadow 0.2s, transform 0.2s;
}

.product-card:hover {
    box-shadow: 0 12px 30px rgba(18, 62, 58, 0.09);
    transform: translateY(-3px);
}

.product-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 175px;
    margin-bottom: 18px;
    color: var(--emerald);
    background: var(--mint);
    border-radius: 12px;
    font-weight: 700;
}

.product-details h3 {
    margin: 0 0 12px;
    color: #172f2c;
    font-size: 18px;
}

.product-price {
    margin: 0;
    color: var(--deep-green);
    font-size: 20px;
    font-weight: 800;
}

.empty-products {
    padding: 35px;
    border: 1px dashed var(--border);
    border-radius: 16px;
    text-align: center;
    background: var(--light-mint);
}

.empty-products h3 {
    margin-top: 0;
}

.empty-products p {
    margin-bottom: 0;
    color: var(--muted);
}

.vendor-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.vendor-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--white);
}

.vendor-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    margin-bottom: 20px;
    color: var(--emerald);
    background: var(--mint);
    border-radius: 15px;
    font-weight: 800;
}

.vendor-card h3 {
    margin: 0 0 12px;
    color: var(--deep-green);
    font-size: 21px;
}

.vendor-card p {
    min-height: 48px;
    color: var(--muted);
    line-height: 1.6;
}

.vendor-card a {
    display: inline-block;
    margin-top: 8px;
    color: var(--emerald);
    font-weight: 700;
}

.vendor-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    margin-top: 30px;
    padding: 30px;
    border-radius: 18px;
    background: var(--mint);
}

.vendor-cta h3 {
    margin: 0 0 8px;
    color: var(--deep-green);
    font-size: 24px;
}

.vendor-cta p {
    margin: 0;
    color: var(--muted);
}

.footer {
    margin-top: 70px;
    padding: 55px max(7%, calc((100% - 1400px) / 2)) 0;
    color: var(--white);
    background: var(--deep-green);
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
}

.footer-logo {
    color: var(--white);
    font-size: 30px;
    font-weight: 800;
}

.footer-brand p {
    color: #c5d9d5;
    line-height: 1.6;
}

.footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
}

.footer-column h3 {
    margin: 0 0 5px;
    color: var(--white);
    font-size: 16px;
}

.footer-column a {
    color: #c5d9d5;
    font-size: 14px;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    color: #c5d9d5;
    font-size: 13px;
}

.footer-bottom p {
    margin: 0;
}

@media (max-width: 1000px) {
    .header {
        flex-wrap: wrap;
    }

    .search-form {
        order: 3;
        width: 100%;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .vendor-grid {
        grid-template-columns: 1fr;
    }

    .footer-content {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .header {
        padding: 20px 5%;
    }

    .logo {
        font-size: 27px;
    }

    .header-links {
        gap: 14px;
        font-size: 14px;
    }

    .navigation {
        gap: 20px;
        flex-wrap: wrap;
        padding: 17px 10px;
    }

    .hero,
    .featured-section,
    .vendors-section {
        width: 90%;
    }

    .hero {
        min-height: 390px;
        margin-top: 20px;
        padding: 35px 25px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero-description {
        font-size: 16px;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .vendor-cta,
    .footer-bottom {
        align-items: flex-start;
        flex-direction: column;
    }

    .footer-content {
        grid-template-columns: 1fr 1fr;
        gap: 30px 20px;
    }

    .footer {
        padding: 40px 5% 0;
    }
}