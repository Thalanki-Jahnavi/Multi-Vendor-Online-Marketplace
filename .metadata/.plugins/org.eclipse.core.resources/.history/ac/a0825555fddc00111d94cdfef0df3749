
package com.vendor.repository;

import java.util.List;
import java.util.Optional;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import com.vendor.entity.Product;

@Repository
public interface ProductRepository extends JpaRepository<Product, Long> {

    List<Product> findByProductStatusIgnoreCaseAndApprovalStatusIgnoreCaseOrderByProductIdDesc(
            String productStatus,
            String approvalStatus
    );

    // Get only the products belonging to the logged-in vendor
    List<Product> findByVendorIdOrderByProductIdDesc(Integer vendorId);

    // Find a product only when it belongs to this vendor
    Optional<Product> findByProductIdAndVendorId(
            Long productId,
            Integer vendorId
    );
}
