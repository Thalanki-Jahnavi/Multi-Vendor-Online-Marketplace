<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | OneCart</title>
    <link rel="stylesheet" th:href="@{/css/login.css}">
</head>
<body>
    <header class="topbar">
        <a class="brand" th:href="@{/}">
            <span class="brand-mark">O</span>
            <span>OneCart</span>
        </a>
        <a class="back-link" th:href="@{/}">← Back to home</a>
    </header>

    <main class="page">
        <section class="login-card">
            <div class="card-heading">
                <p class="eyebrow">WELCOME BACK</p>
                <h1>Sign in to OneCart</h1>
                <p class="subtitle">Your favorite stores, all in one place.</p>
            </div>

            <div class="message error" th:if="${param.error}">
                Email or password is incorrect. Please try again.
            </div>

            <div class="message success" th:if="${param.logout}">
                You have been logged out successfully.
            </div>

            <form th:action="@{/login}" method="post">
                <label for="username">Email address</label>
                <input
                    id="username"
                    name="username"
                    type="email"
                    placeholder="you@example.com"
                    autocomplete="username"
                    required
                >

                <div class="password-label">
                    <label for="password">Password</label>
                </div>
                <div class="password-field">
                    <input
                        id="password"
                        name="password"
                        type="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >
                    <button type="button" id="togglePassword" class="toggle-password">
                        Show
                    </button>
                </div>

                <button type="submit" class="submit-button">Sign in</button>
            </form>

            <p class="signup-prompt">
                New to OneCart?
                <a th:href="@{/signup}">Create an account</a>
            </p>
        </section>

        <p class="page-note">A better way to shop from stores you love.</p>
    </main>

    <script th:src="@{/js/login.js}"></script>
</body>
</html>