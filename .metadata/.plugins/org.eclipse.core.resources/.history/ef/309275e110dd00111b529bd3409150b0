
:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --page-bg: #f4f8f7;
    --white: #ffffff;
    --border: #e0ebe8;
    --muted: #78908c;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--deep-green);
    background: var(--page-bg);
}

a {
    text-decoration: none;
    color: inherit;
}

.dashboard-layout {
    display: flex;
    min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
    width: 235px;
    flex-shrink: 0;
    background: var(--deep-green);
    color: white;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 10px 28px;
    border-bottom: 1px solid rgba(255,255,255,.12);
}

.brand-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    background: var(--emerald);
    border-radius: 12px;
    font-size: 23px;
    font-weight: bold;
}

.brand h2 {
    margin: 0;
    font-size: 20px;
}

.brand span {
    font-size: 9px;
    letter-spacing: 2px;
    color: #9ccbc2;
}

.store-info {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 8px;
    border-bottom: 1px solid rgba(255,255,255,.12);
}

.store-avatar {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.12);
    border-radius: 10px;
}

.store-text strong,
.store-text small {
    display: block;
}

.store-text strong {
    font-size: 14px;
}

.store-text small {
    margin-top: 4px;
    color: #9ccbc2;
    font-size: 11px;
}

.sidebar-nav {
    flex: 1;
    padding-top: 20px;
}

.nav-heading {
    margin: 16px 10px 10px;
    color: #8bb8b0;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 1.5px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 12px;
    margin-bottom: 5px;
    border-radius: 9px;
    color: #b5cbc6;
    font-size: 13px;
    font-weight: 600;
}

.nav-link.active,
.nav-link:hover:not(.disabled-link) {
    color: white;
    background: var(--emerald);
}

.nav-icon {
    width: 20px;
    text-align: center;
}

.disabled-link {
    opacity: .55;
    cursor: default;
}

.coming-soon {
    margin-left: auto;
    font-size: 9px;
    background: rgba(255,255,255,.13);
    padding: 4px 6px;
    border-radius: 5px;
}

.sidebar-bottom {
    margin-top: 20px;
}

.help-card {
    padding: 15px;
    background: rgba(255,255,255,.09);
    border-radius: 12px;
}

.help-icon {
    margin-bottom: 8px;
    font-size: 22px;
}

.help-card strong {
    font-size: 13px;
}

.help-card p {
    color: #b5cbc6;
    font-size: 11px;
    line-height: 1.5;
}

.logout-button {
    width: 100%;
    margin-top: 15px;
    padding: 12px;
    color: white;
    background: transparent;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
}

/* MAIN CONTENT */

.main-content {
    flex: 1;
    min-width: 0;
}

.topbar {
    min-height: 78px;
    padding: 15px 32px;
    background: white;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.topbar h2 {
    margin: 0;
    font-size: 18px;
}

.topbar p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 12px;
}

.profile-area {
    display: flex;
    align-items: center;
    gap: 12px;
}

.profile-avatar {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--mint);
    color: var(--emerald);
    font-weight: bold;
}

.profile-details strong,
.profile-details small {
    display: block;
}

.profile-details strong {
    font-size: 12px;
}

.profile-details small {
    margin-top: 4px;
    color: var(--muted);
    font-size: 10px;
}

.page-content {
    padding: 32px;
    max-width: 1250px;
    margin: auto;
}

.welcome-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
}

.eyebrow {
    color: var(--emerald);
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
}

.welcome-section h1 {
    margin: 8px 0;
    font-size: 30px;
}

.welcome-section p {
    color: var(--muted);
    font-size: 13px;
}

.store-status {
    padding: 10px 16px;
    border-radius: 25px;
    background: var(--mint);
    color: var(--deep-green);
    font-size: 11px;
    white-space: nowrap;
}

.status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--emerald);
}

/* PROFILE CARDS */

.profile-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.profile-card {
    padding: 25px;
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 5px 20px rgba(18,62,58,.04);
}

.card-heading {
    padding-bottom: 18px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--border);
}

.card-heading > div {
    display: flex;
    align-items: center;
    gap: 12px;
}

.card-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    color: var(--emerald);
    background: var(--mint);
    border-radius: 10px;
    font-size: 19px;
}

.card-heading h2 {
    margin: 0;
    font-size: 17px;
}

.card-heading p {
    margin: 8px 0 0 50px;
    color: var(--muted);
    font-size: 12px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-group.full-width {
    grid-column: 1 / -1;
}

.form-group label {
    font-size: 12px;
    font-weight: 700;
}

.form-group input {
    width: 100%;
    height: 44px;
    padding: 0 13px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fff;
    color: var(--deep-green);
    font-size: 13px;
    outline: none;
}

.form-group input:focus {
    border-color: var(--emerald);
    box-shadow: 0 0 0 3px rgba(8,126,120,.1);
}

.form-group input[readonly] {
    background: #f2f6f5;
    color: #718681;
    cursor: not-allowed;
}

.form-group small {
    color: var(--muted);
    font-size: 10px;
}

/* BUTTONS AND ALERTS */

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
}

.save-button,
.cancel-button {
    padding: 12px 22px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
}

.save-button {
    border: 0;
    color: white;
    background: var(--emerald);
}

.save-button:hover {
    background: var(--deep-green);
}

.cancel-button {
    border: 1px solid var(--border);
    background: white;
}

.alert {
    padding: 13px 16px;
    margin-bottom: 18px;
    border-radius: 8px;
    font-size: 13px;
}

.success-alert {
    color: #176b48;
    background: #e6f6ed;
}

.error-alert {
    color: #a52d2d;
    background: #fff0f0;
}

.footer {
    margin-top: 35px;
    padding: 20px 0;
    color: var(--muted);
    font-size: 11px;
    text-align: center;
}

/* RESPONSIVE */

@media (max-width: 850px) {
    .sidebar {
        width: 200px;
    }

    .page-content {
        padding: 22px;
    }

    .topbar {
        padding: 15px 22px;
    }
}

@media (max-width: 650px) {
    .sidebar {
        display: none;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full-width {
        grid-column: auto;
    }

    .welcome-section {
        align-items: flex-start;
        flex-direction: column;
    }

    .page-content {
        padding: 18px;
    }

    .profile-card {
        padding: 18px;
    }

    .topbar {
        padding: 14px 18px;
    }
}
