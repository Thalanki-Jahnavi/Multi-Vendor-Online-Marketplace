:root {
  --teal: #064b4b;
  --teal-dark: #033d3d;
  --teal-light: #0b8580;
  --gold: #ffc900;
  --text: #102f32;
  --muted: #63777a;
  --line: #e5eceb;
  --page: #f7faf9;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--text);
  background: var(--page);
  font-family: Arial, Helvetica, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

.topbar {
  min-height: 72px;
  display: flex;
  align-items: center;
  gap: 28px;
  padding: 12px 6%;
  color: white;
  background: var(--teal-dark);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  color: white;
}

.brand-bag {
  display: grid;
  place-items: center;
  width: 39px;
  height: 39px;
  border-radius: 11px;
  color: var(--teal-dark);
  background: var(--gold);
  font-size: 24px;
}

.brand strong {
  display: block;
  font-size: 25px;
  letter-spacing: -1px;
}

.brand strong span {
  color: var(--gold);
}

.brand small {
  display: block;
  margin-top: 2px;
  font-size: 10px;
}

.search-bar {
  display: flex;
  align-items: center;
  flex: 1;
  max-width: 620px;
  height: 44px;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 8px;
  background: white;
  color: var(--text);
}

.search-bar > span {
  padding-left: 15px;
  font-size: 25px;
}

.search-bar input {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0 12px;
  border: 0;
  outline: 0;
  font: inherit;
}

.search-bar button {
  width: 52px;
  height: 100%;
  border: 0;
  color: var(--teal-dark);
  background: var(--gold);
  font-size: 25px;
  cursor: pointer;
}

.account-actions {
  display: flex;
  align-items: center;
  gap: 18px;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 700;
}

.join-button {
  padding: 11px 15px;
  border: 1px solid var(--gold);
  border-radius: 7px;
  color: var(--gold);
}

.cart-button {
  position: relative;
  font-size: 21px;
}

.cart-button b {
  position: absolute;
  top: -8px;
  right: -10px;
  display: grid;
  place-items: center;
  width: 19px;
  height: 19px;
  border-radius: 50%;
  color: white;
  background: #f04438;
  font-size: 10px;
}

.category-nav {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 10px 6%;
  border-bottom: 1px solid var(--line);
  background: white;
  font-size: 12px;
  font-weight: 700;
}

.category-nav a {
  white-space: nowrap;
}

.category-nav a:first-child {
  color: var(--teal-light);
}

.page-content {
  width: min(1380px, 92%);
  margin: 0 auto;
}

.hero {
  min-height: 250px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  overflow: hidden;
  margin: 10px 0 14px;
  border-radius: 13px;
  color: white;
  background: linear-gradient(110deg, #034747, #087d75 62%, #f5d99e 62%);
}

.hero-copy {
  z-index: 1;
  align-self: center;
  padding: 25px 8%;
}

.hero-kicker {
  margin: 0 0 12px;
  color: #b9e5dc;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.8px;
}

.hero h1 {
  max-width: 590px;
  margin: 0;
  font-size: clamp(30px, 3.5vw, 48px);
  line-height: 1.08;
  letter-spacing: -1.7px;
}

.hero h1 span {
  color: var(--gold);
}

.hero-description {
  max-width: 460px;
  margin: 12px 0 16px;
  color: #e0f1ed;
  font-size: 15px;
  line-height: 1.5;
}

.shop-button {
  display: inline-flex;
  align-items: center;
  gap: 20px;
  padding: 12px 20px;
  border-radius: 7px;
  color: var(--teal-dark);
  background: var(--gold);
  font-size: 13px;
  font-weight: 800;
}

.hero-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 17px;
  font-size: 10px;
  font-weight: 700;
}

.hero-art {
  position: relative;
  min-height: 250px;
  overflow: hidden;
  background: linear-gradient(130deg, #f3d7a3, #fff0d2);
}

.art-circle {
  position: absolute;
  top: -75px;
  left: 10%;
  width: 330px;
  height: 400px;
  border: 12px solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
}

.headphones {
  position: absolute;
  top: 45px;
  left: 18%;
  display: grid;
  place-items: center;
  width: 145px;
  height: 125px;
  border-radius: 50%;
  color: #e7bfa9;
  background: #fff;
  box-shadow: 0 15px 25px #987b5333;
  font-size: 70px;
}

.shopping-bag {
  position: absolute;
  top: 40px;
  right: 18%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 105px;
  height: 135px;
  border-radius: 8px 8px 18px 18px;
  color: var(--teal-dark);
  background: var(--gold);
  box-shadow: 0 15px 25px #987b5333;
  transform: rotate(5deg);
}

.shopping-bag span {
  font-size: 48px;
}

.shopping-bag strong {
  font-size: 12px;
}

.gift-box {
  position: absolute;
  right: 5%;
  bottom: 18px;
  font-size: 70px;
}

.plant {
  position: absolute;
  right: 0;
  top: 20px;
  font-size: 70px;
}

.section {
  margin: 18px 0 23px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin: 0 4px 12px;
}

.section-heading h2 {
  margin: 0;
  font-size: 23px;
  letter-spacing: -0.7px;
}

.section-heading a {
  color: var(--teal);
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 11px;
}

.category-card {
  min-height: 112px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  border: 1px solid #edf1f0;
  border-radius: 12px;
  transition: transform 0.2s, box-shadow 0.2s;
}

.category-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 9px 20px #123b3b12;
}

.category-emoji {
  font-size: 35px;
}

.category-card strong {
  font-size: 12px;
}

.electronics { background: #e1f3fa; }
.fashion { background: #ffeaed; }
.home { background: #fff4d9; }
.beauty { background: #f1e7ff; }
.books { background: #e2f5fa; }
.sports { background: #eaf6df; }
.auto { background: #ffebea; }

.flame {
  color: #f08b24;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
}

.product-card {
  position: relative;
  min-width: 0;
  padding: 12px;
  border: 1px solid #e6eceb;
  border-radius: 12px;
  background: white;
  box-shadow: 0 3px 10px #123b3b06;
}

.discount {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 5px 8px;
  border-radius: 20px;
  color: white;
  background: #ed4b3e;
  font-size: 9px;
  font-weight: 800;
}

.product-image {
  height: 100px;
  display: grid;
  place-items: center;
  margin-bottom: 8px;
  border-radius: 8px;
  background: #f7f9f8;
  font-size: 62px;
}

.product-name {
  margin: 0 0 6px;
  overflow: hidden;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  margin: 0 0 6px;
  font-size: 14px;
  font-weight: 800;
}

.price del {
  margin-left: 5px;
  color: #9aa5a4;
  font-size: 10px;
  font-weight: 400;
}

.rating {
  margin: 0 0 10px;
  color: #f4b400;
  font-size: 12px;
}

.rating span {
  color: #687575;
}

.add-button {
  display: block;
  padding: 9px 6px;
  border-radius: 6px;
  color: white;
  background: var(--teal-light);
  font-size: 11px;
  font-weight: 700;
  text-align: center;
}

.add-button:hover,
.vendor-button:hover {
  background: var(--teal-dark);
}

.vendor-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin: 18px 0;
  padding: 20px 25px;
  border: 1px solid #dcefe7;
  border-radius: 13px;
  background: linear-gradient(100deg, #eaf7e9, #e1f4ef);
}

.vendor-icon {
  display: grid;
  place-items: center;
  width: 65px;
  height: 65px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #fff4c9;
  font-size: 35px;
}

.vendor-copy {
  flex: 1;
}

.vendor-copy h2 {
  margin: 0 0 6px;
  font-size: 21px;
}

.vendor-copy h2 span {
  color: var(--teal-light);
}

.vendor-copy p {
  margin: 0;
  font-size: 12px;
}

.vendor-benefits {
  display: flex;
  align-items: center;
  gap: 22px;
  padding: 0 20px;
  border-left: 1px solid #b6d6cd;
}

.vendor-benefits span {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 6px;
  color: var(--teal-light);
  font-size: 23px;
}

.vendor-benefits small {
  color: var(--text);
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
}

.vendor-button {
  flex-shrink: 0;
  padding: 13px 16px;
  border-radius: 7px;
  color: white;
  background: var(--teal);
  font-size: 12px;
  font-weight: 800;
}

.vendor-button span {
  margin-left: 8px;
}

.footer {
  display: grid;
  grid-template-columns: 1.5fr repeat(3, 1fr) 1fr;
  gap: 30px;
  padding: 28px 6%;
  color: white;
  background: var(--teal-dark);
}

.footer-brand {
  align-self: start;
}

.footer-column {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 11px;
}

.footer-column strong {
  margin-bottom: 4px;
  font-size: 13px;
}

.footer-column a {
  color: #d0e1df;
}

.social-column span {
  font-size: 20px;
}

@media (max-width: 1050px) {
  .topbar {
    flex-wrap: wrap;
  }

  .search-bar {
    order: 3;
    flex-basis: 100%;
    max-width: none;
  }

  .category-nav {
    justify-content: flex-start;
    overflow-x: auto;
  }

  .category-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .product-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .vendor-benefits {
    display: none;
  }
}

@media (max-width: 650px) {
  .topbar {
    padding: 12px 4%;
  }

  .account-actions {
    gap: 10px;
    margin-left: auto;
    font-size: 11px;
  }

  .account-actions > a:first-child span {
    display: none;
  }

  .join-button {
    padding: 9px;
  }

  .page-content {
    width: 94%;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .hero-copy {
    padding: 25px;
  }

  .hero-art {
    min-height: 180px;
  }

  .category-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .product-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .vendor-banner {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .vendor-copy {
    min-width: 70%;
  }

  .vendor-button {
    margin-left: 85px;
  }

  .footer {
    grid-template-columns: repeat(2, 1fr);
  }
}