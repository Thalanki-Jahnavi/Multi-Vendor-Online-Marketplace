<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Shop from many stores</title>

    <link rel="stylesheet" th:href="@{/css/home.css}">
    <script th:src="@{/js/home.js}" defer></script>
</head>

<body>

<!-- Top announcement -->
<div class="announcement">
    <span>Discover independent stores, all in one place.</span>
    <div>
        <a th:href="@{/about}">About OneCart</a>
        <a th:href="@{/contact}">Help & Contact</a>
    </div>
</div>

<!-- Main header -->
<header class="main-header">
    <a class="brand" th:href="@{/}" aria-label="OneCart home">
        <span class="brand-mark">O</span>
        <span>One<span>Cart</span><small>ONE MARKETPLACE. MANY STORES.</small></span>
    </a>

    <form class="search-form" th:action="@{/search}" method="get" role="search">
        <input
            type="search"
            name="q"
            placeholder="Search products, brands, and stores"
            aria-label="Search products, brands, and stores">
        <button type="submit" aria-label="Search">⌕</button>
    </form>

    <div class="header-actions">
        <a class="header-action" th:href="@{/login}" aria-label="Sign in">
            ♙
            <span>Sign in</span>
        </a>
        <a class="header-action" th:href="@{/cart}" aria-label="Shopping cart">
            🛒
            <span>Cart</span>
            <b>0</b>
        </a>
    </div>

    <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false">
        ☰
    </button>
</header>

<!-- Navigation -->
<nav class="navigation" aria-label="Main navigation">
    <a class="active" th:href="@{/}">Home</a>
    <a th:href="@{/products}">All products</a>
    <a th:href="@{/products(category='Fashion')}">Fashion</a>
    <a th:href="@{/products(category='Electronics')}">Electronics</a>
    <a th:href="@{/products(category='Home')}">Home &amp; living</a>
    <a th:href="@{/products(category='Beauty')}">Beauty</a>
    <a th:href="@{/stores}">Explore stores</a>
</nav>

<main>
    <!-- Hero -->
    <section class="hero">
        <div class="hero-content">
            <p class="eyebrow">ONE MARKETPLACE. MANY STORES.</p>
            <h1>Good finds.<br>Great little <em>discoveries.</em></h1>
            <p class="hero-description">
                Shop products from independent stores, all in one place.
                Find something useful, thoughtful, or simply you.
            </p>

            <div class="hero-buttons">
                <a class="button button-primary" th:href="@{/products}">Explore products</a>
                <a class="button button-secondary" th:href="@{/stores}">Meet the stores</a>
            </div>

            <p class="hero-note">
                <span>✓</span> New finds from independent stores
            </p>
        </div>

        <div class="hero-art" aria-hidden="true">
            <div class="art-circle"></div>

            <div class="art-card art-card-one">
                <span>✦</span>
                <small>Made to discover</small>
            </div>

            <div class="shopping-bag">
                <div class="bag-handle"></div>
                <strong>One<br>Cart</strong>
            </div>

            <div class="art-card art-card-two">
                <span>♡</span>
                <small>Your next favourite</small>
            </div>

            <span class="art-spark spark-one">✦</span>
            <span class="art-spark spark-two">✧</span>
        </div>
    </section>

    <!-- Benefits -->
    <section class="benefits" aria-label="OneCart benefits">
        <article>
            <span class="benefit-icon">✦</span>
            <div>
                <strong>Unique finds</strong>
                <small>Products from many stores</small>
            </div>
        </article>
        <article>
            <span class="benefit-icon">♡</span>
            <div>
                <strong>Independent stores</strong>
                <small>Discover new businesses</small>
            </div>
        </article>
        <article>
            <span class="benefit-icon">✓</span>
            <div>
                <strong>Easy browsing</strong>
                <small>Find what you need</small>
            </div>
        </article>
        <article>
            <span class="benefit-icon">↗</span>
            <div>
                <strong>More to explore</strong>
                <small>New products and stores</small>
            </div>
        </article>
    </section>

    <!-- Categories -->
    <section class="section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">A LITTLE BIT OF EVERYTHING</p>
                <h2>Explore by category</h2>
            </div>
            <a class="text-link" th:href="@{/products}">Browse all products →</a>
        </div>

        <div class="category-grid">
            <a class="category-card category-fashion" th:href="@{/products(category='Fashion')}">
                <span>♧</span>
                <strong>Fashion</strong>
                <small>Everyday style</small>
            </a>
            <a class="category-card category-tech" th:href="@{/products(category='Electronics')}">
                <span>⌁</span>
                <strong>Electronics</strong>
                <small>Smart essentials</small>
            </a>
            <a class="category-card category-home" th:href="@{/products(category='Home')}">
                <span>⌂</span>
                <strong>Home &amp; living</strong>
                <small>Make it yours</small>
            </a>
            <a class="category-card category-beauty" th:href="@{/products(category='Beauty')}">
                <span>✿</span>
                <strong>Beauty</strong>
                <small>Little self-care finds</small>
            </a>
            <a class="category-card category-sport" th:href="@{/products(category='Sports')}">
                <span>⚡</span>
                <strong>Sports</strong>
                <small>Move your way</small>
            </a>
            <a class="category-card category-gifts" th:href="@{/products(category='Gifts')}">
                <span>♡</span>
                <strong>Gifts</strong>
                <small>Something thoughtful</small>
            </a>
        </div>
    </section>

    <!-- Products -->
    <section class="section product-section" id="featured-products">
        <div class="section-heading">
            <div>
                <p class="eyebrow">HANDPICKED FOR YOU</p>
                <h2>Featured finds</h2>
            </div>
            <a class="text-link" th:href="@{/products}">View all products →</a>
        </div>

        <div class="product-grid" th:if="${products != null and !#lists.isEmpty(products)}">
            <article class="product-card" th:each="product : ${products}">
                <a class="product-image"
                   th:href="@{/products/{id}(id=${product.productId})}"
                   th:aria-label="${'View ' + product.productName}">
                    <span class="image-placeholder">✦</span>
                </a>

                <div class="product-info">
                    <p class="product-vendor"
                       th:text="${product.brand != null ? product.brand : 'OneCart find'}">
                        OneCart find
                    </p>

                    <h3>
                        <a th:href="@{/products/{id}(id=${product.productId})}"
                           th:text="${product.productName}">
                            Product name
                        </a>
                    </h3>

                    <div class="product-meta">
                        <strong>
                            ₹<span th:text="${#numbers.formatDecimal(product.price, 1, 2)}">0.00</span>
                        </strong>
                        <span class="rating">★ Featured</span>
                    </div>

                    <a class="add-cart-button"
                       th:href="@{/products/{id}(id=${product.productId})}">
                        View product
                    </a>
                </div>
            </article>
        </div>

        <div class="empty-state" th:if="${products == null or #lists.isEmpty(products)}">
            <span>✦</span>
            <h3>Fresh finds are on the way</h3>
            <p>Approved products will appear here when they’re available.</p>
        </div>
    </section>

    <!-- Vendor invitation -->
    <section class="promo-banner">
        <div>
            <p class="eyebrow">HAVE SOMETHING TO SHARE?</p>
            <h2>Bring your store to <em>OneCart.</em></h2>
            <p>Showcase your products and help shoppers discover your store.</p>
            <a class="button button-light" th:href="@{/signup}">Become a vendor →</a>
        </div>

        <div class="promo-decoration" aria-hidden="true">
            ♡
            <small>SELL WITH US</small>
        </div>
    </section>

    <!-- Vendors -->
    <section class="section" id="stores">
        <div class="section-heading">
            <div>
                <p class="eyebrow">SMALL STORES. BIG IDEAS.</p>
                <h2>Stores to discover</h2>
            </div>
            <a class="text-link" th:href="@{/stores}">Explore all stores →</a>
        </div>

        <div class="vendor-grid" th:if="${vendors != null and !#lists.isEmpty(vendors)}">
            <article class="vendor-card" th:each="vendor : ${vendors}">
                <div class="vendor-avatar" aria-hidden="true">
                    <span th:text="${#strings.substring(vendor.storeName, 0, 1)}">S</span>
                </div>
                <div>
                    <h3 th:text="${vendor.storeName}">Store name</h3>
                    <p>Discover products from this store.</p>
                    <a class="text-link" th:href="@{/stores/{id}(id=${vendor.userId})}">
                        Visit store →
                    </a>
                </div>
            </article>
        </div>

        <div class="empty-state compact" th:if="${vendors == null or #lists.isEmpty(vendors)}">
            <span>♡</span>
            <h3>Stores to discover soon</h3>
            <p>Vendor stores will appear here when they’re available.</p>
        </div>
    </section>

    <!-- Marketplace stats -->
    <section class="stats-strip" aria-label="OneCart marketplace">
        <div>
            <strong>Many</strong>
            <span>Stores to discover</span>
        </div>
        <div>
            <strong>One</strong>
            <span>Marketplace to explore</span>
        </div>
        <div>
            <strong>More</strong>
            <span>Finds waiting for you</span>
        </div>
    </section>
</main>

<!-- Footer -->
<footer class="footer">
    <div class="footer-main">
        <div class="footer-brand">
            <a class="brand brand-footer" th:href="@{/}">
                <span class="brand-mark">O</span>
                <span>One<span>Cart</span><small>ONE MARKETPLACE. MANY STORES.</small></span>
            </a>
            <p>Discover products and independent stores in one place.</p>
        </div>

        <div>
            <h3>Explore</h3>
            <a th:href="@{/products}">All products</a>
            <a th:href="@{/stores}">Stores</a>
            <a th:href="@{/products(category='Fashion')}">Fashion</a>
        </div>

        <div>
            <h3>Help</h3>
            <a th:href="@{/about}">About OneCart</a>
            <a th:href="@{/contact}">Contact us</a>
            <a th:href="@{/privacy}">Privacy policy</a>
        </div>

        <div>
            <h3>Stay in the loop</h3>
            <p>Keep an eye out for new stores and featured finds.</p>
            <form class="newsletter-form" th:action="@{/newsletter}" method="post">
                <input type="email" name="email" placeholder="Your email address" aria-label="Your email address" required>
                <button type="submit" aria-label="Subscribe">→</button>
            </form>
            <span id="newsletterMessage"></span>
        </div>
    </div>

    <div class="footer-bottom">
        <span>© <span th:text="${#dates.year(#dates.createNow())}">2026</span> OneCart</span>
        <span>Made for discovering something new.</span>
    </div>
</footer>

</body>
</html>