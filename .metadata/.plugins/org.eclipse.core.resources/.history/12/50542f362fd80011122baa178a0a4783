<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Shop Everything</title>
    <link rel="stylesheet" th:href="@{/css/home.css}">
</head>
<body>

<header class="site-header">
    <a class="brand" th:href="@{/}">
        <span class="brand-mark">O</span>
        <span>One<span class="brand-accent">Cart</span></span>
    </a>

    <nav class="main-nav">
        <a class="active" th:href="@{/}">Home</a>
        <a th:href="@{/products}">Shop</a>
        <a th:href="@{/about}">About</a>
        <a th:href="@{/contact}">Contact</a>
    </nav>

    <div class="header-actions">
        <a class="login-link" th:href="@{/login}">
            <svg class="profile-icon" viewBox="0 0 24 24"
                 aria-hidden="true" focusable="false">
                <circle cx="12" cy="8" r="4"></circle>
                <path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2z"></path>
            </svg>
            <span>Login</span>
        </a>

        <a class="cart-link" th:href="@{/cart}">
            <span aria-hidden="true">🛒</span>
            <span>Cart</span>
        </a>
    </div>
</header>

<main>
    <section class="hero">
        <div class="hero-content">
            <p class="eyebrow">ONE MARKETPLACE. ENDLESS FINDS.</p>
            <h1>Everything you need,<br>all in <span>OneCart.</span></h1>
            <p class="hero-description">
                Discover products from vendors and find something you'll love.
            </p>

            <div class="hero-actions">
                <a class="primary-button" th:href="@{/products}">Explore products</a>
                <a class="secondary-button" th:href="@{/vendor/register}">Start selling</a>
            </div>
        </div>

        <div class="hero-art" aria-hidden="true">
            <div class="art-circle"></div>
            <div class="shopping-bag">
                <div class="bag-handle"></div>
                <span>O</span>
                <strong>OneCart</strong>
            </div>
            <div class="art-label">Find your next favorite</div>
        </div>
    </section>

    <section class="benefits">
        <article>
            <span class="benefit-icon">✓</span>
            <div>
                <h3>Trusted vendors</h3>
                <p>Shop from a growing community of sellers.</p>
            </div>
        </article>
        <article>
            <span class="benefit-icon">⌕</span>
            <div>
                <h3>Easy discovery</h3>
                <p>Explore products from different categories.</p>
            </div>
        </article>
        <article>
            <span class="benefit-icon">♡</span>
            <div>
                <h3>Made for you</h3>
                <p>Find useful things and new favorites.</p>
            </div>
        </article>
    </section>

    <section class="products-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">HANDPICKED FOR YOU</p>
                <h2>Explore popular finds</h2>
                <p>Discover products from OneCart vendors.</p>
            </div>
            <a class="text-link" th:href="@{/products}">View all products →</a>
        </div>

        <div class="product-grid"
             th:if="${products != null and !products.isEmpty()}">
            <article class="product-card" th:each="product : ${products}">
                <div class="product-image">
                    <img th:if="${product.productName == 'Bluetooth Speaker'}"
                         th:src="@{/images/products/Bluetooth Speaker.png}"
                         th:alt="${product.productName}">

                    <img th:if="${product.productName == 'Ceramic Coffee Mug'}"
                         th:src="@{/images/products/Ceramic Coffee Mug.jpg}"
                         th:alt="${product.productName}">

                    <img th:if="${product.productName == 'Cotton T-Shirt'}"
                         th:src="@{/images/products/Cotton T-Shirt.jpg}"
                         th:alt="${product.productName}">

                    <img th:if="${product.productName == 'Running Shoes'}"
                         th:src="@{/images/products/Running Shoes.jpg}"
                         th:alt="${product.productName}">

                    <img th:if="${product.productName == 'Smart Watch'}"
                         th:src="@{/images/products/Smart Watch.webp}"
                         th:alt="${product.productName}">

                    <img th:if="${product.productName == 'Travel back pack'}"
                         th:src="@{/images/products/Travel back pack.jpg}"
                         th:alt="${product.productName}">

                    <img th:if="${product.productName == 'Wireless Headphones'}"
                         th:src="@{/images/products/Wireless Headphones.png}"
                         th:alt="${product.productName}">

                    <img th:if="${product.productName == 'Wireless Mouse'}"
                         th:src="@{/images/products/Wireless Mouse.jpg}"
                         th:alt="${product.productName}">
                </div>

                <div class="product-details">
                    <p class="product-label">OneCart find</p>
                    <h3 th:text="${product.productName}">Product name</h3>
                    <div class="price-row">
                        <strong th:text="${'₹' + product.price}">₹0</strong>
                        <span th:if="${product.discountPercentage != null and product.discountPercentage > 0}"
                              th:text="${product.discountPercentage + '% off'}">
                            Discount
                        </span>
                    </div>
                    <a class="view-button"
                       th:href="@{/products/{id}(id=${product.productId})}">
                        View product
                    </a>
                </div>
            </article>
        </div>

        <div class="empty-state"
             th:if="${products == null or products.isEmpty()}">
            <h3>New finds are on the way</h3>
            <p>Approved products will appear here when vendors list them.</p>
        </div>
    </section>

    <section class="vendor-banner">
        <div>
            <p class="eyebrow">SELL WITH ONECART</p>
            <h2>Have something great to share?</h2>
            <p>Bring your products to OneCart and connect with customers.</p>
            <a class="primary-button" th:href="@{/vendor/register}">Become a vendor</a>
        </div>
        <div class="vendor-art" aria-hidden="true">O</div>
    </section>

    <section class="vendors-section"
             th:if="${vendors != null and !vendors.isEmpty()}">
        <div class="section-heading">
            <div>
                <p class="eyebrow">OUR SELLER COMMUNITY</p>
                <h2>Meet our vendors</h2>
            </div>
        </div>

        <div class="vendor-grid">
            <article class="vendor-card" th:each="vendor : ${vendors}">
                <div class="vendor-avatar">O</div>
                <h3 th:text="${vendor.businessName}">Vendor name</h3>
                <p>Discover this vendor’s products on OneCart.</p>
            </article>
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="footer-content">
        <div>
            <a class="brand footer-brand" th:href="@{/}">
                <span class="brand-mark">O</span>
                <span>One<span class="brand-accent">Cart</span></span>
            </a>
            <p>Everything you need, all in one place.</p>
        </div>

        <div class="footer-links">
            <h3>Explore</h3>
            <a th:href="@{/}">Home</a>
            <a th:href="@{/products}">Shop</a>
            <a th:href="@{/about}">About</a>
        </div>

        <div class="footer-links">
            <h3>Help</h3>
            <a th:href="@{/contact}">Contact us</a>
            <a th:href="@{/login}">Login</a>
            <a th:href="@{/signup}">Sign up</a>
        </div>
    </div>

    <div class="footer-bottom">
        <span>© 2026 OneCart. All rights reserved.</span>
        <span>Made for discovering more.</span>
    </div>
</footer>

</body>
</html>