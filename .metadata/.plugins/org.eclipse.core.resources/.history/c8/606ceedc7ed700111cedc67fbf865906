<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Multi-Vendor Marketplace</title>
    <link rel="stylesheet" th:href="@{/css/home.css}">
</head>
<body>

<!-- Announcement bar -->
<div class="announcement">
    <p>Welcome to OneCart — discover products from independent stores</p>
</div>

<!-- Header -->
<header class="main-header">
    <div class="brand">
        <a th:href="@{/}">OneCart</a>
    </div>

    <nav class="navigation">
        <a th:href="@{/}">Home</a>
        <a th:href="@{/products}">Products</a>
        <a th:href="@{/vendors}">Stores</a>
        <a th:href="@{/about}">About</a>
    </nav>

    <div class="header-actions">
        <a th:href="@{/wishlist}">Wishlist</a>
        <a th:href="@{/cart}">Cart</a>
        <a th:href="@{/login}">Login</a>
    </div>
</header>

<main>
    <!-- Hero section -->
    <section class="hero">
        <div class="hero-content">
            <p class="eyebrow">One marketplace. Many stores.</p>
            <h1>Find something you’ll love.</h1>
            <p>Shop unique finds from trusted independent vendors, all in one place.</p>
            <a class="primary-button" th:href="@{/products}">Explore products</a>
        </div>
    </section>

    <!-- Benefits -->
    <section class="benefits">
        <div class="benefit">
            <h3>Trusted vendors</h3>
            <p>Discover products from independent stores.</p>
        </div>
        <div class="benefit">
            <h3>Secure shopping</h3>
            <p>A simple and convenient shopping experience.</p>
        </div>
        <div class="benefit">
            <h3>One easy checkout</h3>
            <p>Shop across stores from one marketplace.</p>
        </div>
    </section>

    <!-- Categories -->
    <section class="section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Browse by category</p>
                <h2>Explore popular categories</h2>
            </div>
            <a th:href="@{/categories}">View all</a>
        </div>

        <div class="category-grid">
            <a class="category-card" th:href="@{/products(category='electronics')}">
                <span>Electronics</span>
            </a>
            <a class="category-card" th:href="@{/products(category='fashion')}">
                <span>Fashion</span>
            </a>
            <a class="category-card" th:href="@{/products(category='home')}">
                <span>Home &amp; Living</span>
            </a>
            <a class="category-card" th:href="@{/products(category='beauty')}">
                <span>Beauty</span>
            </a>
        </div>
    </section>

    <!-- Products -->
    <section class="product-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Handpicked for you</p>
                <h2>Featured products</h2>
            </div>
            <a th:href="@{/products}">Shop all</a>
        </div>

        <div class="product-grid">
            <article class="product-card" th:each="product : ${products}">
                <a class="product-image"
                   th:href="@{/products/{id}(id=${product.id})}">
                    <img class="product-photo"
                         th:src="@{/images/{image}(image=${product.imageName})}"
                         th:alt="${product.productName}"
                         loading="lazy">
                </a>

                <div class="product-details">
                    <p class="product-vendor"
                       th:text="${product.vendorName != null ? product.vendorName : 'OneCart Store'}">
                        OneCart Store
                    </p>

                    <h3>
                        <a th:href="@{/products/{id}(id=${product.id})}"
                           th:text="${product.productName}">
                            Product name
                        </a>
                    </h3>

                    <p class="product-price">
                        ₹<span th:text="${product.price}">0.00</span>
                    </p>

                    <a class="add-to-cart"
                       th:href="@{/cart/add/{id}(id=${product.id})}">
                        Add to cart
                    </a>
                </div>
            </article>

            <p class="empty-products" th:if="${#lists.isEmpty(products)}">
                No products are available yet. Please check back soon.
            </p>
        </div>
    </section>

    <!-- Vendor stores -->
    <section class="section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Shop from independent sellers</p>
                <h2>Featured stores</h2>
            </div>
            <a th:href="@{/vendors}">View all stores</a>
        </div>

        <div class="vendor-grid">
            <article class="vendor-card" th:each="vendor : ${vendors}">
                <h3 th:text="${vendor.storeName}">Store name</h3>
                <p th:text="${vendor.description}">Discover this store’s collection.</p>
                <a th:href="@{/vendors/{id}(id=${vendor.id})}">Visit store</a>
            </article>

            <p th:if="${#lists.isEmpty(vendors)}">
                Store listings will appear here soon.
            </p>
        </div>
    </section>

    <!-- Marketplace stats -->
    <section class="stats-strip">
        <div>
            <strong th:text="${vendorCount != null ? vendorCount : 'Many'}">Many</strong>
            <span>Independent stores</span>
        </div>
        <div>
            <strong th:text="${productCount != null ? productCount : 'More'}">More</strong>
            <span>Products to discover</span>
        </div>
        <div>
            <strong>One</strong>
            <span>Easy marketplace</span>
        </div>
    </section>
</main>

<!-- Footer: keep this class name aligned with home.css -->
<footer class="footer">
    <div class="footer-main">
        <div class="footer-brand">
            <a class="brand" th:href="@{/}">OneCart</a>
            <p>Your marketplace for discovering products from independent stores.</p>
        </div>

        <div class="footer-column">
            <h3>Shop</h3>
            <a th:href="@{/products}">All products</a>
            <a th:href="@{/categories}">Categories</a>
            <a th:href="@{/vendors}">Stores</a>
        </div>

        <div class="footer-column">
            <h3>Help</h3>
            <a th:href="@{/contact}">Contact us</a>
            <a th:href="@{/shipping}">Shipping information</a>
            <a th:href="@{/returns}">Returns</a>
        </div>

        <div class="footer-column">
            <h3>Account</h3>
            <a th:href="@{/login}">Login</a>
            <a th:href="@{/register}">Create account</a>
            <a th:href="@{/wishlist}">Wishlist</a>
        </div>
    </div>

    <div class="footer-bottom">
        <p>© <span th:text="${#dates.year(#dates.createNow())}">2026</span> OneCart. All rights reserved.</p>
        <div>
            <a th:href="@{/privacy}">Privacy</a>
            <a th:href="@{/terms}">Terms</a>
        </div>
    </div>
</footer>

</body>
</html>