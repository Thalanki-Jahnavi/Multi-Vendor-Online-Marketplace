package com.vendor.controller; 

import com.vendor.entity.Product;
import com.vendor.entity.User;
import com.vendor.repository.UserRepository;
import com.vendor.service.ProductService;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestParam;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Controller
public class CustomerController {

    private final ProductService productService;
    private final UserRepository userRepository;

    public CustomerController(
            ProductService productService,
            UserRepository userRepository
    ) {
        this.productService = productService;
        this.userRepository = userRepository;
    }

    @GetMapping("/customer/products")
    public String products(
            @RequestParam(required = false) String keyword,
            @RequestParam(required = false) String category,
            @RequestParam(required = false) Integer vendorId,
            @RequestParam(required = false, defaultValue = "newest") String sort,
            Model model
    ) {
        List<User> vendors = userRepository.findByRoleIgnoreCase("vendor");

        Map<Integer, String> vendorNames = new HashMap<>();

        for (User vendor : vendors) {
            String vendorName = vendor.getBusinessName();

            if (vendorName == null || vendorName.isBlank()) {
                vendorName = vendor.getFirstName();
            }

            vendorNames.put(vendor.getUserId(), vendorName);
        }

        model.addAttribute(
                "products",
                productService.getApprovedProducts(keyword, category, vendorId, sort)
        );

        model.addAttribute("categories", productService.getApprovedCategories());
        model.addAttribute("vendors", vendors);
        model.addAttribute("vendorNames", vendorNames);

        model.addAttribute("keyword", keyword);
        model.addAttribute("selectedCategory", category);
        model.addAttribute("selectedVendorId", vendorId);
        model.addAttribute("selectedSort", sort);

        return "public/products";
    }
}