  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/guest/index.html">
      <span class="brand-bag">▣</span>
      <span><strong>One<span>Cart</span></strong><small>Multi-Vendor Marketplace</small></span>
    </a>

    <form class="search-bar" id="searchForm">
      <span>⌕</span>
      <input id="searchInput" type="search" placeholder="Search for products, brands and more...">
      <button type="submit" aria-label="Search">⌕</button>
    </form>

    <div class="account-actions">
      <a href="/guest/login.html">♙ <span>Sign in</span></a>
      <a class="join-button" href="/guest/signup.html">Join Now</a>
      <a class="cart-button" href="/guest/login.html" aria-label="Shopping cart">🛒 <b>0</b></a>
    </div>
  </header>

  <nav class="category-nav">
    <a href="#categories">☰ <span>All Categories</span></a>
    <a href="#categories">▣ <span>Electronics</span></a>
    <a href="#categories">♧ <span>Fashion</span></a>
    <a href="#categories">⌂ <span>Home &amp; Living</span></a>
    <a href="#categories">❀ <span>Beauty</span></a>
    <a href="#categories">▤ <span>Books</span></a>
    <a href="#categories">♡ <span>Sports</span></a>
    <a href="#categories">♧ <span>Automotive</span></a>
  </nav>

  <main class="page-content">
    <section class="hero">
      <div class="hero-copy">
        <p class="hero-kicker">YOUR MARKETPLACE, ALL IN ONE PLACE</p>
        <h1>Discover More at <span>OneCart</span></h1>
        <p class="hero-description">
          Shop from multiple trusted vendors across a wide range of categories.
        </p>
        <a class="shop-button" href="#categories">Shop Now <span>→</span></a>

        <div class="hero-benefits">
          <span>✓ Multiple Vendors</span>
          <span>✓ Secure Payments</span>
          <span>✓ Easy Returns</span>
        </div>
      </div>

      <div class="hero-art" aria-label="Shopping illustration">
        <div class="art-circle"></div>
        <div class="headphones">♫</div>
        <div class="shopping-bag">
          <span>🛍</span>
          <strong>OneCart</strong>
        </div>
        <div class="gift-box">🎁</div>
        <div class="plant">🌿</div>
      </div>
    </section>

    <section class="section" id="categories">
      <div class="section-heading">
        <h2>Shop by Category</h2>
        <a href="#categories">View All Categories <span>→</span></a>
      </div>

      <div class="category-grid">
        <a class="category-card electronics" href="#products">
          <span class="category-emoji">💻</span><strong>Electronics</strong>
        </a>
        <a class="category-card fashion" href="#products">
          <span class="category-emoji">👕</span><strong>Fashion</strong>
        </a>
        <a class="category-card home" href="#products">
          <span class="category-emoji">🛋️</span><strong>Home &amp; Living</strong>
        </a>
        <a class="category-card beauty" href="#products">
          <span class="category-emoji">🧴</span><strong>Beauty</strong>
        </a>
        <a class="category-card books" href="#products">
          <span class="category-emoji">📚</span><strong>Books</strong>
        </a>
        <a class="category-card sports" href="#products">
          <span class="category-emoji">🎾</span><strong>Sports</strong>
        </a>
        <a class="category-card auto" href="#products">
          <span class="category-emoji">🚗</span><strong>Automotive</strong>
        </a>
      </div>
    </section>

    <section class="section" id="products">
      <div class="section-heading">
        <h2><span class="flame">♨</span> Trending Products</h2>
        <a href="/guest/login.html">View More <span>→</span></a>
      </div>

      <div class="product-grid">
        <article class="product-card">
          <span class="discount">15% OFF</span>
          <div class="product-image laptop">💻</div>
          <p class="product-name">Laptop (i5, 16GB)</p>
          <p class="price">₹54,990 <del>₹64,990</del></p>
          <p class="rating">★ <span>4.5 (1.2K)</span></p>
          <a class="add-button" href="/guest/login.html">🛒 Add to Cart</a>
        </article>

        <article class="product-card">
          <span class="discount">20% OFF</span>
          <div class="product-image watch">⌚</div>
          <p class="product-name">Smart Watch Series 9</p>
          <p class="price">₹3,999 <del>₹4,999</del></p>
          <p class="rating">★ <span>4.4 (2.1K)</span></p>
          <a class="add-button" href="/guest/login.html">🛒 Add to Cart</a>
        </article>

        <article class="product-card">
          <span class="discount">30% OFF</span>
          <div class="product-image shoes">👟</div>
          <p class="product-name">Men's Casual Sneakers</p>
          <p class="price">₹1,399 <del>₹1,999</del></p>
          <p class="rating">★ <span>4.3 (3.7K)</span></p>
          <a class="add-button" href="/guest/login.html">🛒 Add to Cart</a>
        </article>

        <article class="product-card">
          <span class="discount">25% OFF</span>
          <div class="product-image handbag">👜</div>
          <p class="product-name">Women's Handbag</p>
          <p class="price">₹1,199 <del>₹1,599</del></p>
          <p class="rating">★ <span>4.6 (980)</span></p>
          <a class="add-button" href="/guest/login.html">🛒 Add to Cart</a>
        </article>

        <article class="product-card">
          <span class="discount">18% OFF</span>
          <div class="product-image earbuds">🎧</div>
          <p class="product-name">Wireless Earbuds</p>
          <p class="price">₹2,459 <del>₹2,999</del></p>
          <p class="rating">★ <span>4.4 (2.5K)</span></p>
          <a class="add-button" href="/guest/login.html">🛒 Add to Cart</a>
        </article>
      </div>
    </section>

    <section class="vendor-banner">
      <div class="vendor-icon">🏪</div>
      <div class="vendor-copy">
        <h2>Become a Vendor on <span>OneCart</span></h2>
        <p>Grow your business, reach more customers, and sell with ease.</p>
      </div>
      <div class="vendor-benefits">
        <span>♧<small>More Customers</small></span>
        <span>▥<small>Higher Visibility</small></span>
        <span>♢<small>Secure &amp; Reliable</small></span>
      </div>
      <a class="vendor-button" href="/guest/signup.html">Register as a Vendor <span>→</span></a>
