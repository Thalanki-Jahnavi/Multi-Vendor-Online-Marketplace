<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Home</title>
    <link rel="stylesheet" th:href="@{/css/home.css}">

    <style>
        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-action {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: inherit;
            text-decoration: none;
            font-weight: 600;
        }

        .count-badge {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            min-width: 21px;
            height: 21px;
            padding: 0 5px;
            border-radius: 50px;
            background: #087e78;
            color: white;
            font-size: 12px;
        }

        .product-card {
            position: relative;
        }

        .wishlist-button {
            position: absolute;
            top: 12px;
            right: 12px;
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            border: 0;
            border-radius: 50%;
            background: white;
            color: #123e3a;
            font-size: 23px;
            cursor: pointer;
            box-shadow: 0 2px 10px #00000018;
        }

        .wishlist-button.is-wishlisted {
            color: #d92d5b;
        }

        .product-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 14px;
        }

        .add-to-cart-button {
            flex: 1;
            padding: 11px 14px;
            border: 0;
            border-radius: 8px;
            background: #087e78;
            color: white;
            font-weight: 600;
            cursor: pointer;
        }

        .add-to-cart-button:hover {
            background: #123e3a;
        }

        .product-price {
            font-weight: 700;
        }

        .product-price s {
            margin-left: 7px;
            color: #777;
            font-size: 0.9em;
            font-weight: 400;
        }

        .cart-message {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 1000;
            padding: 12px 18px;
            border-radius: 8px;
            background: #123e3a;
            color: white;
            box-shadow: 0 4px 16px #00000020;
        }

        [hidden] {
            display: none !important;
        }
    </style>
</head>

<body>
    <div class="topbar">
        Discover products from multiple vendors in one place
    </div>

    <header class="header">
        <a class="logo" th:href="@{/}">OneCart</a>

        <form class="search-form" th:action="@{/shop}" method="get">
            <input
                type="search"
                name="q"
                placeholder="Search products..."
                aria-label="Search products">
            <button type="submit">Search</button>
        </form>

        <div class="header-actions">
            <a class="header-action" th:href="@{/wishlist}" aria-label="Wishlist">
                <span aria-hidden="true">♡</span>
                <span>Wishlist</span>
                <span class="count-badge" id="wishlist-count">0</span>
            </a>

            <a class="header-action" th:href="@{/cart}" aria-label="Shopping cart">
                <span aria-hidden="true">🛒</span>
                <span>Cart</span>
                <span class="count-badge" id="cart-count">0</span>
            </a>

            <a th:href="@{/login}">Login</a>
            <a th:href="@{/signup}">Sign up</a>
        </div>
    </header>

    <nav class="navigation">
        <a th:href="@{/}">Home</a>
        <a th:href="@{/shop}">Shop</a>
        <a th:href="@{/about}">About Us</a>
        <a th:href="@{/contact}">Contact</a>
    </nav>

    <main>
        <section class="hero">
            <div class="hero-content">
                <p class="eyebrow">WELCOME TO ONECART</p>
                <h1>Find something you’ll love.</h1>
                <p class="hero-description">
                    Explore products from different vendors, compare your favorites,
                    and shop from one convenient marketplace.
                </p>
                <a class="primary-button" th:href="@{/shop}">Explore Products</a>
            </div>
        </section>

        <section class="featured-section">
            <div class="section-heading">
                <h2>Featured Products</h2>
                <p>Discover items available in the OneCart marketplace.</p>
            </div>

            <div class="product-grid"
                 th:if="${products != null and !products.isEmpty()}">

                <article class="product-card"
                         th:each="product : ${products}"
                         th:attr="data-product-id=${product.id},
                                  data-product-name=${product.name},
                                  data-product-price=${product.price}">

                    <button class="wishlist-button"
                            type="button"
                            aria-label="Add to wishlist"
                            aria-pressed="false"
                            title="Add to wishlist">
                        ♡
                    </button>

                    <div class="product-image-placeholder">
                        <span>OneCart Product</span>
                    </div>

                    <div class="product-details">
                        <h3 th:text="${product.name}">Product name</h3>

                        <p class="product-price">
                            ₹<span th:text="${#numbers.formatDecimal(product.price, 1, 2)}">
                                0.00
                            </span>
                        </p>

                        <div class="product-actions">
                            <button class="add-to-cart-button" type="button">
                                Add to Cart
                            </button>
                        </div>
                    </div>
                </article>
            </div>

            <div class="empty-products"
                 th:if="${products == null or products.isEmpty()}">
                <h3>No featured products yet</h3>
                <p>Products will appear here when vendors add active, approved items.</p>
            </div>
        </section>

        <section class="vendors-section">
            <div class="section-heading">
                <h2>Discover Our Vendors</h2>
                <p>Shop from different sellers, all in one place.</p>
            </div>

            <div class="vendor-grid">
                <article class="vendor-card">
                    <div class="vendor-icon">01</div>
                    <h3>Fashion &amp; Style</h3>
                    <p>Explore clothing, footwear, and everyday accessories.</p>
                    <a th:href="@{/shop}">Explore products</a>
                </article>

                <article class="vendor-card">
                    <div class="vendor-icon">02</div>
                    <h3>Home &amp; Living</h3>
                    <p>Find useful pieces for your home and daily routine.</p>
                    <a th:href="@{/shop}">Explore products</a>
                </article>

                <article class="vendor-card">
                    <div class="vendor-icon">03</div>
                    <h3>Electronics</h3>
                    <p>Browse gadgets and accessories from marketplace sellers.</p>
                    <a th:href="@{/shop}">Explore products</a>
                </article>
            </div>

            <div class="vendor-cta">
                <div>
                    <h3>Have a business to share?</h3>
                    <p>Join OneCart and showcase your products to more customers.</p>
                </div>
                <a class="primary-button" th:href="@{/signup}">Become a Vendor</a>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-brand">
                <a class="footer-logo" th:href="@{/}">OneCart</a>
                <p>Shop smarter, all in one place.</p>
            </div>

            <div class="footer-column">
                <h3>Explore</h3>
                <a th:href="@{/}">Home</a>
                <a th:href="@{/shop}">Shop Products</a>
                <a th:href="@{/signup}">Become a Vendor</a>
            </div>

            <div class="footer-column">
                <h3>About OneCart</h3>
                <a th:href="@{/about}">About Us</a>
                <a th:href="@{/contact}">Contact Us</a>
            </div>

            <div class="footer-column">
                <h3>Help</h3>
                <a th:href="@{/login}">My Account</a>
                <a th:href="@{/contact}">Customer Support</a>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 OneCart. All rights reserved.</p>
            <p>Shop from multiple vendors with confidence.</p>
        </div>
    </footer>

    <div class="cart-message" id="cart-message" role="status" hidden></div>

    <script>
        (() => {
            const WISHLIST_KEY = "onecart-wishlist";
            const CART_KEY = "onecart-cart";

            function readItems(key) {
                try {
                    const saved = JSON.parse(localStorage.getItem(key) || "[]");
                    return Array.isArray(saved) ? saved : [];
                } catch {
                    return [];
                }
            }

            function saveItems(key, items) {
                localStorage.setItem(key, JSON.stringify(items));
            }

            function updateCounts() {
                document.getElementById("wishlist-count").textContent =
                    readItems(WISHLIST_KEY).length;

                const cart = readItems(CART_KEY);
                const total = cart.reduce((sum, item) => sum + item.quantity, 0);
                document.getElementById("cart-count").textContent = total;
            }

            function productFromCard(card) {
                return {
                    id: card.dataset.productId,
                    name: card.dataset.productName,
                    price: Number(card.dataset.productPrice)
                };
            }

            function showCartMessage(message) {
                const box = document.getElementById("cart-message");
                box.textContent = message;
                box.hidden = false;
                window.setTimeout(() => {
                    box.hidden = true;
                }, 2200);
            }

            document.querySelectorAll(".product-card").forEach(card => {
                const product = productFromCard(card);
                const wishlistButton = card.querySelector(".wishlist-button");
                const cartButton = card.querySelector(".add-to-cart-button");

                function syncWishlistButton() {
                    const wishlist = readItems(WISHLIST_KEY);
                    const isSaved = wishlist.some(item => item.id === product.id);

                    wishlistButton.classList.toggle("is-wishlisted", isSaved);
                    wishlistButton.textContent = isSaved ? "♥" : "♡";
                    wishlistButton.setAttribute("aria-pressed", String(isSaved));
                    wishlistButton.setAttribute(
                        "aria-label",
                        isSaved ? "Remove from wishlist" : "Add to wishlist"
                    );
                    wishlistButton.title =
                        isSaved ? "Remove from wishlist" : "Add to wishlist";
                }

                wishlistButton.addEventListener("click", () => {
                    let wishlist = readItems(WISHLIST_KEY);
                    const alreadySaved = wishlist.some(item => item.id === product.id);

                    if (alreadySaved) {
                        wishlist = wishlist.filter(item => item.id !== product.id);
                    } else {
                        wishlist.push(product);
                    }

                    saveItems(WISHLIST_KEY, wishlist);
                    syncWishlistButton();
                    updateCounts();
                });

                cartButton.addEventListener("click", () => {
                    const cart = readItems(CART_KEY);
                    const existingItem = cart.find(item => item.id === product.id);

                    if (existingItem) {
                        existingItem.quantity += 1;
                    } else {
                        cart.push({ ...product, quantity: 1 });
                    }

                    saveItems(CART_KEY, cart);
                    updateCounts();
                    showCartMessage("Added to cart");
                });

                syncWishlistButton();
            });

            updateCounts();
        })();
    </script>
</body>
</html>