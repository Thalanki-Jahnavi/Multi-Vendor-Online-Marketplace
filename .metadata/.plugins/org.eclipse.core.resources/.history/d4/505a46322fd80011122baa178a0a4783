:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --white: #ffffff;
    --text: #20312f;
    --muted: #6d7c79;
    --border: #e5ece9;
    --page-bg: #fbfdfc;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    color: var(--text);
    background: var(--page-bg);
    font-family: Arial, Helvetica, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

.site-header {
    min-height: 78px;
    padding: 0 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--deep-green);
    font-size: 24px;
    font-weight: 800;
    white-space: nowrap;
}

.brand-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    color: var(--white);
    background: var(--emerald);
    border-radius: 12px;
    font-size: 21px;
}

.brand-accent {
    color: var(--emerald);
}

.main-nav,
.header-actions {
    display: flex;
    align-items: center;
    gap: 26px;
}

.main-nav a {
    color: #52615e;
    font-size: 14px;
    font-weight: 600;
    transition: color 0.2s ease;
}

.main-nav a:hover,
.main-nav a.active {
    color: var(--emerald);
}

.header-actions {
    gap: 20px;
}

.login-link,
.cart-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--deep-green);
    font-size: 14px;
    font-weight: 600;
}

.login-link:hover,
.cart-link:hover {
    color: var(--emerald);
}

.profile-icon {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--emerald);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.hero {
    min-height: 490px;
    padding: 70px 8%;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 40px;
    overflow: hidden;
    background: linear-gradient(115deg, #f4fbf8 0%, #e5f4f0 100%);
}

.eyebrow {
    margin: 0 0 14px;
    color: var(--emerald);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.7px;
}

.hero h1 {
    margin: 0;
    color: var(--deep-green);
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.12;
    letter-spacing: -1.8px;
}

.hero h1 span {
    color: var(--emerald);
}

.hero-description {
    max-width: 500px;
    margin: 22px 0 28px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.8;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.primary-button,
.secondary-button {
    min-height: 46px;
    padding: 0 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 700;
    transition: transform 0.2s ease, background 0.2s ease;
}

.primary-button {
    color: var(--white);
    background: var(--emerald);
}

.primary-button:hover {
    background: #066b66;
    transform: translateY(-2px);
}

.secondary-button {
    color: var(--deep-green);
    background: var(--white);
    border: 1px solid #cbded8;
}

.secondary-button:hover {
    transform: translateY(-2px);
}

.hero-art {
    min-height: 330px;
    position: relative;
    display: grid;
    place-items: center;
}

.art-circle {
    width: 300px;
    height: 300px;
    position: absolute;
    border-radius: 50%;
    background: #c6e8de;
}

.shopping-bag {
    width: 190px;
    height: 205px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--white);
    background: var(--emerald);
    border-radius: 24px 24px 35px 35px;
    box-shadow: 0 24px 45px #123e3a25;
    transform: rotate(-5deg);
}

.bag-handle {
    width: 85px;
    height: 55px;
    position: absolute;
    top: -43px;
    border: 11px solid var(--deep-green);
    border-bottom: 0;
    border-radius: 50px 50px 0 0;
}

.shopping-bag span {
    font-size: 55px;
    font-weight: 800;
}

.shopping-bag strong {
    margin-top: 3px;
    font-size: 18px;
}

.art-label {
    position: absolute;
    right: 0;
    bottom: 25px;
    padding: 13px 18px;
    color: var(--deep-green);
    background: var(--white);
    border-radius: 10px;
    box-shadow: 0 8px 24px #123e3a12;
    font-size: 13px;
    font-weight: 700;
}

.benefits {
    padding: 28px 8%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.benefits article {
    display: flex;
    align-items: center;
    gap: 14px;
}

.benefit-icon {
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    display: grid;
    place-items: center;
    color: var(--emerald);
    background: var(--mint);
    border-radius: 12px;
    font-size: 23px;
    font-weight: 700;
}

.benefits h3 {
    margin: 0 0 6px;
    color: var(--deep-green);
    font-size: 15px;
}

.benefits p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
}

.products-section,
.vendors-section {
    padding: 76px 8%;
}

.section-heading {
    margin-bottom: 30px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
}

.section-heading h2,
.vendor-banner h2 {
    margin: 0 0 10px;
    color: var(--deep-green);
    font-size: clamp(27px, 3vw, 36px);
    letter-spacing: -0.8px;
}

.section-heading p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
}

.text-link {
    color: var(--emerald);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.product-card {
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 15px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px #123e3a12;
}

.product-image {
    height: 205px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #f2f7f5;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14px;
}

.product-details {
    padding: 18px;
}

.product-label {
    margin: 0 0 8px;
    color: var(--emerald);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.product-details h3 {
    min-height: 40px;
    margin: 0 0 12px;
    color: var(--deep-green);
    font-size: 16px;
}

.price-row {
    min-height: 28px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.price-row strong {
    color: var(--deep-green);
    font-size: 18px;
}

.price-row span {
    padding: 5px 8px;
    color: var(--emerald);
    background: var(--mint);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
}

.view-button {
    min-height: 39px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    background: var(--emerald);
    border-radius: 7px;
    font-size: 13px;
    font-weight: 700;
}

.view-button:hover {
    background: var(--deep-green);
}

.empty-state {
    padding: 45px 20px;
    text-align: center;
    background: var(--white);
    border: 1px dashed #cbded8;
    border-radius: 14px;
}

.empty-state h3 {
    margin: 0 0 8px;
    color: var(--deep-green);
}

.empty-state p {
    margin: 0;
    color: var(--muted);
}

.vendor-banner {
    margin: 0 8% 70px;
    padding: 45px 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    overflow: hidden;
    background: var(--mint);
    border-radius: 20px;
}

.vendor-banner > div:first-child {
    max-width: 600px;
}

.vendor-banner p:not(.eyebrow) {
    margin: 0 0 24px;
    color: var(--muted);
    line-height: 1.7;
}

.vendor-art {
    width: 145px;
    height: 145px;
    flex: 0 0 145px;
    display: grid;
    place-items: center;
    color: var(--white);
    background: var(--emerald);
    border-radius: 35px;
    font-size: 75px;
    font-weight: 800;
    transform: rotate(8deg);
}

.vendor-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.vendor-card {
    padding: 24px;
    text-align: center;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
}

.vendor-avatar {
    width: 52px;
    height: 52px;
    margin: 0 auto 14px;
    display: grid;
    place-items: center;
    color: var(--white);
    background: var(--emerald);
    border-radius: 16px;
    font-size: 25px;
    font-weight: 800;
}

.vendor-card h3 {
    margin: 0 0 8px;
    color: var(--deep-green);
    font-size: 16px;
}

.vendor-card p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
}

.site-footer {
    padding: 48px 8% 20px;
    color: #dcebe7;
    background: var(--deep-green);
}

.footer-content {
    padding-bottom: 35px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 35px;
}

.footer-brand {
    color: var(--white);
}

.footer-brand .brand-accent {
    color: #80d3c2;
}

.footer-content > div:first-child p {
    color: #b7cbc5;
    font-size: 13px;
}

.footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
}

.footer-links h3 {
    margin: 0 0 5px;
    color: var(--white);
    font-size: 14px;
}

.footer-links a {
    color: #b7cbc5;
    font-size: 13px;
}

.footer-links a:hover {
    color: var(--white);
}

.footer-bottom {
    padding-top: 18px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid #ffffff25;
    color: #b7cbc5;
    font-size: 12px;
}

@media (max-width: 1000px) {
    .site-header {
        padding: 18px 5%;
        flex-wrap: wrap;
    }

    .main-nav {
        order: 3;
        width: 100%;
        justify-content: center;
    }

    .hero {
        padding: 55px 6%;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {
    .site-header {
        gap: 16px;
    }

    .brand {
        font-size: 21px;
    }

    .main-nav {
        gap: 15px;
        overflow-x: auto;
        justify-content: flex-start;
    }

    .header-actions {
        gap: 12px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 45px 6%;
    }

    .hero-art {
        min-height: 270px;
    }

    .art-circle {
        width: 230px;
        height: 230px;
    }

    .shopping-bag {
        width: 150px;
        height: 165px;
    }

    .benefits {
        grid-template-columns: 1fr;
        padding: 28px 6%;
    }

    .products-section,
    .vendors-section {
        padding: 50px 6%;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .product-grid,
    .vendor-grid {
        grid-template-columns: 1fr;
    }

    .vendor-banner {
        margin: 0 6% 50px;
        padding: 35px 7%;
        align-items: flex-start;
        flex-direction: column;
    }

    .vendor-art {
        width: 100px;
        height: 100px;
        flex-basis: 100px;
        font-size: 55px;
    }

    .footer-content {
        grid-template-columns: 1fr 1fr;
    }

    .footer-content > div:first-child {
        grid-column: 1 / -1;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 8px;
    }
}