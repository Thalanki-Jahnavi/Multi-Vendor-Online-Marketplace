package com.vendor.repository;

import java.util.List;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import com.vendor.entity.Product;

@Repository
public interface ProductRepository extends JpaRepository<Product, Long> {

    List<Product> findByProductStatusIgnoreCaseAndApprovalStatusIgnoreCaseOrderByProductIdDesc(
            String productStatus,
            String approvalStatus
    );

    // All products belonging to one vendor
    List<Product> findByVendorIdOrderByProductIdDesc(Integer vendorId);

    // Count vendor products
    long countByVendorId(Integer vendorId);

    // Count products by vendor and status
    long countByVendorIdAndProductStatusIgnoreCase(
            Integer vendorId,
            String productStatus
    );

    // Count products with zero stock
    long countByVendorIdAndStockQuantityLessThanEqual(
            Integer vendorId,
            Integer stockQuantity
    );
}