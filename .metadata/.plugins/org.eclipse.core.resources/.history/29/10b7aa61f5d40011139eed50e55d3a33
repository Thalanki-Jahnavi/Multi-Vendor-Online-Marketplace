<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account | OneCart</title>

  <style>
    :root {
      --emerald: #087e78;
      --deep-green: #123e3a;
      --mint: #e5f4f0;
      --soft-grey: #f5f7f6;
      --border: #dce7e3;
      --muted: #687a75;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      color: var(--deep-green);
      background: var(--soft-grey);
    }

    header {
      height: 78px;
      padding: 0 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #fff;
      border-bottom: 1px solid #e8eeeb;
    }

    .logo {
      color: var(--deep-green);
      font-size: 27px;
      font-weight: 800;
      letter-spacing: -1px;
      text-decoration: none;
    }

    .logo span {
      color: var(--emerald);
    }

    nav {
      display: flex;
      gap: 28px;
    }

    nav a,
    .login-link {
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    nav a:hover,
    .login-link:hover {
      color: var(--emerald);
    }

    main {
      min-height: calc(100vh - 78px);
      display: grid;
      place-items: center;
      padding: 42px 20px;
    }

    .signup-layout {
      width: min(100%, 1000px);
      min-height: 590px;
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 22px;
      background: #fff;
      box-shadow: 0 18px 50px rgba(18, 62, 58, 0.08);
    }

    /* Decorative left panel — no image */
    .welcome-panel {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 46px 38px;
      color: #fff;
      background: var(--deep-green);
    }

    .welcome-panel::before,
    .welcome-panel::after {
      content: "";
      position: absolute;
      border: 1px solid rgba(229, 244, 240, 0.18);
      border-radius: 50%;
      pointer-events: none;
    }

    .welcome-panel::before {
      width: 340px;
      height: 340px;
      right: -160px;
      top: 80px;
    }

    .welcome-panel::after {
      width: 230px;
      height: 230px;
      right: -105px;
      top: 135px;
    }

    .panel-content,
    .panel-footer {
      position: relative;
      z-index: 1;
    }

    .small-label {
      display: inline-block;
      padding: 8px 12px;
      border: 1px solid rgba(229, 244, 240, 0.25);
      border-radius: 20px;
      color: #c8eee5;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .welcome-panel h1 {
      margin: 26px 0 16px;
      font-size: 38px;
      line-height: 1.15;
      letter-spacing: -1px;
    }

    .welcome-panel p {
      max-width: 300px;
      margin: 0;
      color: #d0e3df;
      font-size: 15px;
      line-height: 1.7;
    }

    .mini-bag {
      width: 100px;
      height: 100px;
      display: grid;
      place-items: center;
      margin-top: 38px;
      border: 1px solid rgba(229, 244, 240, 0.25);
      border-radius: 28px;
      background: rgba(229, 244, 240, 0.08);
      color: #c8eee5;
      font-size: 46px;
      transform: rotate(-7deg);
    }

    .panel-footer {
      color: #a9c9c2;
      font-size: 12px;
      letter-spacing: 0.4px;
    }

    .form-panel {
      padding: 48px 50px;
    }

    .form-panel h2 {
      margin: 0 0 9px;
      font-size: 29px;
      letter-spacing: -0.5px;
    }

    .form-intro {
      margin: 0 0 28px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    .field {
      margin-bottom: 17px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 700;
    }

    input,
    select {
      width: 100%;
      height: 47px;
      padding: 0 13px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: #fbfdfc;
      color: var(--deep-green);
      font: inherit;
      outline: none;
    }

    input::placeholder {
      color: #9aa9a4;
    }

    input:focus,
    select:focus {
      border-color: var(--emerald);
      box-shadow: 0 0 0 3px rgba(8, 126, 120, 0.1);
    }

    .password-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .create-btn {
      width: 100%;
      height: 49px;
      margin-top: 3px;
      border: 0;
      border-radius: 9px;
      background: var(--emerald);
      color: #fff;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
    }

    .create-btn:hover {
      background: #066b66;
      transform: translateY(-1px);
    }

    .message {
      min-height: 18px;
      margin: 10px 0 0;
      color: #b42318;
      font-size: 13px;
    }

    .signin {
      margin: 19px 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }

    .signin a {
      color: var(--emerald);
      font-weight: 700;
      text-decoration: none;
    }

    @media (max-width: 760px) {
      header {
        padding: 0 5%;
      }

      nav {
        gap: 14px;
      }

      .signup-layout {
        max-width: 520px;
        grid-template-columns: 1fr;
      }

      .welcome-panel {
        min-height: 270px;
        padding: 30px;
      }

      .welcome-panel h1 {
        max-width: 380px;
        margin-top: 18px;
        font-size: 30px;
      }

      .welcome-panel p {
        max-width: 420px;
      }

      .mini-bag {
        display: none;
      }

      .panel-footer {
        margin-top: 28px;
      }

      .form-panel {
        padding: 34px 30px;
      }
    }

    @media (max-width: 480px) {
      nav a:not(:first-child) {
        display: none;
      }

      .password-row {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .form-panel {
        padding: 30px 22px;
      }
    }
  </style>
</head>

<body>
  <header>
    <a class="logo" href="/guest/index.html">One<span>Cart</span></a>

    <nav>
      <a href="/guest/index.html">Home</a>
      <a href="/guest/about.html">About</a>
      <a href="/guest/contact.html">Contact</a>
    </nav>

    <a class="login-link" href="/guest/login.html">Login</a>
  </header>

  <main>
    <div class="signup-layout">
      <aside class="welcome-panel">
        <div class="panel-content">
          <span class="small-label">Welcome to OneCart</span>
          <h1>More stores.<br>One simple cart.</h1>
          <p>Create an account to discover products from different vendors and keep your shopping organized.</p>

          <div class="mini-bag" aria-hidden="true">⌑</div>
        </div>

        <div class="panel-footer">A smarter way to shop.</div>
      </aside>

      <section class="form-panel">
        <h2>Create your account</h2>
        <p class="form-intro">Enter your details to get started.</p>

        <form id="signupForm">
          <div class="field">
            <label for="fullName">Full name</label>
            <input
              id="fullName"
              name="fullName"
              type="text"
              placeholder="Enter your full name"
              autocomplete="name"
              required
            >
          </div>

          <div class="field">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            >
          </div>

          <div class="password-row">
            <div class="field">
              <label for="password">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                placeholder="At least 8 characters"
                minlength="8"
                autocomplete="new-password"
                required
              >
            </div>

            <div class="field">
              <label for="confirmPassword">Confirm password</label>
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                placeholder="Enter it again"
                minlength="8"
                autocomplete="new-password"
                required
              >
            </div>
          </div>

          <div class="field">
            <label for="accountType">Account type</label>
            <select id="accountType" name="accountType" required>
              <option value="CUSTOMER">Customer</option>
              <option value="VENDOR">Vendor</option>
            </select>
          </div>

          <button class="create-btn" type="submit">Create Account</button>
          <p class="message" id="message" aria-live="polite"></p>
        </form>

        <p class="signin">
          Already have an account?
          <a href="/guest/login.html">Sign in</a>
        </p>
      </section>
    </div>
  </main>

  <script>
    document.getElementById("signupForm").addEventListener("submit", function (event) {
      event.preventDefault();

      const password = document.getElementById("password").value;
      const confirmPassword = document.getElementById("confirmPassword").value;
      const message = document.getElementById("message");

      if (password !== confirmPassword) {
        message.style.color = "#b42318";
        message.textContent = "Passwords do not match.";
        return;
      }

      message.style.color = "#087e78";
      message.textContent = "Details checked. Account creation will be connected to the backend later.";
    });
  </script>
</body>
</html>