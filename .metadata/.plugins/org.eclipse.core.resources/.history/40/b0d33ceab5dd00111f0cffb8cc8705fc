
<!DOCTYPE html>
<html lang="en"
      xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Shop Everything</title>

    <link rel="stylesheet" th:href="@{/css/home.css}">
    <link rel="stylesheet" th:href="@{/css/sidebar-layout.css}">
</head>

<body>

<div class="sidebar-layout">

    <!-- GUEST SIDEBAR -->
    <aside class="app-sidebar" sec:authorize="isAnonymous()">

        <a class="sidebar-brand" th:href="@{/}">
            <span class="sidebar-brand-icon">O</span>
            <span>One<span class="brand-light">Cart</span></span>
        </a>

        <p class="sidebar-label">MENU</p>

        <nav class="sidebar-nav">

            <a class="sidebar-link active" th:href="@{/}">
                <span class="nav-icon">⌂</span>
                <span>Home</span>
            </a>

            <a class="sidebar-link" th:href="@{/#products}">
                <span class="nav-icon">▦</span>
                <span>Products</span>
            </a>

            <a class="sidebar-link" th:href="@{/about}">
                <span class="nav-icon">ⓘ</span>
                <span>About Us</span>
            </a>

            <a class="sidebar-link" th:href="@{/contact}">
                <span class="nav-icon">✉</span>
                <span>Contact Us</span>
            </a>

        </nav>

        <div class="sidebar-bottom">

            <a class="sidebar-link" th:href="@{/login}">
                <span class="nav-icon">↪</span>
                <span>Sign In</span>
            </a>

            <a class="sidebar-signup" th:href="@{/signup}">
                Get Started
            </a>

        </div>
    </aside>


    <!-- CUSTOMER SIDEBAR -->
    <aside class="app-sidebar" sec:authorize="hasRole('CUSTOMER')">

        <a class="sidebar-brand" th:href="@{/customer/dashboard}">
            <span class="sidebar-brand-icon">O</span>
            <span>One<span class="brand-light">Cart</span></span>
        </a>

        <p class="sidebar-label">SHOPPING</p>

        <nav class="sidebar-nav">

            <a class="sidebar-link" th:href="@{/customer/dashboard}">
                <span class="nav-icon">⌂</span>
                <span>Dashboard</span>
            </a>

            <a class="sidebar-link" th:href="@{/customer/products}">
                <span class="nav-icon">▦</span>
                <span>Shop Products</span>
            </a>

            <a class="sidebar-link" th:href="@{/customer/products}">
                <span class="nav-icon">♡</span>
                <span>Wishlist</span>
            </a>

            <a class="sidebar-link" th:href="@{/customer/products}">
                <span class="nav-icon">🛒</span>
                <span>Cart</span>
            </a>

            <a class="sidebar-link" th:href="@{/customer/orders}">
                <span class="nav-icon">▤</span>
                <span>My Orders</span>
            </a>

        </nav>

        <p class="sidebar-label sidebar-label-spaced">ACCOUNT</p>

        <nav class="sidebar-nav">

            <a class="sidebar-link" th:href="@{/customer/account}">
                <span class="nav-icon">♙</span>
                <span>My Account</span>
            </a>

        </nav>

        <div class="sidebar-bottom">

            <form th:action="@{/logout}" method="post">

                <button class="sidebar-logout" type="submit">
                    <span class="nav-icon">↪</span>
                    <span>Logout</span>
                </button>

            </form>

        </div>
    </aside>


    <!-- MAIN CONTENT -->
    <div class="main-shell">

        <!-- TOP HEADER -->
        <header class="content-topbar">

            <button class="mobile-menu-toggle"
                    type="button"
                    onclick="toggleOneCartSidebar()"
                    aria-label="Toggle navigation">
                ☰
            </button>

            <div class="topbar-heading">

                <span class="topbar-eyebrow">
                    ONECART MARKETPLACE
                </span>

                <h1 sec:authorize="isAnonymous()">
                    Discover Products
                </h1>

                <h1 sec:authorize="hasRole('CUSTOMER')">
                    Shop Products
                </h1>

            </div>

            <!-- GUEST ACTION -->
            <div class="topbar-actions"
                 sec:authorize="isAnonymous()">

                <a class="topbar-button" th:href="@{/login}">
                    Sign In
                </a>

            </div>

            <!-- CUSTOMER ACTION -->
            <div class="topbar-actions"
                 sec:authorize="hasRole('CUSTOMER')">

                <a class="topbar-icon-link"
                   th:href="@{/customer/products}"
                   title="Wishlist">
                    ♡
                </a>

                <a class="topbar-icon-link"
                   th:href="@{/customer/products}"
                   title="Cart">
                    🛒
                </a>

                <a class="topbar-profile"
                   th:href="@{/customer/account}">
                    ♙
                </a>

            </div>

        </header>


        <!-- HERO SECTION -->
        <main>

            <section class="hero">

                <div class="hero-content">

                    <span class="eyebrow">
                        YOUR ONE-STOP MARKETPLACE
                    </span>

                    <h1>
                        Everything you love,
                        <span>all in OneCart.</span>
                    </h1>

                    <p>
                        Discover a world of products from trusted sellers.
                        Shop fashion, electronics, home essentials and more,
                        all in one convenient marketplace.
                    </p>

                    <div class="hero-actions">

                        <a class="button button-primary"
                           th:href="@{/#products}">
                            Explore Products
                            <span>→</span>
                        </a>

                        <a class="button button-light"
                           th:href="@{/signup}">
                            Join OneCart
                        </a>

                    </div>

                    <div class="hero-trust">

                        <span>✓ Trusted Vendors</span>
                        <span>✓ Secure Shopping</span>
                        <span>✓ Great Deals</span>

                    </div>

                </div>


                <div class="hero-art">

                    <div class="hero-circle"></div>

                    <div class="hero-card hero-card-back">
                        <span class="hero-card-icon">✦</span>
                        <strong>Special Offers</strong>
                        <span>Discover something new</span>
                    </div>

                    <div class="hero-card hero-card-front">

                        <span class="hero-bag">🛍️</span>

                        <strong>Your Shopping Journey</strong>

                        <span>Everything in one place</span>

                    </div>

                    <span class="floating-tag tag-top">
                        ✨ New Arrivals
                    </span>

                    <span class="floating-tag tag-bottom">
                        ♡ Made for You
                    </span>

                </div>

            </section>


            <!-- BENEFITS -->
            <section class="benefits">

                <div class="benefit">

                    <span class="benefit-icon">✓</span>

                    <div>
                        <strong>Trusted Sellers</strong>
                        <small>Shop from verified vendors</small>
                    </div>

                </div>

                <div class="benefit">

                    <span class="benefit-icon">↗</span>

                    <div>
                        <strong>Great Value</strong>
                        <small>Discover products and offers</small>
                    </div>

                </div>

                <div class="benefit">

                    <span class="benefit-icon">♧</span>

                    <div>
                        <strong>Easy Shopping</strong>
                        <small>Everything in one marketplace</small>
                    </div>

                </div>

            </section>


            <!-- CATEGORIES -->
            <section class="section">

                <div class="section-heading">

                    <div>

                        <span class="eyebrow">
                            FIND YOUR FAVOURITES
                        </span>

                        <h2>Shop by Category</h2>

                        <p>
                            Explore collections across different categories.
                        </p>

                    </div>

                </div>


                <div class="category-grid">

                    <a class="category-card category-fashion"
                       th:href="@{/customer/products(category='Fashion')}">

                        <span class="category-emoji">👗</span>
                        <span class="category-name">Fashion</span>
                        <span class="category-note">Style your everyday</span>

                    </a>

                    <a class="category-card category-electronics"
                       th:href="@{/customer/products(category='Electronics')}">

                        <span class="category-emoji">🎧</span>
                        <span class="category-name">Electronics</span>
                        <span class="category-note">Technology made easy</span>

                    </a>

                    <a class="category-card category-home"
                       th:href="@{/customer/products(category='Home & Kitchen')}">

                        <span class="category-emoji">🏡</span>
                        <span class="category-name">Home & Kitchen</span>
                        <span class="category-note">Make your space special</span>

                    </a>

                    <a class="category-card category-beauty"
                       th:href="@{/customer/products(category='Beauty')}">

                        <span class="category-emoji">✨</span>
                        <span class="category-name">Beauty</span>
                        <span class="category-note">Your everyday essentials</span>

                    </a>

                </div>

            </section>


            <!-- POPULAR PRODUCTS -->
            <section class="section products-section"
                     id="products">

                <div class="section-heading">

                    <div>

                        <span class="eyebrow">
                            EXPLORE OUR COLLECTION
                        </span>

                        <h2>Popular Products</h2>

                        <p>
                            Discover products from OneCart sellers.
                        </p>

                    </div>

                    <a class="text-link"
                       th:href="@{/customer/products}"
                       sec:authorize="hasRole('CUSTOMER')">
                        View All Products <span>→</span>
                    </a>

                    <a class="text-link"
                       th:href="@{/login}"
                       sec:authorize="isAnonymous()">
                        Explore More <span>→</span>
                    </a>

                </div>


                <div class="product-grid"
                     th:if="${products != null and !products.isEmpty()}">

                    <article class="product-card"
                             th:each="product : ${products}">

                        <div class="product-image-wrap">

                            <!-- GUEST PRODUCT IMAGE -->
                            <a th:href="@{/login}"
                               sec:authorize="isAnonymous()">

                                <img class="product-image"
                                     th:src="@{'/images/products/' + ${product.imageFileName}}"
                                     th:alt="${product.productName}"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='/images/products/Ceramic Coffee Mug.jpg';">

                            </a>

                            <!-- CUSTOMER PRODUCT IMAGE -->
                            <a th:href="@{/customer/products(keyword=${product.productName})}"
                               sec:authorize="hasRole('CUSTOMER')">

                                <img class="product-image"
                                     th:src="@{'/images/products/' + ${product.imageFileName}}"
                                     th:alt="${product.productName}"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='/images/products/Ceramic Coffee Mug.jpg';">

                            </a>

                            <span class="product-badge">
                                Popular
                            </span>

                            <a class="wishlist-button"
                               th:href="@{/login}"
                               sec:authorize="isAnonymous()"
                               aria-label="Sign in to add to wishlist">
                                ♡
                            </a>

                            <a class="wishlist-button"
                               th:href="@{/customer/products}"
                               sec:authorize="hasRole('CUSTOMER')"
                               aria-label="Open wishlist">
                                ♡
                            </a>

                        </div>


                        <div class="product-info">

                            <span class="product-category"
                                  th:text="${product.category != null ? product.category : 'ONECART FIND'}">
                                ONECART FIND
                            </span>


                            <a th:href="@{/login}"
                               sec:authorize="isAnonymous()">

                                <h3 th:text="${product.productName}">
                                    Product name
                                </h3>

                            </a>

                            <a th:href="@{/customer/products(keyword=${product.productName})}"
                               sec:authorize="hasRole('CUSTOMER')">

                                <h3 th:text="${product.productName}">
                                    Product name
                                </h3>

                            </a>


                            <div class="product-price-row">

                                <strong class="product-price"
                                        th:text="${product.discountedPrice != null ? '₹' + #numbers.formatDecimal(product.discountedPrice, 1, 2) : '₹' + #numbers.formatDecimal(product.price, 1, 2)}">
                                    ₹0.00
                                </strong>

                                <del th:if="${product.hasDiscount()}"
                                     style="font-size:13px;color:#68817e;margin-left:6px;">

                                    ₹<span th:text="${#numbers.formatDecimal(product.price, 1, 2)}">
                                        0.00
                                    </span>

                                </del>

                            </div>


                            <a class="add-to-cart"
                               th:href="@{/login}"
                               sec:authorize="isAnonymous()">

                                Sign in to buy <span>→</span>

                            </a>

                            <a class="add-to-cart"
                               th:href="@{/customer/products(keyword=${product.productName})}"
                               sec:authorize="hasRole('CUSTOMER')">

                                View product <span>→</span>

                            </a>

                        </div>

                    </article>

                </div>


                <!-- EMPTY PRODUCTS -->
                <div class="empty-state"
                     th:if="${products == null or products.isEmpty()}">

                    <div class="empty-icon">🛍️</div>

                    <h3>Products are on their way</h3>

                    <p>
                        Check back soon to discover new finds from our vendors.
                    </p>

                </div>

            </section>


            <!-- VENDOR SECTION -->
            <section class="section vendor-section">

                <div class="vendor-content">

                    <div class="vendor-copy">

                        <span class="eyebrow">
                            SELL WITH ONECART
                        </span>

                        <h2>
                            Grow your business with OneCart.
                        </h2>

                        <p>
                            Bring your products to more customers.
                            Create your store, manage your products
                            and grow your business through OneCart.
                        </p>

                        <a class="button button-primary"
                           th:href="@{/signup}">
                            Become a Vendor <span>→</span>
                        </a>

                    </div>


                    <div class="vendor-panel">

                        <div class="vendor-panel-heading">

                            <div>

                                <span class="eyebrow">
                                    ONECART COMMUNITY
                                </span>

                                <h3>Our Marketplace</h3>

                            </div>

                            <span class="vendor-star">✦</span>

                        </div>

                        <div class="vendor-row">

                            <span class="vendor-avatar">F</span>

                            <div>
                                <strong>Fashion & Lifestyle</strong>
                                <small>Discover everyday style</small>
                            </div>

                            <span class="vendor-arrow">→</span>

                        </div>

                        <div class="vendor-row">

                            <span class="vendor-avatar">E</span>

                            <div>
                                <strong>Electronics</strong>
                                <small>Explore useful technology</small>
                            </div>

                            <span class="vendor-arrow">→</span>

                        </div>

                        <div class="vendor-row">

                            <span class="vendor-avatar">H</span>

                            <div>
                                <strong>Home & Living</strong>
                                <small>Make your home special</small>
                            </div>

                            <span class="vendor-arrow">→</span>

                        </div>

                    </div>

                </div>

            </section>


            <!-- ABOUT SECTION -->
            <section class="section about-strip">

                <div class="about-inner">

                    <div>

                        <span class="eyebrow">
                            ABOUT ONECART
                        </span>

                        <h2>
                            A simpler way to discover and shop.
                        </h2>

                    </div>

                    <div>

                        <p>
                            OneCart brings customers and independent vendors
                            together in one convenient online marketplace.
                            Explore products, discover sellers and enjoy
                            a smooth shopping experience.
                        </p>

                        <a class="text-link" th:href="@{/about}">
                            Know More About Us <span>→</span>
                        </a>

                    </div>

                </div>

            </section>

        </main>


        <!-- FOOTER -->
        <footer class="site-footer">

            <div class="footer-brand">
                <a class="brand" th:href="@{/}">
                    <span class="brand-icon">O</span>
                    <span>One<span>Cart</span></span>
                </a>

                <p>
                    Everything you need, all in one place.
                </p>
            </div>

            <div class="footer-links">

                <a th:href="@{/}">Home</a>
                <a th:href="@{/about}">About Us</a>
                <a th:href="@{/contact}">Contact Us</a>
                <a th:href="@{/login}">Sign In</a>

            </div>

            <div class="footer-bottom">
                © 2026 OneCart. All rights reserved.
            </div>

        </footer>

    </div>
</div>


<!-- MOBILE OVERLAY -->
<div class="sidebar-mobile-overlay"
     id="oneCartSidebarOverlay"
     onclick="toggleOneCartSidebar()">
</div>


<script>
    function toggleOneCartSidebar() {
        document.body.classList.toggle("sidebar-open");
    }
</script>

</body>
</html>
