:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --white: #ffffff;
    --text: #263c39;
    --muted: #71817e;
    --border: #e5ece9;
    --background: #f8fbfa;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--white);
    color: var(--text);
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input {
    font: inherit;
}

.navbar {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 15px 7%;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.logo {
    font-size: 29px;
    font-weight: 800;
    color: var(--deep-green);
    letter-spacing: -1.5px;
}

.logo span {
    color: var(--emerald);
}

.search-form {
    display: flex;
    width: 340px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--background);
}

.search-form input {
    width: 100%;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    padding: 0 14px;
}

.search-form button {
    border: none;
    background: var(--emerald);
    color: white;
    padding: 0 18px;
    cursor: pointer;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    font-weight: 600;
}

.nav-links a:hover,
.footer-links a:hover {
    color: var(--emerald);
}

.login-btn,
.signup-btn {
    padding: 10px 17px;
    border-radius: 7px;
}

.login-btn {
    border: 1px solid var(--emerald);
    color: var(--emerald);
}

.signup-btn {
    background: var(--emerald);
    color: white;
}

.hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    min-height: 450px;
    padding: 65px 10%;
    background: linear-gradient(120deg, #e5f4f0, #f7fbfa);
}

.hero-label,
.section-label {
    color: var(--emerald);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.7px;
}

.hero h1 {
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.12;
    letter-spacing: -2px;
    margin: 18px 0;
    color: var(--deep-green);
}

.hero h1 span {
    color: var(--emerald);
}

.hero-content p {
    max-width: 440px;
    color: var(--muted);
    font-size: 16px;
    margin-bottom: 28px;
}

.hero-btn,
.vendor-btn {
    display: inline-block;
    background: var(--emerald);
    color: white;
    padding: 13px 24px;
    border-radius: 7px;
    font-weight: 700;
}

.hero-art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
}

.hero-circle {
    width: 240px;
    height: 240px;
    display: grid;
    place-items: center;
    background: var(--emerald);
    border-radius: 50%;
    box-shadow: 0 20px 55px #087e7830;
}

.hero-icon {
    font-size: 110px;
    color: white;
}

.floating-card {
    position: absolute;
    background: white;
    padding: 13px 19px;
    border-radius: 10px;
    box-shadow: 0 8px 25px #123e3a12;
    font-size: 13px;
    font-weight: 700;
}

.floating-card span {
    color: var(--emerald);
    margin-right: 6px;
}

.card-one {
    top: 35px;
    right: 0;
}

.card-two {
    bottom: 35px;
    left: 0;
}

.benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 30px 10%;
    gap: 30px;
    border-bottom: 1px solid var(--border);
}

.benefit {
    display: flex;
    align-items: center;
    gap: 15px;
}

.benefit-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 23px;
}

.benefit h3 {
    font-size: 14px;
    color: var(--deep-green);
}

.benefit p {
    font-size: 12px;
    color: var(--muted);
}

.products-section {
    padding: 65px 7%;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.section-heading h2,
.vendor-banner h2 {
    font-size: 30px;
    color: var(--deep-green);
    margin: 8px 0;
}

.section-heading p {
    color: var(--muted);
    font-size: 14px;
}

.product-count {
    color: var(--muted);
    font-size: 13px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.product-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    background: white;
}

.product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px #123e3a10;
}

.product-image {
    position: relative;
    display: grid;
    place-items: center;
    height: 210px;
    background: var(--mint);
}

.product-placeholder {
    font-size: 65px;
    color: var(--emerald);
}

.discount-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--emerald);
    color: white;
    padding: 5px 9px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 700;
}

.product-info {
    padding: 17px;
}

.vendor-name {
    font-size: 11px;
    color: var(--emerald);
    font-weight: 700;
    margin-bottom: 6px;
}

.product-info h3 {
    font-size: 15px;
    color: var(--deep-green);
    margin-bottom: 12px;
}

.price-row {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 17px;
}

.product-price {
    font-size: 19px;
    font-weight: 800;
    color: var(--deep-green);
}

.original-price {
    font-size: 12px;
    color: var(--muted);
    text-decoration: line-through;
}

.product-btn {
    display: block;
    text-align: center;
    padding: 10px;
    border: 1px solid var(--emerald);
    border-radius: 6px;
    color: var(--emerald);
    font-size: 13px;
    font-weight: 700;
}

.product-btn:hover {
    background: var(--emerald);
    color: white;
}

.empty-products {
    text-align: center;
    padding: 60px 20px;
    background: var(--background);
    border-radius: 12px;
}

.empty-icon {
    font-size: 48px;
    color: var(--emerald);
}

.empty-products h3 {
    color: var(--deep-green);
    margin: 10px 0;
}

.empty-products p {
    color: var(--muted);
    font-size: 14px;
}

.vendor-banner {
    margin: 0 7% 65px;
    padding: 40px;
    border-radius: 14px;
    background: var(--mint);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
}

.vendor-banner p {
    max-width: 560px;
    color: var(--muted);
    font-size: 14px;
}

.vendor-btn {
    white-space: nowrap;
}

.footer {
    padding: 45px 7%;
    background: var(--deep-green);
    color: white;
    text-align: center;
}

.footer .logo {
    color: white;
}

.footer .logo span {
    color: #8bd5c5;
}

.footer > p {
    color: #c0d8d2;
    font-size: 13px;
    margin: 10px 0;
}

.footer-links {
    display: flex;
    justify-content: center;
    gap: 25px;
    margin: 20px 0;
    font-size: 13px;
}

.copyright {
    padding-top: 20px;
    border-top: 1px solid #ffffff20;
}

@media (max-width: 1050px) {
    .navbar {
        flex-wrap: wrap;
    }

    .search-form {
        order: 3;
        width: 100%;
    }

    .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    .navbar {
        padding: 15px 5%;
    }

    .nav-links {
        width: 100%;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 50px 7%;
    }

    .hero-art {
        min-height: 230px;
    }

    .hero-circle {
        width: 180px;
        height: 180px;
    }

    .hero-icon {
        font-size: 80px;
    }

    .benefits {
        grid-template-columns: 1fr;
        padding: 30px 7%;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .product-image {
        height: 150px;
    }

    .product-info {
        padding: 12px;
    }

    .product-info h3 {
        font-size: 13px;
    }

    .product-price {
        font-size: 16px;
    }

    .vendor-banner {
        flex-direction: column;
        align-items: flex-start;
        padding: 25px;
    }

    .section-heading h2,
    .vendor-banner h2 {
        font-size: 24px;
    }
}