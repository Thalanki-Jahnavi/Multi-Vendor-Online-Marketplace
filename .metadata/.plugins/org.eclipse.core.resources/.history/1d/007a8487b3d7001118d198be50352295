<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>OneCart | Online Marketplace</title>

    <link rel="stylesheet" th:href="@{/css/home.css}">
    <script th:src="@{/js/home.js}" defer></script>
</head>

<body>

<header class="navbar">
    <a th:href="@{/}" class="logo">
        One<span>Cart</span>
    </a>

    <form class="search-form" action="#" method="get">
        <input type="search"
               id="productSearch"
               placeholder="Search products..."
               aria-label="Search products">

        <button type="submit">Search</button>
    </form>

    <nav class="nav-links">
        <a th:href="@{/}">Home</a>
        <a th:href="@{/about}">About</a>
        <a th:href="@{/contact}">Contact</a>
        <a th:href="@{/login}" class="login-btn">Login</a>
        <a th:href="@{/signup}" class="signup-btn">Sign Up</a>
    </nav>
</header>

<main>

    <section class="hero">
        <div class="hero-content">
            <span class="hero-label">ONE MARKETPLACE. ENDLESS CHOICES.</span>

            <h1>
                Discover More.<br>
                Shop <span>Smarter.</span>
            </h1>

            <p>
                Explore products from independent vendors
                and discover something you love.
            </p>

            <a href="#featured-products" class="hero-btn">
                Explore Products
            </a>
        </div>

        <div class="hero-art">
            <div class="hero-circle">
                <span class="hero-icon">🛍</span>
            </div>

            <div class="floating-card card-one">
                <span>✦</span> Great finds
            </div>

            <div class="floating-card card-two">
                <span>✓</span> Trusted vendors
            </div>
        </div>
    </section>

    <section class="benefits">
        <div class="benefit">
            <span class="benefit-icon">◇</span>
            <div>
                <h3>Curated Products</h3>
                <p>Discover quality finds</p>
            </div>
        </div>

        <div class="benefit">
            <span class="benefit-icon">◎</span>
            <div>
                <h3>Independent Vendors</h3>
                <p>Shop from unique stores</p>
            </div>
        </div>

        <div class="benefit">
            <span class="benefit-icon">↗</span>
            <div>
                <h3>Easy Shopping</h3>
                <p>Everything in one place</p>
            </div>
        </div>
    </section>

    <section class="products-section" id="featured-products">

        <div class="section-heading">
            <div>
                <span class="section-label">EXPLORE OUR COLLECTION</span>
                <h2>Featured Products</h2>
                <p>Find your next favorite item.</p>
            </div>

            <span class="product-count"
                  th:text="${products.size()} + ' products'">
                0 products
            </span>
        </div>

        <div class="product-grid"
             th:if="${!products.isEmpty()}">

            <article class="product-card"
                     th:each="product : ${products}">

                <div class="product-image">
                    <span class="product-placeholder">🛍</span>

                    <span class="discount-badge"
                          th:if="${product.discountPercentage() > 0}"
                          th:text="${product.discountPercentage().stripTrailingZeros().toPlainString()} + '% OFF'">
                        10% OFF
                    </span>
                </div>

                <div class="product-info">

                    <p class="vendor-name"
                       th:text="${product.vendorName() != null
                           ? product.vendorName()
                           : 'OneCart Vendor'}">
                        Vendor
                    </p>

                    <h3 th:text="${product.productName()}">
                        Product Name
                    </h3>

                    <div class="price-row">
                        <span class="product-price"
                              th:text="'₹' + ${#numbers.formatDecimal(
                                  product.price(), 1, 2)}">
                            ₹0.00
                        </span>

                        <span class="original-price"
                              th:if="${product.discountPercentage() > 0}"
                              th:text="'₹' + ${#numbers.formatDecimal(
                                  product.price().multiply(
                                      T(java.math.BigDecimal).ONE.add(
                                          product.discountPercentage()
                                              .divide(
                                                  T(java.math.BigDecimal).valueOf(100),
                                                  4,
                                                  T(java.math.RoundingMode).HALF_UP
                                              )
                                      )
                                  ), 1, 2)}">
                            ₹0.00
                        </span>
                    </div>

                    <a th:href="@{/login}" class="product-btn">
                        Login to Shop
                    </a>

                </div>
            </article>

        </div>

        <div class="empty-products"
             th:if="${products.isEmpty()}">

            <div class="empty-icon">🛍</div>
            <h3>New discoveries are on the way!</h3>
            <p>There are no approved products to display yet.</p>

        </div>

    </section>

    <section class="vendor-banner">
        <div>
            <span class="section-label">GROW WITH ONECART</span>
            <h2>Have something great to sell?</h2>
            <p>
                Create your vendor account and bring your products
                to a growing marketplace.
            </p>
        </div>

        <a th:href="@{/signup}" class="vendor-btn">
            Become a Vendor
        </a>
    </section>

</main>

<footer class="footer">
    <a th:href="@{/}" class="logo">
        One<span>Cart</span>
    </a>

    <p>Discover more. Shop smarter.</p>

    <div class="footer-links">
        <a th:href="@{/about}">About Us</a>
        <a th:href="@{/contact}">Contact Us</a>
        <a th:href="@{/login}">Login</a>
    </div>

    <p class="copyright">
        © 2026 OneCart. All rights reserved.
    </p>
</footer>

</body>
</html>