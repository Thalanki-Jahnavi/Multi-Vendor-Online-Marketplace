<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Home</title>

    <link rel="stylesheet" th:href="@{/css/guest-layout.css}">

    <style>
        :root {
            --green: #087e78;
            --deep-green: #123e3a;
            --mint: #e5f4f0;
            --text: #183b38;
            --muted: #687d79;
            --border: #e1ece9;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            color: var(--text);
            background: #fff;
            font-family: Arial, sans-serif;
        }

        .home-main {
            max-width: 1280px;
            margin: 0 auto;
            padding: 32px 24px 0;
        }

        .hero {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            align-items: center;
            gap: 36px;
            padding: 56px;
            border-radius: 24px;
            background: var(--mint);
        }

        .hero-tag {
            display: inline-block;
            margin-bottom: 18px;
            padding: 8px 14px;
            border-radius: 30px;
            background: #fff;
            color: var(--green);
            font-size: 13px;
            font-weight: 700;
        }

        .hero h1 {
            max-width: 620px;
            margin: 0 0 18px;
            color: var(--deep-green);
            font-size: clamp(36px, 5vw, 58px);
            line-height: 1.1;
        }

        .hero p {
            max-width: 520px;
            margin: 0 0 28px;
            color: #526c67;
            font-size: 17px;
            line-height: 1.7;
        }

        .hero-button {
            display: inline-block;
            padding: 14px 24px;
            border-radius: 10px;
            background: var(--green);
            color: #fff;
            font-weight: 700;
            text-decoration: none;
        }

        .hero-art {
            display: flex;
            min-height: 280px;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            background: linear-gradient(135deg, #c8e9df, #f7fffc);
            color: var(--green);
            font-size: 86px;
        }

        .section {
            padding: 58px 0 0;
        }

        .section-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
        }

        .section-heading h2 {
            margin: 0 0 8px;
            color: var(--deep-green);
            font-size: 30px;
        }

        .section-heading p {
            margin: 0;
            color: var(--muted);
        }

        .text-link {
            color: var(--green);
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }

        .category-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .category-card {
            display: flex;
            min-height: 150px;
            flex-direction: column;
            justify-content: space-between;
            padding: 22px;
            border: 1px solid var(--border);
            border-radius: 16px;
            color: var(--text);
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .category-card:hover,
        .product-card:hover,
        .vendor-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(18, 62, 58, 0.08);
        }

        .category-icon {
            font-size: 34px;
        }

        .category-card strong {
            font-size: 17px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .product-card {
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 16px;
            background: #fff;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .product-image {
            display: flex;
            height: 190px;
            align-items: center;
            justify-content: center;
            background: #f2f8f6;
            color: var(--green);
            font-size: 48px;
        }

        .product-info {
            padding: 18px;
        }

        .product-info h3 {
            margin: 0 0 10px;
            font-size: 17px;
        }

        .product-price {
            margin: 0;
            color: var(--green);
            font-size: 18px;
            font-weight: 800;
        }

        .empty-products {
            grid-column: 1 / -1;
            padding: 30px;
            border: 1px dashed var(--border);
            border-radius: 14px;
            color: var(--muted);
            text-align: center;
        }

        .vendor-strip {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .vendor-card {
            padding: 26px;
            border: 1px solid var(--border);
            border-radius: 16px;
            background: #fff;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .vendor-card .vendor-icon {
            margin-bottom: 16px;
            font-size: 32px;
        }

        .vendor-card h3 {
            margin: 0 0 10px;
            color: var(--deep-green);
        }

        .vendor-card p {
            margin: 0;
            color: var(--muted);
            line-height: 1.6;
        }

        .vendor-cta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            margin: 58px 0;
            padding: 36px;
            border-radius: 20px;
            background: var(--deep-green);
            color: #fff;
        }

        .vendor-cta h2 {
            margin: 0 0 10px;
            font-size: 28px;
        }

        .vendor-cta p {
            margin: 0;
            color: #d4e6e2;
            line-height: 1.6;
        }

        .vendor-cta a {
            flex-shrink: 0;
            padding: 14px 22px;
            border-radius: 10px;
            background: #fff;
            color: var(--deep-green);
            font-weight: 700;
            text-decoration: none;
        }

        @media (max-width: 900px) {
            .hero {
                grid-template-columns: 1fr;
                padding: 36px;
            }

            .category-grid,
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .vendor-strip {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 560px) {
            .home-main {
                padding: 20px 16px 0;
            }

            .hero {
                padding: 26px;
            }

            .hero-art {
                min-height: 190px;
            }

            .category-grid,
            .product-grid {
                grid-template-columns: 1fr;
            }

            .section-heading,
            .vendor-cta {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
</head>

<body>
    <div th:replace="~{public/fragments/guest-layout :: guestHeader}"></div>

    <main class="home-main">
        <section class="hero">
            <div>
                <span class="hero-tag">ONE MARKETPLACE. MANY VENDORS.</span>
                <h1>Find something you’ll love.</h1>
                <p>
                    Explore products from independent vendors and discover
                    something special, all in one place.
                </p>
                <a class="hero-button" th:href="@{/shop}">Explore products</a>
            </div>

            <div class="hero-art" aria-label="Shopping bags illustration" role="img">
                🛍️
            </div>
        </section>

        <section class="section">
            <div class="section-heading">
                <div>
                    <h2>Shop by category</h2>
                    <p>Explore a few popular categories.</p>
                </div>
                <a class="text-link" th:href="@{/shop}">View all products →</a>
            </div>

            <div class="category-grid">
                <a class="category-card" th:href="@{/shop}">
                    <span class="category-icon">👕</span>
                    <strong>Fashion</strong>
                </a>

                <a class="category-card" th:href="@{/shop}">
                    <span class="category-icon">📱</span>
                    <strong>Electronics</strong>
                </a>

                <a class="category-card" th:href="@{/shop}">
                    <span class="category-icon">🏠</span>
                    <strong>Home & Living</strong>
                </a>

                <a class="category-card" th:href="@{/shop}">
                    <span class="category-icon">✨</span>
                    <strong>Accessories</strong>
                </a>
            </div>
        </section>

        <section class="section">
            <div class="section-heading">
                <div>
                    <h2>Featured products</h2>
                    <p>Discover products available on OneCart.</p>
                </div>
                <a class="text-link" th:href="@{/shop}">Shop all →</a>
            </div>

            <div class="product-grid">
                <div class="product-card" th:each="product : ${products}">
                    <div class="product-image">🛍️</div>
                    <div class="product-info">
                        <h3 th:text="${product.name}">Product name</h3>
                        <p class="product-price"
                           th:text="${'₹' + #numbers.formatDecimal(product.price, 1, 2)}">
                            ₹0.00
                        </p>
                    </div>
                </div>

                <p class="empty-products"
                   th:if="${products == null or #lists.isEmpty(products)}">
                    Featured products will appear here soon.
                </p>
            </div>
        </section>

        <section class="section">
            <div class="section-heading">
                <div>
                    <h2>Discover our vendors</h2>
                    <p>OneCart brings different sellers together in one marketplace.</p>
                </div>
            </div>

            <div class="vendor-strip">
                <article class="vendor-card">
                    <div class="vendor-icon">🧵</div>
                    <h3>Fashion & Style</h3>
                    <p>Find everyday wear and unique pieces from independent sellers.</p>
                </article>

                <article class="vendor-card">
                    <div class="vendor-icon">🎧</div>
                    <h3>Tech & Gadgets</h3>
                    <p>Browse useful electronics and accessories for your daily life.</p>
                </article>

                <article class="vendor-card">
                    <div class="vendor-icon">🏡</div>
                    <h3>Home & Living</h3>
                    <p>Discover thoughtful finds to make your space feel like home.</p>
                </article>
            </div>
        </section>

        <section class="vendor-cta">
            <div>
                <h2>Have a store of your own?</h2>
                <p>Join OneCart and introduce your products to more shoppers.</p>
            </div>
            <a th:href="@{/signup}">Become a vendor</a>
        </section>
    </main>

    <div th:replace="~{public/fragments/guest-layout :: guestFooter}"></div>
</body>
</html>