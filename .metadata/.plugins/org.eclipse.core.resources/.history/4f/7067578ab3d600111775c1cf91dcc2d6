/* ===== Login page styles ===== */

.auth-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: var(--cream);
}

.auth-card {
    width: min(950px, 100%);
    min-height: 590px;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--white);
    box-shadow: var(--shadow);
}

.auth-welcome {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 38px;
    overflow: hidden;
    background: var(--plum);
    color: var(--white);
}

.auth-welcome-copy {
    position: relative;
    z-index: 1;
    margin: 60px 0;
}

.auth-welcome-copy h1 {
    margin: 14px 0;
    font-family: "Playfair Display", serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.08;
}

.auth-welcome-copy p {
    max-width: 310px;
    color: #D6C9D0;
    line-height: 1.7;
}

.auth-welcome .eyebrow {
    color: var(--rose);
}

.auth-decor-circle {
    position: absolute;
    right: -100px;
    bottom: -95px;
    width: 330px;
    height: 330px;
    border: 1px solid rgba(232, 184, 168, 0.35);
    border-radius: 50%;
}

.auth-decor-circle::before,
.auth-decor-circle::after {
    position: absolute;
    content: "";
    border: 1px solid rgba(232, 184, 168, 0.35);
    border-radius: 50%;
}

.auth-decor-circle::before {
    inset: 30px;
}

.auth-decor-circle::after {
    inset: 60px;
}

.auth-form-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px clamp(24px, 6vw, 65px);
}

.auth-form-panel h2 {
    margin: 0 0 8px;
    font-family: "Playfair Display", serif;
    font-size: 2rem;
}

.auth-intro {
    margin: 0 0 28px;
    color: var(--muted);
    line-height: 1.5;
}

.auth-form .field {
    margin-bottom: 18px;
}

.auth-form .field label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.88rem;
    font-weight: 700;
}

.auth-form .field input {
    width: 100%;
    min-height: 46px;
    padding: 12px 13px;
    border: 1px solid var(--line);
    border-radius: 10px;
    outline: none;
    background: var(--white);
    color: var(--plum);
}

.auth-form .field input:focus {
    border-color: var(--terracotta);
    box-shadow: 0 0 0 3px rgba(182, 83, 60, 0.12);
}

.auth-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 3px 0 20px;
    color: var(--muted);
    font-size: 0.83rem;
}

.auth-remember {
    display: inline-flex;
    align-items: center;
    gap: 7px;
}

.auth-remember input {
    accent-color: var(--terracotta);
}

.auth-link {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--terracotta);
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
}

.auth-link:hover {
    color: var(--terracotta-dark);
}

.auth-submit {
    width: 100%;
    min-height: 48px;
    border: 0;
    border-radius: 10px;
    background: var(--terracotta);
    color: var(--white);
    font-weight: 700;
    cursor: pointer;
}

.auth-submit:hover {
    background: var(--terracotta-dark);
}

.auth-message {
    min-height: 20px;
    margin: 14px 0 0;
    color: var(--terracotta-dark);
    font-size: 0.88rem;
    line-height: 1.5;
}

.auth-signup-prompt {
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
}

.auth-back-link {
    display: inline-block;
    margin-top: 22px;
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: none;
}

.auth-back-link:hover {
    color: var(--terracotta-dark);
}

@media (max-width: 700px) {
    .auth-page {
        padding: 14px;
    }

    .auth-card {
        grid-template-columns: 1fr;
    }

    .auth-welcome {
        min-height: 220px;
        padding: 25px;
    }

    .auth-welcome-copy {
        margin: 35px 0 20px;
    }

    .auth-welcome-copy h1 {
        font-size: 2.3rem;
    }

    .auth-form-panel {
        padding: 30px 24px;
    }
}

@media (max-width: 380px) {
    .auth-options {
        align-items: flex-start;
        flex-direction: column;
    }
}