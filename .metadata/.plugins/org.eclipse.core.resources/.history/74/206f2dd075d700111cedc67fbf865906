<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Discover. Shop. Enjoy.</title>
    <link rel="stylesheet" th:href="@{/css/home.css}">
</head>

<body>
<header class="site-header">
    <div class="header-inner">
        <a class="brand" th:href="@{/}">
            <span class="brand-mark">O</span>
            <span>OneCart</span>
        </a>

        <form class="search-form" th:action="@{/products}" method="get">
            <input type="search" name="keyword"
                   placeholder="Search products, brands, and stores">
            <button type="submit">Search</button>
        </form>

        <nav class="header-actions" aria-label="Main navigation">
            <a th:href="@{/products}">Shop</a>
            <a th:href="@{/wishlist}">Wishlist</a>
            <a th:href="@{/cart}">Cart</a>
            <a class="login-link" th:href="@{/login}">Login</a>
        </nav>
    </div>
</header>

<main>
    <section class="hero">
        <div class="hero-content">
            <p class="eyebrow">A marketplace made for you</p>
            <h1>Discover something<br>you’ll love.</h1>
            <p class="hero-description">
                Explore products from independent stores, all in one place.
            </p>
            <a class="primary-button" th:href="@{/products}">Explore products</a>
        </div>

        <div class="hero-art" aria-hidden="true">
            <div class="hero-circle circle-one"></div>
            <div class="hero-circle circle-two"></div>
            <div class="hero-bag">One<br>Cart</div>
            <span class="hero-sparkle sparkle-one">✦</span>
            <span class="hero-sparkle sparkle-two">✦</span>
        </div>
    </section>

    <section class="category-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Browse by interest</p>
                <h2>Shop categories</h2>
            </div>
            <a class="text-link" th:href="@{/products}">View all products →</a>
        </div>

        <div class="category-list">
            <a class="category-chip" th:href="@{/products(category='Electronics')}">
                <span class="category-icon">⌁</span> Electronics
            </a>
            <a class="category-chip" th:href="@{/products(category='Fashion')}">
                <span class="category-icon">◇</span> Fashion
            </a>
            <a class="category-chip" th:href="@{/products(category='Accessories')}">
                <span class="category-icon">◌</span> Accessories
            </a>
            <a class="category-chip" th:href="@{/products(category='Home & Kitchen')}">
                <span class="category-icon">⌂</span> Home &amp; Kitchen
            </a>
        </div>
    </section>

    <section class="products-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Picked for you</p>
                <h2>Featured products</h2>
            </div>
            <a class="text-link" th:href="@{/products}">See all →</a>
        </div>

        <div class="product-grid" th:if="${products != null and !products.isEmpty()}">
            <article class="product-card" th:each="product : ${products}">
                <div class="product-image-wrap">
                    <span class="discount-badge"
                          th:if="${product.discount != null and product.discount > 0}"
                          th:text="${'-' + product.discount + '%'}">-10%</span>

                    <img class="product-image"
                         th:src="@{${product.name == 'Wireless Headphones' ? '/images/Wireless%20Headphones.png' :
                                    product.name == 'Bluetooth Speaker' ? '/images/Bluetooth%20Speaker.png' :
                                    product.name == 'Smart Watch' ? '/images/Smart%20Watch.webp' :
                                    product.name == 'Cotton T-Shirt' ? '/images/Cotton%20T-Shirt.jpg' :
                                    product.name == 'Travel Backpack' ? '/images/Travel%20back%20pack.jpg' :
                                    product.name == 'Wireless Mouse' ? '/images/Wireless%20Mouse.jpg' :
                                    product.name == 'Running Shoes' ? '/images/Running%20Shoes.jpg' :
                                    product.name == 'Ceramic Coffee Mug' ? '/images/Ceramic%20Coffee%20Mug.jpg' :
                                    '/images/product-placeholder.jpg'}}"
                         th:alt="${product.name}">

                    <button class="wishlist-button" type="button"
                            th:attr="aria-label='Add ' + ${product.name} + ' to wishlist'">
                        ♡
                    </button>
                </div>

                <div class="product-info">
                    <p class="store-name"
                       th:text="${product.storeName != null ? product.storeName : 'OneCart Store'}">
                        OneCart Store
                    </p>

                    <h3 th:text="${product.name}">Product name</h3>

                    <p class="product-category" th:text="${product.category}">
                        Category
                    </p>

                    <div class="price-row">
                        <strong th:text="${'₹' + #numbers.formatDecimal(product.price, 1, 2)}">
                            ₹0.00
                        </strong>

                        <span class="old-price"
                              th:if="${product.originalPrice != null and product.originalPrice > product.price}"
                              th:text="${'₹' + #numbers.formatDecimal(product.originalPrice, 1, 2)}">
                            ₹0.00
                        </span>
                    </div>

                    <button class="add-cart-button" type="button">
                        Add to cart
                    </button>
                </div>
            </article>
        </div>

        <p class="empty-message"
           th:if="${products == null or products.isEmpty()}">
            No products are available right now. Please check back soon.
        </p>
    </section>

    <section class="stores-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Meet the makers</p>
                <h2>Stores to discover</h2>
            </div>
        </div>

        <div class="store-grid" th:if="${vendors != null and !vendors.isEmpty()}">
            <a class="store-card"
               th:each="vendor : ${vendors}"
               th:href="@{/store/{id}(id=${vendor.userId})}">
                <span class="store-avatar"
                      th:text="${#strings.substring(vendor.storeName, 0, 1).toUpperCase()}">S</span>
                <span class="store-card-text">
                    <strong th:text="${vendor.storeName}">Store name</strong>
                    <small>Explore store →</small>
                </span>
            </a>
        </div>

        <p class="empty-message"
           th:if="${vendors == null or vendors.isEmpty()}">
            New stores are joining OneCart soon.
        </p>
    </section>

    <section class="newsletter-section">
        <div>
            <p class="eyebrow">Stay in the loop</p>
            <h2>Good finds, straight to your inbox.</h2>
            <p>Get updates about new products and stores.</p>
        </div>

        <form class="newsletter-form" th:action="@{/newsletter}" method="post">
            <input type="email" name="email" placeholder="Your email address" required>
            <button type="submit">Subscribe</button>
        </form>
    </section>
</main>

<footer class="site-footer">
    <div class="footer-top">
        <div class="footer-brand">
            <a class="brand" th:href="@{/}">
                <span class="brand-mark">O</span>
                <span>OneCart</span>
            </a>
            <p>Discover great products from stores you’ll love.</p>
        </div>

        <div class="footer-links">
            <div>
                <h3>Shop</h3>
                <a th:href="@{/products}">All products</a>
                <a th:href="@{/wishlist}">Wishlist</a>
                <a th:href="@{/cart}">Shopping cart</a>
            </div>
            <div>
                <h3>Account</h3>
                <a th:href="@{/login}">Login</a>
                <a th:href="@{/signup}">Create account</a>
            </div>
            <div>
                <h3>Help</h3>
                <a th:href="@{/contact}">Contact us</a>
                <a th:href="@{/faq}">FAQs</a>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <span>© <span th:text="${#dates.year(#dates.createNow())}">2026</span> OneCart</span>
        <span>Made for better discoveries.</span>
    </div>
</footer>
</body>
</html>