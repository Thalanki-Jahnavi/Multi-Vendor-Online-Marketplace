:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --page-bg: #f6fbf9;
    --white: #ffffff;
    --text: #123e3a;
    --muted: #66817e;
    --border: #d7eae5;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
    background: var(--page-bg);
}

a {
    color: inherit;
    text-decoration: none;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.header-inner {
    width: min(1288px, calc(100% - 48px));
    min-height: 82px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
}

.brand,
.customer-footer__logo {
    color: var(--deep-green);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -1px;
}

.brand span {
    color: var(--emerald);
}

.main-nav {
    display: flex;
    align-items: center;
    gap: 32px;
}

.main-nav a {
    padding: 30px 0 27px;
    color: #42635f;
    font-size: 14px;
    font-weight: 700;
    border-bottom: 3px solid transparent;
}

.main-nav a:hover,
.main-nav a.active {
    color: var(--emerald);
    border-bottom-color: var(--emerald);
}

.logout-form {
    margin: 0;
}

.logout-button {
    padding: 12px 22px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--white);
    color: var(--deep-green);
    font-weight: 700;
    cursor: pointer;
}

.logout-button:hover {
    border-color: var(--emerald);
    color: var(--emerald);
}

.page-content {
    width: min(1288px, calc(100% - 48px));
    margin: 0 auto;
    padding: 28px 0 60px;
}

.welcome-banner {
    min-height: 260px;
    padding: 42px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    overflow: hidden;
    border-radius: 20px;
    background: var(--mint);
}

.welcome-copy {
    max-width: 650px;
}

.eyebrow {
    margin: 0 0 12px;
    color: var(--emerald);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
}

.welcome-copy h1 {
    margin: 0 0 14px;
    color: var(--deep-green);
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.15;
}

.welcome-copy > p:not(.eyebrow) {
    margin: 0 0 26px;
    color: var(--muted);
    line-height: 1.7;
}

.primary-button {
    display: inline-block;
    padding: 13px 22px;
    border-radius: 9px;
    background: var(--emerald);
    color: var(--white);
    font-size: 14px;
    font-weight: 700;
}

.primary-button:hover {
    background: var(--deep-green);
}

.banner-art {
    position: relative;
    flex: 0 0 300px;
    height: 190px;
}

.art-circle {
    position: absolute;
    top: 0;
    right: 22px;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: #bde5dc;
}

.art-note {
    position: absolute;
    padding: 17px 22px;
    border-radius: 12px;
    background: var(--white);
    color: var(--deep-green);
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 12px 30px rgb(18 62 58 / 8%);
}

.note-one {
    top: 40px;
    right: 68px;
    transform: rotate(-4deg);
}

.note-two {
    right: 0;
    bottom: 24px;
    transform: rotate(4deg);
}

.quick-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 22px 0 54px;
}

.quick-card {
    min-height: 96px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
    transition: transform 160ms ease, border-color 160ms ease;
}

.quick-card:hover {
    transform: translateY(-3px);
    border-color: #9ccfc4;
}

.quick-icon {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 25px;
}

.quick-card strong,
.quick-card small {
    display: block;
}

.quick-card strong {
    margin-bottom: 7px;
    font-size: 14px;
}

.quick-card small {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
}

.card-arrow {
    margin-left: auto;
    color: var(--emerald);
    font-size: 24px;
}

.featured-section {
    margin-bottom: 42px;
}

.section-heading {
    margin-bottom: 22px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
}

.section-heading h2 {
    margin: 0 0 8px;
    font-size: 28px;
}

.section-heading > div > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
}

.text-link {
    color: var(--emerald);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
}

.text-link span {
    margin-left: 7px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.product-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
}

.product-image-placeholder {
    min-height: 170px;
    display: grid;
    place-items: center;
    background: var(--mint);
    color: #8abdb2;
    font-size: 24px;
    font-weight: 800;
}

.product-info {
    padding: 18px;
}

.product-info h3 {
    margin: 0 0 12px;
    font-size: 15px;
}

.product-price {
    margin: 0 0 14px;
    color: var(--emerald);
    font-size: 18px;
    font-weight: 800;
}

.product-link {
    color: var(--deep-green);
    font-size: 13px;
    font-weight: 700;
}

.empty-products {
    min-height: 205px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px dashed #b8d9d1;
    border-radius: 18px;
    background: rgb(255 255 255 / 70%);
    text-align: center;
}

.empty-icon,
.success-icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--mint);
    color: var(--emerald);
    font-size: 25px;
}

.empty-products h3 {
    margin: 16px 0 7px;
    font-size: 20px;
}

.empty-products p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
}

.account-note {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--white);
}

.account-note strong {
    font-size: 15px;
}

.account-note p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
}

/* Footer uses the same pale mint background as the dashboard page. */

.customer-footer {
    background: #c7e7df;
    border-top: 1px solid #b5d9d0;
}

.customer-footer__inner {
    width: min(1288px, calc(100% - 48px));
    margin: 0 auto;
    padding: 46px 0 38px;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 36px;
}

.customer-footer__brand p {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 13px;
}

.customer-footer__column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
}

.customer-footer__column h3 {
    margin: 3px 0 4px;
    color: var(--deep-green);
    font-size: 15px;
}

.customer-footer__column a {
    color: var(--muted);
    font-size: 13px;
}

.customer-footer__column a:hover {
    color: var(--emerald);
}

.customer-footer__bottom {
    width: min(1288px, calc(100% - 48px));
    margin: 0 auto;
    padding: 18px 0;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid #cce4dd;
    color: var(--muted);
    font-size: 12px;
}

@media (max-width: 900px) {
    .header-inner {
        flex-wrap: wrap;
        padding: 16px 0;
    }

    .main-nav {
        order: 3;
        width: 100%;
        justify-content: center;
        gap: 22px;
    }

    .main-nav a {
        padding: 12px 0;
    }

    .banner-art {
        flex-basis: 230px;
        transform: scale(.85);
        transform-origin: center right;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .customer-footer__inner {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .header-inner,
    .page-content,
    .customer-footer__inner,
    .customer-footer__bottom {
        width: min(100% - 32px, 1288px);
    }

    .brand {
        font-size: 24px;
    }

    .main-nav {
        justify-content: flex-start;
        gap: 18px;
        overflow-x: auto;
    }

    .main-nav a {
        font-size: 12px;
        white-space: nowrap;
    }

    .welcome-banner {
        padding: 30px 24px;
    }

    .banner-art {
        display: none;
    }

    .quick-links {
        grid-template-columns: 1fr;
        margin-bottom: 42px;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .customer-footer__inner {
        grid-template-columns: 1fr 1fr;
        gap: 30px 20px;
        padding: 36px 0 28px;
    }

    .customer-footer__bottom {
        flex-direction: column;
        gap: 8px;
    }
}