
package com.vendor.controller;

import java.util.Optional;

import org.springframework.security.core.Authentication;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.servlet.mvc.support.RedirectAttributes;

import com.vendor.entity.Product;
import com.vendor.entity.User;
import com.vendor.repository.ProductRepository;
import com.vendor.repository.UserRepository;

@Controller
public class EditProductController {

    private final ProductRepository productRepository;
    private final UserRepository userRepository;

    public EditProductController(
            ProductRepository productRepository,
            UserRepository userRepository) {

        this.productRepository = productRepository;
        this.userRepository = userRepository;
    }

    // Display edit product form
    @GetMapping("/vendor/products/edit/{id}")
    public String showEditProductForm(
            @PathVariable Long id,
            Authentication authentication,
            Model model,
            RedirectAttributes redirectAttributes) {

        User vendor = getLoggedInVendor(authentication);

        if (vendor == null) {
            return "redirect:/login";
        }

        Optional<Product> productOptional = productRepository.findById(id);

        if (productOptional.isEmpty()
                || !vendor.getUserId().equals(
                        productOptional.get().getVendorId())) {

            redirectAttributes.addFlashAttribute(
                    "error",
                    "Product not found or you are not allowed to edit it."
            );

            return "redirect:/vendor/products";
        }

        model.addAttribute("vendor", vendor);
        model.addAttribute("product", productOptional.get());

        return "vendor/edit-product";
    }

    // Update product
    @PostMapping("/vendor/products/edit/{id}")
    public String updateProduct(
            @PathVariable Long id,
            Authentication authentication,
            @RequestParam String productName,
            @RequestParam String category,
            @RequestParam Double price,
            @RequestParam(required = false) Double discountPercentage,
            @RequestParam Integer stockQuantity,
            Model model,
            RedirectAttributes redirectAttributes) {

        User vendor = getLoggedInVendor(authentication);

        if (vendor == null) {
            return "redirect:/login";
        }

        Optional<Product> productOptional = productRepository.findById(id);

        if (productOptional.isEmpty()
                || !vendor.getUserId().equals(
                        productOptional.get().getVendorId())) {

            redirectAttributes.addFlashAttribute(
                    "error",
                    "Product not found or you are not allowed to edit it."
            );

            return "redirect:/vendor/products";
        }

        Product product = productOptional.get();

        // Validate product name
        if (productName == null || productName.isBlank()) {
            return showError(model, vendor, product,
                    "Product name is required.");
        }

        // Validate category
        if (category == null || category.isBlank()) {
            return showError(model, vendor, product,
                    "Please select a category.");
        }

        // Validate price
        if (price == null || !Double.isFinite(price) || price <= 0) {
            return showError(model, vendor, product,
                    "Enter a valid product price.");
        }

        // Validate stock
        if (stockQuantity == null || stockQuantity < 0) {
            return showError(model, vendor, product,
                    "Stock quantity cannot be negative.");
        }

        if (discountPercentage == null) {
            discountPercentage = 0.0;
        }

        // Validate discount
        if (!Double.isFinite(discountPercentage)
                || discountPercentage < 0
                || discountPercentage > 100) {

            return showError(model, vendor, product,
                    "Discount must be between 0 and 100.");
        }

        // Update product details
        product.setProductName(productName.trim());
        product.setCategory(category.trim());
        product.setPrice(price);
        product.setDiscountPercentage(discountPercentage);
        product.setStockQuantity(stockQuantity);

        // Updated products require admin review
        product.setApprovalStatus("PENDING");

        // Save changes
        productRepository.save(product);

        redirectAttributes.addFlashAttribute(
                "success",
                "Product updated successfully. It is waiting for admin approval."
        );

        return "redirect:/vendor/products";
    }

    // Display validation errors
    private String showError(
            Model model,
            User vendor,
            Product product,
            String message) {

        model.addAttribute("vendor", vendor);
        model.addAttribute("product", product);
        model.addAttribute("error", message);

        return "vendor/edit-product";
    }

    // Get logged-in vendor
    private User getLoggedInVendor(Authentication authentication) {

        if (authentication == null
                || !authentication.isAuthenticated()
                || "anonymousUser".equals(authentication.getPrincipal())) {

            return null;
        }

        Optional<User> userOptional =
                userRepository.findByEmail(authentication.getName());

        if (userOptional.isEmpty()) {
            return null;
        }

        User user = userOptional.get();

        if (!"vendor".equalsIgnoreCase(user.getRole())) {
            return null;
        }

        return user;
    }
}
