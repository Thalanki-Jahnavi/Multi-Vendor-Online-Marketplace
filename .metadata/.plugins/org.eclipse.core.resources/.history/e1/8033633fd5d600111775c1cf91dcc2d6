
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OneCart | Your Marketplace</title>

    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>

<!-- Navigation -->
<header class="navbar">
    <a th:href="@{/}" class="logo">One<span>Cart</span></a>

    <nav class="nav-links">
        <a th:href="@{/}" class="active">Home</a>
        <a th:href="@{/about}">About</a>
        <a th:href="@{/contact}">Contact</a>
    </nav>

    <div class="nav-actions">
        <a th:href="@{/login}" class="login-btn">Login</a>
        <a th:href="@{/signup}" class="signup-btn">Sign Up</a>
    </div>
</header>

<main>

    <!-- Shopping banner -->
    <section class="hero">
        <div class="hero-content">
            <span class="eyebrow">WELCOME TO ONECART</span>

            <h1>Discover your<br>
                next favorite thing.</h1>

            <p>
                Explore amazing products from independent
                sellers and find everything you love
                in one convenient marketplace.
            </p>

            <a th:href="@{/signup}" class="primary-btn">
                Start Shopping →
            </a>

            <div class="hero-features">
                <span>✓ Multiple sellers</span>
                <span>✓ Easy shopping</span>
                <span>✓ One marketplace</span>
            </div>
        </div>

        <div class="hero-image">
            <img
                src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&amp;fit=crop&amp;w=1000&amp;q=85"
                alt="Beautiful modern shopping boutique">
        </div>
    </section>

    <!-- Categories -->
    <section class="section">
        <div class="section-heading">
            <div>
                <span class="eyebrow">EXPLORE OUR COLLECTION</span>
                <h2>Shop by Category</h2>
                <p>Find something you'll love.</p>
            </div>
        </div>

        <div class="category-grid">

            <a th:href="@{/signup}" class="category-card">
                <img
                    src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                    alt="Fashion clothing">
                <div class="category-info">
                    <h3>Fashion</h3>
                    <span>Explore collection →</span>
                </div>
            </a>

            <a th:href="@{/signup}" class="category-card">
                <img
                    src="https://images.unsplash.com/photo-1498049794561-7780e7231661?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                    alt="Electronic devices">
                <div class="category-info">
                    <h3>Electronics</h3>
                    <span>Explore collection →</span>
                </div>
            </a>

            <a th:href="@{/signup}" class="category-card">
                <img
                    src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                    alt="Modern home interior">
                <div class="category-info">
                    <h3>Home & Living</h3>
                    <span>Explore collection →</span>
                </div>
            </a>

            <a th:href="@{/signup}" class="category-card">
                <img
                    src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                    alt="Beauty and skincare products">
                <div class="category-info">
                    <h3>Beauty</h3>
                    <span>Explore collection →</span>
                </div>
            </a>

        </div>
    </section>

    <!-- Featured products -->
    <section class="section featured-section">
        <div class="section-heading">
            <div>
                <span class="eyebrow">HANDPICKED FOR YOU</span>
                <h2>Featured Products</h2>
                <p>Discover products worth adding to your cart.</p>
            </div>
        </div>

        <div class="product-grid">

            <article class="product-card">
                <div class="product-image">
                    <img
                        src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                        alt="Red sports sneakers">
                    <span class="product-label">Popular</span>
                </div>
                <div class="product-info">
                    <p class="product-category">Fashion</p>
                    <h3>Everyday Sneakers</h3>
                    <p class="price">₹1,499</p>
                    <a th:href="@{/signup}" class="product-btn">
                        View Product
                    </a>
                </div>
            </article>

            <article class="product-card">
                <div class="product-image">
                    <img
                        src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                        alt="Wireless headphones">
                    <span class="product-label">Featured</span>
                </div>
                <div class="product-info">
                    <p class="product-category">Electronics</p>
                    <h3>Wireless Headphones</h3>
                    <p class="price">₹1,999</p>
                    <a th:href="@{/signup}" class="product-btn">
                        View Product
                    </a>
                </div>
            </article>

            <article class="product-card">
                <div class="product-image">
                    <img
                        src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                        alt="Classic wristwatch">
                    <span class="product-label">Popular</span>
                </div>
                <div class="product-info">
                    <p class="product-category">Accessories</p>
                    <h3>Classic Wristwatch</h3>
                    <p class="price">₹2,499</p>
                    <a th:href="@{/signup}" class="product-btn">
                        View Product
                    </a>
                </div>
            </article>

            <article class="product-card">
                <div class="product-image">
                    <img
                        src="https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                        alt="Elegant women's footwear">
                    <span class="product-label">New</span>
                </div>
                <div class="product-info">
                    <p class="product-category">Fashion</p>
                    <h3>Elegant Footwear</h3>
                    <p class="price">₹1,799</p>
                    <a th:href="@{/signup}" class="product-btn">
                        View Product
                    </a>
                </div>
            </article>

        </div>
    </section>

    <!-- Vendor section -->
    <section class="vendor-section">
        <div class="vendor-content">
            <span class="eyebrow">MEET OUR SELLERS</span>
            <h2>Great products.<br>Independent sellers.</h2>
            <p>
                Discover unique collections from different
                vendors and support businesses of all sizes.
            </p>

            <a th:href="@{/signup}" class="primary-btn">
                Become a Seller →
            </a>
        </div>

        <div class="vendor-image">
            <img
                src="https://images.unsplash.com/photo-1555529669-e69e7aa0ba9a?auto=format&amp;fit=crop&amp;w=900&amp;q=85"
                alt="Clothing store with products on display">
        </div>
    </section>

    <!-- Popular vendors -->
    <section class="section">
        <div class="section-heading">
            <div>
                <span class="eyebrow">SHOP FROM DIFFERENT SELLERS</span>
                <h2>Meet Our Vendors</h2>
                <p>Every seller brings something special to OneCart.</p>
            </div>
        </div>

        <div class="vendor-grid">

            <article class="vendor-card">
                <img
                    src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                    alt="Fashion boutique interior">
                <div class="vendor-card-info">
                    <h3>Fashion Boutique</h3>
                    <p>Clothing & Accessories</p>
                    <a th:href="@{/signup}">Explore Store →</a>
                </div>
            </article>

            <article class="vendor-card">
                <img
                    src="https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                    alt="Home decor store">
                <div class="vendor-card-info">
                    <h3>Home Essentials</h3>
                    <p>Home & Lifestyle</p>
                    <a th:href="@{/signup}">Explore Store →</a>
                </div>
            </article>

            <article class="vendor-card">
                <img
                    src="https://images.unsplash.com/photo-1528698827591-e19ccd7bc23d?auto=format&amp;fit=crop&amp;w=600&amp;q=80"
                    alt="Beauty products in a boutique">
                <div class="vendor-card-info">
                    <h3>Beauty Corner</h3>
                    <p>Beauty & Personal Care</p>
                    <a th:href="@{/signup}">Explore Store →</a>
                </div>
            </article>

        </div>
    </section>

    <!-- Seller call to action -->
    <section class="seller-banner">
        <div>
            <span class="eyebrow">YOUR BUSINESS, OUR MARKETPLACE</span>
            <h2>Ready to start selling?</h2>
            <p>Bring your products to OneCart and reach more customers.</p>
        </div>

        <a th:href="@{/signup}" class="primary-btn">
            Register as Vendor →
        </a>
    </section>

</main>

<!-- Footer -->
<footer class="footer">
    <div class="footer-main">

        <div class="footer-brand">
            <a th:href="@{/}" class="logo">One<span>Cart</span></a>
            <p>
                One marketplace. Multiple sellers.
                Endless possibilities.
            </p>
        </div>

        <div class="footer-links">
            <h4>Explore</h4>
            <a th:href="@{/}">Home</a>
            <a th:href="@{/about}">About Us</a>
            <a th:href="@{/contact}">Contact Us</a>
        </div>

        <div class="footer-links">
            <h4>Account</h4>
            <a th:href="@{/login}">Login</a>
            <a th:href="@{/signup}">Create Account</a>
        </div>

        <div class="footer-links">
            <h4>For Sellers</h4>
            <a th:href="@{/signup}">Become a Vendor</a>
        </div>

    </div>

    <div class="footer-bottom">
        <p>© 2026 OneCart. All rights reserved.</p>
        <p>OneCart — Your marketplace, your choice.</p>
    </div>
</footer>

</body>
</html>
