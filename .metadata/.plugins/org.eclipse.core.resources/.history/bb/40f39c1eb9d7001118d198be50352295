<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | OneCart</title>
    <link rel="stylesheet" th:href="@{/css/about.css}">
</head>
<body>

    <div class="topbar">
        Discover products from multiple vendors in one place
    </div>

    <header class="header">
        <a class="logo" th:href="@{/}">OneCart</a>

        <nav class="header-links">
            <a th:href="@{/login}">Login</a>
            <a th:href="@{/signup}">Sign up</a>
        </nav>
    </header>

    <nav class="nav">
        <a th:href="@{/}">Home</a>
        <a th:href="@{/shop}">Shop</a>
        <a class="active" th:href="@{/about}">About Us</a>
        <a th:href="@{/contact}">Contact</a>
    </nav>

    <main>
        <section class="about-hero">
            <p class="eyebrow">ABOUT ONECART</p>
            <h1>One marketplace.<br>Many stores. More choices.</h1>
            <p class="hero-text">
                OneCart brings products from multiple vendors together,
                making it easier to discover items and shop in one convenient place.
            </p>
            <a class="primary-button" th:href="@{/shop}">Explore Products</a>
        </section>

        <section class="about-section">
            <div class="section-heading">
                <p class="eyebrow">OUR PURPOSE</p>
                <h2>Shopping made simpler</h2>
                <p>
                    We want customers to discover products from different stores
                    without having to visit each store separately.
                </p>
            </div>

            <div class="feature-grid">
                <article class="feature-card">
                    <div class="feature-icon">⌕</div>
                    <h3>Discover</h3>
                    <p>Explore products from multiple vendors in one place.</p>
                </article>

                <article class="feature-card">
                    <div class="feature-icon">◇</div>
                    <h3>Compare</h3>
                    <p>Review your options and choose what suits your needs.</p>
                </article>

                <article class="feature-card">
                    <div class="feature-icon">♡</div>
                    <h3>Shop</h3>
                    <p>Find items you love through a simple marketplace experience.</p>
                </article>
            </div>
        </section>

        <section class="vendor-section">
            <div class="vendor-content">
                <p class="eyebrow">FOR VENDORS</p>
                <h2>Bring your store to OneCart</h2>
                <p>
                    OneCart gives vendors a place to showcase their products
                    and reach customers shopping across the marketplace.
                </p>
                <a class="primary-button" th:href="@{/signup}">Join as a Vendor</a>
            </div>

            <div class="vendor-art" aria-hidden="true">
                <div class="store-card store-card-back">
                    <span>YOUR STORE</span>
                </div>
                <div class="store-card store-card-front">
                    <div class="store-awning"></div>
                    <div class="store-window"></div>
                    <strong>OneCart</strong>
                    <small>Many vendors. One marketplace.</small>
                </div>
            </div>
        </section>

        <section class="values-section">
            <p class="eyebrow">WHAT MATTERS TO US</p>
            <h2>Built around a better shopping experience</h2>

            <div class="values-grid">
                <div>
                    <h3>Choice</h3>
                    <p>Products from different vendors, brought together.</p>
                </div>
                <div>
                    <h3>Convenience</h3>
                    <p>A single place to browse and discover products.</p>
                </div>
                <div>
                    <h3>Opportunity</h3>
                    <p>A marketplace where vendors can present their products.</p>
                </div>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-main">
            <div class="footer-brand">
                <a class="footer-logo" th:href="@{/}">OneCart</a>
                <p>Shop smarter, all in one place.</p>
            </div>

            <div class="footer-column">
                <h3>Explore</h3>
                <a th:href="@{/}">Home</a>
                <a th:href="@{/shop}">Shop</a>
                <a th:href="@{/about}">About Us</a>
            </div>

            <div class="footer-column">
                <h3>Account</h3>
                <a th:href="@{/login}">Login</a>
                <a th:href="@{/signup}">Sign up</a>
            </div>

            <div class="footer-column">
                <h3>Help</h3>
                <a th:href="@{/contact}">Contact Us</a>
            </div>
        </div>

        <div class="footer-bottom">
            <span>© 2026 OneCart. All rights reserved.</span>
            <span>Shop smarter, all in one place.</span>
        </div>
    </footer>

</body>
</html>