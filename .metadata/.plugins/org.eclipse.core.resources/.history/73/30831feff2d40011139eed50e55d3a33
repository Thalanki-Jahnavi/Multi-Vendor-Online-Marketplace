<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | OneCart</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .signup-page {
            min-height: calc(100vh - 78px);
            display: grid;
            place-items: center;
            padding: 48px 20px;
            background: var(--mint-light);
        }

        .signup-card {
            width: min(100%, 480px);
            padding: 36px;
            border: 1px solid var(--border);
            border-radius: 18px;
            background: var(--white);
            box-shadow: var(--shadow);
        }

        .signup-card h1 {
            margin-bottom: 8px;
            color: var(--deep-green);
        }

        .signup-card > p {
            margin-bottom: 24px;
            color: var(--muted);
            font-size: 14px;
        }

        .form-field {
            margin-bottom: 17px;
        }

        .form-field label {
            display: block;
            margin-bottom: 7px;
            color: var(--deep-green);
            font-size: 13px;
            font-weight: 700;
        }

        .form-field input,
        .form-field select {
            width: 100%;
            min-height: 45px;
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: white;
        }

        .form-field input:focus,
        .form-field select:focus {
            outline: 2px solid var(--mint);
            border-color: var(--emerald);
        }

        .signup-card .button {
            width: 100%;
            margin-top: 5px;
        }

        .form-footer {
            margin-top: 20px;
            text-align: center;
            font-size: 13px;
        }

        .form-footer a {
            color: var(--emerald);
            font-weight: 700;
        }

        @media (max-width: 500px) {
            .signup-card {
                padding: 25px 20px;
            }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <a class="logo" href="/guest/index.html">One<span>Cart</span></a>
        <nav class="nav-links">
            <a href="/guest/index.html">Home</a>
            <a href="/guest/about.html">About</a>
            <a href="/guest/contact.html">Contact</a>
        </nav>
        <div class="header-actions">
            <a class="login-link" href="/guest/login.html">Login</a>
        </div>
    </header>

    <main class="signup-page">
        <form class="signup-card" id="signupForm">
            <h1>Create your account</h1>
            <p>Join OneCart to shop from multiple vendors in one place.</p>

            <div class="form-field">
                <label for="fullName">Full name</label>
                <input id="fullName" name="fullName" type="text"
                       autocomplete="name" required>
            </div>

            <div class="form-field">
                <label for="email">Email address</label>
                <input id="email" name="email" type="email"
                       autocomplete="email" required>
            </div>

            <div class="form-field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password"
                       autocomplete="new-password" minlength="8" required>
            </div>

            <div class="form-field">
                <label for="confirmPassword">Confirm password</label>
                <input id="confirmPassword" name="confirmPassword"
                       type="password" autocomplete="new-password"
                       minlength="8" required>
            </div>

            <div class="form-field">
                <label for="accountType">Account type</label>
                <select id="accountType" name="accountType" required>
                    <option value="CUSTOMER">Customer</option>
                    <option value="VENDOR">Vendor</option>
                </select>
            </div>

            <button class="button" type="submit">Create Account</button>

            <div class="form-footer">
                Already have an account?
                <a href="/guest/login.html">Log in</a>
            </div>
        </form>
    </main>

    <script>
        document.getElementById("signupForm").addEventListener("submit", function (event) {
            event.preventDefault();

            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            if (password !== confirmPassword) {
                alert("Passwords do not match. Please try again.");
                return;
            }

            alert("The signup page is ready. Account creation will be connected to the backend later.");
        });
    </script>
</body>
</html>