<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Home</title>
    <link rel="stylesheet" th:href="@{/css/home.css}">
</head>

<body>

    <div class="topbar">
        Discover products from multiple vendors in one place
    </div>

    <header class="header">
        <a class="logo" th:href="@{/}">OneCart</a>

        <form class="search-form" th:action="@{/shop}" method="get">
            <input
                type="search"
                name="q"
                placeholder="Search products..."
                aria-label="Search products">
            <button type="submit">Search</button>
        </form>

        <div class="header-links">
            <a th:href="@{/login}">Login</a>
            <a th:href="@{/signup}">Sign up</a>
        </div>
    </header>

    <nav class="navigation">
        <a th:href="@{/}">Home</a>
        <a th:href="@{/shop}">Shop</a>
        <a th:href="@{/about}">About Us</a>
        <a th:href="@{/contact}">Contact</a>
    </nav>

    <main>
        <section class="hero">
            <div class="hero-content">
                <p class="eyebrow">WELCOME TO ONECART</p>
                <h1>Find something you’ll love.</h1>
                <p class="hero-description">
                    Explore products from different vendors, compare your favorites,
                    and shop from one convenient marketplace.
                </p>
                <a class="primary-button" th:href="@{/shop}">
                    Explore Products
                </a>
            </div>
        </section>

        <section class="featured-section">
            <div class="section-heading">
                <h2>Featured Products</h2>
                <p>Discover items available in the OneCart marketplace.</p>
            </div>

            <div class="product-grid" th:if="${products != null and !products.isEmpty()}">
                <article class="product-card" th:each="product : ${products}">
                    <div class="product-image-placeholder">
                        <span>OneCart Product</span>
                    </div>

                    <div class="product-details">
                        <h3 th:text="${product.productName}">Product name</h3>

                        <p class="product-price">
                            ₹<span th:text="${#numbers.formatDecimal(product.discountedPrice, 1, 2)}">
                                0.00
                            </span>
                        </p>
                    </div>
                </article>
            </div>

            <div class="empty-products" th:if="${products == null or products.isEmpty()}">
                <h3>No featured products yet</h3>
                <p>Products will appear here when vendors add active, approved items.</p>
            </div>
        </section>

        <section class="vendors-section">
            <div class="section-heading">
                <h2>Discover Our Vendors</h2>
                <p>Shop from different sellers, all in one place.</p>
            </div>

            <div class="vendor-grid">
                <article class="vendor-card">
                    <div class="vendor-icon">01</div>
                    <h3>Fashion & Style</h3>
                    <p>Explore clothing, footwear, and everyday accessories.</p>
                    <a th:href="@{/shop}">Explore products</a>
                </article>

                <article class="vendor-card">
                    <div class="vendor-icon">02</div>
                    <h3>Home & Living</h3>
                    <p>Find useful pieces for your home and daily routine.</p>
                    <a th:href="@{/shop}">Explore products</a>
                </article>

                <article class="vendor-card">
                    <div class="vendor-icon">03</div>
                    <h3>Electronics</h3>
                    <p>Browse gadgets and accessories from marketplace sellers.</p>
                    <a th:href="@{/shop}">Explore products</a>
                </article>
            </div>

            <div class="vendor-cta">
                <div>
                    <h3>Have a business to share?</h3>
                    <p>Join OneCart and showcase your products to more customers.</p>
                </div>
                <a class="primary-button" th:href="@{/signup}">Become a Vendor</a>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-brand">
                <a class="footer-logo" th:href="@{/}">OneCart</a>
                <p>Shop smarter, all in one place.</p>
            </div>

            <div class="footer-column">
                <h3>Explore</h3>
                <a th:href="@{/}">Home</a>
                <a th:href="@{/shop}">Shop Products</a>
                <a th:href="@{/signup}">Become a Vendor</a>
            </div>

            <div class="footer-column">
                <h3>About OneCart</h3>
                <a th:href="@{/about}">About Us</a>
                <a th:href="@{/contact}">Contact Us</a>
            </div>

            <div class="footer-column">
                <h3>Help</h3>
                <a th:href="@{/login}">My Account</a>
                <a th:href="@{/contact}">Customer Support</a>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 OneCart. All rights reserved.</p>
            <p>Shop from multiple vendors with confidence.</p>
        </div>
    </footer>

</body>
</html>