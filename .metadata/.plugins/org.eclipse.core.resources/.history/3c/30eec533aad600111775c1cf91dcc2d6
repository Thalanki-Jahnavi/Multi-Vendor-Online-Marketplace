/* =========================
   OneCart - Guest Home Page
   Emerald & Mint theme
   ========================= */

:root {
    --emerald: #087e78;
    --emerald-dark: #05645f;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --mint-light: #f2faf7;
    --white: #ffffff;
    --soft-grey: #f5f7f6;
    --text: #263b38;
    --muted: #6d7e7a;
    --border: #e1e9e6;
    --shadow: 0 12px 32px rgba(18, 62, 58, 0.08);
    --radius: 18px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
    background: var(--white);
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

button {
    cursor: pointer;
}

img {
    display: block;
    max-width: 100%;
}

[hidden] {
    display: none !important;
}

/* Header */

.site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-height: 78px;
    padding: 14px 7%;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
}

.logo {
    flex-shrink: 0;
    color: var(--deep-green);
    font-size: 27px;
    font-weight: 800;
    letter-spacing: -1.2px;
}

.logo span {
    color: var(--emerald);
}

.nav-links,
.header-actions {
    display: flex;
    align-items: center;
    gap: 28px;
}

.nav-links a,
.login-link {
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
    transition: color 0.2s ease;
}

.nav-links a:hover,
.nav-links a.active,
.login-link:hover {
    color: var(--emerald);
}

.header-actions {
    gap: 20px;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid var(--emerald);
    border-radius: 10px;
    background: var(--emerald);
    color: var(--white);
    font-size: 14px;
    font-weight: 700;
    transition: background 0.2s ease, transform 0.2s ease;
}

.button:hover {
    background: var(--emerald-dark);
    transform: translateY(-2px);
}

.button-small {
    min-height: 40px;
    padding: 9px 18px;
}

.menu-toggle {
    display: none;
    border: 0;
    background: transparent;
    color: var(--deep-green);
    font-size: 26px;
}

/* Hero */

.hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 40px;
    min-height: 500px;
    padding: 70px 10%;
    overflow: hidden;
    background: linear-gradient(110deg, var(--mint-light), #ffffff 70%);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 600px;
}

.eyebrow {
    margin-bottom: 12px;
    color: var(--emerald);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

.hero h1 {
    color: var(--deep-green);
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1.1;
    letter-spacing: -2px;
}

.hero h1 span {
    color: var(--emerald);
}

.hero-description {
    max-width: 480px;
    margin: 22px 0 28px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.8;
}

.hero-art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 330px;
}

.art-circle {
    position: absolute;
    width: min(32vw, 350px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #d5eee6;
}

.shopping-bag {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    box-shadow: 0 20px 45px rgba(18, 62, 58, 0.13);
}

.bag-back {
    width: 145px;
    height: 175px;
    margin: -35px 0 0 105px;
    background: #a6d9ca;
    color: var(--emerald);
    font-size: 45px;
    transform: rotate(12deg);
}

.bag-front {
    flex-direction: column;
    width: 175px;
    height: 205px;
    margin: 35px 70px 0 0;
    background: var(--emerald);
    color: var(--white);
    font-size: 27px;
    transform: rotate(-8deg);
}

.bag-front::before {
    position: absolute;
    top: -35px;
    width: 70px;
    height: 55px;
    border: 9px solid var(--emerald);
    border-bottom: 0;
    border-radius: 35px 35px 0 0;
    content: "";
}

.bag-front strong {
    font-size: 34px;
}

.floating-tag {
    position: absolute;
    right: 0;
    bottom: 30px;
    padding: 12px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--white);
    color: var(--deep-green);
    box-shadow: var(--shadow);
    font-size: 12px;
    font-weight: 700;
}

/* Shared section layout */

.section {
    width: min(1120px, 86%);
    margin: 0 auto;
}

.categories-section,
.featured-section {
    padding-top: 76px;
    padding-bottom: 76px;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 30px;
}

.section-heading h2,
.seller-banner h2 {
    color: var(--deep-green);
    font-size: clamp(27px, 3vw, 36px);
    line-height: 1.2;
    letter-spacing: -1px;
}

.section-note {
    color: var(--muted);
    font-size: 14px;
}

/* Categories */

.category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.category-card {
    display: flex;
    align-items: center;
    gap: 15px;
    min-height: 100px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--deep-green);
    font-size: 14px;
    font-weight: 700;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.category-card:hover {
    transform: translateY(-4px);
    border-color: #b8ded3;
    box-shadow: var(--shadow);
}

.category-icon {
    display: grid;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 14px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 27px;
}

/* Featured products */

.search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(280px, 100%);
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--muted);
}

.search-box span {
    font-size: 25px;
}

.search-box input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-size: 13px;
}

.filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 25px;
}

.filter-button {
    padding: 9px 17px;
    border: 1px solid var(--border);
    border-radius: 30px;
    background: var(--white);
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
    transition: background 0.2s ease, color 0.2s ease;
}

.filter-button:hover,
.filter-button.active {
    border-color: var(--emerald);
    background: var(--emerald);
    color: var(--white);
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.product-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
}

.product-image {
    position: relative;
    display: grid;
    min-height: 210px;
    place-items: center;
    overflow: hidden;
}

.product-image-one {
    background: #e8f1f8;
}

.product-image-two {
    background: #f6eae2;
}

.product-image-three {
    background: #e9f0e3;
}

.product-image-four {
    background: #f5e8ee;
}

.product-emoji {
    font-size: 76px;
    filter: drop-shadow(0 12px 8px rgba(0, 0, 0, 0.08));
    transition: transform 0.25s ease;
}

.product-card:hover .product-emoji {
    transform: scale(1.08) rotate(-3deg);
}

.product-badge {
    position: absolute;
    top: 13px;
    left: 13px;
    padding: 5px 10px;
    border-radius: 20px;
    background: var(--white);
    color: var(--emerald);
    font-size: 10px;
    font-weight: 800;
}

.product-info {
    padding: 18px;
}

.product-category {
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

.product-info h3 {
    min-height: 44px;
    color: var(--deep-green);
    font-size: 15px;
}

.product-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 15px;
}

.product-bottom strong {
    color: var(--deep-green);
    font-size: 17px;
}

.add-button {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 0;
    border-radius: 10px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 25px;
    line-height: 1;
    transition: background 0.2s ease, color 0.2s ease;
}

.add-button:hover {
    background: var(--emerald);
    color: var(--white);
}

.demo-note,
.empty-message {
    margin-top: 22px;
    color: var(--muted);
    font-size: 12px;
    text-align: center;
}

/* Benefits */

.benefits-section {
    padding: 70px 0;
    background: var(--mint-light);
}

.benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.benefit {
    padding: 25px;
    border: 1px solid #e2efea;
    border-radius: var(--radius);
    background: var(--white);
}

.benefit-icon {
    display: grid;
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    place-items: center;
    border-radius: 13px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 24px;
}

.benefit h3 {
    margin-bottom: 8px;
    color: var(--deep-green);
    font-size: 17px;
}

.benefit p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}

/* Seller banner */

.seller-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    width: min(1120px, 86%);
    margin: 76px auto;
    padding: 42px 48px;
    border-radius: 22px;
    background: var(--deep-green);
    color: var(--white);
}

.seller-banner .eyebrow {
    color: #a9dfd1;
}

.seller-banner h2 {
    margin-bottom: 10px;
    color: var(--white);
}

.seller-banner p:not(.eyebrow) {
    color: #d4e7e2;
    font-size: 14px;
}

.button-light {
    flex-shrink: 0;
    border-color: var(--white);
    background: var(--white);
    color: var(--deep-green);
}

.button-light:hover {
    border-color: var(--mint);
    background: var(--mint);
    color: var(--deep-green);
}

/* Footer */

.site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 42px 7% 28px;
    border-top: 1px solid var(--border);
    background: var(--white);
    text-align: center;
}

.footer-logo {
    font-size: 25px;
}

.site-footer > p {
    color: var(--muted);
    font-size: 13px;
}

.footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin: 5px 0;
}

.footer-links a {
    color: var(--muted);
    font-size: 13px;
}

.footer-links a:hover {
    color: var(--emerald);
}

.site-footer small {
    color: #8a9995;
    font-size: 11px;
}

/* Responsive layout */

@media (max-width: 900px) {
    .site-header {
        gap: 18px;
        padding-right: 5%;
        padding-left: 5%;
    }

    .nav-links,
    .header-actions {
        gap: 16px;
    }

    .hero {
        padding-right: 7%;
        padding-left: 7%;
    }

    .category-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-image {
        min-height: 190px;
    }
}

@media (max-width: 650px) {
    .site-header {
        min-height: 68px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .menu-toggle {
        display: block;
        order: 3;
    }

    .nav-links {
        display: none;
        order: 4;
        flex-basis: 100%;
        align-items: flex-start;
        flex-direction: column;
        gap: 0;
        padding: 8px 0;
    }

    .nav-links.open {
        display: flex;
    }

    .nav-links a {
        width: 100%;
        padding: 11px 0;
    }

    .header-actions {
        margin-left: auto;
        gap: 12px;
    }

    .login-link {
        font-size: 13px;
    }

    .button-small {
        min-height: 36px;
        padding: 7px 12px;
        font-size: 12px;
    }

    .hero {
        grid-template-columns: 1fr;
        gap: 10px;
        padding: 55px 7% 35px;
    }

    .hero h1 {
        font-size: clamp(37px, 10vw, 52px);
    }

    .hero-art {
        min-height: 280px;
    }

    .art-circle {
        width: 250px;
    }

    .bag-front {
        width: 145px;
        height: 175px;
        margin-right: 50px;
        font-size: 22px;
    }

    .bag-front strong {
        font-size: 28px;
    }

    .bag-back {
        width: 120px;
        height: 145px;
        margin-left: 85px;
    }

    .floating-tag {
        right: 2%;
        bottom: 10px;
    }

    .section {
        width: 88%;
    }

    .categories-section,
    .featured-section {
        padding-top: 55px;
        padding-bottom: 55px;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 18px;
    }

    .search-box {
        width: 100%;
    }

    .category-grid {
        gap: 12px;
    }

    .category-card {
        min-height: 85px;
        gap: 10px;
        padding: 13px;
        font-size: 12px;
    }

    .category-icon {
        width: 38px;
        height: 38px;
        font-size: 22px;
    }

    .product-grid {
        gap: 12px;
    }

    .product-image {
        min-height: 145px;
    }

    .product-emoji {
        font-size: 55px;
    }

    .product-info {
        padding: 13px;
    }

    .product-info h3 {
        font-size: 13px;
    }

    .product-bottom strong {
        font-size: 15px;
    }

    .benefits-section {
        padding: 55px 0;
    }

    .benefit-grid {
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .seller-banner {
        align-items: flex-start;
        flex-direction: column;
        width: 88%;
        margin: 55px auto;
        padding: 30px 25px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}