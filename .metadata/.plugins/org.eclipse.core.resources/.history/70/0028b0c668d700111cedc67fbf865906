:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --text: #203331;
    --muted: #71817e;
    --border: #dce7e4;
    --white: #ffffff;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
    background:
        radial-gradient(circle at 15% 15%, #d8f0e9 0, transparent 32%),
        linear-gradient(135deg, #f7fbf9, #edf7f3);
}

.topbar {
    min-height: 76px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(18, 62, 58, 0.08);
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--deep-green);
    font-size: 23px;
    font-weight: 800;
    text-decoration: none;
}

.brand-mark {
    width: 35px;
    height: 35px;
    display: grid;
    place-items: center;
    color: var(--white);
    background: var(--emerald);
    border-radius: 11px;
}

.back-link {
    color: var(--deep-green);
    font-size: 14px;
    text-decoration: none;
}

.back-link:hover,
.signup-prompt a:hover {
    text-decoration: underline;
}

.page {
    min-height: calc(100vh - 76px);
    padding: 48px 20px 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.login-card {
    width: 100%;
    max-width: 440px;
    padding: 38px;
    background: var(--white);
    border: 1px solid rgba(18, 62, 58, 0.08);
    border-radius: 20px;
    box-shadow: 0 18px 55px rgba(18, 62, 58, 0.10);
}

.card-heading {
    margin-bottom: 28px;
    text-align: center;
}

.eyebrow {
    margin: 0 0 10px;
    color: var(--emerald);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
}

h1 {
    margin: 0;
    color: var(--deep-green);
    font-size: 28px;
    line-height: 1.25;
}

.subtitle {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
}

form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

label {
    color: var(--deep-green);
    font-size: 13px;
    font-weight: 700;
}

input {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    color: var(--text);
    background: #fbfdfc;
    border: 1px solid var(--border);
    border-radius: 9px;
    outline: none;
    font: inherit;
    font-size: 14px;
}

input:focus {
    border-color: var(--emerald);
    box-shadow: 0 0 0 3px rgba(8, 126, 120, 0.12);
}

.password-label {
    margin-top: 10px;
}

.password-field {
    position: relative;
}

.password-field input {
    padding-right: 68px;
}

.toggle-password {
    position: absolute;
    top: 50%;
    right: 12px;
    padding: 5px;
    transform: translateY(-50%);
    color: var(--emerald);
    background: transparent;
    border: 0;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
}

.submit-button {
    height: 49px;
    margin-top: 12px;
    color: var(--white);
    background: var(--emerald);
    border: 0;
    border-radius: 9px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 700;
    transition: background 0.2s, transform 0.2s;
}

.submit-button:hover {
    background: var(--deep-green);
    transform: translateY(-1px);
}

.signup-prompt {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
}

.signup-prompt a {
    color: var(--emerald);
    font-weight: 700;
    text-decoration: none;
}

.message {
    margin-bottom: 18px;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.4;
}

.error {
    color: #9b2828;
    background: #fff0f0;
    border: 1px solid #f3cccc;
}

.success {
    color: #176a46;
    background: #edf9f1;
    border: 1px solid #c9ead5;
}

.page-note {
    margin: 22px 0 0;
    color: #81918d;
    font-size: 12px;
    text-align: center;
}

@media (max-width: 520px) {
    .topbar {
        min-height: 66px;
        padding: 0 20px;
    }

    .brand {
        font-size: 20px;
    }

    .page {
        min-height: calc(100vh - 66px);
        padding: 28px 14px;
    }

    .login-card {
        padding: 28px 22px;
    }

    h1 {
        font-size: 25px;
    }
}