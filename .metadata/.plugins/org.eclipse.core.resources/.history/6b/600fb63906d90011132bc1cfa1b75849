:root {
    --emerald: #087e78;
    --emerald-dark: #066963;
    --emerald-light: #e5f4f0;
    --deep-green: #123e3a;
    --mint: #eaf7f4;
    --page-bg: #f5fbf9;
    --card-bg: #ffffff;
    --text: #173d39;
    --text-muted: #5e7a76;
    --border: #d4eae4;
    --danger: #e53935;
    --warning: #f59e0b;
    --shadow-sm: 0 2px 8px rgba(18, 62, 58, 0.05);
    --shadow-md: 0 6px 20px rgba(18, 62, 58, 0.08);
    --shadow-lg: 0 12px 32px rgba(18, 62, 58, 0.12);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 18px;
    --radius-full: 9999px;
    --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--page-bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.5;
}

a {
    color: inherit;
    text-decoration: none;
}

/* ==========================================================================
   Header & Navigation
   ========================================================================== */
.site-header {
    position: sticky;
    top: 0;
    z-index: 900;
    min-height: 74px;
    padding: 0 4%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
}

.brand {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--deep-green);
    display: inline-flex;
    align-items: center;
    gap: 2px;
}

.brand span {
    color: var(--emerald);
}

.main-nav {
    display: flex;
    align-items: center;
    gap: 24px;
}

.main-nav a {
    padding: 24px 0 22px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 3px solid transparent;
    transition: var(--transition);
}

.main-nav a:hover {
    color: var(--emerald);
}

.main-nav a.active {
    color: var(--emerald);
    border-bottom-color: var(--emerald);
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 14px;
}

.user-greeting {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    background: var(--emerald-light);
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 600;
    color: var(--deep-green);
}

.user-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--emerald);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 700;
}

.action-pill-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--deep-green);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
}

.action-pill-btn:hover {
    border-color: var(--emerald);
    background: var(--emerald-light);
}

.action-pill-btn.cart-btn-primary {
    background: var(--emerald);
    color: #fff;
    border-color: var(--emerald);
}

.action-pill-btn.cart-btn-primary:hover {
    background: var(--emerald-dark);
}

.badge-count {
    display: none;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    background: var(--danger);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    align-items: center;
    justify-content: center;
    line-height: 1;
}

.cart-btn-primary .badge-count {
    background: #fff;
    color: var(--emerald);
}

.sign-out {
    padding: 8px 16px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
}

.sign-out:hover {
    color: var(--danger);
    border-color: var(--danger);
}

/* ==========================================================================
   Page Layout
   ========================================================================== */
.page {
    max-width: 1440px;
    margin: 0 auto;
    padding: 24px 28px 60px;
}

.breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-size: 13px;
    color: var(--text-muted);
}

.breadcrumb a {
    color: var(--emerald);
    font-weight: 500;
}

.breadcrumb a:hover {
    text-decoration: underline;
}

/* ==========================================================================
   Hero Banner
   ========================================================================== */
.page-intro {
    position: relative;
    padding: 32px 36px;
    margin-bottom: 28px;
    border-radius: var(--radius-lg);
    background: linear-gradient(125deg, #e4f4f0 0%, #ccefe7 100%);
    border: 1px solid #c0e8df;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
}

.page-intro-copy h1 {
    margin: 0 0 10px;
    color: var(--deep-green);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.5px;
}

.page-intro-copy p {
    margin: 0 0 16px;
    color: var(--text-muted);
    font-size: 15px;
    max-width: 650px;
}

.trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.7);
    color: var(--deep-green);
    font-size: 12px;
    font-weight: 700;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(8, 126, 120, 0.15);
}

.shopping-art {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    display: grid;
    place-items: center;
    font-size: 56px;
    box-shadow: 0 8px 24px rgba(8, 126, 120, 0.1);
    flex-shrink: 0;
}

/* ==========================================================================
   Active Filters Bar
   ========================================================================== */
.active-filters-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    margin-bottom: 20px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
}

.active-filters-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--deep-green);
}

.filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--emerald-light);
    border: 1px solid #b8e4db;
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 600;
    color: var(--emerald-dark);
}

.filter-chip-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--emerald);
    color: #fff;
    font-size: 10px;
    line-height: 1;
    transition: var(--transition);
}

.filter-chip-remove:hover {
    background: var(--danger);
}

.clear-all-link {
    font-size: 12px;
    font-weight: 700;
    color: var(--danger);
    margin-left: auto;
    text-decoration: underline;
    cursor: pointer;
}

/* ==========================================================================
   Shop Layout & Sidebar
   ========================================================================== */
.shop-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    align-items: start;
    gap: 28px;
}

.filter-sidebar {
    position: sticky;
    top: 96px;
    padding: 22px 20px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
}

.sidebar-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
}

.sidebar-heading h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--deep-green);
    display: flex;
    align-items: center;
    gap: 8px;
}

.sidebar-heading a {
    color: var(--emerald);
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
}

.filter-section {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
}

.filter-section:last-child {
    border-bottom: 0;
    padding-bottom: 6px;
}

.filter-section h3 {
    margin: 0 0 12px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--deep-green);
}

.filter-options-scroll {
    max-height: 220px;
    overflow-y: auto;
    padding-right: 4px;
}

.filter-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 8px 0;
    color: var(--text);
    font-size: 14px;
    cursor: pointer;
    user-select: none;
    transition: var(--transition);
}

.filter-option:hover {
    color: var(--emerald);
}

.filter-option-left {
    display: flex;
    align-items: center;
    gap: 10px;
}

.filter-option input {
    width: 17px;
    height: 17px;
    accent-color: var(--emerald);
    cursor: pointer;
    margin: 0;
}

.filter-count-badge {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--page-bg);
    padding: 2px 7px;
    border-radius: var(--radius-full);
}

.price-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
}

.price-preset-btn {
    padding: 4px 9px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: #fff;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
}

.price-preset-btn:hover {
    border-color: var(--emerald);
    background: var(--emerald-light);
    color: var(--emerald-dark);
}

.price-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
}

.price-input-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.price-input-group span {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
}

.price-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.price-currency {
    position: absolute;
    left: 10px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
}

.price-input-wrapper input {
    width: 100%;
    height: 38px;
    padding: 0 8px 0 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    background: #fff;
    outline: none;
    transition: var(--transition);
}

.price-input-wrapper input:focus,
.vendor-search:focus,
.search-form input:focus {
    border-color: var(--emerald);
    box-shadow: 0 0 0 3px rgba(8, 126, 120, 0.15);
}

.vendor-search {
    width: 100%;
    height: 36px;
    padding: 0 12px;
    margin-bottom: 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 13px;
    background: #fff;
    outline: none;
    transition: var(--transition);
}

.sidebar-apply {
    width: 100%;
    height: 38px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--emerald);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
}

.sidebar-apply:hover {
    background: var(--emerald-dark);
}

/* ==========================================================================
   Products Content Toolbar
   ========================================================================== */
.products-content {
    min-width: 0;
}

.products-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
    padding: 14px 18px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
}

.search-form {
    display: flex;
    align-items: center;
    position: relative;
    flex: 1;
    min-width: 260px;
    max-width: 480px;
}

.search-form input {
    width: 100%;
    height: 42px;
    padding: 0 42px 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--text);
    font-size: 14px;
    outline: none;
    transition: var(--transition);
}

.search-clear-btn {
    position: absolute;
    right: 56px;
    background: transparent;
    border: 0;
    color: var(--text-muted);
    font-size: 14px;
    cursor: pointer;
    padding: 4px;
}

.search-clear-btn:hover {
    color: var(--danger);
}

.search-submit-btn {
    position: absolute;
    right: 4px;
    height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--emerald);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
}

.search-submit-btn:hover {
    background: var(--emerald-dark);
}

.toolbar-controls {
    display: flex;
    align-items: center;
    gap: 14px;
}

.view-mode-buttons {
    display: flex;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.view-btn {
    height: 38px;
    padding: 0 12px;
    background: #fff;
    border: 0;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: var(--transition);
}

.view-btn:first-child {
    border-right: 1px solid var(--border);
}

.view-btn.active {
    background: var(--emerald-light);
    color: var(--emerald-dark);
}

.sort-form {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
}

.sort-form select {
    height: 38px;
    padding: 0 32px 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: #fff url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235e7a76' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e") no-repeat right 10px center/14px;
    appearance: none;
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    outline: none;
}

.results-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 16px;
    font-size: 13px;
    color: var(--text-muted);
}

.results-meta strong {
    color: var(--deep-green);
}

/* ==========================================================================
   Product Grid & Cards (Modern & Responsive)
   ========================================================================== */
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
}

.product-card {
    position: relative;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
}

.product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: #badcd4;
}

.card-image-wrapper {
    position: relative;
    width: 100%;
    height: 200px;
    background: var(--mint);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.product-card:hover .product-img {
    transform: scale(1.05);
}

/* Badges on Image */
.card-badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 2;
}

.discount-badge {
    padding: 3px 8px;
    border-radius: var(--radius-full);
    background: var(--danger);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    box-shadow: 0 2px 6px rgba(229, 57, 53, 0.35);
}

.stock-badge {
    padding: 3px 8px;
    border-radius: var(--radius-full);
    background: rgba(18, 62, 58, 0.8);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    backdrop-filter: blur(4px);
}

/* Floating Actions on Image */
.card-floating-actions {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
}

.icon-action-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.95);
    color: var(--deep-green);
    font-size: 16px;
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
    transition: var(--transition);
}

.icon-action-btn:hover {
    background: #fff;
    transform: scale(1.1);
    color: var(--emerald);
}

.icon-action-btn.wishlist-btn.wishlist-active {
    color: var(--danger);
}

/* Card Body */
.card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
}

.card-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
}

.category-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--emerald);
}

.vendor-tag {
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
}

.card-title {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--deep-green);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 44px;
}

.card-rating-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
}

.star-rating {
    color: #f59e0b;
    font-size: 13px;
    letter-spacing: 1px;
}

.rating-count {
    font-size: 11px;
    color: var(--text-muted);
}

/* Price Row */
.card-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
    margin-top: auto;
}

.final-price {
    font-size: 20px;
    font-weight: 800;
    color: var(--deep-green);
}

.original-price {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: line-through;
}

.savings-text {
    font-size: 11px;
    font-weight: 700;
    color: #2e7d32;
    background: #e8f5e9;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
}

/* Card Actions */
.card-actions-row {
    display: flex;
    align-items: center;
    gap: 8px;
}

.card-qty-box {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    height: 38px;
    background: #fff;
    overflow: hidden;
}

.card-qty-btn {
    width: 28px;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
}

.card-qty-btn:hover {
    background: var(--emerald-light);
    color: var(--emerald-dark);
}

.card-qty-val {
    width: 24px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--deep-green);
}

.btn-add-cart {
    flex: 1;
    height: 38px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--emerald);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: var(--transition);
}

.btn-add-cart:hover {
    background: var(--emerald-dark);
}

.btn-add-cart.btn-added-state {
    background: #2e7d32 !important;
}

.btn-quick-view-card {
    width: 38px;
    height: 38px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--text-muted);
    font-size: 16px;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: var(--transition);
}

.btn-quick-view-card:hover {
    border-color: var(--emerald);
    color: var(--emerald);
    background: var(--emerald-light);
}

/* ==========================================================================
   List View Mode Styles
   ========================================================================== */
.product-grid.product-list-view {
    grid-template-columns: 1fr;
    gap: 16px;
}

.product-grid.product-list-view .product-card {
    flex-direction: row;
    align-items: stretch;
}

.product-grid.product-list-view .card-image-wrapper {
    width: 220px;
    height: auto;
    min-height: 180px;
    flex-shrink: 0;
}

.product-grid.product-list-view .card-body {
    flex: 1;
}

.product-grid.product-list-view .card-title {
    font-size: 18px;
    min-height: auto;
}

/* ==========================================================================
   Empty State
   ========================================================================== */
.empty-state {
    padding: 60px 20px;
    text-align: center;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
}

.empty-state-icon {
    font-size: 50px;
    margin-bottom: 14px;
    display: inline-block;
}

.empty-state h2 {
    margin: 0 0 8px;
    font-size: 20px;
    color: var(--deep-green);
}

.empty-state p {
    margin: 0 0 20px;
    color: var(--text-muted);
    font-size: 14px;
}

.btn-clear-filters {
    display: inline-flex;
    padding: 10px 22px;
    border-radius: var(--radius-full);
    background: var(--emerald);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    transition: var(--transition);
}

.btn-clear-filters:hover {
    background: var(--emerald-dark);
}

/* ==========================================================================
   Quick View Modal
   ========================================================================== */
.modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(18, 62, 58, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

.modal-backdrop.backdrop-open {
    opacity: 1;
    pointer-events: auto;
}

.quick-view-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -46%) scale(0.95);
    width: 90%;
    max-width: 820px;
    max-height: 90vh;
    overflow-y: auto;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: 1001;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 32px;
}

.quick-view-modal.modal-open {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
    pointer-events: auto;
}

.modal-close-btn {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--text-muted);
    font-size: 18px;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: var(--transition);
}

.modal-close-btn:hover {
    color: var(--danger);
    border-color: var(--danger);
}

.qv-content-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 30px;
}

.qv-image-box {
    width: 100%;
    height: 340px;
    background: var(--mint);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
}

.qv-image-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.qv-details {
    display: flex;
    flex-direction: column;
}

.qv-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
}

.qv-title {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 800;
    color: var(--deep-green);
    line-height: 1.3;
}

.qv-price-box {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
}

.qv-final-price {
    font-size: 26px;
    font-weight: 800;
    color: var(--emerald-dark);
}

.qv-features-list {
    margin: 0 0 20px;
    padding-left: 20px;
    font-size: 13px;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.qv-action-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
}

.qv-qty-input-box {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    height: 44px;
}

.qv-qty-btn {
    width: 36px;
    height: 100%;
    border: 0;
    background: transparent;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
}

.qv-qty-input {
    width: 44px;
    text-align: center;
    border: 0;
    font-size: 14px;
    font-weight: 700;
    outline: none;
}

.btn-qv-add {
    flex: 1;
    height: 44px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--emerald);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
}

.btn-qv-add:hover {
    background: var(--emerald-dark);
}

.btn-qv-buy {
    height: 44px;
    padding: 0 20px;
    border: 1px solid var(--emerald);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--emerald);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
}

.btn-qv-buy:hover {
    background: var(--emerald-light);
}

/* ==========================================================================
   Slide-over Cart Drawer
   ========================================================================== */
.cart-drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(18, 62, 58, 0.45);
    backdrop-filter: blur(4px);
    z-index: 1100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

.cart-drawer-backdrop.backdrop-open {
    opacity: 1;
    pointer-events: auto;
}

.cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100vh;
    background: #fff;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.15);
    z-index: 1101;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.cart-drawer.drawer-open {
    transform: translateX(0);
}

.cart-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
}

.cart-drawer-header h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    color: var(--deep-green);
    display: flex;
    align-items: center;
    gap: 8px;
}

.cart-drawer-close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--text-muted);
    font-size: 16px;
    cursor: pointer;
    display: grid;
    place-items: center;
}

.cart-drawer-close:hover {
    color: var(--danger);
    border-color: var(--danger);
}

.cart-drawer-items {
    flex: 1;
    overflow-y: auto;
    padding: 16px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.cart-drawer-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
}

.cart-item-thumb {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    background: var(--mint);
    flex-shrink: 0;
}

.cart-item-details {
    flex: 1;
    min-width: 0;
}

.cart-item-title {
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 700;
    color: var(--deep-green);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cart-item-vendor {
    display: block;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 6px;
}

.cart-item-pricing {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.cart-item-unit {
    font-size: 14px;
    font-weight: 700;
    color: var(--emerald-dark);
}

.cart-qty-controls {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    height: 28px;
}

.qty-btn {
    width: 24px;
    height: 100%;
    border: 0;
    background: transparent;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
}

.qty-value {
    width: 22px;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
}

.cart-item-remove {
    background: transparent;
    border: 0;
    color: var(--text-muted);
    font-size: 14px;
    cursor: pointer;
    padding: 6px;
}

.cart-item-remove:hover {
    color: var(--danger);
}

.cart-drawer-empty {
    padding: 50px 20px;
    text-align: center;
    color: var(--text-muted);
}

.cart-drawer-empty-icon {
    font-size: 48px;
    margin-bottom: 12px;
}

.cart-drawer-footer {
    padding: 20px 24px;
    border-top: 1px solid var(--border);
    background: var(--page-bg);
}

.cart-summary-line {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 8px;
}

.cart-summary-total {
    display: flex;
    justify-content: space-between;
    font-size: 17px;
    font-weight: 800;
    color: var(--deep-green);
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--border);
}

.btn-cart-checkout {
    width: 100%;
    height: 46px;
    margin-top: 16px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--emerald);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
}

.btn-cart-checkout:hover {
    background: var(--emerald-dark);
}

/* ==========================================================================
   Toast Notifications
   ========================================================================== */
.toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 2000;
    pointer-events: none;
}

.toast-message {
    min-width: 280px;
    max-width: 400px;
    padding: 12px 18px;
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--deep-green);
    border-left: 4px solid var(--emerald);
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: auto;
}

.toast-message.toast-show {
    transform: translateY(0);
    opacity: 1;
}

.toast-icon {
    font-size: 16px;
    font-weight: 800;
    color: var(--emerald);
}

.toast-wishlist {
    border-left-color: var(--danger);
}

.toast-wishlist .toast-icon {
    color: var(--danger);
}

/* ==========================================================================
   Responsive Breakpoints
   ========================================================================== */
@media (max-width: 1100px) {
    .shop-layout {
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 20px;
    }
}

@media (max-width: 880px) {
    .site-header {
        padding: 0 3%;
    }

    .main-nav {
        gap: 14px;
    }

    .shop-layout {
        grid-template-columns: 1fr;
    }

    .filter-sidebar {
        position: static;
        order: 2;
    }

    .products-content {
        order: 1;
    }

    .qv-content-grid {
        grid-template-columns: 1fr;
    }

    .qv-image-box {
        height: 250px;
    }
}

@media (max-width: 640px) {
    .site-header {
        flex-wrap: wrap;
        padding: 12px 4%;
    }

    .main-nav {
        order: 3;
        width: 100%;
        overflow-x: auto;
        padding-top: 10px;
    }

    .main-nav a {
        padding: 8px 0;
        white-space: nowrap;
    }

    .page {
        padding: 16px 14px 40px;
    }

    .shopping-art {
        display: none;
    }

    .products-toolbar {
        flex-direction: column;
        align-items: stretch;
    }

    .search-form {
        max-width: 100%;
    }

    .toolbar-controls {
        justify-content: space-between;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }
}
