
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Customer Dashboard | OneCart</title>

    <link rel="stylesheet" th:href="@{/css/customer-dashboard.css}">
</head>

<body>

<header class="site-header">

    <div class="header-inner">

        <a class="brand" th:href="@{/}">
            One<span>Cart</span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">

            <a class="active" th:href="@{/customer/dashboard}">
                Dashboard
            </a>

            <a th:href="@{/customer/products}">
                Shop
            </a>

            <a th:href="@{/customer/orders}">
                My Orders
            </a>

            <a th:href="@{/customer/account}">
                My Account
            </a>

        </nav>

        <form class="logout-form"
              th:action="@{/logout}"
              method="post">

            <button class="logout-button" type="submit">
                Sign out
            </button>

        </form>

    </div>

</header>


<main class="page-content">

    <!-- Welcome Banner -->
    <section class="welcome-banner">

        <div class="welcome-copy">

            <p class="eyebrow">WELCOME TO ONECART</p>

            <h1>
                Hello, <span th:text="${firstName}">Customer</span>!
            </h1>

            <p>
                Discover something you’ll love, and keep your shopping in one place.
            </p>

            <a class="primary-button" th:href="@{/customer/products}">
                Explore products
            </a>

        </div>

        <div class="banner-art" aria-hidden="true">

            <div class="art-circle"></div>

            <div class="art-note note-one">
                Your next favorite find
            </div>

            <div class="art-note note-two">
                OneCart ♥
            </div>

        </div>

    </section>


    <!-- Customer Quick Links -->
    <section class="quick-links" aria-label="Customer shortcuts">

        <a class="quick-card" th:href="@{/customer/products}">

            <span class="quick-icon">⌕</span>

            <span>
                <strong>Browse products</strong>
                <small>Explore products from multiple vendors</small>
            </span>

            <span class="card-arrow">→</span>

        </a>


        <a class="quick-card" th:href="@{/customer/orders}">

            <span class="quick-icon">▤</span>

            <span>
                <strong>My orders</strong>
                <small>View your order history</small>
            </span>

            <span class="card-arrow">→</span>

        </a>


        <a class="quick-card" th:href="@{/customer/account}">

            <span class="quick-icon">♙</span>

            <span>
                <strong>My account</strong>
                <small>Manage your account details</small>
            </span>

            <span class="card-arrow">→</span>

        </a>

    </section>


    <!-- Featured Products -->
    <section class="featured-section">

        <div class="section-heading">

            <div>

                <p class="eyebrow">HANDPICKED FOR YOU</p>

                <h2>Featured products</h2>

                <p>
                    Find something great from OneCart vendors.
                </p>

            </div>

            <a class="text-link" th:href="@{/customer/products}">
                View all products <span>→</span>
            </a>

        </div>


        <!-- Product Grid -->
        <div class="product-grid"
             th:if="${products != null and !products.isEmpty()}">

            <article class="product-card"
                     th:each="product : ${products}">

                <!-- Product Image -->
                <div class="product-image-placeholder">

                    <img class="featured-product-image"

                         th:src="${product.imageFileName != null and !#strings.isEmpty(product.imageFileName) ? (product.imageFileName.startsWith('/') ? product.imageFileName : '/images/products/' + product.imageFileName) : '/images/products/Ceramic Coffee Mug.jpg'}"

                         th:alt="${product.productName}"

                         loading="lazy"

                         onerror="this.onerror=null;this.src='/images/products/Ceramic Coffee Mug.jpg';">


                    <span class="image-fallback"
                          th:text="${product.productName}">
                        OneCart
                    </span>

                </div>


                <!-- Product Information -->
                <div class="product-info">

                    <h3 th:text="${product.productName}">
                        Product name
                    </h3>

                    <p class="product-price">

                        ₹<span th:text="${#numbers.formatDecimal(product.discountedPrice != null ? product.discountedPrice : product.price, 1, 2)}">
                            0.00
                        </span>

                    </p>

                    <a class="product-link"
                       th:href="@{/customer/products(keyword=${product.productName})}">

                        View product

                    </a>

                </div>

            </article>

        </div>


        <!-- Empty Products -->
        <div class="empty-products"
             th:if="${products == null or products.isEmpty()}">

            <span class="empty-icon">⌕</span>

            <h3>No products available yet</h3>

            <p>
                Approved products from vendors will appear here.
            </p>

        </div>

    </section>


    <!-- Account Note -->
    <section class="account-note">

        <span class="success-icon">✓</span>

        <div>

            <strong>You’re all set</strong>

            <p>
                You’re signed in as a customer. Start exploring products
                and discover your next favorite find.
            </p>

        </div>

    </section>

</main>


<!-- Footer -->
<footer class="customer-footer">

    <div class="customer-footer__inner">

        <div class="customer-footer__brand">

            <a class="customer-footer__logo" th:href="@{/}">
                OneCart
            </a>

            <p>Shop more. Live better.</p>

        </div>


        <div class="customer-footer__column">

            <h3>Shop</h3>

            <a th:href="@{/customer/products}">
                Browse products
            </a>

            <a th:href="@{/customer/orders}">
                Track your orders
            </a>

        </div>


        <div class="customer-footer__column">

            <h3>Your account</h3>

            <a th:href="@{/customer/account}">
                My account
            </a>

            <a th:href="@{/customer/orders}">
                Order history
            </a>

        </div>


        <div class="customer-footer__column">

            <h3>Help</h3>

            <a th:href="@{/contact}">
                Contact us
            </a>

            <a th:href="@{/about}">
                About OneCart
            </a>

        </div>

    </div>


    <div class="customer-footer__bottom">

        <span>© 2026 OneCart</span>

        <span>Shop more. Live better.</span>

    </div>

</footer>

</body>
</html>
