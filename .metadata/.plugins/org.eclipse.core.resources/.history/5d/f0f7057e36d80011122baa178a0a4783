<section class="featured-products" id="products">
    <div class="section-heading">
        <div>
            <p class="eyebrow">HANDPICKED FOR YOU</p>
            <h2>Featured products</h2>
        </div>
        <a class="view-all" th:href="@{/}">View all products →</a>
    </div>

    <div class="product-grid" th:if="${!#lists.isEmpty(products)}">
        <article class="product-card" th:each="product : ${products}">
            <div class="product-placeholder" aria-hidden="true">OneCart</div>

            <div class="product-info">
                <h3 th:text="${product.productName}">Product name</h3>

                <div class="price-row">
                    <strong th:text="${'₹' + #numbers.formatDecimal(product.discountedPrice, 1, 2)}">
                        ₹0.00
                    </strong>

                    <span class="original-price"
                          th:if="${product.discountPercentage != null and product.discountPercentage.compareTo(T(java.math.BigDecimal).ZERO) > 0}"
                          th:text="${'₹' + #numbers.formatDecimal(product.price, 1, 2)}">
                        ₹0.00
                    </span>
                </div>

                <p class="discount-label"
                   th:if="${product.discountPercentage != null and product.discountPercentage.compareTo(T(java.math.BigDecimal).ZERO) > 0}"
                   th:text="${#numbers.formatDecimal(product.discountPercentage, 1, 0) + '% off'}">
                    Discount
                </p>

                <button class="add-cart-btn" type="button" disabled>
                    Add to cart
                </button>
            </div>
        </article>
    </div>

    <p class="empty-products" th:if="${#lists.isEmpty(products)}">
        No approved products are available right now. Please check back soon.
    </p>
</section>