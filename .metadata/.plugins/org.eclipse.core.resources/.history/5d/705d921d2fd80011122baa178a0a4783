@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --pale-mint: #f3faf7;
    --white: #ffffff;
    --ink: #193633;
    --muted: #71827e;
    --border: #e4eeea;
    --shadow: 0 16px 40px rgba(18, 62, 58, 0.08);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    color: var(--ink);
    background: var(--white);
    font-family: "DM Sans", sans-serif;
    line-height: 1.5;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

button {
    cursor: pointer;
}

.site-header {
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.top-strip {
    min-height: 34px;
    padding: 7px 6.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: #e8f7f3;
    background: var(--deep-green);
    font-size: 11px;
    letter-spacing: 0.02em;
}

.top-strip p {
    margin: 0;
}

.header-main {
    max-width: 1440px;
    min-height: 88px;
    margin: 0 auto;
    padding: 18px 6.5%;
    display: flex;
    align-items: center;
    gap: 34px;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    color: var(--deep-green);
    font-family: "Manrope", sans-serif;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -1.2px;
}

.brand > span:last-child > span {
    color: var(--emerald);
}

.brand-icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: white;
    background: var(--emerald);
    font-size: 22px;
    font-weight: 800;
}

.search-form {
    flex: 1;
    max-width: 560px;
    height: 46px;
    display: flex;
    overflow: hidden;
    border: 1px solid #dce9e4;
    border-radius: 9px;
    background: #f9fcfa;
}

.search-form:focus-within {
    border-color: var(--emerald);
    box-shadow: 0 0 0 3px rgba(8, 126, 120, 0.08);
}

.search-form input {
    width: 100%;
    min-width: 0;
    padding: 0 16px;
    border: 0;
    outline: 0;
    color: var(--ink);
    background: transparent;
    font-size: 13px;
}

.search-form button {
    width: 52px;
    flex-shrink: 0;
    border: 0;
    color: white;
    background: var(--emerald);
    font-size: 25px;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-left: auto;
}

.header-action {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #45605b;
    font-size: 12px;
    white-space: nowrap;
}

.header-action b {
    display: inline-grid;
    min-width: 17px;
    height: 17px;
    margin-left: 2px;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: var(--emerald);
    font-size: 10px;
}

.action-icon {
    color: var(--emerald);
    font-size: 21px;
}

.main-nav {
    min-height: 48px;
    padding: 0 6.5%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(22px, 4vw, 54px);
    border-top: 1px solid #f0f5f2;
}

.main-nav a {
    position: relative;
    padding: 14px 0;
    color: #526762;
    font-size: 12px;
    font-weight: 600;
}

.main-nav a:hover,
.main-nav a.active {
    color: var(--emerald);
}

.main-nav a.active::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--emerald);
    content: "";
}

.hero {
    position: relative;
    min-height: 440px;
    padding: 70px 9%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    overflow: hidden;
    background:
        radial-gradient(circle at 80% 35%, rgba(190, 231, 218, 0.65), transparent 28%),
        linear-gradient(115deg, #f4faf7 0%, #e9f6f0 58%, #dff1e9 100%);
}

.hero-content {
    position: relative;
    z-index: 1;
    width: min(560px, 58%);
}

.eyebrow {
    display: block;
    margin-bottom: 12px;
    color: var(--emerald);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
}

.hero h1,
.section-heading h2,
.vendor-copy h2,
.about-inner h2 {
    margin: 0;
    color: var(--deep-green);
    font-family: "Manrope", sans-serif;
    font-size: clamp(32px, 4.2vw, 54px);
    font-weight: 800;
    letter-spacing: -1.8px;
    line-height: 1.12;
}

.hero h1 span {
    color: var(--emerald);
}

.hero-content > p {
    max-width: 450px;
    margin: 20px 0 25px;
    color: #637973;
    font-size: 14px;
    line-height: 1.8;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.button {
    min-height: 46px;
    padding: 0 21px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    border: 1px solid transparent;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 700;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
}

.button-primary {
    color: white;
    background: var(--emerald);
    box-shadow: 0 8px 18px rgba(8, 126, 120, 0.16);
}

.button-light {
    border-color: #d5e8e0;
    color: var(--deep-green);
    background: rgba(255, 255, 255, 0.65);
}

.hero-trust {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: #607771;
    font-size: 10px;
}

.hero-trust span::first-letter {
    color: var(--emerald);
}

.hero-art {
    position: relative;
    width: 390px;
    height: 310px;
    flex-shrink: 0;
}

.hero-circle {
    position: absolute;
    top: 15px;
    left: 38px;
    width: 280px;
    height: 280px;
    border: 1px solid rgba(8, 126, 120, 0.15);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
}

.hero-circle::before,
.hero-circle::after {
    position: absolute;
    border: 1px solid rgba(8, 126, 120, 0.13);
    border-radius: 50%;
    content: "";
}

.hero-circle::before {
    inset: 24px;
}

.hero-circle::after {
    inset: 50px;
}

.hero-card {
    position: absolute;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 17px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--shadow);
}

.hero-card-back {
    top: 50px;
    right: 0;
    width: 205px;
    min-height: 95px;
    padding: 18px;
    justify-content: center;
    gap: 7px;
    color: #66817a;
    font-size: 11px;
    transform: rotate(7deg);
}

.hero-card-icon {
    color: #e0a84b;
    font-size: 22px;
}

.hero-card-front {
    top: 100px;
    left: 36px;
    width: 235px;
    min-height: 170px;
    padding: 20px;
    align-items: center;
    justify-content: center;
    text-align: center;
    transform: rotate(-5deg);
}

.hero-bag {
    margin-bottom: 9px;
    font-size: 48px;
}

.hero-card-front strong {
    color: var(--deep-green);
    font-family: "Manrope", sans-serif;
    font-size: 13px;
}

.hero-card-front > span:last-child {
    margin-top: 5px;
    color: var(--emerald);
    font-size: 10px;
}

.floating-tag {
    position: absolute;
    padding: 10px 14px;
    border: 1px solid #e5f0eb;
    border-radius: 30px;
    color: var(--deep-green);
    background: white;
    box-shadow: 0 8px 20px rgba(18, 62, 58, 0.08);
    font-size: 10px;
    font-weight: 700;
}

.tag-top {
    top: 25px;
    left: 0;
}

.tag-bottom {
    right: 2px;
    bottom: 20px;
}

.benefits {
    max-width: 1180px;
    margin: 0 auto;
    padding: 27px 30px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    border-bottom: 1px solid var(--border);
}

.benefit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
}

.benefit-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: var(--emerald);
    background: var(--mint);
    font-size: 21px;
}

.benefit strong,
.benefit small {
    display: block;
}

.benefit strong {
    color: var(--deep-green);
    font-size: 12px;
}

.benefit small {
    margin-top: 3px;
    color: var(--muted);
    font-size: 10px;
}

.section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 72px 6.5%;
}

.section-heading {
    margin-bottom: 28px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
}

.section-heading .eyebrow {
    margin-bottom: 8px;
}

.section-heading h2 {
    font-size: clamp(26px, 3vw, 35px);
    letter-spacing: -1px;
}

.section-heading p {
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 12px;
}

.text-link {
    flex-shrink: 0;
    color: var(--emerald);
    font-size: 12px;
    font-weight: 700;
}

.text-link span {
    margin-left: 7px;
}

.category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 17px;
}

.category-card {
    min-height: 170px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.category-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.category-fashion {
    background: #f8f0e9;
}

.category-electronics {
    background: #edf2fb;
}

.category-home {
    background: #eef5e9;
}

.category-beauty {
    background: #f7edf4;
}

.category-emoji {
    margin-bottom: 15px;
    font-size: 31px;
}

.category-name {
    color: var(--deep-green);
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    font-weight: 800;
}

.category-note {
    margin-top: 5px;
    color: #71817b;
    font-size: 11px;
}

.products-section {
    padding-top: 15px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.product-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: white;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.product-image-wrap {
    position: relative;
    height: 220px;
    overflow: hidden;
    background: #f2f7f4;
}

.product-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.35s ease;
}

.product-card:hover .product-image {
    transform: scale(1.04);
}

.product-badge {
    position: absolute;
    top: 13px;
    left: 13px;
    padding: 6px 9px;
    border-radius: 4px;
    color: var(--emerald);
    background: white;
    font-size: 9px;
    font-weight: 800;
}

.wishlist-button {
    position: absolute;
    top: 11px;
    right: 11px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: var(--deep-green);
    background: white;
    font-size: 20px;
}

.wishlist-button.is-active {
    color: #d94c67;
}

.product-info {
    padding: 17px;
}

.product-category {
    color: #8b9a95;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
}

.product-info h3 {
    min-height: 42px;
    margin: 7px 0 12px;
    overflow-wrap: anywhere;
    color: var(--deep-green);
    font-family: "Manrope", sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
}

.product-price-row {
    min-height: 25px;
    margin-bottom: 14px;
}

.product-price {
    color: var(--emerald);
    font-size: 16px;
}

.add-to-cart {
    width: 100%;
    min-height: 40px;
    padding: 0 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #cfe5dc;
    border-radius: 6px;
    color: var(--emerald);
    background: #f5fbf8;
    font-size: 11px;
    font-weight: 700;
    transition: color 0.2s ease, background 0.2s ease;
}

.add-to-cart:hover {
    color: white;
    background: var(--emerald);
}

.add-to-cart span {
    font-size: 18px;
}

.empty-state {
    padding: 50px 20px;
    border: 1px dashed #cfe2d9;
    border-radius: 12px;
    text-align: center;
    background: var(--pale-mint);
}

.empty-icon {
    font-size: 36px;
}

.empty-state h3 {
    margin: 10px 0 5px;
    color: var(--deep-green);
    font-family: "Manrope", sans-serif;
}

.empty-state p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
}

.vendor-section {
    background: var(--pale-mint);
}

.vendor-content {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 70px;
}

.vendor-copy h2 {
    font-size: clamp(30px, 3.5vw, 43px);
}

.vendor-copy p {
    max-width: 420px;
    margin: 18px 0 25px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
}

.vendor-panel {
    padding: 27px;
    border: 1px solid #e1eee8;
    border-radius: 14px;
    background: white;
    box-shadow: 0 15px 40px rgba(18, 62, 58, 0.05);
}

.vendor-panel-heading {
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.vendor-panel-heading .eyebrow {
    margin-bottom: 5px;
}

.vendor-panel-heading h3 {
    margin: 0;
    color: var(--deep-green);
    font-family: "Manrope", sans-serif;
    font-size: 20px;
}

.vendor-star {
    color: #d8a24a;
    font-size: 27px;
}

.vendor-row {
    padding: 14px 0;
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid #edf3ef;
}

.vendor-avatar {
    width: 40px;
    height: 40px;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    border-radius: 12px;
    color: var(--emerald);
    background: var(--mint);
    font-family: "Manrope", sans-serif;
    font-size: 15px;
    font-weight: 800;
}

.vendor-row strong,
.vendor-row small {
    display: block;
}

.vendor-row strong {
    color: var(--deep-green);
    font-size: 12px;
}

.vendor-row small {
    margin-top: 3px;
    color: var(--muted);
    font-size: 10px;
}

.vendor-arrow {
    margin-left: auto;
    color: var(--emerald);
}

.vendor-empty {
    margin: 0;
    padding: 16px 0 4px;
    color: var(--muted);
    font-size: 12px;
}

.about-strip {
    background: white;
}

.about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
}

.about-inner h2 {
    font-size: clamp(28px, 3vw, 38px);
}

.about-inner > p {
    max-width: 500px;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
}

.site-footer {
    padding: 50px 6.5% 0;
    color: #d7e8e2;
    background: var(--deep-green);
}

.footer-main {
    max-width: 1280px;
    margin: 0 auto;
    padding-bottom: 40px;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 35px;
}

.brand-footer {
    color: white;
}

.brand-footer > span:last-child > span {
    color: #76d1bd;
}

.footer-brand p,
.footer-contact p {
    margin: 12px 0 0;
    color: #a8c4ba;
    font-size: 11px;
}

.footer-links,
.footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
    font-size: 11px;
}

.footer-links strong,
.footer-contact strong {
    margin-bottom: 4px;
    color: white;
    font-size: 12px;
}

.footer-links a {
    color: #b4cbc2;
}

.footer-links a:hover,
.footer-contact a:hover {
    color: white;
}

.footer-contact p {
    margin: 0;
    line-height: 1.7;
}

.footer-contact a {
    color: #8cdbca;
    font-weight: 700;
}

.footer-contact a span {
    margin-left: 5px;
}

.footer-bottom {
    max-width: 1280px;
    min-height: 54px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    color: #a8c4ba;
    font-size: 10px;
}

.footer-heart {
    color: #8cdbca;
}

/* Tablet */
@media (max-width: 1050px) {
    .header-main {
        flex-wrap: wrap;
        gap: 18px;
    }

    .search-form {
        order: 3;
        flex-basis: 100%;
        max-width: none;
    }

    .header-actions {
        margin-left: auto;
    }

    .hero {
        padding-right: 6%;
        padding-left: 6%;
    }

    .hero-art {
        transform: scale(0.85);
        transform-origin: center right;
        margin-left: -35px;
    }

    .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .vendor-content {
        gap: 35px;
    }
}

/* Mobile */
@media (max-width: 700px) {
    .top-strip {
        justify-content: center;
        text-align: center;
    }

    .top-strip p:last-child {
        display: none;
    }

    .header-main {
        padding: 16px 5%;
    }

    .brand {
        font-size: 22px;
    }

    .header-actions {
        gap: 12px;
    }

    .header-action {
        gap: 3px;
        font-size: 0;
    }

    .header-action b {
        font-size: 10px;
    }

    .action-icon {
        font-size: 22px;
    }

    .main-nav {
        padding: 0 5%;
        justify-content: flex-start;
        gap: 25px;
        overflow-x: auto;
    }

    .main-nav a {
        flex-shrink: 0;
    }

    .hero {
        min-height: auto;
        padding: 52px 6% 38px;
    }

    .hero-content {
        width: 100%;
    }

    .hero h1 {
        font-size: clamp(34px, 9vw, 46px);
    }

    .hero-art {
        display: none;
    }

    .hero-trust {
        gap: 10px 15px;
    }

    .benefits {
        padding: 22px 6%;
        grid-template-columns: 1fr;
        gap: 15px;
    }

    .benefit {
        justify-content: flex-start;
    }

    .section {
        padding: 52px 6%;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .category-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .category-card {
        min-height: 145px;
        padding: 17px;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .product-image-wrap {
        height: 155px;
    }

    .product-info {
        padding: 12px;
    }

    .product-info h3 {
        font-size: 12px;
    }

    .product-price {
        font-size: 14px;
    }

    .vendor-content,
    .about-inner {
        grid-template-columns: 1fr;
        gap: 28px;
    }

    .vendor-panel {
        padding: 20px;
    }

    .footer-main {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px 20px;
    }

    .footer-bottom {
        padding: 15px 0;
        align-items: flex-start;
        flex-direction: column;
    }
}

@media (max-width: 380px) {
    .product-grid {
        grid-template-columns: 1fr;
    }

    .product-image-wrap {
        height: 220px;
    }

    .footer-main {
        grid-template-columns: 1fr;
    }
}