package com.vendor.service;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashSet;
import java.util.List;
import java.util.Objects;
import java.util.Set;
import java.util.stream.Collectors;
import java.util.stream.Stream;

import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.vendor.entity.Product;
import com.vendor.repository.ProductRepository;

@Service
public class ProductService {

    private final ProductRepository productRepository;

    private static final Set<String> ALLOWED_PRODUCTS = Set.of(
        "bluetooth speaker",
        "ceramic coffee mug",
        "cotton t-shirt",
        "running shoes",
        "smart watch",
        "travel back pack",
        "travel backpack",
        "wireless headphones",
        "wireless mouse"
    );

    public ProductService(ProductRepository productRepository) {
        this.productRepository = productRepository;
    }

    @Transactional
    public List<Product> getApprovedProducts() {
        List<Product> all = productRepository
                .findByProductStatusIgnoreCaseAndApprovalStatusIgnoreCaseOrderByProductIdDesc(
                        "ACTIVE",
                        "APPROVED"
                );

        Set<String> seenNames = new HashSet<>();
        List<Product> cleanList = new ArrayList<>();

        for (Product product : all) {
            if (product.getProductName() == null) {
                continue;
            }
            String normalizedName = product.getProductName().trim().toLowerCase();

            // 1. Remove seeded non-original products (e.g. Sony Wireless..., etc.)
            if (!ALLOWED_PRODUCTS.contains(normalizedName)) {
                try {
                    productRepository.delete(product);
                } catch (Exception ignored) {
                }
                continue;
            }

            // 2. Remove duplicate copies of original products
            if (seenNames.contains(normalizedName)) {
                try {
                    productRepository.delete(product);
                } catch (Exception ignored) {
                }
                continue;
            }

            seenNames.add(normalizedName);
            cleanList.add(product);
        }

        return cleanList;
    }

    public List<Product> filterProducts(
            List<Product> products,
            String keyword,
            String category,
            Integer vendorId,
            Double minPrice,
            Double maxPrice,
            String sort) {

        Stream<Product> result = products.stream();

        if (keyword != null && !keyword.isBlank()) {
            String searchText = keyword.trim().toLowerCase();

            result = result.filter(product ->
                    product.getProductName() != null
                            && product.getProductName()
                                    .toLowerCase()
                                    .contains(searchText)
            );
        }

        if (category != null && !category.isBlank()) {
            String selectedCategory = category.trim();

            result = result.filter(product ->
                    product.getCategory() != null
                            && product.getCategory()
                                    .equalsIgnoreCase(selectedCategory)
            );
        }

        if (vendorId != null) {
            result = result.filter(product ->
                    Objects.equals(product.getVendorId(), vendorId)
            );
        }

        if (minPrice != null) {
            result = result.filter(product -> {
                Double effectivePrice = product.getDiscountedPrice() != null ? product.getDiscountedPrice() : product.getPrice();
                return effectivePrice != null && effectivePrice >= minPrice;
            });
        }

        if (maxPrice != null) {
            result = result.filter(product -> {
                Double effectivePrice = product.getDiscountedPrice() != null ? product.getDiscountedPrice() : product.getPrice();
                return effectivePrice != null && effectivePrice <= maxPrice;
            });
        }

        Comparator<Product> comparator;

        switch (sort == null ? "newest" : sort.toLowerCase()) {
            case "price-low":
                comparator = Comparator.comparing(
                        product -> product.getDiscountedPrice() != null ? product.getDiscountedPrice() : product.getPrice(),
                        Comparator.nullsLast(Double::compareTo)
                );
                break;

            case "price-high":
                comparator = Comparator.<Product, Double>comparing(
                        product -> product.getDiscountedPrice() != null ? product.getDiscountedPrice() : product.getPrice(),
                        Comparator.nullsLast(Double::compareTo)
                ).reversed();
                break;

            case "name":
                comparator = Comparator.comparing(
                        Product::getProductName,
                        Comparator.nullsLast(String.CASE_INSENSITIVE_ORDER)
                );
                break;

            case "discount":
                comparator = Comparator.<Product, Double>comparing(
                        product -> product.getDiscountPercentage() != null ? product.getDiscountPercentage() : 0.0,
                        Comparator.nullsLast(Double::compareTo)
                ).reversed();
                break;

            case "newest":
            default:
                comparator = Comparator.comparing(
                        Product::getProductId,
                        Comparator.nullsLast(Long::compareTo)
                ).reversed();
                break;
        }

        return result
                .sorted(comparator)
                .collect(Collectors.toList());
    }
}