@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');

:root {
    --emerald: #087e78;
    --dark-green: #123e3a;
    --mint: #e5f4f0;
    --light-bg: #f8fbfa;
    --white: #fff;
    --text: #354b48;
    --muted: #71817e;
    --border: #e3ece9;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'DM Sans', Arial, sans-serif;
    color: var(--dark-green);
    background: #fff;
    line-height: 1.5;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    display: block;
    width: 100%;
    object-fit: cover;
}

/* Header */
.site-header {
    background: #fff;
    border-bottom: 1px solid var(--border);
}

.topbar {
    max-width: 1350px;
    margin: auto;
    min-height: 72px;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 32px;
}

.logo {
    color: var(--dark-green);
    font-size: 27px;
    font-weight: 700;
    white-space: nowrap;
    letter-spacing: -1px;
}

.cart-icon {
    color: var(--emerald);
}

.search {
    display: flex;
    flex: 1;
    min-width: 180px;
    height: 42px;
    border: 1px solid var(--emerald);
    border-radius: 7px;
    overflow: hidden;
}

.search input {
    flex: 1;
    min-width: 0;
    padding: 0 14px;
    border: 0;
    outline: 0;
    font: inherit;
}

.search button {
    width: 48px;
    border: 0;
    background: var(--emerald);
    color: white;
    font-size: 27px;
    cursor: pointer;
}

.account-links {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
}

.signup-btn,
.primary-btn {
    background: var(--emerald);
    color: #fff;
    border-radius: 7px;
    padding: 10px 22px;
}

.signup-btn:hover,
.primary-btn:hover {
    background: var(--dark-green);
}

.categories {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 9px 20px;
    background: var(--mint);
    overflow-x: auto;
    white-space: nowrap;
}

.categories a {
    padding: 6px 13px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}

.categories a:hover,
.categories .selected {
    background: var(--emerald);
    color: #fff;
}

/* Main layout */
.page-content {
    max-width: 1350px;
    margin: auto;
    padding: 18px 24px 16px;
}

.hero {
    min-height: 205px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    border-radius: 13px;
    background: linear-gradient(105deg, #d8f1e8 0%, #bce4d6 55%, #8bc7b4 100%);
}

.hero-copy {
    z-index: 1;
    padding: 24px 5%;
}

.sale-tag {
    display: inline-block;
    padding: 5px 15px;
    border-radius: 20px 20px 20px 0;
    background: var(--emerald);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
}

.hero h1 {
    margin: 5px 0 0;
    color: #111;
    font-size: clamp(30px, 3vw, 46px);
    line-height: 1.15;
    letter-spacing: -1px;
}

.hero p {
    margin: 4px 0 15px;
    color: #182a27;
    font-size: 15px;
}

.primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    font-weight: 700;
}

.hero > img {
    width: 46%;
    height: 100%;
    max-height: 240px;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: multiply;
}

/* Sections */
.content-section {
    margin-top: 22px;
}

.section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.section-title h2 {
    font-size: 20px;
    color: #101b19;
    letter-spacing: -0.4px;
}

.section-title h2 span {
    color: #e4a51a;
}

.section-title > a {
    color: var(--emerald);
    font-size: 12px;
    font-weight: 700;
}

/* Spotlight row */
.spotlight-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
}

.spotlight-card {
    min-width: 0;
    min-height: 90px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    background: #f2f7f5;
    border: 1px solid #edf1ef;
    border-radius: 10px;
    overflow: hidden;
}

.spotlight-card img {
    width: 42%;
    height: 70px;
    object-fit: contain;
}

.spotlight-card h3 {
    color: #17221f;
    font-size: 11px;
    line-height: 1.3;
}

.spotlight-card p {
    margin-top: 4px;
    color: var(--emerald);
    font-size: 11px;
    font-weight: 700;
}

/* Product row */
.product-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
}

.product-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: #fff;
}

.product-card > a {
    display: block;
    height: 125px;
    padding: 8px;
    background: #fafcfb;
}

.product-card img {
    height: 100%;
    object-fit: contain;
}

.product-info {
    padding: 9px 11px 11px;
    border-top: 1px solid #edf1ef;
}

.product-info h3 {
    overflow: hidden;
    color: #23312e;
    font-size: 11px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.product-info p {
    margin-top: 3px;
    color: var(--emerald);
    font-size: 11px;
    font-weight: 700;
}

.product-info del {
    margin-left: 3px;
    color: #8a9693;
    font-size: 10px;
    font-weight: 400;
}

.product-info b {
    margin-left: 3px;
    color: #188b43;
    font-size: 10px;
}

/* Brand banners */
.brand-banners {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 18px;
}

.brand-banner {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    border-radius: 10px;
    padding: 12px 20px;
}

.brand-banner div {
    z-index: 1;
}

.brand-banner strong {
    font-size: 14px;
}

.brand-banner h3 {
    margin-top: 3px;
    color: #17221f;
    font-size: 15px;
}

.brand-banner p {
    color: #243b36;
    font-size: 12px;
}

.brand-banner img {
    width: 38%;
    height: 85px;
    object-fit: contain;
}

.motorola {
    background: #eaf5d5;
}

.samsung {
    background: #dceefa;
}

.boat {
    background: #ffe1e1;
}

/* Footer */
.footer {
    background: var(--dark-green);
    color: #fff;
    padding: 25px max(24px, calc((100% - 1300px) / 2)) 14px;
}

.footer-main {
    display: grid;
    grid-template-columns: 1.5fr repeat(5, 1fr);
    gap: 24px;
    padding-bottom: 20px;
}

.footer-brand .logo {
    color: #fff;
    font-size: 20px;
}

.footer-brand p {
    margin-top: 7px;
    color: #c3d7d3;
    font-size: 11px;
}

.footer-main h4 {
    margin-bottom: 7px;
    font-size: 12px;
}

.footer-main a:not(.logo) {
    display: block;
    margin: 4px 0;
    color: #d0e0dc;
    font-size: 11px;
}

.footer-main a:hover {
    color: #fff;
}

.social-links {
    font-size: 18px;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    border-top: 1px solid #315a55;
    padding-top: 12px;
    color: #d0e0dc;
    font-size: 10px;
}

/* Responsive */
@media (max-width: 1000px) {
    .topbar {
        gap: 16px;
        padding-inline: 16px;
    }

    .account-links {
        gap: 12px;
    }

    .spotlight-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-main {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {
    .topbar {
        flex-wrap: wrap;
    }

    .search {
        order: 3;
        flex-basis: 100%;
    }

    .account-links {
        margin-left: auto;
    }

    .account-links a span {
        display: none;
    }

    .categories {
        justify-content: flex-start;
    }

    .page-content {
        padding: 12px;
    }

    .hero {
        min-height: 180px;
    }

    .hero-copy {
        padding: 18px;
    }

    .hero h1 {
        font-size: 29px;
    }

    .hero p {
        max-width: 210px;
        font-size: 12px;
    }

    .hero > img {
        position: absolute;
        right: 0;
        width: 45%;
        opacity: 0.45;
    }

    .spotlight-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .brand-banners {
        grid-template-columns: 1fr;
    }

    .footer-main {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-bottom {
        flex-direction: column;
    }
}