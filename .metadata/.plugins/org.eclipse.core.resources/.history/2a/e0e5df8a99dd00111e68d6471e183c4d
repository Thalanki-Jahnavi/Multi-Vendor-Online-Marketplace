
/* =========================================
   ONECART CUSTOMER DASHBOARD
   ========================================= */

/* FORCE THE SAME FONT EVERYWHERE */

html,
body,
body *,
body *::before,
body *::after {
    font-family: "Segoe UI", Arial, Helvetica, sans-serif !important;
}

button,
input,
select,
textarea {
    font-family: "Segoe UI", Arial, Helvetica, sans-serif !important;
}


/* COLOR VARIABLES */

:root {
    --dashboard-emerald: #087e78;
    --dashboard-deep: #123e3a;
    --dashboard-mint: #e5f4f0;
    --dashboard-background: #f7faf9;
    --dashboard-white: #ffffff;
    --dashboard-border: #e5eeeb;
    --dashboard-muted: #718783;
}


/* BASE */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    min-height: 100vh;
    color: var(--dashboard-deep);
    background: var(--dashboard-background);
    font-size: 14px;
    line-height: 1.5;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font-size: inherit;
}


/* MAIN SHELL */

.main-shell {
    min-height: 100vh;
    background: var(--dashboard-background);
}


/* =========================================
   TOPBAR
   ========================================= */

.content-topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    min-height: 94px;
    padding: 18px 40px;
    background: #ffffff;
    border-bottom: 1px solid var(--dashboard-border);
}


/* SEARCH BAR */

.dashboard-search {
    width: min(100%, 530px);
    height: 60px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 17px;
    background: #f7faf9;
    border: 1px solid var(--dashboard-border);
    border-radius: 13px;
    transition: border-color 0.2s ease,
                box-shadow 0.2s ease;
}

.dashboard-search:focus-within {
    border-color: var(--dashboard-emerald);
    box-shadow: 0 0 0 3px rgba(8, 126, 120, 0.08);
}

.search-icon {
    color: var(--dashboard-emerald);
    font-size: 25px;
    line-height: 1;
}

.dashboard-search input {
    width: 100%;
    min-width: 0;
    padding: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--dashboard-deep);
    font-size: 14px;
}

.dashboard-search input::placeholder {
    color: #899b97;
}

.dashboard-search button {
    display: none;
}


/* TOPBAR ICONS */

.topbar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.topbar-icon-link,
.topbar-profile {
    width: 47px;
    height: 47px;
    display: grid;
    place-items: center;
    color: var(--dashboard-deep);
    background: #ffffff;
    border: 1px solid var(--dashboard-border);
    border-radius: 12px;
    font-size: 21px;
    text-decoration: none;
    transition: 0.2s ease;
}

.topbar-icon-link:hover,
.topbar-profile:hover {
    color: var(--dashboard-emerald);
    background: var(--dashboard-mint);
    border-color: #c9e6de;
}


/* =========================================
   PRODUCT SECTION
   ========================================= */

.dashboard-products-main {
    min-height: calc(100vh - 170px);
    padding: 38px 40px 55px;
}


/* HEADING */

.products-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
}

.products-eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    color: var(--dashboard-emerald);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.products-heading h2 {
    margin: 0;
    color: var(--dashboard-deep);
    font-size: 27px;
    font-weight: 800;
    letter-spacing: -0.7px;
}

.products-heading p {
    margin: 8px 0 0;
    color: var(--dashboard-muted);
    font-size: 14px;
}

.view-all-products {
    flex-shrink: 0;
    color: var(--dashboard-emerald);
    font-size: 14px;
    font-weight: 700;
}

.view-all-products:hover {
    color: var(--dashboard-deep);
}


/* =========================================
   PRODUCT GRID
   ========================================= */

.dashboard-products-main .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.dashboard-products-main .product-card {
    min-width: 0;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--dashboard-border);
    border-radius: 16px;
    transition: transform 0.25s ease,
                box-shadow 0.25s ease;
}

.dashboard-products-main .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(18, 62, 58, 0.09);
}


/* PRODUCT IMAGE */

.dashboard-products-main .product-image-wrap {
    position: relative;
    height: 225px;
    margin: 0;
    overflow: hidden;
    background: #f1f7f5;
}

.dashboard-products-main .dashboard-product-image-link {
    display: block;
    width: 100%;
    height: 100%;
}

.dashboard-products-main .product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
}

.dashboard-products-main .product-card:hover .product-image {
    transform: scale(1.045);
}


/* PRODUCT BADGE */

.dashboard-products-main .product-badge {
    position: absolute;
    top: 13px;
    left: 13px;
    padding: 6px 11px;
    color: var(--dashboard-deep);
    background: var(--dashboard-mint);
    border-radius: 20px;
    font-size: 10px;
    font-weight: 800;
}


/* WISHLIST */

.dashboard-products-main .wishlist-button {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    color: var(--dashboard-deep);
    background: #ffffff;
    border-radius: 50%;
    font-size: 21px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
}

.dashboard-products-main .wishlist-button:hover {
    color: #e05268;
}


/* PRODUCT INFORMATION */

.dashboard-products-main .product-info {
    padding: 17px;
}

.dashboard-products-main .product-category {
    display: block;
    margin-bottom: 8px;
    color: var(--dashboard-emerald);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.dashboard-product-name {
    color: var(--dashboard-deep);
    text-decoration: none;
}

.dashboard-products-main .product-info h3 {
    min-height: 42px;
    margin: 0 0 12px;
    overflow: hidden;
    color: var(--dashboard-deep);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.dashboard-product-name:hover {
    color: var(--dashboard-emerald);
}


/* PRICE */

.dashboard-products-main .product-price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 15px;
}

.dashboard-products-main .product-price {
    color: var(--dashboard-deep);
    font-size: 19px;
    font-weight: 800;
}

.dashboard-products-main .product-price-row del {
    color: #91a19d;
    font-size: 12px;
}


/* VIEW PRODUCT BUTTON */

.dashboard-products-main .add-to-cart {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    color: #ffffff;
    background: var(--dashboard-emerald);
    border-radius: 9px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
}

.dashboard-products-main .add-to-cart:hover {
    background: var(--dashboard-deep);
}

.dashboard-products-main .add-to-cart span {
    font-size: 18px;
}


/* =========================================
   EMPTY PRODUCTS
   ========================================= */

.dashboard-products-main .empty-state {
    padding: 75px 20px;
    text-align: center;
    background: #ffffff;
    border: 1px dashed #cbded8;
    border-radius: 16px;
}

.dashboard-products-main .empty-icon {
    margin-bottom: 15px;
    font-size: 45px;
}

.dashboard-products-main .empty-state h3 {
    margin: 0 0 8px;
    color: var(--dashboard-deep);
    font-size: 21px;
}

.dashboard-products-main .empty-state p {
    margin: 0 0 20px;
    color: var(--dashboard-muted);
    font-size: 14px;
}

.dashboard-products-main .empty-state a {
    display: inline-block;
    padding: 11px 20px;
    color: #ffffff;
    background: var(--dashboard-emerald);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
}


/* =========================================
   FOOTER
   ========================================= */

.sidebar-page-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 20px 40px;
    color: var(--dashboard-muted);
    background: #ffffff;
    border-top: 1px solid var(--dashboard-border);
    font-size: 12px;
}


/* =========================================
   RESPONSIVE DESIGN
   ========================================= */

@media (max-width: 1250px) {

    .dashboard-products-main .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .dashboard-products-main {
        padding-right: 25px;
        padding-left: 25px;
    }

    .content-topbar {
        padding-right: 25px;
        padding-left: 25px;
    }
}


@media (max-width: 900px) {

    .dashboard-products-main .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-products-main .product-image-wrap {
        height: 220px;
    }
}


@media (max-width: 650px) {

    .content-topbar {
        min-height: 75px;
        gap: 12px;
        padding: 12px 15px;
    }

    .dashboard-search {
        height: 46px;
        flex: 1;
        width: auto;
        padding: 0 10px;
    }

    .dashboard-search input {
        font-size: 12px;
    }

    .topbar-actions {
        gap: 6px;
    }

    .topbar-icon-link,
    .topbar-profile {
        width: 35px;
        height: 35px;
        font-size: 17px;
        border-radius: 9px;
    }

    .dashboard-products-main {
        padding: 25px 15px 35px;
    }

    .products-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 22px;
    }

    .products-heading h2 {
        font-size: 23px;
    }

    .dashboard-products-main .product-grid {
        gap: 13px;
    }

    .dashboard-products-main .product-image-wrap {
        height: 180px;
    }

    .dashboard-products-main .product-info {
        padding: 12px;
    }

    .dashboard-products-main .product-info h3 {
        font-size: 13px;
    }

    .dashboard-products-main .product-price {
        font-size: 16px;
    }

    .sidebar-page-footer {
        flex-direction: column;
        align-items: flex-start;
        padding: 17px 15px;
    }
}


@media (max-width: 400px) {

    .dashboard-products-main .product-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-products-main .product-image-wrap {
        height: 250px;
    }

}
