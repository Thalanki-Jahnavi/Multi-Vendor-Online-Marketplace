:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --text: #294c48;
    --muted: #6b8581;
    --white: #ffffff;
    --border: #dcebe7;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #f8fbfa;
    color: var(--deep-green);
    font-family: Arial, Helvetica, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

.topbar {
    min-height: 76px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.brand {
    font-size: 27px;
    font-weight: 800;
    letter-spacing: -1px;
}

.brand span {
    color: var(--emerald);
}

.nav-links {
    display: flex;
    gap: 30px;
    color: var(--text);
    font-size: 14px;
}

.nav-links a:hover {
    color: var(--emerald);
}

.logout-btn {
    padding: 11px 18px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--white);
    color: var(--deep-green);
    font-weight: 700;
    cursor: pointer;
}

.logout-btn:hover {
    border-color: var(--emerald);
    color: var(--emerald);
}

.dashboard {
    width: min(1120px, 86%);
    margin: 38px auto 60px;
}

.welcome {
    min-height: 300px;
    padding: 42px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    overflow: hidden;
    position: relative;
    border-radius: 22px;
    background: var(--mint);
}

.welcome > div:first-child {
    max-width: 570px;
    position: relative;
    z-index: 1;
}

.eyebrow {
    margin: 0 0 12px;
    color: var(--emerald);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
}

.welcome h1 {
    margin: 0;
    max-width: 540px;
    color: var(--deep-green);
    font-size: clamp(30px, 4vw, 45px);
    line-height: 1.12;
    letter-spacing: -1.5px;
}

.welcome p:not(.eyebrow) {
    margin: 16px 0 25px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
}

.primary-btn {
    display: inline-block;
    padding: 13px 21px;
    border-radius: 9px;
    background: var(--emerald);
    color: var(--white);
    font-size: 14px;
    font-weight: 700;
}

.primary-btn:hover {
    background: var(--deep-green);
}

.welcome-art {
    width: 300px;
    height: 220px;
    flex: 0 0 300px;
    position: relative;
}

.art-circle {
    width: 220px;
    height: 220px;
    position: absolute;
    top: 0;
    left: 38px;
    border-radius: 50%;
    background: #bfe5dc;
}

.art-card {
    position: absolute;
    display: block;
    padding: 20px 25px;
    border-radius: 12px;
    background: var(--white);
    color: var(--deep-green);
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 14px 30px rgba(18, 62, 58, 0.09);
}

.card-one {
    top: 55px;
    left: 0;
    transform: rotate(-5deg);
}

.card-two {
    right: 0;
    bottom: 18px;
    transform: rotate(5deg);
}

.quick-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 24px;
}

.quick-card {
    min-height: 110px;
    padding: 22px;
    display: flex;
    align-items: center;
    gap: 15px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
    transition: transform 0.2s, border-color 0.2s;
}

.quick-card:hover {
    transform: translateY(-3px);
    border-color: #a8d6cc;
}

.quick-icon {
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 24px;
}

.quick-card strong,
.quick-card small {
    display: block;
}

.quick-card strong {
    margin-bottom: 7px;
    font-size: 15px;
}

.quick-card small {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
}

.arrow {
    margin-left: auto;
    color: var(--emerald);
    font-size: 20px;
}

.section-heading {
    margin: 42px 0 18px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
}

.section-heading h2 {
    margin: 0;
    font-size: 25px;
    letter-spacing: -0.5px;
}

.section-heading > p {
    color: var(--muted);
    font-size: 13px;
}

.info-panel {
    padding: 23px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
}

.info-mark {
    width: 35px;
    height: 35px;
    flex: 0 0 35px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--mint);
    color: var(--emerald);
    font-weight: 800;
}

.info-panel h3 {
    margin: 2px 0 8px;
    font-size: 16px;
}

.info-panel p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
}

.footer {
    padding: 25px 7%;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--border);
    background: var(--white);
    color: var(--muted);
    font-size: 12px;
}

@media (max-width: 800px) {
    .topbar {
        padding: 18px 6%;
        flex-wrap: wrap;
    }

    .nav-links {
        order: 3;
        width: 100%;
        justify-content: center;
        gap: 18px;
    }

    .dashboard {
        width: 90%;
        margin-top: 24px;
    }

    .welcome {
        padding: 32px;
    }

    .welcome-art {
        display: none;
    }

    .quick-links {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .welcome {
        padding: 27px 23px;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .footer {
        flex-direction: column;
    }
}
.featured-products {
    margin-top: 38px;
}

.section-heading {
    margin: 0 0 18px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
}

.section-heading h2 {
    margin: 0;
    font-size: 25px;
    letter-spacing: -0.5px;
}

.view-all {
    color: var(--emerald);
    font-size: 13px;
    font-weight: 700;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.product-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
}

.product-placeholder {
    min-height: 145px;
    display: grid;
    place-items: center;
    background: var(--mint);
    color: var(--emerald);
    font-size: 20px;
    font-weight: 800;
}

.product-info {
    padding: 16px;
}

.product-info h3 {
    min-height: 40px;
    margin: 0 0 12px;
    color: var(--deep-green);
    font-size: 15px;
    line-height: 1.4;
}

.price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
}

.price-row strong {
    color: var(--deep-green);
    font-size: 17px;
}

.original-price {
    color: var(--muted);
    font-size: 12px;
    text-decoration: line-through;
}

.discount-label {
    margin: 8px 0;
    color: var(--emerald);
    font-size: 12px;
    font-weight: 700;
}

.add-cart-btn {
    width: 100%;
    margin-top: 12px;
    padding: 11px;
    border: 0;
    border-radius: 8px;
    background: #dcebe7;
    color: var(--muted);
    font-weight: 700;
    cursor: not-allowed;
}

.empty-products {
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--white);
    color: var(--muted);
}

@media (max-width: 900px) {
    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 480px) {
    .product-grid {
        grid-template-columns: 1fr;
    }
}