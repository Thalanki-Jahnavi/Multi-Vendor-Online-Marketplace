<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Shop Everything</title>
    <link rel="stylesheet" th:href="@{/css/home.css}">
</head>
<body>

<header class="site-header">
    <div class="top-strip">
        <p>Discover great products from trusted sellers</p>
        <p>OneCart — one place for everything</p>
    </div>

    <div class="header-main">
        <a class="brand" th:href="@{/}">
            <span class="brand-icon">O</span>
            <span>One<span>Cart</span></span>
        </a>

        <form class="search-form" th:action="@{/products}" method="get">
            <input type="search" name="keyword" placeholder="Search products..." aria-label="Search products">
            <button type="submit" aria-label="Search">⌕</button>
        </form>

        <div class="header-actions">
            <a class="header-action" th:href="@{/login}">
                <span class="action-icon">♙</span>
                <span>Account</span>
            </a>
            <a class="header-action" th:href="@{/login}">
                <span class="action-icon">♡</span>
                <span>Wishlist <b id="wishlist-count">0</b></span>
            </a>
            <a class="header-action" th:href="@{/cart}">
                <span class="action-icon">🛒</span>
                <span>Cart <b id="cart-count">0</b></span>
            </a>
        </div>
    </div>

    <nav class="main-nav">
        <a class="active" th:href="@{/}">Home</a>
        <a href="#categories">Categories</a>
        <a href="#products">Products</a>
        <a href="#vendors">Vendors</a>
        <a th:href="@{/about}">About</a>
        <a th:href="@{/contact}">Contact</a>
    </nav>
</header>

<main>
    <section class="hero">
        <div class="hero-content">
            <span class="eyebrow">WELCOME TO ONECART</span>
            <h1>Everything you love.<br><span>All in one cart.</span></h1>
            <p>Explore products from independent sellers and find something you'll love.</p>

            <div class="hero-actions">
                <a class="button button-primary" href="#products">Shop now <span>→</span></a>
                <a class="button button-light" href="#vendors">Explore vendors</a>
            </div>

            <div class="hero-trust">
                <span>✓ Trusted sellers</span>
                <span>✓ Easy shopping</span>
                <span>✓ Great finds</span>
            </div>
        </div>

        <div class="hero-art" aria-hidden="true">
            <div class="hero-circle"></div>
            <div class="hero-card hero-card-back">
                <span class="hero-card-icon">✦</span>
                <span>Everyday essentials</span>
            </div>
            <div class="hero-card hero-card-front">
                <div class="hero-bag">🛍️</div>
                <strong>Find your next favorite</strong>
                <span>Shop OneCart</span>
            </div>
            <div class="floating-tag tag-top">Fresh finds</div>
            <div class="floating-tag tag-bottom">Made for you ♡</div>
        </div>
    </section>

    <section class="benefits">
        <div class="benefit">
            <span class="benefit-icon">✦</span>
            <div>
                <strong>Curated finds</strong>
                <small>Discover something new</small>
            </div>
        </div>
        <div class="benefit">
            <span class="benefit-icon">♧</span>
            <div>
                <strong>Independent vendors</strong>
                <small>Shop from trusted sellers</small>
            </div>
        </div>
        <div class="benefit">
            <span class="benefit-icon">♡</span>
            <div>
                <strong>Simple shopping</strong>
                <small>Your favorites in one place</small>
            </div>
        </div>
    </section>

    <section class="section categories-section" id="categories">
        <div class="section-heading">
            <div>
                <span class="eyebrow">EXPLORE</span>
                <h2>Shop by category</h2>
                <p>Find the things you need, and the things you didn't know you needed.</p>
            </div>
            <a class="text-link" href="#products">Browse products <span>→</span></a>
        </div>

        <div class="category-grid">
            <a class="category-card category-fashion" href="#products">
                <span class="category-emoji">👕</span>
                <span class="category-name">Fashion</span>
                <span class="category-note">Everyday style</span>
            </a>
            <a class="category-card category-electronics" href="#products">
                <span class="category-emoji">🎧</span>
                <span class="category-name">Electronics</span>
                <span class="category-note">Tech favorites</span>
            </a>
            <a class="category-card category-home" href="#products">
                <span class="category-emoji">🏡</span>
                <span class="category-name">Home & Living</span>
                <span class="category-note">Make it yours</span>
            </a>
            <a class="category-card category-beauty" href="#products">
                <span class="category-emoji">🌿</span>
                <span class="category-name">Beauty</span>
                <span class="category-note">Little luxuries</span>
            </a>
        </div>
    </section>

    <section class="section products-section" id="products">
        <div class="section-heading">
            <div>
                <span class="eyebrow">HANDPICKED FOR YOU</span>
                <h2>Popular products</h2>
                <p>Take a look at some of the products available on OneCart.</p>
            </div>
            <a class="text-link" th:href="@{/products}">View all products <span>→</span></a>
        </div>

        <div class="product-grid" th:if="${products != null and !products.isEmpty()}">
            <article class="product-card" th:each="product : ${products}">
                <div class="product-image-wrap">
                    <img class="product-image"
                         th:src="@{/images/products/Ceramic Coffee Mug.jpg}"
                         th:alt="${product.productName}"
                         th:attr="data-product-name=${product.productName}"
                         loading="lazy">

                    <span class="product-badge">Popular</span>

                    <button class="wishlist-button"
                            type="button"
                            aria-label="Add to wishlist"
                            th:attr="data-product-id=${product.productId},data-product-name=${product.productName}">
                        ♡
                    </button>
                </div>

                <div class="product-info">
                    <span class="product-category">ONECART FIND</span>
                    <h3 th:text="${product.productName}">Product name</h3>

                    <div class="product-price-row">
                        <strong class="product-price"
                                th:text="${product.price != null ? '₹' + #numbers.formatDecimal(product.price, 1, 2) : 'Price unavailable'}">
                            ₹0.00
                        </strong>
                    </div>

                    <button class="add-to-cart"
                            type="button"
                            th:attr="data-product-id=${product.productId},data-product-name=${product.productName},data-product-price=${product.price}">
                        Add to cart <span>＋</span>
                    </button>
                </div>
            </article>
        </div>

        <div class="empty-state" th:if="${products == null or products.isEmpty()}">
            <div class="empty-icon">🛍️</div>
            <h3>Products are on their way</h3>
            <p>Check back soon to discover new finds from our vendors.</p>
        </div>
    </section>

    <section class="vendor-section" id="vendors">
        <div class="section vendor-content">
            <div class="vendor-copy">
                <span class="eyebrow">SELL WITH ONECART</span>
                <h2>Have something<br>great to share?</h2>
                <p>Bring your products to OneCart and connect with shoppers looking for their next favorite find.</p>
                <a class="button button-primary" th:href="@{/vendor/register}">
                    Become a vendor <span>→</span>
                </a>
            </div>

            <div class="vendor-panel">
                <div class="vendor-panel-heading">
                    <div>
                        <span class="eyebrow">OUR COMMUNITY</span>
                        <h3>Meet our vendors</h3>
                    </div>
                    <span class="vendor-star">✦</span>
                </div>

                <div class="vendor-list" th:if="${vendors != null and !vendors.isEmpty()}">
                    <div class="vendor-row" th:each="vendor : ${vendors}">
                        <span class="vendor-avatar"
                              th:text="${vendor.businessName != null and !vendor.businessName.isEmpty() ? #strings.substring(vendor.businessName, 0, 1).toUpperCase() : 'V'}">V</span>
                        <div>
                            <strong th:text="${vendor.businessName != null ? vendor.businessName : 'OneCart Vendor'}">Vendor name</strong>
                            <small>OneCart seller</small>
                        </div>
                        <span class="vendor-arrow">→</span>
                    </div>
                </div>

                <p class="vendor-empty" th:if="${vendors == null or vendors.isEmpty()}">
                    New vendors are joining OneCart soon.
                </p>
            </div>
        </div>
    </section>

    <section class="about-strip" id="about">
        <div class="section about-inner">
            <div>
                <span class="eyebrow">ABOUT ONECART</span>
                <h2>A little more choice.<br>A lot more discovery.</h2>
            </div>
            <p>OneCart brings customers and independent vendors together in one simple marketplace. Browse, discover, and shop your way.</p>
        </div>
    </section>
</main>

<footer class="site-footer" id="contact">
    <div class="footer-main">
        <div class="footer-brand">
            <a class="brand brand-footer" th:href="@{/}">
                <span class="brand-icon">O</span>
                <span>One<span>Cart</span></span>
            </a>
            <p>Discover more. Shop simply.</p>
        </div>

        <div class="footer-links">
            <strong>Explore</strong>
            <a href="#categories">Categories</a>
            <a href="#products">Products</a>
            <a href="#vendors">Vendors</a>
        </div>

        <div class="footer-links">
            <strong>Help</strong>
            <a th:href="@{/login}">My account</a>
            <a th:href="@{/contact}">Contact us</a>
            <a th:href="@{/about}">About OneCart</a>
        </div>

        <div class="footer-contact">
            <strong>Stay connected</strong>
            <p>Have a question? We'd love to hear from you.</p>
            <a th:href="@{/contact}">Get in touch <span>→</span></a>
        </div>
    </div>

    <div class="footer-bottom">
        <span>© <span id="current-year"></span> OneCart. All rights reserved.</span>
        <span>Made for everyday discoveries <span class="footer-heart">♡</span></span>
    </div>
</footer>

<script>
    (() => {
        const imagePath = "/images/products/";
        const defaultImage = imagePath + "Ceramic Coffee Mug.jpg";

        function imageForProduct(productName) {
            const name = (productName || "").toLowerCase();

            if (name.includes("shirt") || name.includes("t-shirt")) {
                return imagePath + "Cotton T-Shirt.jpg";
            }
            if (name.includes("shoe") || name.includes("sneaker")) {
                return imagePath + "Running Shoes.jpg";
            }
            if (name.includes("watch")) {
                return imagePath + "Smart Watch.webp";
            }
            if (name.includes("speaker")) {
                return imagePath + "Bluetooth Speaker.png";
            }
            if (name.includes("headphone") || name.includes("headset")) {
                return imagePath + "Wireless Headphones.png";
            }
            if (name.includes("mouse")) {
                return imagePath + "Wireless Mouse.jpg";
            }
            if (name.includes("bag") || name.includes("backpack")) {
                return imagePath + "Travel back pack.jpg";
            }
            if (name.includes("mug") || name.includes("cup")) {
                return imagePath + "Ceramic Coffee Mug.jpg";
            }

            return defaultImage;
        }

        document.querySelectorAll(".product-image").forEach((image) => {
            image.src = imageForProduct(image.dataset.productName);
            image.onerror = () => {
                image.onerror = null;
                image.src = defaultImage;
            };
        });

        function readStorage(key) {
            try {
                return JSON.parse(localStorage.getItem(key)) || [];
            } catch (error) {
                return [];
            }
        }

        function writeStorage(key, value) {
            localStorage.setItem(key, JSON.stringify(value));
        }

        function updateCounts() {
            const wishlist = readStorage("onecart-wishlist");
            const cart = readStorage("onecart-cart");

            document.getElementById("wishlist-count").textContent = wishlist.length;
            document.getElementById("cart-count").textContent =
                cart.reduce((total, item) => total + (item.quantity || 1), 0);
        }

        document.querySelectorAll(".wishlist-button").forEach((button) => {
            button.addEventListener("click", () => {
                const wishlist = readStorage("onecart-wishlist");
                const productId = button.dataset.productId;

                const existingIndex = wishlist.findIndex(
                    (item) => String(item.productId) === productId
                );

                if (existingIndex >= 0) {
                    wishlist.splice(existingIndex, 1);
                    button.classList.remove("is-active");
                    button.textContent = "♡";
                } else {
                    wishlist.push({
                        productId: productId,
                        productName: button.dataset.productName
                    });
                    button.classList.add("is-active");
                    button.textContent = "♥";
                }

                writeStorage("onecart-wishlist", wishlist);
                updateCounts();
            });
        });

        document.querySelectorAll(".add-to-cart").forEach((button) => {
            button.addEventListener("click", () => {
                const cart = readStorage("onecart-cart");
                const productId = button.dataset.productId;

                const existingItem = cart.find(
                    (item) => String(item.productId) === productId
                );

                if (existingItem) {
                    existingItem.quantity = (existingItem.quantity || 1) + 1;
                } else {
                    cart.push({
                        productId: productId,
                        productName: button.dataset.productName,
                        price: Number(button.dataset.productPrice) || 0,
                        quantity: 1
                    });
                }

                writeStorage("onecart-cart", cart);
                updateCounts();

                const originalText = button.innerHTML;
                button.innerHTML = "Added to cart ✓";

                window.setTimeout(() => {
                    button.innerHTML = originalText;
                }, 1200);
            });
        });

        document.getElementById("current-year").textContent = new Date().getFullYear();
        updateCounts();
    })();
</script>

</body>
</html>