<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OneCart | Shop Everything</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/script.js" defer></script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/guest/index.html">
      <span class="brand-mark">O</span>
      <span>OneCart</span>
    </a>

    <nav class="main-nav" aria-label="Main categories">
      <button class="category-button" data-category="Fashion">Women</button>
      <button class="category-button" data-category="Fashion">Men</button>
      <button class="category-button" data-category="Electronics">Electronics</button>
      <button class="category-button" data-category="Home">Home &amp; Living</button>
      <button class="category-button" data-category="Beauty">Beauty</button>
      <button class="category-button" data-category="Fitness">Fitness</button>
      <button class="category-button" data-category="Books">Books</button>
    </nav>

    <form id="searchForm" class="search-box">
      <span aria-hidden="true">⌕</span>
      <input id="searchInput" type="search" placeholder="Search products, brands and sellers">
    </form>

    <div class="header-actions">
      <button id="accountButton" class="header-action">
        <span class="action-icon">♙</span><span>Profile</span>
      </button>
      <button class="header-action" type="button">
        <span class="action-icon">♡</span><span>Wishlist</span>
      </button>
      <button id="openCartButton" class="header-action bag-action" type="button">
        <span class="action-icon">♧<span id="cartCount" class="cart-count">0</span></span>
        <span>Bag</span>
      </button>
    </div>
  </header>

  <main class="page-content">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">NEW SEASON COLLECTION</p>
        <h1>Style, Tech, Home<br>&amp; More</h1>
        <p>Explore a wide range of products from<br>trusted sellers.</p>
        <a class="shop-button" href="#trending">Shop Now <span>→</span></a>
      </div>
      <div class="hero-art">
        <div class="hero-orb"></div>
        <img
          src="https://images.unsplash.com/photo- shopping?auto=format&fit=crop&w=700&q=85"
          alt=""
          onerror="this.style.display='none'"
        >
        <div class="discount-bubble">UP TO<strong>60%</strong>OFF</div>
      </div>
      <button class="hero-arrow hero-prev" type="button" aria-label="Previous banner">‹</button>
      <button class="hero-arrow hero-next" type="button" aria-label="Next banner">›</button>
    </section>

    <div class="hero-dots" aria-hidden="true">
      <span class="active"></span><span></span><span></span><span></span>
    </div>

    <section class="category-section">
      <div class="section-heading">
        <h2>Shop by Category</h2>
        <button class="view-all category-button" data-category="All">View All <span>→</span></button>
      </div>

      <div class="category-tiles">
        <button class="category-tile fashion category-button" data-category="Fashion">
          <span class="tile-emoji">👗</span><span>Fashion</span>
        </button>
        <button class="category-tile electronics category-button" data-category="Electronics">
          <span class="tile-emoji">🎧</span><span>Electronics</span>
        </button>
        <button class="category-tile home category-button" data-category="Home">
          <span class="tile-emoji">🪑</span><span>Home &amp; Living</span>
        </button>
        <button class="category-tile beauty category-button" data-category="Beauty">
          <span class="tile-emoji">🧴</span><span>Beauty</span>
        </button>
        <button class="category-tile fitness category-button" data-category="Fitness">
          <span class="tile-emoji">🏋️</span><span>Fitness</span>
        </button>
        <button class="category-tile books category-button" data-category="Books">
          <span class="tile-emoji">📚</span><span>Books</span>
        </button>
      </div>
    </section>

    <section id="trending" class="products-section">
      <div class="products-toolbar">
        <h2>Trending Products</h2>
        <div class="product-filters">
          <button class="category-button active" data-category="All">All</button>
          <button class="category-button" data-category="Fashion">Fashion</button>
          <button class="category-button" data-category="Electronics">Electronics</button>
          <button class="category-button" data-category="Home">Home</button>
          <button class="category-button" data-category="Beauty">Beauty</button>
          <button class="category-button" data-category="Fitness">Fitness</button>
          <button class="category-button" data-category="Books">Books</button>
        </div>
        <label class="sort-control">
          <span>Sort by:</span>
          <select id="sortSelect">
            <option value="featured">Featured</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="name">Name</option>
          </select>
        </label>
      </div>

      <p id="resultSummary" class="result-summary"></p>
      <div id="productGrid" class="product-grid"></div>

      <div id="emptyState" class="empty-state" hidden>
        <h3>No products found</h3>
        <p>Try another search or category.</p>
      </div>
    </section>
  </main>

  <div id="cartOverlay" class="cart-overlay">
    <aside class="cart-panel" aria-label="Shopping cart">
      <div class="cart-heading">
        <h2>Your Bag</h2>
        <button id="closeCartButton" type="button" aria-label="Close cart">×</button>
      </div>
      <div id="cartItems" class="cart-items"></div>
      <div class="cart-footer">
        <div class="subtotal-row"><span>Subtotal</span><strong id="cartSubtotal">₹0</strong></div>
        <button id="checkoutButton" class="checkout-button" type="button">Proceed to Checkout</button>
        <button id="continueShoppingButton" class="continue-button" type="button">Continue Shopping</button>
      </div>
    </aside>
  </div>

  <div id="toast" class="toast" role="status"></div>
</body>
</html>