
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #ffffff;
    color: #123e3a;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 8%;
    background: #ffffff;
}

.logo {
    font-size: 28px;
    font-weight: bold;
    color: #087e78;
    text-decoration: none;
}

nav {
    display: flex;
    gap: 30px;
}

nav a,
.login-btn {
    text-decoration: none;
    color: #123e3a;
}

.auth-links {
    display: flex;
    gap: 20px;
    align-items: center;
}

.signup-btn,
.shop-btn {
    background: #087e78;
    color: white;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
}

.hero {
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: 8%;
    background: #e5f4f0;
}

.hero-content {
    max-width: 650px;
}

.tagline {
    color: #087e78;
    font-weight: bold;
    letter-spacing: 2px;
}

h1 {
    font-size: 58px;
    line-height: 1.2;
    margin: 20px 0;
}

.description {
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 30px;
}
