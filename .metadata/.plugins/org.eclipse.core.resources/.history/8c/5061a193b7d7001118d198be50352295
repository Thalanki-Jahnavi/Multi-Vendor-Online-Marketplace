<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Home</title>
    <link rel="stylesheet" th:href="@{/css/home.css}">
</head>
<body>

    <div class="topbar">
        Discover products from multiple vendors in one place
    </div>

    <header class="header">
        <a class="logo" th:href="@{/}">OneCart</a>

        <form class="search" th:action="@{/}" method="get">
            <input type="search" name="q" placeholder="Search products...">
            <button type="submit">Search</button>
        </form>

        <div class="header-links">
            <a th:href="@{/login}">Login</a>
            <a th:href="@{/signup}">Sign up</a>
        </div>
    </header>

    <nav class="nav">
        <a th:href="@{/}">Home</a>
        <a th:href="@{/shop}">Shop</a>
        <a th:href="@{/about}">About Us</a>
        <a th:href="@{/contact}">Contact</a>
    </nav>

    <main>
        <!-- Hero section -->
        <section class="hero">
            <div class="hero-content">
                <p class="eyebrow">WELCOME TO ONECART</p>
                <h1>Find something you’ll love.</h1>
                <p class="hero-description">
                    Explore products from different vendors, compare your favorites,
                    and shop from one convenient marketplace.
                </p>
                <a class="primary-button" th:href="@{/shop}">Explore Products</a>
            </div>
        </section>

        <!-- Featured products -->
        <section class="section" id="featured-products">
            <div class="section-heading">
                <div>
                    <h2>Featured Products</h2>
                    <p>Discover items available in the OneCart marketplace.</p>
                </div>
                <a class="text-link" th:href="@{/shop}">View all products</a>
            </div>

            <div class="product-grid" th:if="${products != null and !products.isEmpty()}">
                <article class="product-card" th:each="product : ${products}">
                    <div class="product-image">
                        <span>OneCart Product</span>
                    </div>

                    <div class="product-info">
                        <h3 th:text="${product.productName}">Product name</h3>
                        <p class="product-price">
                            ₹<span th:text="${#numbers.formatDecimal(product.price, 1, 2)}">0.00</span>
                        </p>
                    </div>
                </article>
            </div>

            <div class="empty-state" th:if="${products == null or products.isEmpty()}">
                <h3>No featured products yet</h3>
                <p>Products will appear here when vendors add them to OneCart.</p>
            </div>
        </section>

        <!-- Vendor stores -->
        <section class="section stores-section" id="vendor-stores">
            <div class="section-heading">
                <div>
                    <h2>Explore Our Stores</h2>
                    <p>Shop from independent vendors, all in one place.</p>
                </div>
                <a class="text-link" th:href="@{/signup}">Become a vendor</a>
            </div>

            <div class="store-grid">
                <article class="store-card">
                    <div class="store-icon">S</div>
                    <div>
                        <h3>Discover new stores</h3>
                        <p>Find products from different vendors on OneCart.</p>
                    </div>
                    <a th:href="@{/shop}">Explore products <span aria-hidden="true">→</span></a>
                </article>

                <article class="store-card">
                    <div class="store-icon">+</div>
                    <div>
                        <h3>Open your own store</h3>
                        <p>Register as a vendor and start listing your products.</p>
                    </div>
                    <a th:href="@{/signup}">Become a vendor <span aria-hidden="true">→</span></a>
                </article>
            </div>
        </section>

        <!-- Marketplace benefits -->
        <section class="benefits">
            <div>
                <span class="benefit-symbol">✓</span>
                <h3>Many vendors</h3>
                <p>Discover products from different sellers.</p>
            </div>
            <div>
                <span class="benefit-symbol">⌕</span>
                <h3>Easy discovery</h3>
                <p>Find items for your everyday needs.</p>
            </div>
            <div>
                <span class="benefit-symbol">♡</span>
                <h3>One convenient place</h3>
                <p>Explore the marketplace with ease.</p>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-main">
            <div class="footer-brand">
                <a class="footer-logo" th:href="@{/}">OneCart</a>
                <p>Shop smarter, all in one place.</p>
                <p class="footer-tagline">A marketplace bringing customers and vendors together.</p>
            </div>

            <div class="footer-column">
                <h3>Explore</h3>
                <a th:href="@{/}">Home</a>
                <a th:href="@{/shop}">Shop products</a>
                <a th:href="@{/signup}">Become a vendor</a>
            </div>

            <div class="footer-column">
                <h3>About OneCart</h3>
                <a th:href="@{/about}">About Us</a>
                <a th:href="@{/contact}">Contact Us</a>
            </div>

            <div class="footer-column">
                <h3>Your Account</h3>
                <a th:href="@{/login}">Login</a>
                <a th:href="@{/signup}">Create an account</a>
            </div>
        </div>

        <div class="footer-bottom">
            <span>© 2026 OneCart. All rights reserved.</span>
            <span>Shop smarter, all in one place.</span>
        </div>
    </footer>

</body>
</html>