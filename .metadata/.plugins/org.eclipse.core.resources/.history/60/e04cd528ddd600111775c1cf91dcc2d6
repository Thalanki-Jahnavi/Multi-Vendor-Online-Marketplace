<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OneCart | Multi-Vendor Marketplace</title>

    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>

<body>

    <!-- Header -->
    <header class="header">
        <a th:href="@{/}" class="logo">One<span>Cart</span></a>

        <nav class="nav-links">
            <a th:href="@{/}">Home</a>
            <a href="#categories">Categories</a>
            <a href="#about">About Us</a>
            <a href="#contact">Contact</a>
        </nav>

        <div class="header-actions">
            <a th:href="@{/login}" class="login-btn">Login</a>
            <a th:href="@{/signup}" class="signup-btn">Sign Up</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <p class="hero-label">WELCOME TO ONECART</p>

            <h1>
                Everything you love,<br>
                all in <span>OneCart.</span>
            </h1>

            <p class="hero-description">
                Discover amazing products from multiple vendors
                and enjoy a seamless shopping experience.
            </p>

            <a th:href="@{/login}" class="primary-btn">
                Start Shopping →
            </a>
        </div>

        <div class="hero-image">
            <img th:src="@{/images/hero-shopping.png}"
                 alt="OneCart online shopping">
        </div>
    </section>

    <!-- Categories -->
    <section class="categories section" id="categories">
        <div class="section-heading">
            <div>
                <p class="section-label">EXPLORE ONECART</p>
                <h2>Shop by category</h2>
            </div>
        </div>

        <div class="category-grid">
            <div class="category-card">
                <span>👕</span>
                <h3>Fashion</h3>
            </div>

            <div class="category-card">
                <span>📱</span>
                <h3>Electronics</h3>
            </div>

            <div class="category-card">
                <span>🏠</span>
                <h3>Home & Living</h3>
            </div>

            <div class="category-card">
                <span>✨</span>
                <h3>Beauty</h3>
            </div>
        </div>
    </section>

    <!-- Products -->
    <section class="products section">
        <div class="section-heading">
            <div>
                <p class="section-label">DISCOVER MORE</p>
                <h2>Featured products</h2>
            </div>
        </div>

        <div class="product-grid">
            <div class="empty-products">
                <h3>Discover something amazing</h3>
                <p>
                    Our products will appear here once the
                    database integration is complete.
                </p>
            </div>
        </div>
    </section>

    <!-- About -->
    <section class="about section" id="about">
        <div>
            <p class="section-label">ABOUT ONECART</p>
            <h2>One marketplace.<br>Endless possibilities.</h2>
        </div>

        <p>
            OneCart brings customers and independent vendors
            together in one convenient online marketplace.
            Discover products, explore stores, and shop with ease.
        </p>
    </section>

    <!-- Footer -->
    <footer class="footer" id="contact">
        <div>
            <a th:href="@{/}" class="logo">One<span>Cart</span></a>
            <p>Your shopping destination, all in one place.</p>
        </div>

        <div class="footer-links">
            <a href="#about">About Us</a>
            <a href="#contact">Contact Us</a>
            <a th:href="@{/login}">Login</a>
            <a th:href="@{/signup}">Sign Up</a>
        </div>

        <p class="copyright">
            © 2026 OneCart. All rights reserved.
        </p>
    </footer>

</body>
</html>