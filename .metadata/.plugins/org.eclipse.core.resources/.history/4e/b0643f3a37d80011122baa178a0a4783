:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --page: #f7fbfa;
    --text: #173f3b;
    --muted: #718b88;
    --border: #d9eae6;
    --white: #ffffff;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--page);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

/* Header */
.site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.header-inner {
    width: min(1200px, calc(100% - 48px));
    min-height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
}

.brand {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--deep-green);
}

.brand span {
    color: var(--emerald);
}

.main-nav {
    display: flex;
    align-items: center;
    gap: 28px;
}

.main-nav a {
    padding: 28px 0;
    color: #607b77;
    font-size: 14px;
    font-weight: 600;
    border-bottom: 3px solid transparent;
}

.main-nav a:hover,
.main-nav a.active {
    color: var(--emerald);
    border-bottom-color: var(--emerald);
}

.logout-form {
    margin: 0;
}

.logout-button {
    padding: 11px 18px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--white);
    color: var(--deep-green);
    font-weight: 700;
    cursor: pointer;
}

.logout-button:hover {
    border-color: var(--emerald);
    color: var(--emerald);
}

/* Main content */
.page-content {
    width: min(1200px, calc(100% - 48px));
    margin: 32px auto 56px;
}

.welcome-banner {
    min-height: 260px;
    padding: 42px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    overflow: hidden;
    border-radius: 20px;
    background: var(--mint);
}

.welcome-copy {
    max-width: 650px;
}

.eyebrow {
    margin: 0 0 12px;
    color: var(--emerald);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
}

.welcome-banner h1 {
    margin: 0;
    color: var(--deep-green);
    font-size: clamp(30px, 4vw, 42px);
    letter-spacing: -1.5px;
}

.welcome-banner p:not(.eyebrow) {
    margin: 14px 0 24px;
    color: var(--muted);
    line-height: 1.6;
}

.primary-button {
    display: inline-block;
    padding: 13px 20px;
    border-radius: 9px;
    background: var(--emerald);
    color: var(--white);
    font-size: 14px;
    font-weight: 700;
}

.primary-button:hover {
    background: var(--deep-green);
}

.banner-art {
    position: relative;
    width: 280px;
    height: 190px;
    flex: 0 0 280px;
}

.art-circle {
    position: absolute;
    top: 5px;
    right: 30px;
    width: 185px;
    height: 185px;
    border-radius: 50%;
    background: #bfe7dc;
}

.art-note {
    position: absolute;
    padding: 17px 22px;
    border-radius: 12px;
    background: var(--white);
    box-shadow: 0 12px 28px #123e3a12;
    color: var(--deep-green);
    font-size: 13px;
    font-weight: 700;
    transform: rotate(-4deg);
}

.note-one {
    top: 48px;
    left: 0;
}

.note-two {
    right: 0;
    bottom: 15px;
    transform: rotate(5deg);
}

/* Shortcut cards */
.quick-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 22px 0 48px;
}

.quick-card {
    min-height: 100px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.quick-card:hover {
    transform: translateY(-3px);
    border-color: #9dcfc4;
}

.quick-icon,
.success-icon,
.empty-icon {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 25px;
}

.quick-card strong,
.quick-card small {
    display: block;
}

.quick-card strong {
    margin-bottom: 7px;
    font-size: 14px;
}

.quick-card small {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.4;
}

.card-arrow {
    margin-left: auto;
    color: var(--emerald);
    font-size: 24px;
}

/* Featured products */
.featured-section {
    margin-bottom: 36px;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
}

.section-heading h2 {
    margin: 0;
    color: var(--deep-green);
    font-size: 27px;
    letter-spacing: -0.5px;
}

.section-heading p:not(.eyebrow) {
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 14px;
}

.text-link {
    color: var(--emerald);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
}

.text-link span {
    margin-left: 8px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.product-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
}

.product-image-placeholder {
    min-height: 170px;
    display: grid;
    place-items: center;
    background: #edf7f4;
    color: #9abbb4;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
}

.product-info {
    padding: 17px;
}

.product-info h3 {
    margin: 0 0 12px;
    color: var(--deep-green);
    font-size: 15px;
}

.product-price {
    margin: 0 0 14px;
    color: var(--emerald);
    font-size: 18px;
    font-weight: 800;
}

.product-link {
    color: var(--emerald);
    font-size: 13px;
    font-weight: 700;
}

.empty-products {
    min-height: 205px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px dashed #c5ded8;
    border-radius: 17px;
    background: #fbfefd;
    text-align: center;
}

.empty-icon {
    margin-bottom: 12px;
    border-radius: 50%;
}

.empty-products h3 {
    margin: 0 0 8px;
    font-size: 20px;
}

.empty-products p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
}

/* Account note */
.account-note {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
}

.success-icon {
    border-radius: 50%;
    font-size: 25px;
}

.account-note strong {
    font-size: 14px;
}

.account-note p {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
}

/* Footer */
.site-footer {
    border-top: 1px solid var(--border);
    background: var(--white);
}

.footer-main,
.footer-bottom {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
}

.footer-main {
    padding: 42px 0;
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 36px;
}

.footer-brand p {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 13px;
}

.footer-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.footer-column h3 {
    margin: 4px 0 5px;
    color: var(--deep-green);
    font-size: 14px;
}

.footer-column a {
    color: var(--muted);
    font-size: 13px;
}

.footer-column a:hover {
    color: var(--emerald);
}

.footer-bottom {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 12px;
}

/* Responsive layout */
@media (max-width: 900px) {
    .header-inner {
        flex-wrap: wrap;
        padding: 16px 0;
    }

    .main-nav {
        order: 3;
        width: 100%;
        justify-content: center;
        gap: 22px;
    }

    .main-nav a {
        padding: 10px 0;
    }

    .quick-links {
        grid-template-columns: 1fr;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-main {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .header-inner,
    .page-content,
    .footer-main,
    .footer-bottom {
        width: min(100% - 28px, 1200px);
    }

    .main-nav {
        justify-content: flex-start;
        gap: 16px;
        overflow-x: auto;
    }

    .main-nav a {
        white-space: nowrap;
        font-size: 12px;
    }

    .welcome-banner {
        padding: 28px 24px;
    }

    .banner-art {
        display: none;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .footer-main {
        grid-template-columns: 1fr 1fr;
        gap: 28px 18px;
    }
	
	.customer-footer {
	    background: #e5f4f0;
	    border-top: 1px solid #d5e9e4;
	}

    .footer-bottom {
        align-items: flex-start;
        flex-direction: column;
        justify-content: center;
        padding: 16px 0;
    }
}