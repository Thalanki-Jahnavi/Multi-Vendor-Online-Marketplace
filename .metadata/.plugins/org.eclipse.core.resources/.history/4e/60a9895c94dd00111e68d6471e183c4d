
:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --light-bg: #f7faf9;
    --white: #ffffff;
    --text: #243d39;
    --muted: #81918d;
    --border: #e9efed;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--light-bg);
    color: var(--text);
    font-family: "Segoe UI", Arial, sans-serif;
}

a {
    text-decoration: none;
}

/* TOP BAR */

.content-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.dashboard-search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(460px, 55%);
    padding: 12px 17px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #f8fbfa;
    color: var(--muted);
    font-size: 14px;
}

.dashboard-search span {
    color: var(--emerald);
    font-size: 22px;
}

.dashboard-search a {
    color: var(--muted);
}

.dashboard-top-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.top-action,
.profile-shortcut {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: white;
    color: var(--deep-green);
    font-size: 20px;
}

.top-action:hover,
.profile-shortcut:hover {
    border-color: var(--emerald);
    color: var(--emerald);
}

/* MAIN CONTENT */

.dashboard-content {
    width: 100%;
    max-width: 1600px;
    margin: auto;
    padding: 30px 38px 55px;
}

/* WELCOME SECTION */

.dashboard-welcome {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 245px;
    overflow: hidden;
    padding: 38px 45px;
    border: 1px solid #dceee9;
    border-radius: 16px;
    background: linear-gradient(110deg, #e5f4f0, #f4faf8);
}

.welcome-label,
.section-eyebrow {
    display: block;
    margin-bottom: 10px;
    color: var(--emerald);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.6px;
}

.dashboard-welcome h1 {
    margin: 0 0 12px;
    color: var(--deep-green);
    font-size: clamp(28px, 3vw, 38px);
    letter-spacing: -1px;
}

.dashboard-welcome h1 span {
    color: var(--emerald);
}

.dashboard-welcome p {
    max-width: 540px;
    margin: 0 0 22px;
    color: #647c76;
    font-size: 14px;
    line-height: 1.8;
}

.shop-now-button {
    display: inline-flex;
    align-items: center;
    gap: 17px;
    padding: 12px 20px;
    border-radius: 8px;
    background: var(--emerald);
    color: white;
    font-size: 13px;
    font-weight: 700;
    transition: .2s;
}

.shop-now-button:hover {
    background: var(--deep-green);
    transform: translateY(-2px);
}

.welcome-decoration {
    position: relative;
    display: grid;
    width: 230px;
    height: 190px;
    flex-shrink: 0;
    place-items: center;
}

.decoration-circle {
    display: grid;
    width: 155px;
    height: 155px;
    place-items: center;
    border-radius: 50%;
    background: #c7e9df;
}

.decoration-circle span {
    font-size: 75px;
}

.decoration-star {
    position: absolute;
    color: var(--emerald);
    font-size: 35px;
}

.star-one {
    top: 10px;
    right: 20px;
}

.star-two {
    bottom: 10px;
    left: 20px;
}

/* SECTION HEADINGS */

.section-title {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 20px;
}

.section-title h2 {
    margin: 0 0 7px;
    color: var(--deep-green);
    font-size: 23px;
    letter-spacing: -.5px;
}

.section-title p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
}

/* QUICK LINKS */

.shortcut-section {
    margin-top: 36px;
}

.shortcut-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 15px;
}

.shortcut-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 78px;
    padding: 15px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: white;
    transition: .2s;
}

.shortcut-card:hover {
    border-color: #a8d8ce;
    box-shadow: 0 7px 20px rgba(18, 62, 58, .07);
    transform: translateY(-3px);
}

.shortcut-icon {
    display: grid;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 10px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 21px;
}

.shortcut-name {
    color: var(--deep-green);
    font-size: 13px;
    font-weight: 700;
}

.shortcut-arrow {
    margin-left: auto;
    color: var(--emerald);
    font-size: 18px;
}

/* PRODUCT SECTION */

.dashboard-products {
    margin-top: 43px;
}

.products-title {
    margin-bottom: 23px;
}

.view-all-link {
    flex-shrink: 0;
    color: var(--emerald);
    font-size: 13px;
    font-weight: 700;
}

.view-all-link:hover {
    color: var(--deep-green);
}

.dashboard-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}

.dashboard-product-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: white;
    transition: .22s;
}

.dashboard-product-card:hover {
    border-color: #c5dfd8;
    box-shadow: 0 10px 25px rgba(18, 62, 58, .09);
    transform: translateY(-4px);
}

.dashboard-product-image {
    display: block;
    height: 205px;
    overflow: hidden;
    background: #f1f7f5;
}

.dashboard-product-image img {
    display: block;
    width: 100%;
    height: 100%;
    padding: 12px;
    object-fit: contain;
    transition: transform .3s;
}

.dashboard-product-card:hover .dashboard-product-image img {
    transform: scale(1.05);
}

.dashboard-product-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: stretch;
    padding: 15px;
}

.dashboard-product-info h3 {
    display: -webkit-box;
    min-height: 40px;
    margin: 0 0 10px;
    overflow: hidden;
    color: var(--deep-green);
    font-size: 14px;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.dashboard-product-price {
    margin-bottom: 13px;
    color: var(--emerald);
    font-size: 18px;
    font-weight: 800;
}

.view-product-button {
    display: block;
    margin-top: auto;
    padding: 10px;
    border-radius: 7px;
    background: var(--emerald);
    color: white;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
    transition: .2s;
}

.view-product-button:hover {
    background: var(--deep-green);
}

/* EMPTY PRODUCTS */

.dashboard-empty {
    padding: 50px 20px;
    border: 1px dashed #c9dfd8;
    border-radius: 13px;
    background: white;
    text-align: center;
}

.dashboard-empty > div {
    font-size: 42px;
}

.dashboard-empty h3 {
    color: var(--deep-green);
}

.dashboard-empty p {
    color: var(--muted);
    font-size: 14px;
}

.dashboard-empty a {
    display: inline-block;
    margin-top: 10px;
    color: var(--emerald);
    font-size: 13px;
    font-weight: 700;
}

/* BOTTOM PROMO */

.dashboard-promo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 42px;
    padding: 25px 30px;
    border-radius: 13px;
    background: var(--deep-green);
    color: white;
}

.dashboard-promo span {
    color: #8bd8c8;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.dashboard-promo h2 {
    margin: 8px 0;
    font-size: 20px;
}

.dashboard-promo p {
    margin: 0;
    color: #c4dcd5;
    font-size: 13px;
    line-height: 1.6;
}

.dashboard-promo > a {
    flex-shrink: 0;
    padding: 12px 17px;
    border-radius: 8px;
    background: white;
    color: var(--deep-green);
    font-size: 12px;
    font-weight: 800;
}

.dashboard-promo > a:hover {
    background: #c9eee4;
}

/* FOOTER */

.dashboard-footer {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 20px 38px;
    border-top: 1px solid var(--border);
    background: white;
    color: var(--muted);
    font-size: 12px;
}

/* RESPONSIVE */

@media (max-width: 1100px) {
    .dashboard-product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .shortcut-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 760px) {
    .dashboard-content {
        padding: 22px 18px 40px;
    }

    .dashboard-search {
        width: auto;
        flex: 1;
    }

    .dashboard-welcome {
        min-height: auto;
        padding: 28px 23px;
    }

    .welcome-decoration {
        width: 130px;
        transform: scale(.75);
    }

    .dashboard-product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
    }

    .dashboard-footer {
        padding: 18px;
        flex-direction: column;
    }
}

@media (max-width: 480px) {
    .welcome-decoration {
        display: none;
    }

    .shortcut-grid {
        grid-template-columns: 1fr 1fr;
    }

    .dashboard-product-grid {
        grid-template-columns: 1fr 1fr;
    }

    .dashboard-product-image {
        height: 150px;
    }

    .dashboard-promo {
        align-items: flex-start;
        flex-direction: column;
    }

    .dashboard-search {
        font-size: 12px;
    }
}
