:root {
    --terracotta: #b6533c;
    --cream: #fff7ea;
    --plum: #352536;
    --rose: #e8b8a8;
    --sand: #f0e2cf;
    --white: #ffffff;
    --muted: #766d6b;
    --border: #eadfd5;
    --shadow: 0 12px 32px rgba(53, 37, 54, 0.08);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--cream);
    color: var(--plum);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.5;
}

button,
input,
select {
    font: inherit;
}

button,
a,
select {
    -webkit-tap-highlight-color: transparent;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
    text-decoration: none;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--white);
    box-shadow: 0 2px 14px rgba(53, 37, 54, 0.06);
}

.header-top {
    display: flex;
    align-items: center;
    gap: 28px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 18px 28px;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    color: var(--plum);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.04em;
}

.brand-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 12px;
    background: var(--terracotta);
    color: var(--white);
    font-size: 1.25rem;
    font-weight: 800;
}

.search-form {
    display: flex;
    flex: 1;
    min-width: 160px;
    max-width: 620px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fffdfa;
}

.search-form input {
    width: 100%;
    min-width: 0;
    padding: 12px 15px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--plum);
}

.search-form:focus-within {
    border-color: var(--terracotta);
    box-shadow: 0 0 0 3px rgba(182, 83, 60, 0.12);
}

.search-form button {
    padding: 0 20px;
    border: 0;
    background: var(--terracotta);
    color: var(--white);
    font-weight: 700;
}

.search-form button:hover,
.hero-button:hover,
.checkout-button:hover {
    background: #99442f;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: auto;
}

.account-link {
    font-size: 0.95rem;
    font-weight: 700;
}

.account-link:hover {
    color: var(--terracotta);
}

.cart-button {
    padding: 10px 15px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--white);
    color: var(--plum);
    font-weight: 700;
}

.cart-button span {
    display: inline-grid;
    min-width: 23px;
    height: 23px;
    margin-left: 5px;
    padding: 0 5px;
    place-items: center;
    border-radius: 50%;
    background: var(--terracotta);
    color: var(--white);
    font-size: 0.8rem;
}

.category-nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 0 20px 14px;
}

.category-button {
    padding: 8px 16px;
    border: 0;
    border-radius: 20px;
    background: transparent;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
}

.category-button:hover,
.category-button.active {
    background: var(--sand);
    color: var(--plum);
}

main {
    max-width: 1240px;
    margin: 0 auto;
    padding: 30px 28px 70px;
}

.hero-banner {
    position: relative;
    display: flex;
    min-height: 340px;
    align-items: center;
    overflow: hidden;
    padding: 54px 60px;
    border-radius: 18px;
    background:
        radial-gradient(circle at 85% 25%, rgba(232, 184, 168, 0.75) 0 9%, transparent 9.5%),
        radial-gradient(circle at 90% 75%, rgba(240, 226, 207, 0.9) 0 19%, transparent 19.5%),
        linear-gradient(115deg, #f0e2cf 0%, #f8e8d8 52%, #e8b8a8 100%);
}

.hero-copy {
    position: relative;
    z-index: 1;
    max-width: 560px;
}

.eyebrow {
    margin: 0 0 10px;
    color: var(--terracotta);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
}

.hero-copy h1 {
    margin: 0;
    color: var(--plum);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
}

.hero-copy > p:not(.eyebrow) {
    max-width: 420px;
    margin: 18px 0 26px;
    color: #615456;
    font-size: 1.05rem;
}

.hero-button {
    display: inline-block;
    padding: 13px 23px;
    border-radius: 7px;
    background: var(--terracotta);
    color: var(--white);
    font-weight: 700;
}

.shop-section {
    padding-top: 52px;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.section-heading h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.03em;
}

.section-heading p:not(.eyebrow) {
    margin: 8px 0 0;
    color: var(--muted);
}

.sort-control {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.9rem;
}

.sort-control select {
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--white);
    color: var(--plum);
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.product-card {
    overflow: hidden;
    border: 1px solid #eee4dc;
    border-radius: 12px;
    background: var(--white);
    box-shadow: 0 5px 18px rgba(53, 37, 54, 0.04);
    transition: transform 180ms ease, box-shadow 180ms ease;
}

.product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.product-image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f4eee8;
}

.product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
}

.product-card:hover .product-image {
    transform: scale(1.04);
}

.product-category {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 10px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--plum);
    font-size: 0.75rem;
    font-weight: 700;
}

.product-info {
    padding: 16px;
}

.product-seller {
    margin: 0 0 6px;
    color: var(--muted);
    font-size: 0.78rem;
}

.product-name {
    min-height: 46px;
    margin: 0;
    color: var(--plum);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
}

.product-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 15px;
}

.product-price {
    color: var(--plum);
    font-size: 1.05rem;
    font-weight: 800;
}

.add-button {
    padding: 9px 12px;
    border: 1px solid var(--terracotta);
    border-radius: 6px;
    background: var(--white);
    color: var(--terracotta);
    font-size: 0.85rem;
    font-weight: 700;
}

.add-button:hover {
    background: var(--terracotta);
    color: var(--white);
}

.empty-state {
    padding: 50px 20px;
    text-align: center;
}

.empty-state h3 {
    margin: 0 0 8px;
}

.empty-state p {
    margin: 0;
    color: var(--muted);
}

.site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 28px max(28px, calc((100% - 1184px) / 2));
    border-top: 1px solid var(--border);
    background: #fffaf4;
}

.site-footer p,
.site-footer small {
    color: var(--muted);
}

.site-footer p {
    margin: 0;
}

.cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: flex;
    justify-content: flex-end;
    background: rgba(35, 25, 35, 0.45);
}

.cart-overlay[hidden],
.empty-state[hidden] {
    display: none;
}

.cart-panel {
    display: flex;
    width: min(100%, 440px);
    height: 100%;
    flex-direction: column;
    padding: 24px;
    background: var(--white);
    box-shadow: -10px 0 35px rgba(0, 0, 0, 0.12);
}

.cart-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
}

.cart-heading h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
}

.cart-heading button {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--sand);
    color: var(--plum);
    font-size: 1.5rem;
}

.cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 16px 0;
}

.cart-empty {
    color: var(--muted);
    text-align: center;
}

.cart-item {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
}

.cart-item img {
    width: 72px;
    height: 72px;
    border-radius: 8px;
    object-fit: cover;
}

.cart-item-name {
    margin: 0 0 5px;
    font-weight: 700;
}

.cart-item-price {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
}

.quantity-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 9px;
}

.quantity-controls button {
    width: 26px;
    height: 26px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--white);
}

.remove-button {
    border: 0;
    background: transparent;
    color: var(--terracotta);
    font-size: 0.82rem;
}

.cart-footer {
    padding-top: 18px;
    border-top: 1px solid var(--border);
}

.cart-total {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
    font-size: 1.05rem;
}

.checkout-button,
.continue-shopping-button {
    width: 100%;
    padding: 13px;
    border-radius: 7px;
    font-weight: 700;
}

.checkout-button {
    border: 0;
    background: var(--terracotta);
    color: var(--white);
}

.checkout-button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
}

.continue-shopping-button {
    margin-top: 9px;
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--plum);
}

.toast {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 30;
    max-width: calc(100% - 48px);
    padding: 13px 18px;
    border-radius: 8px;
    background: var(--plum);
    color: var(--white);
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: opacity 180ms ease, transform 180ms ease;
}

.toast.show {
    opacity: 1;
    transform: translateY(0);
}

@media (max-width: 980px) {
    .header-top {
        flex-wrap: wrap;
        gap: 16px;
    }

    .search-form {
        order: 3;
        flex-basis: 100%;
        max-width: none;
    }

    .header-actions {
        margin-left: auto;
    }

    .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero-banner {
        padding: 44px;
    }
}

@media (max-width: 680px) {
    .header-top {
        padding: 14px 16px;
    }

    .category-nav {
        justify-content: flex-start;
        overflow-x: auto;
        padding: 0 16px 12px;
    }

    .category-button {
        flex-shrink: 0;
    }

    main {
        padding: 20px 16px 45px;
    }

    .hero-banner {
        min-height: 300px;
        padding: 30px 24px;
        border-radius: 12px;
    }

    .hero-copy h1 {
        font-size: 2.7rem;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .product-info {
        padding: 12px;
    }

    .product-name {
        min-height: 0;
        font-size: 0.92rem;
    }

    .product-bottom {
        align-items: flex-start;
        flex-direction: column;
    }

    .add-button {
        width: 100%;
    }

    .site-footer {
        align-items: flex-start;
        flex-direction: column;
        padding: 24px 16px;
    }
}

@media (max-width: 380px) {
    .product-grid {
        grid-template-columns: 1fr;
    }
}