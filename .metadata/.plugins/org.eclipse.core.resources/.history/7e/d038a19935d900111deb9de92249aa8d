                <button type="submit">Search</button>
            </form>
            <div class="toolbar-right">
                <div class="view-toggle">
                    <button class="view-btn active" id="gridViewBtn" onclick="setView('grid')" title="Grid view">&#9638; Grid</button>
                    <button class="view-btn" id="listViewBtn" onclick="setView('list')" title="List view">&#9776; List</button>
                </div>
                <form th:action="@{/customer/products}" method="get" id="sortForm">
                    <input type="hidden" name="keyword" th:value="${keyword}">
                    <input type="hidden" name="category" th:value="${selectedCategory}">
                    <input type="hidden" name="vendorId" th:value="${selectedVendorId}">
                    <input type="hidden" name="minPrice" th:value="${minPrice}">
                    <input type="hidden" name="maxPrice" th:value="${maxPrice}">
                    <select class="sort-select" name="sort" onchange="this.form.submit()">
                        <option value="newest" th:selected="${selectedSort == 'newest' or selectedSort == null}">Newest Arrivals</option>
                        <option value="price_asc" th:selected="${selectedSort == 'price_asc'}">Price: Low to High</option>
                        <option value="price_desc" th:selected="${selectedSort == 'price_desc'}">Price: High to Low</option>
                        <option value="name_asc" th:selected="${selectedSort == 'name_asc'}">Name: A to Z</option>
                        <option value="rating" th:selected="${selectedSort == 'rating'}">Top Rated</option>
                    </select>
                </form>
            </div>
        </div>

        <!-- Results meta -->
        <div class="results-meta">
            <span class="results-count">
                Showing <strong th:text="${products != null ? products.size() : 0}">0</strong> products
            </span>
            <span class="verified-badge">&#10003; Verified products from authorized sellers</span>
        </div>

        <!-- Product Grid -->
        <div class="product-grid" id="productGrid">

            <div th:if="${products == null or products.isEmpty()}" class="empty-state">
                <div class="empty-state-icon">&#128722;</div>
                <h3>No products found</h3>
                <p>Try adjusting your filters or search term.</p>
                <a class="empty-btn" th:href="@{/customer/products}">Clear Filters</a>
            </div>

            <div class="product-card" th:each="product : ${products}">
                <div class="card-img-wrap">
                    <!-- Badges -->
                    <div class="card-badges">
                        <span class="badge-pill badge-new">NEW</span>
                        <span class="badge-pill badge-off"
                              th:if="${product.discountedPrice != null and product.discountedPrice < product.price}"
                              th:text="${#numbers.formatDecimal((1 - product.discountedPrice / product.price) * 100, 0, 0) + '% OFF'}">OFF</span>
                    </div>
                    <span class="badge-stock badge-instock"
                          th:if="${product.stockQuantity != null and product.stockQuantity > 0}">In Stock</span>
                    <span class="badge-stock badge-outstock"
                          th:if="${product.stockQuantity == null or product.stockQuantity <= 0}">Out of Stock</span>

                    <img th:src="@{'/images/products/' + ${product.imageFileName}}"
                         th:alt="${product.name}"
