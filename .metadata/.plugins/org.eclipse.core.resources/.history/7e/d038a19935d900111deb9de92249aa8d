                </div>

                <div class="card-body">
                    <div class="card-meta">
                        <span class="card-category" th:text="${product.category != null ? product.category : 'General'}">Category</span>
                        <span class="card-vendor" th:text="${product.vendorName != null ? product.vendorName : 'OneCart'}">Vendor</span>
                    </div>
                    <div class="card-name" th:text="${product.name}">Product Name</div>
                    <div class="card-rating">
