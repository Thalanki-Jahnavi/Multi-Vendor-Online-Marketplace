                         loading="lazy">

                    <!-- Floating actions -->
                    <div class="card-actions">
                        <button class="icon-btn" title="Quick View"
                                th:onclick="'openQuickView(' + ${product.productId} + ', \'' + ${product.name} + '\', ' + ${product.discountedPrice != null ? product.discountedPrice : product.price} + ', \'' + ${product.imageFileName} + '\', \'' + (${product.description} != null ? product.description.replace('\'','').replace('\"','') : '') + '\')'">
