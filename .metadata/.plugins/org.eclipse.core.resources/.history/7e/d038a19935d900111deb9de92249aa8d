<!-- ===== SHOP LAYOUT ===== -->
<div class="shop-layout">

    <!-- SIDEBAR -->
    <aside class="filter-sidebar" aria-label="Product filters">
        <div class="sidebar-header">
            <h3>&#9889; Filters</h3>
            <a class="sidebar-reset" th:href="@{/customer/products}">Reset</a>
        </div>

        <form id="filterForm" th:action="@{/customer/products}" method="get">
            <input type="hidden" name="keyword" th:value="${keyword}">
            <input type="hidden" name="sort" th:value="${selectedSort}">

            <!-- Categories -->
            <div class="sidebar-section">
                <div class="sidebar-title">Categories</div>
                <div>
                    <label class="filter-option">
                        <div class="filter-option-left">
                            <input type="radio" name="category" value="" onchange="this.form.submit()"
                                   th:checked="${selectedCategory == null or selectedCategory.isBlank()}">
                            <span>All Categories</span>
                        </div>
                        <span class="filter-count" th:text="${totalProductsCount != null ? totalProductsCount : 0}">0</span>
                    </label>
                    <label class="filter-option" th:each="cat : ${categories}">
                        <div class="filter-option-left">
                            <input type="radio" name="category" th:value="${cat}" onchange="this.form.submit()"
                                   th:checked="${cat.equalsIgnoreCase(selectedCategory)}">
                            <span th:text="${cat}">Category</span>
                        </div>
                        <span class="filter-count" th:text="${categoryCounts != null and categoryCounts[cat] != null ? categoryCounts[cat] : 0}">0</span>
                    </label>
                </div>
            </div>

            <!-- Price Range -->
            <div class="sidebar-section">
                <div class="sidebar-title">Price Range (Rs.)</div>
                <div class="price-presets">
                    <button type="button" class="preset-btn" onclick="applyPreset(0,500)">Under Rs.500</button>
                    <button type="button" class="preset-btn" onclick="applyPreset(500,2000)">Rs.500-2k</button>
                    <button type="button" class="preset-btn" onclick="applyPreset(2000,10000)">Rs.2k-10k</button>
                </div>
                <div class="price-row">
                    <div>
                        <label>Min</label>
                        <input type="number" id="minPrice" name="minPrice" placeholder="0" min="0" step="50" th:value="${minPrice}">
                    </div>
                    <div>
                        <label>Max</label>
                        <input type="number" id="maxPrice" name="maxPrice" placeholder="50000" min="0" step="50" th:value="${maxPrice}">
                    </div>
                </div>
                <button type="submit" class="apply-btn">Apply Price</button>
            </div>

            <!-- Vendors -->
            <div class="sidebar-section">
                <div class="sidebar-title">Vendors</div>
                <input type="text" class="vendor-search" placeholder="Search vendors..." id="vendorSearch" oninput="filterVendors(this.value)">
                <div id="vendorList">
                    <label class="filter-option">
                        <div class="filter-option-left">
                            <input type="radio" name="vendorId" value="" onchange="this.form.submit()"
                                   th:checked="${selectedVendorId == null}">
                            <span>All Vendors</span>
                        </div>
                    </label>
                    <label class="filter-option" th:each="vendor : ${vendors}" th:data-name="${vendor.firstName + ' ' + vendor.lastName}">
