                            <input class="qty-val" type="number" th:id="'qty-' + ${product.productId}" value="1" min="1" max="99" readonly>
                            <button type="button" class="qty-btn" th:onclick="'changeQty(' + ${product.productId} + ', 1)'">&#43;</button>
                        </div>
                        <button class="add-cart-btn"
                                th:onclick="'addToCart(' + ${product.productId} + ', \'' + ${product.name} + '\', ' + ${product.discountedPrice != null ? product.discountedPrice : product.price} + ', \'' + ${product.imageFileName} + '\')'">
                            Add to Cart
