:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --page-bg: #f7fbfa;
    --white: #ffffff;
    --text: #173d39;
    --muted: #718985;
    --border: #dcebe7;
    --shadow: 0 12px 30px rgba(18, 62, 58, 0.07);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--page-bg);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

.site-header {
    min-height: 72px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.logo {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--deep-green);
}

.logo span {
    color: var(--emerald);
}

.main-nav {
    display: flex;
    align-items: center;
    gap: 32px;
}

.main-nav a {
    color: #526d68;
    font-size: 14px;
    font-weight: 600;
}

.main-nav a:hover {
    color: var(--emerald);
}

.logout-form {
    margin: 0;
}

.logout-button {
    padding: 11px 18px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--white);
    color: var(--deep-green);
    font-weight: 700;
    cursor: pointer;
}

.logout-button:hover {
    border-color: var(--emerald);
    color: var(--emerald);
}

.page-container {
    width: min(1120px, 90%);
    margin: 32px auto 54px;
}

.welcome-banner {
    min-height: 260px;
    padding: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    overflow: hidden;
    border-radius: 22px;
    background: var(--mint);
}

.welcome-copy {
    max-width: 650px;
}

.eyebrow {
    margin: 0 0 12px;
    color: var(--emerald);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

.welcome-banner h1 {
    margin: 0;
    color: var(--deep-green);
    font-size: clamp(28px, 4vw, 38px);
    letter-spacing: -1.2px;
}

.welcome-banner p:not(.eyebrow) {
    margin: 14px 0 24px;
    color: var(--muted);
    line-height: 1.6;
}

.primary-button,
.product-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 9px;
    background: var(--emerald);
    color: var(--white);
    font-size: 13px;
    font-weight: 700;
    transition: background 0.2s ease, transform 0.2s ease;
}

.primary-button {
    min-height: 42px;
    padding: 0 20px;
}

.primary-button:hover,
.product-button:hover {
    background: var(--deep-green);
    transform: translateY(-1px);
}

.banner-art {
    position: relative;
    flex: 0 0 260px;
    height: 190px;
}

.art-circle {
    position: absolute;
    top: 0;
    right: 15px;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: #bfe7dd;
}

.art-note {
    position: absolute;
    padding: 17px 20px;
    border-radius: 12px;
    background: var(--white);
    box-shadow: var(--shadow);
    color: var(--deep-green);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.note-one {
    top: 45px;
    right: 55px;
    transform: rotate(-4deg);
}

.note-two {
    right: 0;
    bottom: 25px;
    transform: rotate(4deg);
}

.quick-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 22px 0 46px;
}

.quick-card {
    min-height: 94px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.quick-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
}

.quick-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    flex: 0 0 42px;
    border-radius: 12px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 23px;
}

.quick-card strong,
.quick-card small {
    display: block;
}

.quick-card strong {
    margin-bottom: 6px;
    font-size: 13px;
}

.quick-card small {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.4;
}

.card-arrow {
    margin-left: auto;
    color: var(--emerald);
    font-size: 22px;
}

.products-section {
    scroll-margin-top: 24px;
}

.section-heading {
    margin-bottom: 22px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
}

.section-heading h2 {
    margin: 0;
    color: var(--deep-green);
    font-size: 25px;
    letter-spacing: -0.5px;
}

.section-description {
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 13px;
}

.text-link {
    color: var(--emerald);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
}

.text-link span {
    margin-left: 5px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.product-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.product-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
}

.product-image-placeholder {
    min-height: 170px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #e5f4f0, #f5fbf9);
    color: #8bbdb2;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
}

.product-details {
    padding: 17px;
}

.product-category {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 11px;
}

.product-details h3 {
    min-height: 38px;
    margin: 0 0 12px;
    color: var(--deep-green);
    font-size: 15px;
    line-height: 1.3;
}

.price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}

.price-row strong {
    color: var(--deep-green);
    font-size: 17px;
}

.old-price {
    color: #91a29e;
    font-size: 12px;
    text-decoration: line-through;
}

.discount-label {
    display: inline-block;
    margin-top: 8px;
    padding: 5px 8px;
    border-radius: 6px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 11px;
    font-weight: 700;
}

.product-button {
    width: 100%;
    min-height: 38px;
    margin-top: 15px;
}

.empty-products {
    padding: 42px 20px;
    border: 1px dashed #bfd8d1;
    border-radius: 15px;
    background: var(--white);
    text-align: center;
}

.empty-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 14px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--mint);
    color: var(--emerald);
    font-size: 25px;
}

.empty-products h3 {
    margin: 0 0 8px;
    color: var(--deep-green);
}

.empty-products p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
}

.shopping-note {
    margin-top: 40px;
    padding: 22px;
    display: flex;
    align-items: center;
    gap: 15px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
}

.note-check {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    border-radius: 50%;
    background: var(--mint);
    color: var(--emerald);
    font-size: 19px;
    font-weight: 800;
}

.shopping-note h3 {
    margin: 0 0 6px;
    color: var(--deep-green);
    font-size: 14px;
}

.shopping-note p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
}

.site-footer {
    padding: 22px 7%;
    border-top: 1px solid var(--border);
    background: var(--white);
    color: var(--muted);
    font-size: 11px;
}

.footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

@media (max-width: 900px) {
    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .quick-links {
        grid-template-columns: 1fr;
    }

    .banner-art {
        flex-basis: 210px;
        transform: scale(0.85);
        transform-origin: right center;
    }
}

@media (max-width: 620px) {
    .site-header {
        padding: 16px 5%;
        flex-wrap: wrap;
    }

    .main-nav {
        order: 3;
        width: 100%;
        justify-content: space-between;
        gap: 12px;
    }

    .page-container {
        width: 92%;
        margin-top: 20px;
    }

    .welcome-banner {
        padding: 28px 24px;
    }

    .banner-art {
        display: none;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .product-image-placeholder {
        min-height: 190px;
    }

    .footer-inner {
        flex-direction: column;
    }
}