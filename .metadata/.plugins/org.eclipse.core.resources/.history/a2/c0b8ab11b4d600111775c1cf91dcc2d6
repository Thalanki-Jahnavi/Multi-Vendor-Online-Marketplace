<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OneCart | Home</title>

    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/script.js" defer></script>
</head>
<body>
    <header class="site-header">
        <div class="header-top">
            <a class="brand" href="/guest/index.html">
                <span class="brand-mark">O</span>
                <span>OneCart</span>
            </a>

            <form class="search-form" id="searchForm">
                <input
                    id="searchInput"
                    type="search"
                    placeholder="Search products and sellers"
                    aria-label="Search products and sellers"
                >
                <button type="submit">Search</button>
            </form>

            <div class="header-actions">
                <a class="account-link" href="/guest/login.html" id="accountButton">
                    Sign in
                </a>
                <button class="cart-button" id="openCartButton" type="button">
                    Cart <span id="cartCount">0</span>
                </button>
            </div>
        </div>

        <nav class="category-nav" aria-label="Product categories">
            <button class="category-button active" data-category="All" type="button">All</button>
            <button class="category-button" data-category="Electronics" type="button">Electronics</button>
            <button class="category-button" data-category="Fashion" type="button">Fashion</button>
            <button class="category-button" data-category="Home" type="button">Home</button>
            <button class="category-button" data-category="Beauty" type="button">Beauty</button>
            <button class="category-button" data-category="Fitness" type="button">Fitness</button>
            <button class="category-button" data-category="Books" type="button">Books</button>
        </nav>
    </header>

    <main>
        <section class="hero-banner">
            <div class="hero-copy">
                <p class="eyebrow">Welcome to OneCart</p>
                <h1>Good finds.<br>Better days.</h1>
                <p>Discover everyday essentials from sellers in one place.</p>
                <a class="hero-button" href="#shop">Shop now</a>
            </div>
        </section>

        <section class="shop-section" id="shop">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">The OneCart collection</p>
                    <h2>Shop our products</h2>
                    <p id="resultSummary">Products from our sellers</p>
                </div>

                <label class="sort-control" for="sortSelect">
                    Sort by
                    <select id="sortSelect">
                        <option value="featured">Featured</option>
                        <option value="price-low">Price: low to high</option>
                        <option value="price-high">Price: high to low</option>
                        <option value="name">Name</option>
                    </select>
                </label>
            </div>

            <div class="product-grid" id="productGrid"></div>

            <div class="empty-state" id="emptyState" hidden>
                <h3>No products found</h3>
                <p>Try another search or category.</p>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <a class="brand" href="/guest/index.html">
            <span class="brand-mark">O</span>
            <span>OneCart</span>
        </a>
        <p>Everyday shopping from sellers you can discover.</p>
        <small>© 2026 OneCart</small>
    </footer>

    <div class="cart-overlay" id="cartOverlay" hidden>
        <aside class="cart-panel" role="dialog" aria-modal="true" aria-labelledby="cartTitle">
            <div class="cart-heading">
                <h2 id="cartTitle">Your cart</h2>
                <button id="closeCartButton" type="button" aria-label="Close cart">×</button>
            </div>

            <div class="cart-items" id="cartItems"></div>

            <div class="cart-footer">
                <div class="cart-total">
                    <span>Subtotal</span>
                    <strong id="cartSubtotal">₹0</strong>
                </div>
                <button class="checkout-button" id="checkoutButton" type="button">
                    Checkout
                </button>
                <button class="continue-shopping-button" id="continueShoppingButton" type="button">
                    Continue shopping
                </button>
            </div>
        </aside>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body>
</html>