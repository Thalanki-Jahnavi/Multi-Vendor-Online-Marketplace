            </footer>

        </section>

    </main>

</div>


<!-- SEARCH AND FILTER -->
<script>

document.addEventListener("DOMContentLoaded", function () {

    const searchInput =
        document.getElementById("orderSearch");

    const statusFilter =
        document.getElementById("orderStatusFilter");

    const paymentFilter =
        document.getElementById("paymentFilter");

    const table =
        document.getElementById("ordersTable");

    const noResults =
        document.getElementById("noOrderResults");


    function filterOrders() {

        if (!table) {
            return;
        }

        const keyword =
            searchInput.value.toLowerCase().trim();

        const selectedStatus =
            statusFilter.value.toLowerCase();

        const selectedPayment =
            paymentFilter.value.toLowerCase();

        const rows =
            table.querySelectorAll("tbody tr");

        let visibleCount = 0;


        rows.forEach(row => {

            const orderNumber =
                (row.dataset.order || "").toLowerCase();

            const customer =
                (row.dataset.customer || "").toLowerCase();

            const status =
                (row.dataset.status || "").toLowerCase();

            const payment =
                (row.dataset.payment || "").toLowerCase();


            const matchesSearch =
                orderNumber.includes(keyword) ||
                customer.includes(keyword);

            const matchesStatus =
                selectedStatus === "" ||
                status === selectedStatus;

            const matchesPayment =
                selectedPayment === "" ||
                payment === selectedPayment;


            const visible =
                matchesSearch &&
                matchesStatus &&
                matchesPayment;


            row.style.display =
                visible ? "" : "none";


            if (visible) {
                visibleCount++;
            }

        });


        if (noResults) {

            noResults.style.display =
                visibleCount === 0 ? "block" : "none";

        }

    }


    if (searchInput) {
        searchInput.addEventListener(
            "input",
            filterOrders
        );
    }

    if (statusFilter) {
        statusFilter.addEventListener(
            "change",
            filterOrders
        );
    }

    if (paymentFilter) {
        paymentFilter.addEventListener(
            "change",
            filterOrders
        );
    }

});

</script>


<script th:src="@{/js/vendor-dashboard.js}"></script>

</body>
