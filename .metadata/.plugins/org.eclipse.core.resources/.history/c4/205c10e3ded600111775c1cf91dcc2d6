<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OneCart | Discover Something Worth Keeping</title>
    <meta name="description"
          content="Discover unique products and independent stores at OneCart.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" th:href="@{/css/home.css}">
</head>

<body th:attr="data-role=${userRole}">

<!-- Announcement -->
<div class="announcement">
    <p>Discover something new. Find your next favourite.</p>
    <a th:href="@{/about}">Discover OneCart <span>→</span></a>
</div>

<!-- Header -->
<header class="site-header">
    <a th:href="@{/}" class="brand" aria-label="OneCart home">
        One<span>Cart</span><i>.</i>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
        <a th:href="@{/}">Home</a>
        <a href="#categories">Explore</a>
        <a href="#featured">Featured</a>
        <a href="#stores">Our stores</a>
    </nav>

    <form class="search-box" id="searchForm" role="search">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input type="search" id="productSearch"
               placeholder="Search products..."
               aria-label="Search products">
        <button type="submit">Search</button>
    </form>

    <div class="header-actions">
        <a class="header-link guest-only" th:href="@{/login}">Login</a>
        <a class="header-signup guest-only" th:href="@{/signup}">Sign up</a>

        <a class="icon-link customer-only" th:href="@{/customer/dashboard}"
           aria-label="My account">♙</a>
        <a class="icon-link customer-only" th:href="@{/customer/wishlist}"
           aria-label="Wishlist">♡ <span class="count" id="wishlistCount">0</span></a>
        <a class="icon-link customer-only" th:href="@{/customer/cart}"
           aria-label="Shopping cart">♧ <span class="count" id="cartCount">0</span></a>

        <a class="icon-link vendor-only" th:href="@{/vendor/dashboard}"
           aria-label="Vendor dashboard">Store</a>

        <a class="icon-link admin-only" th:href="@{/admin/dashboard}"
           aria-label="Admin dashboard">Admin</a>

        <button class="menu-toggle" id="menuToggle"
                type="button" aria-label="Open navigation"
                aria-expanded="false" aria-controls="mobileMenu">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

<!-- Mobile navigation -->
<nav class="mobile-menu" id="mobileMenu" aria-label="Mobile navigation" hidden>
    <a th:href="@{/}">Home</a>
    <a href="#categories">Explore categories</a>
    <a href="#featured">Featured products</a>
    <a href="#stores">Our stores</a>
    <a th:href="@{/login}" class="guest-only">Login</a>
    <a th:href="@{/signup}" class="guest-only">Sign up</a>
    <a th:href="@{/customer/dashboard}" class="customer-only">My dashboard</a>
    <a th:href="@{/vendor/dashboard}" class="vendor-only">Vendor dashboard</a>
    <a th:href="@{/admin/dashboard}" class="admin-only">Admin dashboard</a>
</nav>

<main>

    <!-- Hero -->
    <section class="hero">
        <div class="hero-copy">
            <div class="eyebrow">
                <span class="eyebrow-line"></span>
                THE ONECART EDIT
            </div>

            <h1>
                Discover something<br>
                <em>worth keeping.</em>
            </h1>

            <p class="hero-description">
                Good finds. Great stores. All in one place.
                Explore a world of products from independent
                sellers and discover your next favourite.
            </p>

            <div class="hero-actions">
                <a href="#featured" class="button button-primary">
                    Explore the collection <span>↗</span>
                </a>
                <a href="#categories" class="text-link">
                    Browse categories <span>→</span>
                </a>
            </div>

            <div class="hero-note">
                <span class="note-dot"></span>
                A marketplace made for discovery
            </div>
        </div>

        <div class="hero-visual">
            <div class="hero-image-wrap">
                <img th:src="@{/images/hero-shopping.png}"
                     alt="A curated collection of lifestyle products"
                     class="hero-image"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">

                <div class="hero-image-fallback">
                    <span>ONECART</span>
                    <strong>Find your<br>next favourite.</strong>
                    <small>Discover. Explore. Enjoy.</small>
                </div>
            </div>

            <div class="floating-note">
                <span class="floating-note-icon">✳</span>
                <div>
                    <strong>Good things,</strong>
                    <small>from great stores.</small>
                </div>
            </div>

            <div class="hero-stamp">THE<br>GOOD<br>FINDS<br>CLUB</div>
        </div>
    </section>

    <!-- Benefits strip -->
    <section class="benefit-strip" aria-label="Shopping benefits">
        <div><span>✳</span> Discover independent stores</div>
        <div><span>✳</span> Explore unique finds</div>
        <div><span>✳</span> Shop in one place</div>
    </section>

    <!-- Categories -->
    <section class="section categories-section" id="categories">
        <div class="section-heading">
            <div>
                <p class="eyebrow">A WORLD TO EXPLORE</p>
                <h2>Find your kind<br>of <em>something.</em></h2>
            </div>
            <p class="section-intro">
                From everyday essentials to little luxuries,
                there's always something worth discovering.
            </p>
        </div>

        <div class="category-grid">
            <a href="#featured" class="category-card category-fashion">
                <div class="category-art art-fashion">
                    <span class="art-shape"></span>
                    <span class="art-caption">THE STYLE EDIT</span>
                </div>
                <div class="category-info">
                    <div><h3>Fashion & Style</h3><p>Find your expression</p></div>
                    <span class="round-arrow">↗</span>
                </div>
            </a>

            <a href="#featured" class="category-card category-tech">
                <div class="category-art art-tech">
                    <span class="art-shape"></span>
                    <span class="art-caption">THE TECH EDIT</span>
                </div>
                <div class="category-info">
                    <div><h3>Tech & Gadgets</h3><p>Smart finds, daily life</p></div>
                    <span class="round-arrow">↗</span>
                </div>
            </a>

            <a href="#featured" class="category-card category-home">
                <div class="category-art art-home">
                    <span class="art-shape"></span>
                    <span class="art-caption">THE HOME EDIT</span>
                </div>
                <div class="category-info">
                    <div><h3>Home & Living</h3><p>Make space for good</p></div>
                    <span class="round-arrow">↗</span>
                </div>
            </a>

            <a href="#featured" class="category-card category-beauty">
                <div class="category-art art-beauty">
                    <span class="art-shape"></span>
                    <span class="art-caption">THE BEAUTY EDIT</span>
                </div>
                <div class="category-info">
                    <div><h3>Beauty & Care</h3><p>Your everyday ritual</p></div>
                    <span class="round-arrow">↗</span>
                </div>
            </a>
        </div>
    </section>

    <!-- Featured products -->
    <section class="section products-section" id="featured">
        <div class="section-heading">
            <div>
                <p class="eyebrow">A FEW GOOD FINDS</p>
                <h2>Featured <em>for you.</em></h2>
            </div>
            <p class="section-intro">
                A little inspiration for your next discovery.
            </p>
        </div>

        <div class="product-grid" id="featuredProducts"
             aria-live="polite">

            <div class="empty-state">
                <span class="empty-icon">✳</span>
                <h3>Your next favourite is waiting.</h3>
                <p>Products will appear here once the OneCart catalogue is connected.</p>
            </div>

        </div>
    </section>

    <!-- Promotional banner -->
    <section class="promo-section">
        <div class="promo-copy">
            <p class="eyebrow">GOOD THINGS ARE CLOSER</p>
            <h2>More to discover.<br><em>More to love.</em></h2>
            <p>Explore a growing world of independent stores and products made to find their way into your everyday.</p>
            <a href="#stores" class="button button-light">Meet our stores <span>↗</span></a>
        </div>
        <div class="promo-art" aria-hidden="true">
            <div class="promo-circle"></div>
            <div class="promo-orbit"></div>
            <span class="promo-star">✳</span>
            <span class="promo-word">GOOD<br>FINDS</span>
        </div>
    </section>

    <!-- Trending -->
    <section class="section products-section" id="trending">
        <div class="section-heading">
            <div>
                <p class="eyebrow">THE ONES TO KNOW</p>
                <h2>Trending <em>now.</em></h2>
            </div>
        </div>

        <div class="product-grid" id="trendingProducts">
            <div class="empty-state">
                <span class="empty-icon">↗</span>
                <h3>What's catching your eye?</h3>
                <p>Trending products will appear here when the catalogue is connected.</p>
            </div>
        </div>
    </section>

    <!-- New arrivals -->
    <section class="section new-arrivals-section" id="new-arrivals">
        <div class="section-heading">
            <div>
                <p class="eyebrow">FRESH FROM OUR STORES</p>
                <h2>Just <em>arrived.</em></h2>
            </div>
        </div>

        <div class="product-grid" id="newArrivals">
            <div class="empty-state">
                <span class="empty-icon">✦</span>
                <h3>Something new is on its way.</h3>
                <p>New arrivals will appear here when the catalogue is connected.</p>
            </div>
        </div>
    </section>

    <!-- Vendor stores -->
    <section class="section stores-section" id="stores">
        <div class="section-heading">
            <div>
                <p class="eyebrow">MEET THE MAKERS & SELLERS</p>
                <h2>Good finds start<br>with <em>great stores.</em></h2>
            </div>
            <p class="section-intro">
                Every store has its own story.
                Find one that feels like yours.
            </p>
        </div>

        <div class="store-grid" id="vendorStores">
            <div class="empty-state">
                <span class="empty-icon">✳</span>
                <h3>Meet our marketplace sellers.</h3>
                <p>Store information will appear here once vendor accounts are connected.</p>
            </div>
        </div>
    </section>

    <!-- Customer benefits -->
    <section class="section trust-section">
        <div class="trust-heading">
            <p class="eyebrow">A LITTLE MORE PEACE OF MIND</p>
            <h2>Shopping should feel <em>good.</em></h2>
        </div>

        <div class="trust-grid">
            <article class="trust-card">
                <span class="trust-icon">♢</span>
                <h3>Secure payments</h3>
                <p>Shop with confidence through a secure checkout experience.</p>
            </article>
            <article class="trust-card">
                <span class="trust-icon">↗</span>
                <h3>Reliable delivery</h3>
                <p>Follow your order as it makes its way to you.</p>
            </article>
            <article class="trust-card">
                <span class="trust-icon">♡</span>
                <h3>Easy support</h3>
                <p>Need a hand? Our support team is here to help.</p>
            </article>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="section testimonials-section">
        <p class="eyebrow">KIND WORDS, GOOD FINDS</p>
        <h2>Shopping stories<br>worth <em>sharing.</em></h2>

        <div class="testimonial-empty">
            <span>✳</span>
            <p>Customer stories will appear here as the OneCart community grows.</p>
        </div>
    </section>

    <!-- Newsletter -->
    <section class="newsletter-section">
        <div>
            <p class="eyebrow">A LITTLE SOMETHING IN YOUR INBOX</p>
            <h2>Good finds, <em>delivered.</em></h2>
            <p>Get the latest discoveries, store stories, and marketplace updates.</p>
        </div>

        <form class="newsletter-form" id="newsletterForm" novalidate>
            <label for="newsletterEmail">Your email address</label>
            <div class="newsletter-input-row">
                <input type="email" id="newsletterEmail"
                       placeholder="you@example.com" required>
                <button type="submit">Join us <span>→</span></button>
            </div>
            <p id="newsletterMessage" class="form-message" aria-live="polite"></p>
        </form>
    </section>

</main>

<!-- Footer -->
<footer class="site-footer">
    <div class="footer-main">
        <div class="footer-brand">
            <a th:href="@{/}" class="brand brand-light">One<span>Cart</span><i>.</i></a>
            <p>Good finds. Great stores.<br>All in one place.</p>
        </div>

        <div class="footer-column">
            <h3>Discover</h3>
            <a href="#categories">Categories</a>
            <a href="#featured">Featured finds</a>
            <a href="#stores">Our stores</a>
        </div>

        <div class="footer-column">
            <h3>OneCart</h3>
            <a th:href="@{/about}">About Us</a>
            <a th:href="@{/contact}">Contact Us</a>
            <a th:href="@{/contact}">Help & Support</a>
        </div>

        <div class="footer-column">
            <h3>Your account</h3>
            <a th:href="@{/login}">Login</a>
            <a th:href="@{/signup}">Create account</a>
        </div>
    </div>

    <div class="footer-bottom">
        <p>© 2026 OneCart. All rights reserved.</p>
        <div>
            <a th:href="@{/privacy}">Privacy Policy</a>
            <a th:href="@{/terms}">Terms & Conditions</a>
        </div>
    </div>
</footer>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script th:src="@{/js/home.js}" defer></script>

</body>
</html>