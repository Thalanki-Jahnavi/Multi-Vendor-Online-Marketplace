:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --pale-mint: #f3faf8;
    --text: #173b38;
    --muted: #687f7c;
    --border: #e1eeeb;
    --white: #ffffff;
    --shadow: 0 12px 30px rgba(18, 62, 58, 0.08);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    color: var(--text);
    background: var(--white);
    font-family: Arial, Helvetica, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font: inherit;
}

.announcement {
    padding: 11px 20px;
    color: var(--white);
    background: var(--deep-green);
    text-align: center;
    font-size: 14px;
}

.main-header {
    min-height: 98px;
    display: grid;
    grid-template-columns: 1fr minmax(280px, 1.5fr) 1fr;
    align-items: center;
    gap: 32px;
    padding: 20px max(7%, calc((100% - 1320px) / 2));
    border-bottom: 1px solid var(--border);
}

.logo,
.footer-logo {
    color: var(--emerald);
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -1.5px;
}

.search-form {
    display: flex;
    min-width: 0;
    height: 52px;
    overflow: hidden;
    border: 1px solid #d5e5e1;
    border-radius: 12px;
    background: var(--white);
}

.search-form input {
    width: 100%;
    min-width: 0;
    padding: 0 18px;
    border: 0;
    outline: 0;
    color: var(--text);
}

.search-form button {
    padding: 0 24px;
    border: 0;
    color: var(--white);
    background: var(--emerald);
    font-weight: 700;
    cursor: pointer;
}

.account-links {
    display: flex;
    justify-content: flex-end;
    gap: 24px;
    font-weight: 700;
}

.account-links a:hover,
.main-nav a:hover,
.footer-column a:hover {
    color: var(--emerald);
}

.main-nav {
    display: flex;
    justify-content: center;
    gap: 40px;
    padding: 21px 20px;
    border-bottom: 1px solid var(--border);
}

.main-nav a {
    font-size: 15px;
}

main {
    width: min(1320px, 86%);
    margin: 0 auto;
}

.hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 470px;
    margin: 36px 0 78px;
    padding: 60px 5%;
    overflow: hidden;
    border-radius: 24px;
    background: linear-gradient(115deg, #e4f4ef 0%, #f6fbf9 75%);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 650px;
}

.eyebrow {
    margin: 0 0 16px;
    color: var(--emerald);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
}

.hero h1 {
    max-width: 650px;
    margin: 0;
    color: var(--deep-green);
    font-size: clamp(42px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -2px;
}

.hero-description {
    max-width: 570px;
    margin: 24px 0 32px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.8;
}

.primary-button,
.light-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 25px;
    border-radius: 10px;
    background: var(--emerald);
    color: var(--white);
    font-weight: 700;
    transition: transform 0.2s ease, background 0.2s ease;
}

.primary-button:hover,
.light-button:hover {
    transform: translateY(-2px);
    background: #066b66;
}

.hero-decoration {
    position: absolute;
    inset: 0 0 0 58%;
    overflow: hidden;
}

.decoration-circle {
    position: absolute;
    border: 1px solid rgba(8, 126, 120, 0.13);
    border-radius: 50%;
}

.circle-one {
    width: 390px;
    height: 390px;
    top: 40px;
    right: -40px;
}

.circle-two {
    width: 270px;
    height: 270px;
    top: 100px;
    right: 20px;
    background: rgba(255, 255, 255, 0.32);
}

.decoration-card {
    position: absolute;
    top: 42%;
    right: 14%;
    display: grid;
    place-items: center;
    width: 180px;
    height: 115px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--emerald);
    font-size: 26px;
    font-weight: 800;
    box-shadow: var(--shadow);
    transform: rotate(8deg);
}

.section {
    margin: 0 0 82px;
}

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
}

.section-heading h2 {
    margin: 0 0 9px;
    color: var(--deep-green);
    font-size: 32px;
    letter-spacing: -0.8px;
}

.section-heading .eyebrow {
    margin-bottom: 10px;
}

.section-heading p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
}

.text-link {
    flex-shrink: 0;
    padding-bottom: 5px;
    color: var(--emerald);
    font-weight: 700;
}

.text-link span {
    margin-left: 6px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
}

.product-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--white);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-card:hover,
.store-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.product-image {
    display: grid;
    place-items: center;
    height: 178px;
    margin: 20px 20px 0;
    border-radius: 12px;
    background: var(--mint);
    color: var(--emerald);
    font-weight: 700;
}

.product-info {
    padding: 18px 20px 20px;
}

.product-info h3 {
    margin: 0 0 12px;
    color: #142f2c;
    font-size: 18px;
}

.product-price {
    margin: 0 0 16px;
    color: var(--deep-green);
    font-size: 20px;
    font-weight: 800;
}

.small-button {
    display: inline-block;
    padding: 10px 14px;
    border: 1px solid #b9d9d2;
    border-radius: 8px;
    color: var(--emerald);
    font-size: 13px;
    font-weight: 700;
}

.small-button:hover {
    color: var(--white);
    background: var(--emerald);
}

.empty-state {
    padding: 55px 20px;
    border: 1px dashed #bfd9d3;
    border-radius: 16px;
    background: var(--pale-mint);
    text-align: center;
}

.empty-icon {
    margin-bottom: 12px;
    font-size: 36px;
}

.empty-state h3 {
    margin: 0 0 8px;
}

.empty-state p {
    margin: 0;
    color: var(--muted);
}

.stores-section {
    padding: 45px;
    border-radius: 22px;
    background: var(--pale-mint);
}

.store-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}

.store-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--white);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.store-banner {
    display: grid;
    place-items: center;
    height: 150px;
}

.store-banner-one {
    background: linear-gradient(135deg, #d9eee7, #b8dcd1);
}

.store-banner-two {
    background: linear-gradient(135deg, #e8e4f4, #d4cbea);
}

.store-banner-three {
    background: linear-gradient(135deg, #dceaf2, #c0dce9);
}

.store-banner-four {
    background: linear-gradient(135deg, #f3e8d9, #ead3b8);
}

.store-mark {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.7);
    color: var(--deep-green);
    font-size: 30px;
    font-weight: 800;
}

.store-info {
    padding: 20px;
}

.store-label {
    color: var(--emerald);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.3px;
}

.store-info h3 {
    margin: 10px 0 8px;
    font-size: 19px;
}

.store-info p {
    min-height: 42px;
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
}

.store-info a {
    color: var(--emerald);
    font-size: 14px;
    font-weight: 700;
}

.store-info a span {
    margin-left: 5px;
}

.vendor-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin: 0 0 65px;
    padding: 38px 45px;
    border-radius: 20px;
    background: var(--deep-green);
    color: var(--white);
}

.vendor-banner .eyebrow {
    color: #9bd6c8;
}

.vendor-banner h2 {
    margin: 0 0 10px;
    font-size: 28px;
}

.vendor-banner p:not(.eyebrow) {
    margin: 0;
    color: #d0e3df;
    line-height: 1.6;
}

.light-button {
    flex-shrink: 0;
    color: var(--deep-green);
    background: var(--white);
}

.light-button:hover {
    color: var(--deep-green);
    background: #e5f4f0;
}

.benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    padding: 30px 0 65px;
    border-top: 1px solid var(--border);
}

.benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
}

.benefit-icon {
    display: grid;
    flex: 0 0 44px;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 20px;
    font-weight: 800;
}

.benefit-item h3 {
    margin: 2px 0 8px;
    font-size: 16px;
}

.benefit-item p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
}

.site-footer {
    color: #e4f0ed;
    background: var(--deep-green);
}

.footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1.5fr;
    gap: 35px;
    width: min(1320px, 86%);
    margin: 0 auto;
    padding: 58px 0 48px;
}

.footer-logo {
    display: inline-block;
    margin-bottom: 16px;
    color: var(--white);
    font-size: 30px;
}

.footer-brand p,
.footer-newsletter p {
    margin: 0 0 20px;
    color: #bcd2cd;
    font-size: 14px;
    line-height: 1.7;
}

.social-links {
    display: flex;
    gap: 10px;
}

.social-links a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid #55736e;
    border-radius: 50%;
    color: var(--white);
    font-size: 12px;
    font-weight: 700;
}

.social-links a:hover {
    background: var(--emerald);
}

.footer-column h3,
.footer-newsletter h3 {
    margin: 6px 0 20px;
    color: var(--white);
    font-size: 15px;
}

.footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
}

.footer-column a {
    color: #bcd2cd;
    font-size: 14px;
}

.newsletter-form {
    display: flex;
    height: 44px;
    overflow: hidden;
    border: 1px solid #55736e;
    border-radius: 8px;
}

.newsletter-form input {
    width: 100%;
    min-width: 0;
    padding: 0 12px;
    border: 0;
    outline: 0;
    color: var(--white);
    background: transparent;
}

.newsletter-form input::placeholder {
    color: #bcd2cd;
}

.newsletter-form button {
    width: 48px;
    border: 0;
    color: var(--deep-green);
    background: #c7e8df;
    font-size: 22px;
    cursor: pointer;
}

.footer-newsletter small {
    display: inline-block;
    margin-top: 12px;
    color: #bcd2cd;
    font-size: 11px;
}

.footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    width: min(1320px, 86%);
    margin: 0 auto;
    padding: 20px 0;
    border-top: 1px solid #315b55;
    color: #bcd2cd;
    font-size: 13px;
}

.footer-bottom p {
    margin: 0;
}

.footer-bottom div {
    display: flex;
    gap: 22px;
}

.footer-bottom a:hover {
    color: var(--white);
}

/* Responsive layout */
@media (max-width: 1100px) {
    .main-header {
        grid-template-columns: auto 1fr auto;
        gap: 20px;
        padding-right: 5%;
        padding-left: 5%;
    }

    .product-grid,
    .store-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-main {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-brand,
    .footer-newsletter {
        grid-column: span 3;
    }
}

@media (max-width: 700px) {
    .main-header {
        grid-template-columns: 1fr auto;
        gap: 16px;
    }

    .logo {
        font-size: 29px;
    }

    .search-form {
        grid-column: 1 / -1;
        grid-row: 2;
    }

    .account-links {
        gap: 14px;
        font-size: 14px;
    }

    .main-nav {
        gap: 20px;
        overflow-x: auto;
        justify-content: flex-start;
        padding: 18px 7%;
    }

    main {
        width: 90%;
    }

    .hero {
        min-height: 390px;
        margin-top: 24px;
        padding: 38px 7%;
    }

    .hero h1 {
        font-size: 42px;
    }

    .hero-description {
        font-size: 16px;
    }

    .hero-decoration {
        opacity: 0.35;
        inset-left: 35%;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .section-heading h2 {
        font-size: 27px;
    }

    .product-grid,
    .store-grid,
    .benefits {
        grid-template-columns: 1fr;
    }

    .stores-section {
        padding: 25px 18px;
    }

    .vendor-banner {
        align-items: flex-start;
        flex-direction: column;
        padding: 30px 25px;
    }

    .footer-main {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px 20px;
    }

    .footer-brand,
    .footer-newsletter {
        grid-column: span 2;
    }

    .footer-bottom {
        flex-direction: column;
    }
}

@media (max-width: 420px) {
    .account-links {
        gap: 10px;
        font-size: 13px;
    }

    .hero h1 {
        font-size: 36px;
    }

    .footer-main {
        grid-template-columns: 1fr;
    }

    .footer-brand,
    .footer-newsletter {
        grid-column: auto;
    }
}