<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Successful & Order Confirmed | OneCart</title>
    <link rel="stylesheet" th:href="@{/css/products.css}">

    <style>
        .success-page {
            max-width: 680px;
            margin: 40px auto 80px;
            padding: 0 20px;
        }

        .success-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 40px 36px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        }

        .success-checkmark {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: #e8f5e9;
            color: #2e7d32;
            display: grid;
            place-items: center;
            font-size: 36px;
            margin: 0 auto 20px;
            box-shadow: 0 0 0 10px #f1f8e9;
        }

        .success-card h1 {
            color: var(--deep-green);
            font-size: 26px;
            margin: 0 0 8px;
        }

        .success-card p {
            color: var(--text-muted);
            font-size: 15px;
            margin: 0 0 24px;
        }

        .order-badge-pill {
            display: inline-block;
            background: var(--emerald-light);
            color: var(--deep-green);
            padding: 8px 18px;
            border-radius: var(--radius-full);
            font-weight: 700;
            font-size: 15px;
            margin-bottom: 24px;
        }

        .email-alert-box {
            background: #f0faf9;
            border: 1px solid #c2ece7;
            border-radius: var(--radius-md);
            padding: 14px 18px;
            font-size: 14px;
            color: var(--deep-green);
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 28px;
            text-align: left;
        }

        .order-meta-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
            text-align: left;
            font-size: 14px;
        }

        .order-meta-table td {
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .order-meta-table td:first-child {
            color: var(--text-muted);
            width: 40%;
        }

        .order-meta-table td:last-child {
            font-weight: 600;
            color: var(--deep-green);
            text-align: right;
        }

        .success-actions {
            display: flex;
            gap: 14px;
            justify-content: center;
        }

        .btn-view-orders {
            padding: 12px 24px;
            background: var(--emerald);
            color: #fff;
            border-radius: var(--radius-md);
            font-weight: 700;
            text-decoration: none;
            transition: var(--transition);
        }

        .btn-view-orders:hover {
            background: var(--emerald-dark);
        }

        .btn-shop-more {
            padding: 12px 24px;
            background: #fff;
            border: 1px solid var(--border);
            color: var(--deep-green);
            border-radius: var(--radius-md);
            font-weight: 700;
            text-decoration: none;
            transition: var(--transition);
        }

        .btn-shop-more:hover {
            border-color: var(--emerald);
            background: var(--emerald-light);
        }
    </style>
</head>

<body>

<header class="site-header">
    <a class="brand" th:href="@{/}">One<span>Cart</span></a>

    <nav class="main-nav" aria-label="Main navigation">
        <a th:href="@{/customer/dashboard}">Dashboard</a>
        <a th:href="@{/customer/products}">Shop</a>
        <a th:href="@{/customer/orders}">My Orders</a>
        <a th:href="@{/customer/account}">My Account</a>
    </nav>
</header>

<main class="success-page">
    <div class="success-card">
        <div class="success-checkmark">✓</div>
        <h1>Payment Successful!</h1>
        <p>Your order has been confirmed and is being processed for delivery.</p>

        <div class="order-badge-pill" th:if="${order != null}">
            Order ID: <span th:text="${order.orderNumber}">OD-12345678</span>
        </div>

        <div class="email-alert-box">
            <span style="font-size: 20px;">📧</span>
            <span>
                A confirmation email with your order summary has been dispatched to 
                <strong th:text="${order != null ? order.customerEmail : 'your email address'}">your email</strong>.
            </span>
        </div>

        <table class="order-meta-table" th:if="${order != null}">
            <tr>
                <td>Payment Method</td>
                <td th:text="${order.paymentMethod}">CARD</td>
            </tr>
            <tr>
                <td>Payment Status</td>
                <td><span style="color: #2e7d32; font-weight: 800;">PAID (Verified)</span></td>
            </tr>
            <tr>
                <td>Total Paid</td>
                <td th:text="'₹' + #numbers.formatDecimal(order.totalAmount, 1, 2)">₹0.00</td>
            </tr>
            <tr>
                <td>Delivery To</td>
                <td th:text="${order.shippingAddress}">Address</td>
            </tr>
            <tr>
                <td>Estimated Delivery</td>
                <td>Within 3 - 5 Business Days</td>
            </tr>
        </table>

        <div class="success-actions">
            <a class="btn-view-orders" th:href="@{/customer/orders}">📦 View My Orders</a>
            <a class="btn-shop-more" th:href="@{/customer/products}">🛍️ Continue Shopping</a>
        </div>
    </div>
</main>

</body>
</html>
