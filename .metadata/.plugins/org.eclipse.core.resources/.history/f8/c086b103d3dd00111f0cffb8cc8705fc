<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Customers | OneCart Admin</title>

    <link rel="stylesheet" th:href="@{/css/admin-dashboard.css}">

    <style>
        .customers-content {
            padding: 30px;
        }

        .customers-header {
            margin-bottom: 26px;
        }

        .customers-header .breadcrumb {
            color: #78908e;
            font-size: 14px;
            margin-bottom: 22px;
        }

        .customers-header .breadcrumb span {
            color: #087e78;
            font-weight: 600;
        }

        .customers-header h1 {
            color: #123e3a;
            font-size: 32px;
            margin: 0 0 12px;
        }

        .customers-header p {
            color: #78908e;
            font-size: 16px;
            margin: 0;
        }

        .customer-stat-card {
            background: white;
            border: 1px solid #e0eeeb;
            border-radius: 16px;
            padding: 25px;
            width: 220px;
            margin-bottom: 26px;
        }

        .customer-stat-card span {
            color: #78908e;
            font-size: 13px;
            text-transform: uppercase;
        }

        .customer-stat-card h2 {
            color: #087e78;
            font-size: 32px;
            margin: 12px 0 0;
        }

        .customer-table-card {
            background: white;
            border: 1px solid #e0eeeb;
            border-radius: 17px;
            padding: 26px;
            overflow: hidden;
        }

        .customer-table-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .customer-table-heading h2 {
            color: #123e3a;
            font-size: 21px;
            margin: 0;
        }

        .customer-search {
            width: 280px;
            max-width: 100%;
            padding: 13px 16px;
            border: 1px solid #d9e8e5;
            border-radius: 9px;
            outline: none;
            font-size: 14px;
        }

        .customer-search:focus {
            border-color: #087e78;
            box-shadow: 0 0 0 3px rgba(8, 126, 120, 0.10);
        }

        .customer-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .customer-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 850px;
        }

        .customer-table thead {
            background: #f2f8f6;
        }

        .customer-table th {
            text-align: left;
            padding: 17px;
            color: #66817e;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .customer-table td {
            padding: 20px 17px;
            border-bottom: 1px solid #edf2f0;
            color: #123e3a;
            font-size: 14px;
        }

        .customer-table tbody tr:hover {
            background: #f9fcfb;
        }

        .customer-name {
            font-weight: 700;
        }

        .customer-status {
            display: inline-block;
            padding: 7px 14px;
            border-radius: 20px;
            background: #e4f4ed;
            color: #16845e;
            font-size: 12px;
            font-weight: 600;
        }

        .customer-empty {
            text-align: center;
            padding: 30px;
            color: #78908e;
        }

        @media (max-width: 768px) {
            .customers-content {
                padding: 18px;
            }

            .customer-table-card {
                padding: 16px;
            }

            .customer-table-heading {
                align-items: stretch;
            }

            .customer-search {
                width: 100%;
            }
        }
    </style>
</head>

<body>

<div class="admin-layout">

    <!-- REUSABLE ADMIN SIDEBAR -->
    <div th:replace="~{fragments/sidebar :: adminSidebar}"></div>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <div class="customers-content">

            <!-- PAGE HEADER -->
            <header class="customers-header">

                <div class="breadcrumb">
                    OneCart / <span>Admin</span> / Customers
                </div>

                <h1>Customer Management</h1>

                <p>View and manage customers registered on OneCart.</p>

            </header>

            <!-- CUSTOMER COUNT -->
            <section class="customer-stat-card">

                <span>Total Customers</span>

                <h2 th:text="${totalCustomers}">0</h2>

            </section>

            <!-- CUSTOMER TABLE -->
            <section class="customer-table-card">

                <div class="customer-table-heading">

                    <h2>Registered Customers</h2>

                    <input
                        type="text"
                        id="customerSearch"
                        class="customer-search"
                        placeholder="Search by name or email..."
                        autocomplete="off">

                </div>

                <div class="customer-table-wrapper">

                    <table class="customer-table" id="customersTable">

                        <thead>
                        <tr>
                            <th>CUSTOMER ID</th>
                            <th>CUSTOMER NAME</th>
                            <th>EMAIL ADDRESS</th>
                            <th>PHONE</th>
                            <th>CITY</th>
                            <th>STATUS</th>
                        </tr>
                        </thead>

                        <tbody id="customerTableBody">

                        <tr th:each="customer : ${customers}">

                            <td th:text="${customer.userId}">
                                1
                            </td>

                            <td class="customer-name"
                                th:text="${(customer.firstName != null ? customer.firstName : '') + ' ' + (customer.lastName != null ? customer.lastName : '')}">
                                Customer Name
                            </td>

                            <td th:text="${customer.email}">
                                customer@email.com
                            </td>

                            <td th:text="${customer.phone != null ? customer.phone : 'N/A'}">
                                N/A
                            </td>

                            <td th:text="${customer.city != null ? customer.city : 'N/A'}">
                                N/A
                            </td>

                            <td>
                                <span class="customer-status">Registered</span>
                            </td>

                        </tr>

                        <tr th:if="${#lists.isEmpty(customers)}">
                            <td colspan="6" class="customer-empty">
                                No customers registered yet.
                            </td>
                        </tr>

                        </tbody>

                    </table>

                </div>

                <p id="noCustomerResults"
                   class="customer-empty"
                   style="display:none;">
                    No matching customers found.
                </p>

            </section>

        </div>

    </main>

</div>

<!-- CUSTOMER SEARCH -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("customerSearch");
		const customerRows = document.querySelectorAll(
		    "#customerTableBody tr"
		);
        const noResults = document.getElementById("noCustomerResults");

        searchInput.addEventListener("input", function () {

            const searchValue = this.value.toLowerCase().trim();

            let visibleCount = 0;

            customerRows.forEach(function (row) {

                if (row.querySelector(".customer-empty")) {
                    return;
                }

                const rowText = row.innerText.toLowerCase();

                const matches = rowText.includes(searchValue);

                row.style.display = matches ? "" : "none";

                if (matches) {
                    visibleCount++;
                }

            });

            noResults.style.display =
                visibleCount === 0 ? "block" : "none";

        });

    });
</script>

</body>
</html>