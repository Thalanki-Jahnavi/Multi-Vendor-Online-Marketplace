<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Join OneCart</title>
  <style>
    :root {
      --emerald: #087e78;
      --deep-green: #123e3a;
      --mint: #e5f4f0;
      --border: #dce8e4;
      --muted: #71817d;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      color: var(--deep-green);
      background:
        radial-gradient(circle at 12% 18%, #d2eee7 0, transparent 28%),
        radial-gradient(circle at 90% 85%, #c9e8df 0, transparent 30%),
        #f6faf8;
    }

    header {
      height: 78px;
      padding: 0 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255, 255, 255, 0.75);
      border-bottom: 1px solid rgba(220, 232, 228, 0.8);
      backdrop-filter: blur(12px);
    }

    .logo {
      color: var(--deep-green);
      font-size: 27px;
      font-weight: 800;
      text-decoration: none;
      letter-spacing: -1px;
    }

    .logo span { color: var(--emerald); }

    nav { display: flex; gap: 28px; }

    nav a, .login-link {
      color: #60736e;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    nav a:hover, .login-link:hover { color: var(--emerald); }

    main {
      min-height: calc(100vh - 78px);
      display: grid;
      place-items: center;
      padding: 42px 18px;
    }

    .signup-card {
      width: min(100%, 510px);
      padding: 38px 42px 34px;
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid white;
      border-radius: 26px;
      box-shadow: 0 24px 70px rgba(18, 62, 58, 0.12);
      backdrop-filter: blur(16px);
    }

    .brand-mark {
      width: 52px;
      height: 52px;
      display: grid;
      place-items: center;
      margin-bottom: 24px;
      border-radius: 17px;
      background: var(--deep-green);
      color: white;
      font-size: 25px;
      font-weight: 800;
      box-shadow: 0 8px 18px rgba(18, 62, 58, 0.18);
    }

    h1 {
      margin: 0 0 9px;
      font-size: 31px;
      letter-spacing: -0.7px;
    }

    .intro {
      margin: 0 0 28px;
      color: var(--muted);
      line-height: 1.5;
      font-size: 15px;
    }

    .field { margin-bottom: 17px; }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 700;
    }

    input, select {
      width: 100%;
      height: 48px;
      padding: 0 14px;
      border: 1px solid var(--border);
      border-radius: 11px;
      background: #fbfdfc;
      color: var(--deep-green);
      font: inherit;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }

    input::placeholder { color: #9aa9a4; }

    input:focus, select:focus {
      background: white;
      border-color: var(--emerald);
      box-shadow: 0 0 0 4px rgba(8, 126, 120, 0.1);
    }

    .password-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .create-btn {
      width: 100%;
      height: 51px;
      margin-top: 5px;
      border: 0;
      border-radius: 12px;
      background: linear-gradient(105deg, #087e78, #0b958b);
      color: white;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(8, 126, 120, 0.2);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .create-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 22px rgba(8, 126, 120, 0.25);
    }

    .message {
      min-height: 18px;
      margin: 12px 0 0;
      font-size: 13px;
      color: #b42318;
    }

    .signin {
      margin: 19px 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }

    .signin a {
      color: var(--emerald);
      font-weight: 700;
      text-decoration: none;
    }

    @media (max-width: 560px) {
      header { padding: 0 5%; }
      nav { gap: 14px; }
      nav a:not(:first-child) { display: none; }
      .signup-card { padding: 30px 24px; }
      h1 { font-size: 27px; }
      .password-row { grid-template-columns: 1fr; gap: 0; }
    }
  </style>
</head>
<body>
  <header>
    <a class="logo" href="/guest/index.html">One<span>Cart</span></a>
    <nav>
      <a href="/guest/index.html">Home</a>
      <a href="/guest/about.html">About</a>
      <a href="/guest/contact.html">Contact</a>
    </nav>
    <a class="login-link" href="/guest/login.html">Login</a>
  </header>

  <main>
    <section class="signup-card">
      <div class="brand-mark">O</div>
      <h1>Create your account</h1>
      <p class="intro">One account. Many stores. A simpler way to shop.</p>

      <form id="signupForm">
        <div class="field">
          <label for="fullName">Full name</label>
          <input id="fullName" name="fullName" type="text"
                 placeholder="Enter your full name" autocomplete="name" required>
        </div>

        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email"
                 placeholder="you@example.com" autocomplete="email" required>
        </div>

        <div class="password-row">
          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password"
                   placeholder="At least 8 characters" minlength="8"
                   autocomplete="new-password" required>
          </div>

          <div class="field">
            <label for="confirmPassword">Confirm password</label>
            <input id="confirmPassword" name="confirmPassword" type="password"
                   placeholder="Enter it again" minlength="8"
                   autocomplete="new-password" required>
          </div>
        </div>

        <div class="field">
          <label for="accountType">Account type</label>
          <select id="accountType" name="accountType" required>
            <option value="CUSTOMER">Customer</option>
            <option value="VENDOR">Vendor</option>
          </select>
        </div>

        <button class="create-btn" type="submit">Create Account</button>
        <p class="message" id="message" aria-live="polite"></p>
      </form>

      <p class="signin">Already have an account? <a href="/guest/login.html">Sign in</a></p>
    </section>
  </main>

  <script>
    document.getElementById("signupForm").addEventListener("submit", function (event) {
      event.preventDefault();

      const password = document.getElementById("password").value;
      const confirmPassword = document.getElementById("confirmPassword").value;
      const message = document.getElementById("message");

      if (password !== confirmPassword) {
        message.style.color = "#b42318";
        message.textContent = "Passwords do not match.";
        return;
      }

      message.style.color = "#087e78";
      message.textContent = "Details checked. Account creation will be connected to the backend later.";
    });
  </script>
</body>
</html>