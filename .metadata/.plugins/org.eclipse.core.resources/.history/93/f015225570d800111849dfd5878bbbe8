<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products | OneCart</title>
    <link rel="stylesheet" th:href="@{/css/products.css}">
</head>
<body>

<header class="site-header">
    <a class="brand" th:href="@{/}">One<span>Cart</span></a>

    <nav class="main-nav">
        <a th:href="@{/customer/dashboard}">Dashboard</a>
        <a class="active" th:href="@{/products}">Shop</a>
        <a th:href="@{/customer/orders}">My Orders</a>
        <a th:href="@{/customer/account}">My Account</a>
    </nav>

    <form th:action="@{/logout}" method="post">
        <button class="sign-out" type="submit">Sign out</button>
    </form>
</header>

<main class="page">
    <div class="breadcrumb">
        <a th:href="@{/customer/dashboard}">⌂ Home</a>
        <span>/</span>
        <span>Products</span>
    </div>

    <section class="page-intro">
        <div>
            <h1>Explore products</h1>
            <p>Find something great from OneCart vendors.</p>
        </div>
        <div class="shopping-art" aria-hidden="true">🛍️</div>
    </section>

    <form class="filter-bar" th:action="@{/products}" method="get">
        <input type="search" name="keyword"
               th:value="${keyword}"
               placeholder="Search products..."
               aria-label="Search products">

        <label>
            Category
            <select name="category">
                <option value="">All Categories</option>
                <option value="Fashion" th:selected="${category == 'Fashion'}">Fashion</option>
                <option value="Electronics" th:selected="${category == 'Electronics'}">Electronics</option>
                <option value="Home & Living" th:selected="${category == 'Home & Living'}">Home &amp; Living</option>
                <option value="Beauty" th:selected="${category == 'Beauty'}">Beauty</option>
            </select>
        </label>

        <label>
            Sort by
            <select name="sort">
                <option value="newest" th:selected="${sort == 'newest'}">Newest First</option>
                <option value="price-low" th:selected="${sort == 'price-low'}">Price: Low to High</option>
                <option value="price-high" th:selected="${sort == 'price-high'}">Price: High to Low</option>
            </select>
        </label>

        <button type="submit">Apply</button>
    </form>

    <section class="product-grid"
             th:if="${products != null and !products.isEmpty()}">
        <article class="product-card" th:each="product : ${products}">
            <div class="product-image-wrap">
                <img class="product-image"
                     th:src="@{/images/products/Ceramic Coffee Mug.jpg}"
                     th:alt="${product.productName}"
                     loading="lazy">
                <button class="wishlist-button" type="button"
                        aria-label="Sign in to add this product to wishlist"
                        onclick="window.location.href='/login'">♡</button>
            </div>

            <div class="product-info">
                <h2 th:text="${product.productName}">Product name</h2>
                <p class="vendor-name">OneCart vendor</p>

                <strong class="product-price"
                        th:text="${product.price != null ? '₹' + #numbers.formatDecimal(product.price, 1, 2) : 'Price unavailable'}">
                    ₹0.00
                </strong>

                <button class="add-to-cart" type="button"
                        onclick="window.location.href='/login'">
                    🛒 Add to cart
                </button>
            </div>
        </article>
    </section>

    <section class="empty-state"
             th:if="${products == null or products.isEmpty()}">
        <h2>No products found</h2>
        <p>Try another search, or check back later for new products.</p>
        <a th:href="@{/products}">Clear search</a>
    </section>
</main>

</body>
</html>