@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');

:root {
    --terracotta: #B6533C;
    --terracotta-dark: #93412F;
    --cream: #FFF7EA;
    --plum: #352536;
    --rose: #E8B8A8;
    --sand: #F0E2CF;
    --white: #FFFFFF;
    --muted: #786B69;
    --line: #E8D9C9;
    --shadow: 0 12px 35px rgba(53, 37, 54, 0.09);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--cream);
    color: var(--plum);
    font-family: "DM Sans", sans-serif;
}

button,
input,
select {
    font: inherit;
}

button,
a,
select {
    -webkit-tap-highlight-color: transparent;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
    text-decoration: none;
}

.site-header {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 18px 6%;
    background: var(--plum);
    color: var(--white);
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.04em;
}

.brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 11px;
    background: var(--terracotta);
    color: var(--white);
    font-family: "Playfair Display", serif;
    font-size: 1.3rem;
}

.search-form {
    display: flex;
    flex: 1;
    max-width: 660px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
}

.search-form input {
    width: 100%;
    min-width: 0;
    padding: 13px 16px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--white);
}

.search-form input::placeholder {
    color: #D6C9D0;
}

.search-form button {
    width: 50px;
    border: 0;
    background: var(--terracotta);
    color: var(--white);
    font-size: 1.6rem;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
}

.text-button,
.cart-button {
    border: 0;
    background: transparent;
    color: var(--white);
    font-weight: 600;
}

.cart-button {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 13px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 10px;
}

#cartCount {
    display: grid;
    min-width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 50%;
    background: var(--rose);
    color: var(--plum);
    font-size: 0.78rem;
}

.category-nav {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 12px 5%;
    border-bottom: 1px solid var(--line);
    background: var(--cream);
    overflow-x: auto;
}

.category-button {
    padding: 9px 17px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--plum);
    white-space: nowrap;
}

.category-button:hover,
.category-button.active {
    border-color: var(--terracotta);
    background: var(--terracotta);
    color: var(--white);
}

main {
    width: min(1200px, 88%);
    margin: 34px auto 70px;
}

.hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    min-height: 330px;
    overflow: hidden;
    border-radius: 24px;
    background: var(--sand);
}

.hero-copy {
    align-self: center;
    padding: 42px 9%;
}

.eyebrow {
    margin: 0 0 10px;
    color: var(--terracotta);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
}

.hero h1 {
    margin: 0;
    font-family: "Playfair Display", serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
}

.hero-copy > p:not(.eyebrow) {
    max-width: 420px;
    margin: 20px 0;
    color: var(--muted);
    line-height: 1.7;
}

.hero-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 17px;
    border-radius: 10px;
    background: var(--terracotta);
    color: var(--white);
    font-weight: 600;
}

.hero-link:hover,
.checkout-button:hover {
    background: var(--terracotta-dark);
}

.hero-art {
    position: relative;
    min-height: 280px;
    background: var(--rose);
}

.hero-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 250px;
    height: 250px;
    border: 1px solid rgba(53, 37, 54, 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
}

.hero-circle::before,
.hero-circle::after {
    position: absolute;
    content: "";
    border: 1px solid rgba(53, 37, 54, 0.2);
    border-radius: 50%;
}

.hero-circle::before {
    inset: 22px;
}

.hero-circle::after {
    inset: 45px;
}

.hero-label {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 150px;
    height: 150px;
    place-content: center;
    border-radius: 50%;
    background: var(--cream);
    color: var(--plum);
    font-family: "Playfair Display", serif;
    font-size: 1.55rem;
    line-height: 1.1;
    text-align: center;
    transform: translate(-50%, -50%) rotate(-8deg);
}

.hero-star {
    position: absolute;
    top: 18%;
    right: 17%;
    color: var(--terracotta);
    font-size: 3.5rem;
}

.products-section {
    padding-top: 58px;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.section-heading h2,
.cart-heading h2 {
    margin: 0;
    font-family: "Playfair Display", serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
}

.section-subtitle {
    margin: 8px 0 0;
    color: var(--muted);
}

.sort-control {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.9rem;
}

.sort-control select {
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--white);
    color: var(--plum);
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.product-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 17px;
    background: var(--white);
    transition: transform 180ms ease, box-shadow 180ms ease;
}

.product-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-4px);
}

.product-image-wrap {
    position: relative;
    aspect-ratio: 1 / 0.86;
    overflow: hidden;
    background: #F5EEE6;
}

.product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
}

.product-card:hover .product-image {
    transform: scale(1.04);
}

.product-category {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 6px 9px;
    border-radius: 999px;
    background: rgba(255, 247, 234, 0.94);
    color: var(--plum);
    font-size: 0.72rem;
    font-weight: 600;
}

.product-info {
    padding: 16px;
}

.product-seller {
    margin: 0 0 7px;
    color: var(--muted);
    font-size: 0.78rem;
}

.product-name {
    min-height: 44px;
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
}

.product-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 16px;
}

.product-price {
    font-size: 1.05rem;
    font-weight: 700;
}

.add-button {
    padding: 9px 12px;
    border: 0;
    border-radius: 9px;
    background: var(--terracotta);
    color: var(--white);
    font-size: 0.83rem;
    font-weight: 700;
}

.add-button:hover {
    background: var(--terracotta-dark);
}

.empty-state {
    padding: 35px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    color: var(--muted);
    text-align: center;
}

.site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 26px 6%;
    background: var(--plum);
    color: var(--white);
}

.footer-brand {
    font-size: 1.1rem;
}

.site-footer p {
    margin: 0;
    color: #D6C9D0;
    font-size: 0.9rem;
}

.overlay {
    position: fixed;
    z-index: 10;
    inset: 0;
    display: flex;
    justify-content: flex-end;
    background: rgba(28, 19, 29, 0.48);
}

.overlay[hidden] {
    display: none;
}

.cart-panel {
    display: flex;
    flex-direction: column;
    width: min(440px, 100%);
    height: 100%;
    padding: 25px;
    background: var(--cream);
    box-shadow: var(--shadow);
}

.cart-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
}

.cart-heading h2 {
    font-size: 1.8rem;
}

.icon-button {
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--white);
    color: var(--plum);
    font-size: 1.5rem;
}

.cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 12px 0;
}

.cart-empty {
    padding: 35px 10px;
    color: var(--muted);
    text-align: center;
}

.cart-item {
    display: grid;
    grid-template-columns: 74px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
}

.cart-item img {
    width: 74px;
    height: 74px;
    border-radius: 10px;
    object-fit: cover;
    background: var(--sand);
}

.cart-item-name {
    margin: 0 0 6px;
    font-size: 0.9rem;
    font-weight: 700;
}

.cart-item-price {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
}

.quantity-controls {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 9px;
}

.quantity-controls button {
    width: 26px;
    height: 26px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--white);
    color: var(--plum);
}

.remove-button {
    padding: 5px;
    border: 0;
    background: transparent;
    color: var(--terracotta);
    font-size: 0.8rem;
}

.cart-bottom {
    padding-top: 18px;
    border-top: 1px solid var(--line);
}

.cart-total-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.1rem;
}

.cart-note {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
}

.checkout-button,
.continue-button {
    width: 100%;
    padding: 13px;
    border-radius: 10px;
    font-weight: 700;
}

.checkout-button {
    border: 0;
    background: var(--terracotta);
    color: var(--white);
}

.continue-button {
    margin-top: 9px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--plum);
}

.checkout-button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
}

.toast {
    position: fixed;
    z-index: 20;
    right: 22px;
    bottom: 22px;
    max-width: min(360px, calc(100% - 44px));
    padding: 13px 18px;
    border-radius: 10px;
    background: var(--plum);
    color: var(--white);
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 180ms ease, transform 180ms ease;
}

.toast.show {
    opacity: 1;
    transform: translateY(0);
}

@media (max-width: 900px) {
    .site-header {
        flex-wrap: wrap;
        gap: 15px;
    }

    .search-form {
        order: 3;
        flex-basis: 100%;
        max-width: none;
    }

    .header-actions {
        margin-left: auto;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero {
        grid-template-columns: 1fr 0.7fr;
    }
}

@media (max-width: 600px) {
    .site-header {
        padding: 14px 5%;
    }

    .brand {
        font-size: 1.15rem;
    }

    .header-actions {
        gap: 10px;
    }

    .text-button {
        font-size: 0.85rem;
    }

    .category-nav {
        justify-content: flex-start;
    }

    main {
        width: 90%;
        margin-top: 22px;
    }

    .hero {
        grid-template-columns: 1fr;
    }

    .hero-copy {
        padding: 32px 8%;
    }

    .hero-art {
        min-height: 210px;
    }

    .hero-circle {
        width: 190px;
        height: 190px;
    }

    .hero-label {
        width: 115px;
        height: 115px;
        font-size: 1.2rem;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .product-grid {
        gap: 13px;
    }

    .product-info {
        padding: 12px;
    }

    .product-name {
        min-height: 60px;
        font-size: 0.9rem;
    }

    .product-bottom {
        align-items: flex-start;
        flex-direction: column;
    }

    .add-button {
        width: 100%;
    }

    .site-footer {
        align-items: flex-start;
        flex-direction: column;
    }
}