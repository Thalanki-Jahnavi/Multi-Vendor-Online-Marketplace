
/*
 * OneCart - Products Page JavaScript
 * Features:
 * - Per-user cart and wishlist using localStorage
 * - Wishlist filtering
 * - Cart drawer
 * - Product quantity controls
 * - Quick view modal
 * - Category, price and vendor filters
 * - Sidebar navigation view=wishlist / view=cart
 */

(function () {
    "use strict";


    // =========================================
    // USER-SPECIFIC STORAGE KEYS
    // =========================================

    function getCurrentUsername() {
        const userElement =
            document.querySelector(".user-greeting strong") ||
            document.querySelector(".user-menu-btn strong") ||
            document.querySelector(".user-menu-wrapper strong");

        return userElement
            ? userElement.textContent.trim().toLowerCase()
            : "guest";
    }

    function getCartKey() {
        return "onecart_cart_" + getCurrentUsername();
    }

    function getWishlistKey() {
        return "onecart_wishlist_" + getCurrentUsername();
    }

    const VIEW_MODE_KEY = "onecart_view_mode";


    // =========================================
    // STORAGE HELPERS
    // =========================================

    function getStoredCart() {
        try {
            const cart = JSON.parse(localStorage.getItem(getCartKey()));
            return Array.isArray(cart) ? cart : [];
        } catch (error) {
            console.error("Unable to read cart:", error);
            return [];
        }
    }

    function saveCart(cart) {
        localStorage.setItem(getCartKey(), JSON.stringify(cart));

        updateCartBadge();
        renderCartDrawer();
    }

    function getStoredWishlist() {
        try {
            const wishlist = JSON.parse(localStorage.getItem(getWishlistKey()));
            return Array.isArray(wishlist) ? wishlist : [];
        } catch (error) {
            console.error("Unable to read wishlist:", error);
            return [];
        }
    }

    function saveWishlist(wishlist) {
        localStorage.setItem(getWishlistKey(), JSON.stringify(wishlist));

        updateWishlistBadge();
        syncWishlistButtons();

        if (showingWishlistOnly) {
            applyWishlistFilter();
        }
    }


    // =========================================
    // HTML ESCAPE HELPER
    // =========================================

    function escapeHTML(value) {
        return String(value ?? "").replace(/[&<>"']/g, function (char) {
            const entities = {
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            };

            return entities[char];
        });
    }


    // =========================================
    // TOAST NOTIFICATIONS
    // =========================================

    window.showToast = function (message, type = "success") {

        let container = document.getElementById("toastContainer");

        if (!container) {
            container = document.createElement("div");
            container.id = "toastContainer";
            container.className = "toast-container";
            document.body.appendChild(container);
        }

        const toast = document.createElement("div");
        toast.className = "toast-message toast-" + type;

        const icon =
            type === "success" ? "✓" :
            type === "wishlist" ? "♥" : "ℹ";

        const iconElement = document.createElement("span");
        iconElement.className = "toast-icon";
        iconElement.textContent = icon;

        const textElement = document.createElement("span");
        textElement.className = "toast-text";
        textElement.textContent = message;

        toast.appendChild(iconElement);
        toast.appendChild(textElement);
        container.appendChild(toast);

        requestAnimationFrame(function () {
            toast.classList.add("toast-show");
        });

        setTimeout(function () {
            toast.classList.remove("toast-show");

            setTimeout(function () {
                toast.remove();
            }, 300);

        }, 3000);
    };


    // =========================================
    // CART FUNCTIONS
    // =========================================

    window.addToCart = function (
        id,
        name,
        price,
        image,
        vendor,
        qty = 1
    ) {
        id = String(id);
        qty = Math.max(1, parseInt(qty, 10) || 1);
        price = parseFloat(price) || 0;

        const cart = getStoredCart();

        const existingItem = cart.find(function (item) {
            return String(item.id) === id;
        });

        if (existingItem) {
            existingItem.qty = (parseInt(existingItem.qty, 10) || 1) + qty;
        } else {
            cart.push({
                id: id,
                name: name,
                price: price,
                image: image,
                vendor: vendor || "OneCart Vendor",
                qty: qty
            });
        }

        saveCart(cart);

        showToast(name + " added to your cart!", "success");
    };


    window.removeFromCart = function (id) {

        id = String(id);

        const cart = getStoredCart();

        const item = cart.find(function (product) {
            return String(product.id) === id;
        });

        const updatedCart = cart.filter(function (product) {
            return String(product.id) !== id;
        });

        saveCart(updatedCart);

        if (item) {
            showToast(item.name + " removed from your cart.", "info");
        }
    };


    window.updateCartQty = function (id, delta) {

        id = String(id);

        const cart = getStoredCart();

        const item = cart.find(function (product) {
            return String(product.id) === id;
        });

        if (!item) return;

        item.qty = (parseInt(item.qty, 10) || 1) + delta;

        if (item.qty <= 0) {
            const updatedCart = cart.filter(function (product) {
                return String(product.id) !== id;
            });

            saveCart(updatedCart);
            showToast(item.name + " removed from your cart.", "info");
            return;
        }

        saveCart(cart);
    };


    function updateCartBadge() {

        const cart = getStoredCart();

        const totalCount = cart.reduce(function (total, item) {
            return total + (parseInt(item.qty, 10) || 1);
        }, 0);

        document.querySelectorAll(".cart-badge-count").forEach(function (badge) {
            badge.textContent = totalCount;
            badge.style.display = "inline-flex";
        });
    }


    // =========================================
    // CART DRAWER
    // =========================================

    function renderCartDrawer() {

        const cart = getStoredCart();

        const drawerItems = document.getElementById("cartDrawerItems");
        const drawerSubtotal = document.getElementById("cartDrawerSubtotal");
        const drawerTotal = document.getElementById("cartDrawerTotal");
        const drawerCount = document.getElementById("cartDrawerCount");
        const drawerEmpty = document.getElementById("cartDrawerEmpty");
        const drawerFooter = document.getElementById("cartDrawerFooter");

        if (!drawerItems) return;

        const totalItems = cart.reduce(function (total, item) {
            return total + (parseInt(item.qty, 10) || 1);
        }, 0);

        if (drawerCount) {
            drawerCount.textContent = totalItems;
        }

        if (cart.length === 0) {

            drawerItems.innerHTML = "";

            if (drawerEmpty) {
                drawerEmpty.style.display = "block";
            }

            if (drawerFooter) {
                drawerFooter.style.display = "none";
            }

            if (drawerSubtotal) drawerSubtotal.textContent = "₹0.00";
            if (drawerTotal) drawerTotal.textContent = "₹0.00";

            return;
        }

        if (drawerEmpty) {
            drawerEmpty.style.display = "none";
        }

        if (drawerFooter) {
            drawerFooter.style.display = "block";
        }

        let subtotal = 0;

        drawerItems.innerHTML = cart.map(function (item) {

            const price = parseFloat(item.price) || 0;
            const qty = parseInt(item.qty, 10) || 1;

            subtotal += price * qty;

            const safeId = escapeHTML(item.id);
            const safeName = escapeHTML(item.name);
            const safeVendor = escapeHTML(item.vendor);
            const safeImage = escapeHTML(item.image);

            return `
                <div class="cart-drawer-item">

                    <img
                        src="${safeImage}"
                        alt="${safeName}"
                        class="cart-item-thumb"
                        onerror="this.onerror=null;this.src='/images/products/Ceramic Coffee Mug.jpg'">

                    <div class="cart-item-details">

                        <h4 class="cart-item-title">${safeName}</h4>

                        <span class="cart-item-vendor">
                            ${safeVendor}
                        </span>

                        <div class="cart-item-pricing">

                            <span class="cart-item-unit">
                                ₹${price.toFixed(2)}
                            </span>

                            <div class="cart-qty-controls">

                                <button
                                    type="button"
                                    class="qty-btn"
                                    onclick="updateCartQty('${safeId}', -1)">
                                    −
                                </button>

                                <span class="qty-value">${qty}</span>

                                <button
                                    type="button"
                                    class="qty-btn"
                                    onclick="updateCartQty('${safeId}', 1)">
                                    +
                                </button>

                            </div>

                        </div>

                    </div>

                    <button
                        type="button"
                        class="cart-item-remove"
                        onclick="removeFromCart('${safeId}')"
                        title="Remove item">
                        ✕
                    </button>

                </div>
            `;

        }).join("");

        if (drawerSubtotal) {
            drawerSubtotal.textContent = "₹" + subtotal.toFixed(2);
        }

        if (drawerTotal) {
            drawerTotal.textContent = "₹" + subtotal.toFixed(2);
        }
    }


    window.toggleCartDrawer = function (open) {

        const drawer = document.getElementById("cartDrawer");
        const backdrop = document.getElementById("cartDrawerBackdrop");

        if (!drawer || !backdrop) return;

        const currentlyOpen = drawer.classList.contains("drawer-open");

        const shouldOpen =
            typeof open === "boolean" ? open : !currentlyOpen;

        if (shouldOpen) {

            renderCartDrawer();

            drawer.classList.add("drawer-open");
            backdrop.classList.add("backdrop-open");

            document.body.style.overflow = "hidden";

        } else {

            drawer.classList.remove("drawer-open");
            backdrop.classList.remove("backdrop-open");

            document.body.style.overflow = "";
        }
    };


    // =========================================
    // WISHLIST FUNCTIONS
    // =========================================

    window.toggleWishlist = function (
        id,
        name,
        price,
        image,
        vendor
    ) {

        id = String(id);

        const wishlist = getStoredWishlist();

        const existingIndex = wishlist.findIndex(function (item) {
            return String(item.id) === id;
        });

        if (existingIndex !== -1) {

            wishlist.splice(existingIndex, 1);

            showToast(name + " removed from your wishlist.", "info");

        } else {

            wishlist.push({
                id: id,
                name: name,
                price: parseFloat(price) || 0,
                image: image,
                vendor: vendor || "OneCart Vendor"
            });

            showToast(name + " saved to your wishlist!", "wishlist");
        }

        saveWishlist(wishlist);
    };


    function syncWishlistButtons() {

        const wishlist = getStoredWishlist();

        const wishlistIds = new Set(
            wishlist.map(function (item) {
                return String(item.id);
            })
        );

        document.querySelectorAll(".product-card").forEach(function (card) {

            const id = card.id.replace("product-", "");
            const button = card.querySelector(".wishlist-btn");

            if (!button) return;

            if (wishlistIds.has(id)) {

                button.classList.add("wishlist-active");
                button.innerHTML = "♥";
                button.title = "Remove from wishlist";

            } else {

                button.classList.remove("wishlist-active");
                button.innerHTML = "♡";
                button.title = "Add to wishlist";
            }
        });
    }


    function updateWishlistBadge() {

        const wishlist = getStoredWishlist();

        document.querySelectorAll(".wishlist-badge-count").forEach(function (badge) {
            badge.textContent = wishlist.length;
            badge.style.display = "inline-flex";
        });
    }


    // =========================================
    // WISHLIST FILTER
    // =========================================

    let showingWishlistOnly = false;


    function applyWishlistFilter() {

        const wishlist = getStoredWishlist();

        const wishlistIds = new Set(
            wishlist.map(function (item) {
                return String(item.id);
            })
        );

        const cards = document.querySelectorAll(".product-card");

        let visibleCount = 0;

        cards.forEach(function (card) {

            const id = card.id.replace("product-", "");
            const shouldShow = wishlistIds.has(id);

            card.classList.toggle("wishlist-hidden", !shouldShow);

            if (shouldShow) {
                visibleCount++;
            }
        });

        const emptyMessage = document.getElementById("wishlistEmptyMessage");
        const serverEmptyState = document.getElementById("serverEmptyState");
        const resultsText = document.getElementById("productsFoundText");

        if (emptyMessage) {
            emptyMessage.style.display =
                visibleCount === 0 ? "block" : "none";
        }

        if (serverEmptyState) {
            serverEmptyState.style.display = "none";
        }

        if (resultsText) {
            resultsText.textContent =
                visibleCount + (visibleCount === 1 ? " saved product" : " saved products");
        }

        const title = document.getElementById("productsPageTitle");
        const subtitle = document.getElementById("productsPageSubtitle");

        if (title) {
            title.textContent = "My Wishlist (" + visibleCount + ")";
        }

        if (subtitle) {
            subtitle.textContent = "Your favourite products in one place.";
        }

        const wishlistButton = document.getElementById("wishlistFilterToggle");

        if (wishlistButton) {
            wishlistButton.classList.add("active-filter-btn");
        }
    }


    window.toggleWishlistFilter = function () {

        showingWishlistOnly = !showingWishlistOnly;

        if (showingWishlistOnly) {

            applyWishlistFilter();

        } else {

            document.querySelectorAll(".product-card").forEach(function (card) {
                card.classList.remove("wishlist-hidden");
            });

            const emptyMessage = document.getElementById("wishlistEmptyMessage");
            const serverEmptyState = document.getElementById("serverEmptyState");
            const resultsText = document.getElementById("productsFoundText");
            const title = document.getElementById("productsPageTitle");
            const subtitle = document.getElementById("productsPageSubtitle");
            const wishlistButton = document.getElementById("wishlistFilterToggle");

            if (emptyMessage) emptyMessage.style.display = "none";
            if (serverEmptyState) serverEmptyState.style.display = "";
            if (wishlistButton) wishlistButton.classList.remove("active-filter-btn");

            if (resultsText) {
                resultsText.textContent =
                    document.querySelectorAll(".product-card").length + " products found";
            }

            if (title) title.textContent = "All Products";
            if (subtitle) subtitle.textContent = "Explore products from OneCart sellers";
        }
    };


    // =========================================
    // QUICK VIEW MODAL
    // =========================================

    window.openQuickView = function (product) {

        const modal = document.getElementById("quickViewModal");
        const backdrop = document.getElementById("quickViewBackdrop");

        if (!modal || !backdrop) return;

        document.getElementById("qvImage").src = product.image;
        document.getElementById("qvImage").alt = product.name;

        document.getElementById("qvTitle").textContent = product.name;
        document.getElementById("qvVendor").textContent = product.vendor;
        document.getElementById("qvCategory").textContent = product.category;

        document.getElementById("qvFinalPrice").textContent =
            "₹" + product.price.toFixed(2);

        const originalElement = document.getElementById("qvOriginalPrice");
        const discountElement = document.getElementById("qvDiscountBadge");
        const savingsElement = document.getElementById("qvSavings");

        if (product.originalPrice > product.price) {

            originalElement.textContent =
                "₹" + product.originalPrice.toFixed(2);

            originalElement.style.display = "inline";

            discountElement.textContent =
                Math.round(product.discountPercent) + "% OFF";

            discountElement.style.display = "inline-block";

            savingsElement.textContent =
                "Save ₹" + (product.originalPrice - product.price).toFixed(2);

            savingsElement.style.display = "inline";

        } else {

            originalElement.style.display = "none";
            discountElement.style.display = "none";
            savingsElement.style.display = "none";
        }

        const qtyInput = document.getElementById("qvQtyInput");

        if (qtyInput) {
            qtyInput.value = 1;
        }

        const addButton = document.getElementById("qvAddToCartBtn");
        const buyButton = document.getElementById("qvBuyNowBtn");

        if (addButton) {
            addButton.onclick = function () {

                const qty = parseInt(qtyInput.value, 10) || 1;

                addToCart(
                    product.id,
                    product.name,
                    product.price,
                    product.image,
                    product.vendor,
                    qty
                );

                closeQuickView();
            };
        }

        if (buyButton) {
            buyButton.onclick = function () {

                const qty = parseInt(qtyInput.value, 10) || 1;

                addToCart(
                    product.id,
                    product.name,
                    product.price,
                    product.image,
                    product.vendor,
                    qty
                );

                closeQuickView();
                proceedToCheckout();
            };
        }

        modal.classList.add("modal-open");
        backdrop.classList.add("backdrop-open");

        document.body.style.overflow = "hidden";
    };


    window.closeQuickView = function () {

        const modal = document.getElementById("quickViewModal");
        const backdrop = document.getElementById("quickViewBackdrop");

        if (modal) modal.classList.remove("modal-open");
        if (backdrop) backdrop.classList.remove("backdrop-open");

        if (!document.getElementById("cartDrawer")?.classList.contains("drawer-open")) {
            document.body.style.overflow = "";
        }
    };


    window.adjustQvQty = function (delta) {

        const input = document.getElementById("qvQtyInput");

        if (!input) return;

        let value = (parseInt(input.value, 10) || 1) + delta;

        value = Math.max(1, Math.min(20, value));

        input.value = value;
    };


    // =========================================
    // PRODUCT CARD EVENT HANDLERS
    // =========================================

    function getProductFromCard(card) {

        const id = card.id.replace("product-", "");

        const nameElement = card.querySelector(".card-title");
        const priceElement = card.querySelector(".final-price");
        const originalElement = card.querySelector(".original-price");
        const categoryElement = card.querySelector(".category-tag");
        const vendorElement = card.querySelector(".vendor-tag");
        const imageElement = card.querySelector(".product-img");
        const discountElement = card.querySelector(".discount-badge");

        const price = priceElement
            ? parseFloat(priceElement.textContent.replace(/[^0-9.]/g, "")) || 0
            : 0;

        const originalPrice = originalElement
            ? parseFloat(originalElement.textContent.replace(/[^0-9.]/g, "")) || price
            : price;

        const discountPercent = discountElement
            ? parseFloat(discountElement.textContent.replace(/[^0-9.]/g, "")) || 0
            : 0;

        return {
            id: id,
            name: nameElement ? nameElement.textContent.trim() : "Product",
            price: price,
            originalPrice: originalPrice,
            discountPercent: discountPercent,
            category: categoryElement ? categoryElement.textContent.trim() : "General",
            vendor: vendorElement
                ? vendorElement.textContent.replace("🏪", "").trim()
                : "OneCart Vendor",
            image: imageElement
                ? imageElement.src
                : "/images/products/Ceramic Coffee Mug.jpg"
        };
    }


    window.handleWishlistClick = function (button) {

        const card = button.closest(".product-card");

        if (!card) return;

        const product = getProductFromCard(card);

        toggleWishlist(
            product.id,
            product.name,
            product.price,
            product.image,
            product.vendor
        );
    };


    window.handleQuickViewClick = function (button) {

        const card = button.closest(".product-card");

        if (!card) return;

        openQuickView(getProductFromCard(card));
    };


    window.handleAddToCartClick = function (button) {

        const card = button.closest(".product-card");

        if (!card) return;

        const product = getProductFromCard(card);

        const quantityElement = card.querySelector(".card-qty-val");

        const quantity = quantityElement
            ? parseInt(quantityElement.textContent, 10) || 1
            : 1;

        addToCart(
            product.id,
            product.name,
            product.price,
            product.image,
            product.vendor,
            quantity
        );
    };


    // =========================================
    // QUANTITY CONTROLS
    // =========================================

    window.adjustCardQty = function (button, delta) {

        const container = button.closest(".card-qty-box");

        if (!container) return;

        const valueElement = container.querySelector(".card-qty-val");

        if (!valueElement) return;

        let value = (parseInt(valueElement.textContent, 10) || 1) + delta;

        value = Math.max(1, Math.min(20, value));

        valueElement.textContent = value;
    };


    // =========================================
    // GRID / LIST VIEW
    // =========================================

    window.setViewMode = function (mode) {

        const grid = document.getElementById("productsContainer");

        const gridButton = document.getElementById("viewModeGrid");
        const listButton = document.getElementById("viewModeList");

        if (!grid) return;

        if (mode === "list") {

            grid.classList.add("product-list-view");

            if (listButton) listButton.classList.add("active");
            if (gridButton) gridButton.classList.remove("active");

            localStorage.setItem(VIEW_MODE_KEY, "list");

        } else {

            grid.classList.remove("product-list-view");

            if (gridButton) gridButton.classList.add("active");
            if (listButton) listButton.classList.remove("active");

            localStorage.setItem(VIEW_MODE_KEY, "grid");
        }
    };


    // =========================================
    // PRICE PRESETS
    // =========================================

    window.applyPricePreset = function (min, max) {

        const minInput = document.querySelector('input[name="minPrice"]');
        const maxInput = document.querySelector('input[name="maxPrice"]');
        const form = document.getElementById("productFilterForm");

        if (!minInput || !maxInput || !form) return;

        minInput.value = min !== null ? min : "";
        maxInput.value = max !== null ? max : "";

        form.submit();
    };


    // =========================================
    // VENDOR SEARCH
    // =========================================

    window.filterVendorOptions = function (searchText) {

        const search = searchText.toLowerCase().trim();

        document.querySelectorAll(".vendor-options-list .filter-option")
            .forEach(function (option) {

                const labelText = option.textContent.toLowerCase();

                option.style.display =
                    labelText.includes(search) ? "flex" : "none";
            });
    };


    // =========================================
    // CLEAR SEARCH
    // =========================================

    window.clearSearchKeyword = function () {

        const input = document.getElementById("productSearchInput");

        if (!input) return;

        input.value = "";

        if (input.form) {
            input.form.submit();
        }
    };


    // =========================================
    // CHECKOUT
    // =========================================

    window.proceedToCheckout = function () {

        const cart = getStoredCart();

        if (!cart || cart.length === 0) {
            alert("Your cart is empty! Please add a product to the cart first.");
            return;
        }

        window.location.href = "/customer/checkout";
    };


    // =========================================
    // INITIALIZE PAGE
    // =========================================

    document.addEventListener("DOMContentLoaded", function () {

        updateCartBadge();
        updateWishlistBadge();
        syncWishlistButtons();
        renderCartDrawer();

        // Restore grid/list preference
        const savedView = localStorage.getItem(VIEW_MODE_KEY);

        if (savedView === "list") {
            setViewMode("list");
        }

        // Read sidebar navigation request
        const params = new URLSearchParams(window.location.search);
        const requestedView = params.get("view");

        if (requestedView === "wishlist") {

            showingWishlistOnly = true;
            applyWishlistFilter();

        } else if (requestedView === "cart") {

            toggleCartDrawer(true);

        }

        // Close modal or cart using Escape
        document.addEventListener("keydown", function (event) {

            if (event.key === "Escape") {
                closeQuickView();
                toggleCartDrawer(false);
            }
        });

    });

})();
