
<aside class="sidebar" th:fragment="sidebar">

    <!-- BRAND -->
    <div class="brand">
        <div class="brand-logo">O</div>
        <div class="brand-name">
            <h2>OneCart</h2>
        </div>
    </div>

    <!-- MAIN MENU -->
    <div class="sidebar-label">MAIN MENU</div>

    <a th:href="@{/admin/dashboard}"
       class="nav-link"
       th:classappend="${activePage == 'dashboard'} ? ' active' : ''">
        <span class="nav-icon">⌂</span>
        <span>Dashboard</span>
    </a>

    <!-- MARKETPLACE MANAGEMENT -->
    <div class="sidebar-label">MARKETPLACE MANAGEMENT</div>

    <a th:href="@{/admin/customers}"
       class="nav-link"
       th:classappend="${activePage == 'customers'} ? ' active' : ''">
        <span class="nav-icon">♙</span>
        <span>Customers</span>
    </a>

    <a th:href="@{/admin/vendors}"
       class="nav-link"
       th:classappend="${activePage == 'vendors'} ? ' active' : ''">
        <span class="nav-icon">♧</span>
        <span>Vendors</span>
    </a>

    <a th:href="@{/admin/products}"
       class="nav-link"
       th:classappend="${activePage == 'products'} ? ' active' : ''">
        <span class="nav-icon">▦</span>
        <span>Products</span>
    </a>

    <a th:href="@{/admin/product-approvals}"
       class="nav-link"
       th:classappend="${activePage == 'approvals'} ? ' active' : ''">
        <span class="nav-icon">✓</span>
