    <a th:href="@{/admin/orders}"
       class="nav-link"
       th:classappend="${activePage == 'orders'} ? ' active' : ''">
        <span class="nav-icon">▧</span>
        <span>Orders</span>
    </a>

    <!-- ANALYTICS -->
    <div class="sidebar-label">ANALYTICS</div>

    <a th:href="@{/admin/reports}"
       class="nav-link"
       th:classappend="${activePage == 'reports'} ? ' active' : ''">
        <span class="nav-icon">▥</span>
        <span>Reports &amp; Analytics</span>
    </a>

