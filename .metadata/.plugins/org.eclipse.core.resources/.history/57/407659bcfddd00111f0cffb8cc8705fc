    <div class="sidebar-bottom">

        <a th:href="@{/admin/profile}"
           class="nav-link"
           th:classappend="${activePage == 'profile'} ? ' active' : ''">
            <span class="nav-icon">⚙</span>
            <span>My Profile</span>
