<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | OneCart</title>

  <style>
    :root {
      --emerald: #087e78;
      --deep-green: #123e3a;
      --soft-grey: #f5f7f6;
      --border: #dce7e3;
      --muted: #687a75;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      color: var(--deep-green);
      background: var(--soft-grey);
    }

    header {
      height: 78px;
      padding: 0 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #fff;
      border-bottom: 1px solid #e8eeeb;
    }

    .logo {
      color: var(--deep-green);
      font-size: 27px;
      font-weight: 800;
      letter-spacing: -1px;
      text-decoration: none;
    }

    .logo span { color: var(--emerald); }

    nav { display: flex; gap: 28px; }

    nav a, .signup-link {
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }

    nav a:hover, .signup-link:hover { color: var(--emerald); }

    main {
      min-height: calc(100vh - 78px);
      display: grid;
      place-items: center;
      padding: 42px 20px;
    }

    .login-layout {
      width: min(100%, 900px);
      min-height: 530px;
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 22px;
      background: #fff;
      box-shadow: 0 18px 50px rgba(18, 62, 58, 0.08);
    }

    .welcome-panel {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 42px 36px;
      color: white;
      background: var(--deep-green);
    }

    .welcome-panel::before,
    .welcome-panel::after {
      content: "";
      position: absolute;
      border: 1px solid rgba(229, 244, 240, 0.18);
      border-radius: 50%;
      pointer-events: none;
    }

    .welcome-panel::before {
      width: 330px;
      height: 330px;
      right: -155px;
      top: 85px;
    }

    .welcome-panel::after {
      width: 220px;
      height: 220px;
      right: -100px;
      top: 140px;
    }

    .panel-content, .panel-footer {
      position: relative;
      z-index: 1;
    }

    .small-label {
      display: inline-block;
      padding: 8px 12px;
      border: 1px solid rgba(229, 244, 240, 0.25);
      border-radius: 20px;
      color: #c8eee5;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .welcome-panel h1 {
      margin: 25px 0 15px;
      font-size: 36px;
      line-height: 1.15;
      letter-spacing: -1px;
    }

    .welcome-panel p {
      margin: 0;
      color: #d0e3df;
      font-size: 15px;
      line-height: 1.7;
    }

    .panel-footer {
      color: #a9c9c2;
      font-size: 12px;
    }

    .form-panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 48px 50px;
    }

    .form-panel h2 {
      margin: 0 0 9px;
      font-size: 29px;
      letter-spacing: -0.5px;
    }

    .form-intro {
      margin: 0 0 28px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    .field { margin-bottom: 18px; }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 13px;
      font-weight: 700;
    }

    input {
      width: 100%;
      height: 48px;
      padding: 0 13px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: #fbfdfc;
      color: var(--deep-green);
      font: inherit;
      outline: none;
    }

    input::placeholder { color: #9aa9a4; }

    input:focus {
      border-color: var(--emerald);
      box-shadow: 0 0 0 3px rgba(8, 126, 120, 0.1);
    }

    .login-btn {
      width: 100%;
      height: 49px;
      margin-top: 5px;
      border: 0;
      border-radius: 9px;
      background: var(--emerald);
      color: white;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .login-btn:hover { background: #066b66; }

    .message {
      min-height: 18px;
      margin: 10px 0 0;
      color: #b42318;
      font-size: 13px;
    }

    .signup-prompt {
      margin: 20px 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }

    .signup-prompt a {
      color: var(--emerald);
      font-weight: 700;
      text-decoration: none;
    }

    @media (max-width: 760px) {
      header { padding: 0 5%; }
      nav { gap: 14px; }

      .login-layout {
        max-width: 520px;
        grid-template-columns: 1fr;
      }

      .welcome-panel { min-height: 230px; padding: 30px; }
      .welcome-panel h1 { margin-top: 18px; font-size: 30px; }
      .panel-footer { margin-top: 25px; }
      .form-panel { padding: 34px 30px; }
    }

    @media (max-width: 480px) {
      nav a:not(:first-child) { display: none; }
      .form-panel { padding: 30px 22px; }
    }
  </style>
</head>

<body>
  <header>
    <a class="logo" href="/guest/index.html">One<span>Cart</span></a>

    <nav>
      <a href="/guest/index.html">Home</a>
      <a href="/guest/about.html">About</a>
      <a href="/guest/contact.html">Contact</a>
    </nav>

    <a class="signup-link" href="/guest/signup.html">Sign up</a>
  </header>

  <main>
    <div class="login-layout">
      <aside class="welcome-panel">
        <div class="panel-content">
          <span class="small-label">Welcome back</span>
          <h1>Your next great find is waiting.</h1>
          <p>Sign in to continue shopping and keep track of your orders in one place.</p>
        </div>
        <div class="panel-footer">OneCart · A simpler way to shop</div>
      </aside>

      <section class="form-panel">
        <h2>Login to OneCart</h2>
        <p class="form-intro">Enter your account details to continue.</p>

        <form id="loginForm">
          <div class="field">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            >
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            >
          </div>

          <button class="login-btn" type="submit">Login</button>
          <p class="message" id="message" aria-live="polite"></p>
        </form>

        <p class="signup-prompt">
          Don't have an account?
          <a href="/guest/signup.html">Create one</a>
        </p>
      </section>
    </div>
  </main>

  <script>
    document.getElementById("loginForm").addEventListener("submit", function (event) {
      event.preventDefault();
      document.getElementById("message").textContent =
        "Login will be connected to the backend later.";
    });
  </script>
</body>
</html>