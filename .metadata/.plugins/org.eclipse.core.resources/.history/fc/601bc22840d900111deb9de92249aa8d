<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account | OneCart</title>
    <link rel="stylesheet" th:href="@{/css/products.css}">

    <style>
        .account-page {
            max-width: 900px;
            margin: 30px auto 80px;
            padding: 0 20px;
        }

        .account-header {
            margin-bottom: 24px;
        }

        .account-header h1 {
            color: var(--deep-green);
            font-size: 28px;
            margin: 0 0 6px;
        }

        .account-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 28px;
            margin-bottom: 24px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
        }

        .account-profile-hero {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 24px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .profile-avatar-large {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: var(--emerald);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 32px;
            font-weight: 800;
        }

        .profile-hero-info h2 {
            margin: 0 0 4px;
            color: var(--deep-green);
            font-size: 22px;
        }

        .profile-hero-info p {
            margin: 0;
            color: var(--text-muted);
            font-size: 14px;
        }

        .account-stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-box {
            background: #f7faf9;
            border: 1px solid #e0eeeb;
            border-radius: var(--radius-md);
            padding: 16px;
            text-align: center;
        }

        .stat-box-val {
            font-size: 24px;
            font-weight: 800;
            color: var(--emerald);
        }

        .stat-box-lbl {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 700;
            color: var(--deep-green);
        }

        .form-control {
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            font-size: 14px;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--emerald);
            box-shadow: 0 0 0 3px rgba(8, 126, 120, 0.15);
        }

        .alert-success-banner {
            background: #e8f5e9;
            color: #2e7d32;
            padding: 12px 16px;
            border-radius: var(--radius-md);
            margin-bottom: 20px;
            font-size: 14px;
        }
    </style>
</head>

<body>

<header class="site-header">
    <a class="brand" th:href="@{/}">One<span>Cart</span></a>

    <nav class="main-nav" aria-label="Main navigation">
        <a th:href="@{/customer/dashboard}">Dashboard</a>
        <a th:href="@{/customer/products}">Shop</a>
        <a th:href="@{/customer/orders}">My Orders</a>
        <a class="active" th:href="@{/customer/account}">My Account</a>
    </nav>

    <div class="header-actions">
        <div class="user-menu-dropdown" id="userMenuDropdown" th:if="${customerName != null}">
            <button type="button" class="user-menu-btn" onclick="toggleUserDropdown(event)">
                <span class="user-avatar" th:text="${#strings.substring(customerName, 0, 1)}">C</span>
                <span class="user-greeting-name">Hi, <strong th:text="${customerName}">Customer</strong></span>
                <span class="user-menu-chevron">▾</span>
            </button>
            <div class="user-dropdown-pane" id="userDropdownPane">
                <div class="dropdown-header">
                    <span class="dropdown-avatar" th:text="${#strings.substring(customerName, 0, 1)}">C</span>
                    <div class="dropdown-user-details">
                        <strong class="dropdown-name" th:text="${customerFullName != null ? customerFullName : customerName}">Customer</strong>
                        <span class="dropdown-email" th:text="${customerEmail != null ? customerEmail : ''}"></span>
                    </div>
                </div>
                <div class="dropdown-links">
                    <a th:href="@{/customer/dashboard}" class="dropdown-link-item"><span>📊 Dashboard</span></a>
                    <a th:href="@{/customer/products}" class="dropdown-link-item"><span>🛍️ Explore Shop</span></a>
                    <a th:href="@{/customer/orders}" class="dropdown-link-item"><span>📦 My Orders</span></a>
                </div>
                <div class="dropdown-footer">
                    <form th:action="@{/logout}" method="post">
                        <button class="dropdown-signout-btn" type="submit">🚪 Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>

<main class="account-page">
    <div class="account-header">
        <h1>My Account</h1>
        <p>Manage your profile, view order statistics, and update personal information.</p>
    </div>

    <div class="alert-success-banner" th:if="${updated}">
        ✓ Your profile details have been updated successfully!
    </div>

    <div class="account-card">
        <div class="account-profile-hero">
            <div class="profile-avatar-large" th:text="${#strings.substring(customerName != null ? customerName : 'C', 0, 1)}">C</div>
            <div class="profile-hero-info">
                <h2 th:text="${customerFullName != null ? customerFullName : customerName}">Customer Name</h2>
                <p>Registered Member & Customer &bull; OneCart Verified</p>
            </div>
        </div>

        <div class="account-stats-row">
            <div class="stat-box">
                <div class="stat-box-val" th:text="${ordersCount}">0</div>
                <div class="stat-box-lbl">Total Orders</div>
            </div>
            <div class="stat-box">
                <div class="stat-box-val">Active</div>
                <div class="stat-box-lbl">Account Status</div>
            </div>
            <div class="stat-box">
                <div class="stat-box-val">Premium</div>
                <div class="stat-box-lbl">Support Tier</div>
            </div>
        </div>

        <h3 style="color: var(--deep-green); margin-bottom: 16px;">Personal Information</h3>

        <form th:action="@{/customer/account/update}" method="post">
            <div class="form-row">
                <div class="form-group">
                    <label>First Name</label>
                    <input type="text" name="firstName" class="form-control" th:value="${user != null ? user.firstName : customerName}" required>
                </div>
                <div class="form-group">
                    <label>Last Name</label>
                    <input type="text" name="lastName" class="form-control" th:value="${user != null ? user.lastName : ''}" required>
                </div>
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" class="form-control" th:value="${customerEmail}" readonly style="background: #f7f7f7;">
            </div>

            <div class="form-group">
                <label>Assigned Role</label>
                <input type="text" class="form-control" value="CUSTOMER" readonly style="background: #f7f7f7;">
            </div>

            <div style="margin-top: 20px;">
                <button type="submit" class="action-pill-btn cart-btn-primary" style="padding: 12px 24px;">Save Changes</button>
            </div>
        </form>
    </div>
</main>

<script>
    function toggleUserDropdown(event) {
        if (event) event.stopPropagation();
        const dropdown = document.getElementById('userMenuDropdown');
        if (dropdown) dropdown.classList.toggle('active');
    }

    document.addEventListener('click', function (e) {
        const dropdown = document.getElementById('userMenuDropdown');
        if (dropdown && !dropdown.contains(e.target)) dropdown.classList.remove('active');
    });
</script>

</body>
</html>