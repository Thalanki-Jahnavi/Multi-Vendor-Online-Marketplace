
/* STORE IMAGE PREVIEWS */

.stored-banner-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .48;
}

.store-logo-preview {
    position: relative;
    overflow: hidden;
}

.store-logo-preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 11px;
    background: #fff;
}

.store-logo-preview span {
    position: relative;
    z-index: 1;
}

/* IMAGE UPLOAD BOXES */

.upload-field {
    margin-top: 2px;
}

.upload-box {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px;
    border: 1px dashed #b9d8cd;
    border-radius: 10px;
    background: #f7fbf9;
    transition: border-color .2s, background .2s;
}

.upload-box:hover {
    border-color: #087e78;
    background: #eff8f4;
}

.upload-symbol {
    width: 40px;
    height: 40px;
    display: grid;
    flex: 0 0 40px;
    place-items: center;
    border-radius: 11px;
    color: #087e78;
    background: #e5f4f0;
    font-size: 21px;
}

.upload-content {
    display: flex;
    flex: 1 1 180px;
    flex-direction: column;
    gap: 5px;
}

.upload-content strong {
    color: #123e3a;
    font-size: 12px;
}

.upload-content small {
    color: #718681;
    font-size: 10px;
    line-height: 1.5;
}

.upload-box input[type="file"] {
    width: 100%;
    max-width: 100%;
    color: #526d65;
    font-size: 11px;
}

.upload-box input[type="file"]::file-selector-button {
    margin-right: 9px;
    padding: 8px 11px;
    border: 1px solid #cfe5dc;
    border-radius: 7px;
    color: #087e78;
    background: #fff;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
}

.upload-box input[type="file"]::file-selector-button:hover {
    background: #e5f4f0;
}

/* MOBILE */

@media (max-width: 700px) {
    .upload-box {
        align-items: flex-start;
    }

    .upload-box input[type="file"] {
        flex-basis: 100%;
    }
}
