<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | OneCart</title>
    <link rel="stylesheet" th:href="@{/css/auth.css}">
</head>
<body>
<header class="auth-header">
    <a class="brand" th:href="@{/}">One<span>Cart</span></a>
    <a class="back-link" th:href="@{/}">Back to home</a>
</header>

<main class="auth-page">
    <section class="auth-card">
        <div class="auth-icon">↗</div>
        <p class="eyebrow">WELCOME BACK</p>
        <h1>Sign in to OneCart</h1>
        <p class="intro">Enter your account details to continue shopping.</p>

        <div class="message error-message" th:if="${param.error}">
            Invalid email or password. Please try again.
        </div>

        <div class="message success-message" th:if="${param.logout}">
            You have been signed out successfully.
        </div>

        <form th:action="@{/login}" method="post">
            <label for="username">Email address</label>
            <input
                id="username"
                type="email"
                name="username"
                placeholder="you@example.com"
                autocomplete="email"
                required>

            <label for="password">Password</label>
            <input
                id="password"
                type="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                required>

            <a class="forgot-password-link" th:href="@{/forgot-password}">
                Forgot password?
            </a>

            <button class="primary-button" type="submit">Sign in</button>
        </form>

        <p class="auth-footer">
            Don’t have an account?
            <a th:href="@{/signup}">Create an account</a>
        </p>
    </section>
</main>
</body>
</html>