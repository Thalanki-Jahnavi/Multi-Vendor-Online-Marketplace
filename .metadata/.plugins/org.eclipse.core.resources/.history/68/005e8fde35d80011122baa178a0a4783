<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Dashboard | OneCart</title>
    <link rel="stylesheet" th:href="@{/css/customer-dashboard.css}">
</head>
<body>
<header class="topbar">
    <a class="brand" th:href="@{/}">One<span>Cart</span></a>

    <nav class="nav-links">
        <a th:href="@{/}">Shop</a>
        <a href="#orders">My Orders</a>
        <a href="#account">My Account</a>
    </nav>

    <form th:action="@{/logout}" method="post">
        <button class="logout-btn" type="submit">Sign out</button>
    </form>
</header>

<main class="dashboard">
    <section class="welcome">
        <div>
            <p class="eyebrow">CUSTOMER DASHBOARD</p>
            <h1>Welcome back to OneCart</h1>
            <p>Discover something you’ll love, and keep your shopping in one place.</p>
            <a class="primary-btn" th:href="@{/}">Explore products</a>
        </div>

        <div class="welcome-art" aria-hidden="true">
            <span class="art-circle"></span>
            <span class="art-card card-one">Your next favorite find</span>
            <span class="art-card card-two">OneCart ♥</span>
        </div>
    </section>

    <section class="quick-links" id="orders">
        <a class="quick-card" th:href="@{/}">
            <span class="quick-icon">⌕</span>
            <span>
                <strong>Browse products</strong>
                <small>Explore products from multiple vendors</small>
            </span>
            <span class="arrow">→</span>
        </a>

        <a class="quick-card" href="#orders">
            <span class="quick-icon">▤</span>
            <span>
                <strong>My orders</strong>
                <small>Order history will appear here</small>
            </span>
            <span class="arrow">→</span>
        </a>

        <a class="quick-card" href="#account">
            <span class="quick-icon">♙</span>
            <span>
                <strong>My account</strong>
                <small>Manage your account details</small>
            </span>
            <span class="arrow">→</span>
        </a>
    </section>

    <section class="section-heading" id="account">
        <div>
            <p class="eyebrow">YOUR SHOPPING SPACE</p>
            <h2>Make yourself at home</h2>
        </div>
        <p>Your OneCart account, all in one place.</p>
    </section>

    <section class="info-panel">
        <div class="info-mark">✓</div>
        <div>
            <h3>You’re all set</h3>
            <p>You’re signed in as a customer. Start exploring products and discover your next favorite find.</p>
        </div>
    </section>
</main>

<footer class="footer">
    <span>© OneCart</span>
    <span>Shop more. Live better.</span>
</footer>
</body>
</html>