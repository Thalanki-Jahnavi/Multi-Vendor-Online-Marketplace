<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Categories | OneCart Admin</title>

	<link rel="stylesheet" th:href="@{/css/admin-dashboard.css}">
	<link rel="stylesheet" th:href="@{/css/categories.css}">
</head>

<body>

<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <span class="logo-icon">O</span>
            <span>OneCart</span>
        </div>

        <div class="menu-label">MAIN MENU</div>

        <a th:href="@{/admin/dashboard}">⌂ Dashboard</a>

        <div class="menu-label">MARKETPLACE MANAGEMENT</div>

        <a th:href="@{/admin/customers}">♙ Customers</a>
        <a th:href="@{/admin/vendors}">♧ Vendors</a>
        <a th:href="@{/admin/products}">▦ Products</a>
        <a th:href="@{/admin/product-approvals}">✓ Product Approvals</a>
        <a th:href="@{/admin/categories}" class="active">▤ Categories</a>
        <a th:href="@{/admin/orders}">▣ Orders</a>

        <div class="menu-label">ANALYTICS</div>
        <a th:href="@{/admin/reports}">▥ Reports & Analytics</a>

        <div class="bottom-menu">
            <a th:href="@{/admin/profile}">⚙ My Profile</a>
            <a th:href="@{/logout}">↪ Logout</a>
        </div>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <header class="top-header">

            <div>
                <p class="breadcrumb">OneCart / <b>Categories</b></p>
                <h1>Category Management</h1>
                <p class="subtitle">
                    Manage product categories across your marketplace.
                </p>
            </div>

            <div class="admin-profile">
                <div class="avatar">O</div>
                <div>
                    <strong th:text="${adminName}">OneCart</strong>
                    <small>Super Admin</small>
                </div>
            </div>

        </header>

        <!-- MESSAGES -->
        <div class="alert success"
             th:if="${successMessage}"
             th:text="${successMessage}">
        </div>

        <div class="alert error"
             th:if="${errorMessage}"
             th:text="${errorMessage}">
        </div>

        <!-- STATISTICS -->
        <section class="stats-grid">

            <div class="stat-card">
                <span>TOTAL CATEGORIES</span>
                <h2 th:text="${totalCategories}">0</h2>
            </div>

            <div class="stat-card">
                <span>ACTIVE CATEGORIES</span>
                <h2 th:text="${activeCategories}">0</h2>
            </div>

            <div class="stat-card">
                <span>INACTIVE CATEGORIES</span>
                <h2 th:text="${inactiveCategories}">0</h2>
            </div>

        </section>

        <!-- CATEGORY MANAGEMENT -->
        <section class="category-section">

            <div class="section-header">

                <div>
                    <h2>All Categories</h2>
                    <p>Manage and organize your marketplace categories.</p>
                </div>

                <button class="add-button"
                        onclick="openAddModal()">
                    + Add Category
                </button>

            </div>

            <!-- SEARCH -->
            <form th:action="@{/admin/categories}"
                  method="get"
                  class="search-form">

                <input type="text"
                       name="keyword"
                       placeholder="Search categories..."
                       th:value="${keyword}">

                <button type="submit">Search</button>

                <a th:href="@{/admin/categories}">Clear</a>

            </form>

            <!-- TABLE -->
            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr th:each="category : ${categories}">

                            <td th:text="${category.categoryId}"></td>

                            <td class="category-name">
                                <div class="category-image">
                                    <img th:if="${category.imageUrl != null
                                                and !#strings.isEmpty(category.imageUrl)}"
                                         th:src="${category.imageUrl}"
                                         alt="Category">

                                    <span th:unless="${category.imageUrl != null
                                                      and !#strings.isEmpty(category.imageUrl)}">
                                        ◈
                                    </span>
                                </div>

                                <strong th:text="${category.categoryName}"></strong>
                            </td>

                            <td th:text="${category.description != null
                                          ? category.description : '—'}">
                            </td>

                            <td>
                                <span class="status"
                                      th:classappend="${category.active} ? ' active' : ' inactive'"
                                      th:text="${category.active} ? 'Active' : 'Inactive'">
                                </span>
                            </td>

                            <td class="actions">

                                <button type="button"
                                        class="edit-button"
                                        th:attr="data-id=${category.categoryId},
                                                 data-name=${category.categoryName},
                                                 data-description=${category.description},
                                                 data-image=${category.imageUrl}"
                                        onclick="openEditModal(this)">
                                    Edit
                                </button>

                                <form th:action="@{/admin/categories/{id}/toggle(id=${category.categoryId})}"
                                      method="post">

                                    <button type="submit"
                                            class="toggle-button"
                                            th:text="${category.active} ? 'Deactivate' : 'Activate'">
                                    </button>
                                </form>

                                <form th:action="@{/admin/categories/{id}/delete(id=${category.categoryId})}"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this category?')">

                                    <button type="submit"
                                            class="delete-button">
                                        Delete
                                    </button>
                                </form>

                            </td>

                        </tr>

                        <tr th:if="${#lists.isEmpty(categories)}">
                            <td colspan="5" class="empty-state">
                                <h3>No Categories Found</h3>
                                <p>Add a new category to get started.</p>
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </section>

        <footer>
            © 2026 OneCart. Admin Management Panel.
        </footer>

    </main>

</div>

<!-- ADD CATEGORY MODAL -->
<div class="modal" id="addModal">

    <div class="modal-content">

        <div class="modal-header">
            <h2>Add New Category</h2>
            <button type="button" onclick="closeAddModal()">×</button>
        </div>

        <form th:action="@{/admin/categories/add}"
              th:object="${newCategory}"
              method="post">

            <label>Category Name *</label>
            <input type="text"
                   th:field="*{categoryName}"
                   placeholder="Enter category name"
                   required>

            <label>Description</label>
            <textarea th:field="*{description}"
                      placeholder="Enter category description"></textarea>

            <label>Image URL</label>
            <input type="text"
                   th:field="*{imageUrl}"
                   placeholder="Enter image URL">

            <div class="modal-actions">
                <button type="button"
                        class="cancel-button"
                        onclick="closeAddModal()">
                    Cancel
                </button>

                <button type="submit" class="save-button">
                    Save Category
                </button>
            </div>

        </form>

    </div>

</div>

<!-- EDIT CATEGORY MODAL -->
<div class="modal" id="editModal">

    <div class="modal-content">

        <div class="modal-header">
            <h2>Edit Category</h2>
            <button type="button" onclick="closeEditModal()">×</button>
        </div>

        <form id="editForm" method="post">

            <label>Category Name *</label>
            <input type="text"
                   name="categoryName"
                   id="editName"
                   required>

            <label>Description</label>
            <textarea name="description"
                      id="editDescription"></textarea>

            <label>Image URL</label>
            <input type="text"
                   name="imageUrl"
                   id="editImage">

            <div class="modal-actions">

                <button type="button"
                        class="cancel-button"
                        onclick="closeEditModal()">
                    Cancel
                </button>

                <button type="submit" class="save-button">
                    Update Category
                </button>

            </div>

        </form>

    </div>

</div>

<script>

function openAddModal() {
    document.getElementById("addModal").style.display = "flex";
}

function closeAddModal() {
    document.getElementById("addModal").style.display = "none";
}

function openEditModal(button) {

    const id = button.dataset.id;

    document.getElementById("editName").value =
        button.dataset.name || "";

    document.getElementById("editDescription").value =
        button.dataset.description || "";

    document.getElementById("editImage").value =
        button.dataset.image || "";

    document.getElementById("editForm").action =
        "/admin/categories/" + id + "/update";

    document.getElementById("editModal").style.display = "flex";
}

function closeEditModal() {
    document.getElementById("editModal").style.display = "none";
}

window.addEventListener("click", function(event) {

    if (event.target === document.getElementById("addModal")) {
        closeAddModal();
    }

    if (event.target === document.getElementById("editModal")) {
        closeEditModal();
    }

});

</script>

</body>
</html>
