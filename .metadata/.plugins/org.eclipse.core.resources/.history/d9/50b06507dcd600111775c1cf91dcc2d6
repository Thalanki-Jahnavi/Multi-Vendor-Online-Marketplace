@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');

:root {
    --green: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --pale-mint: #f3f8f6;
    --text: #263d39;
    --muted: #71817d;
    --border: #e2ebe7;
    --white: #fff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'DM Sans', Arial, sans-serif;
    color: var(--text);
    background: var(--white);
    line-height: 1.5;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    display: block;
    max-width: 100%;
}

.site-header {
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.topbar {
    max-width: 1440px;
    min-height: 76px;
    margin: auto;
    padding: 14px 4%;
    display: flex;
    align-items: center;
    gap: 30px;
}

.logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--deep-green);
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -1px;
    white-space: nowrap;
}

.logo span {
    color: var(--green);
}

.search {
    flex: 1;
    display: flex;
    height: 44px;
    min-width: 150px;
    border: 1px solid #b7d8d0;
    border-radius: 8px;
    overflow: hidden;
}

.search input {
    flex: 1;
    min-width: 0;
    padding: 0 15px;
    border: 0;
    outline: 0;
    color: var(--text);
    font: inherit;
}

.search button {
    width: 50px;
    border: 0;
    background: var(--green);
    color: white;
    font-size: 25px;
    cursor: pointer;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
}

.signup-btn,
.primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border-radius: 7px;
    background: var(--green);
    color: white;
    padding: 11px 22px;
    font-size: 13px;
    font-weight: 700;
    transition: background 0.2s ease;
}

.signup-btn:hover,
.primary-btn:hover {
    background: var(--deep-green);
}

.cart-link {
    font-size: 20px;
}

.cart-link span {
    font-size: 13px;
}

.categories {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 10px 3%;
    background: var(--mint);
    overflow-x: auto;
    white-space: nowrap;
}

.categories a {
    padding: 7px 15px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}

.categories a:hover,
.categories .active {
    color: white;
    background: var(--green);
}

/* Hero */
.page-content {
    max-width: 1440px;
    margin: auto;
    padding: 22px 4% 34px;
}

.hero {
    min-height: 300px;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    overflow: hidden;
    border-radius: 15px;
    background: #f3eee5;
}

.hero-copy {
    align-self: center;
    padding: 36px 10%;
}

.eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    color: var(--green);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
}

.hero h1 {
    color: #26312e;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1.06;
    letter-spacing: -1.8px;
}

.hero p {
    margin: 14px 0 22px;
    color: #68736e;
    font-size: 15px;
}

.hero > img {
    width: 100%;
    height: 100%;
    min-height: 300px;
    object-fit: cover;
}

/* Section headings */
.content-section {
    margin-top: 30px;
}

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
}

.section-heading h2 {
    color: var(--deep-green);
    font-size: 22px;
    letter-spacing: -0.5px;
}

.section-heading > a {
    color: var(--green);
    font-size: 12px;
    font-weight: 700;
}

/* Category cards */
.category-grid {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 12px;
}

.category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 13px 8px;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: var(--pale-mint);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.category-card:hover,
.product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px #123e3a12;
}

.category-card img {
    width: 100%;
    height: 78px;
    object-fit: contain;
}

.category-card span {
    text-align: center;
    font-size: 12px;
    font-weight: 600;
}

/* Product cards */
.product-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 13px;
}

.product-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: #fff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.product-image {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 155px;
    padding: 12px;
    background: #fbfcfb;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.product-details {
    padding: 12px;
}

.product-details h3 {
    overflow: hidden;
    color: #263d39;
    font-size: 12px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.rating {
    margin-top: 5px;
    color: #d89a22;
    font-size: 12px;
    font-weight: 700;
}

.rating span {
    color: var(--muted);
    font-weight: 400;
}

.price {
    margin-top: 6px;
    color: var(--deep-green);
    font-size: 12px;
    font-weight: 700;
}

.price del {
    margin-left: 4px;
    color: #87918d;
    font-size: 10px;
    font-weight: 400;
}

.price b {
    margin-left: 4px;
    color: #18864b;
    font-size: 10px;
}

.add-button {
    display: block;
    margin-top: 11px;
    padding: 8px 5px;
    border: 1px solid var(--green);
    border-radius: 7px;
    color: var(--green);
    text-align: center;
    font-size: 12px;
    font-weight: 700;
}

.add-button:hover {
    background: var(--green);
    color: white;
}

/* Seller banner */
.seller-banner {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
    padding: 25px 5%;
    overflow: hidden;
    border: 1px solid #d5e9e2;
    border-radius: 13px;
    background: linear-gradient(110deg, #e5f4f0, #f7f8f1);
}

.seller-banner h2 {
    color: var(--deep-green);
    font-size: 25px;
}

.seller-banner p {
    max-width: 460px;
    margin: 8px 0 17px;
    color: #657570;
    font-size: 13px;
}

.seller-banner img {
    width: 100%;
    height: 180px;
    border-radius: 9px;
    object-fit: cover;
}

/* Footer */
.footer {
    background: var(--deep-green);
    color: white;
    padding: 30px 4% 14px;
}

.footer-grid {
    max-width: 1350px;
    margin: auto;
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 28px;
    padding-bottom: 25px;
}

.footer-about .logo {
    color: white;
    font-size: 22px;
}

.footer-about p {
    margin-top: 9px;
    color: #c7d9d5;
    font-size: 12px;
}

.footer-grid h3 {
    margin-bottom: 10px;
    font-size: 13px;
}

.footer-grid a:not(.logo) {
    display: block;
    margin: 6px 0;
    color: #c7d9d5;
    font-size: 12px;
}

.footer-grid a:hover {
    color: white;
}

.footer-bottom {
    max-width: 1350px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    border-top: 1px solid #315a55;
    padding-top: 14px;
    color: #c7d9d5;
    font-size: 11px;
}

/* Responsive layout */
@media (max-width: 1050px) {
    .topbar {
        gap: 16px;
    }

    .header-actions {
        gap: 12px;
    }

    .category-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {
    .topbar {
        flex-wrap: wrap;
        padding: 12px 4%;
    }

    .search {
        order: 3;
        flex-basis: 100%;
    }

    .header-actions {
        margin-left: auto;
        gap: 12px;
    }

    .header-actions > a:first-child {
        display: none;
    }

    .categories {
        justify-content: flex-start;
    }

    .page-content {
        padding: 14px 4% 24px;
    }

    .hero {
        grid-template-columns: 1fr;
    }

    .hero-copy {
        padding: 25px;
    }

    .hero > img {
        min-height: 190px;
        max-height: 220px;
    }

    .category-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .seller-banner {
        grid-template-columns: 1fr;
    }

    .seller-banner img {
        height: 150px;
    }

    .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-bottom {
        flex-direction: column;
    }
}