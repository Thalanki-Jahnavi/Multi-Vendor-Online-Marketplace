:root {
    --emerald: #087e78;
    --deep: #123e3a;
    --mint: #e5f4f0;
    --pale: #f5faf8;
    --white: #fff;
    --ink: #172b29;
    --muted: #71817e;
    --line: #e5eeeb;
    --shadow: 0 14px 38px rgba(18, 62, 58, .08);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; color: var(--ink); background: #fff; font-family: Inter, "Segoe UI", Arial, sans-serif; }
a { color: inherit; text-decoration: none; }
button, input, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
.announcement { display:flex; justify-content:space-between; gap:16px; padding:10px 5.5%; background:var(--deep); color:#e9f6f2; font-size:12px; }
.announcement div { display:flex; gap:24px; }
.announcement a { color:#e9f6f2; }
.main-header { display:flex; align-items:center; gap:30px; padding:20px 5.5%; }
.brand { display:flex; align-items:center; gap:10px; flex-shrink:0; font-size:25px; font-weight:800; letter-spacing:-1px; }
.brand > span:last-child { display:block; }
.brand > span:last-child > span { color:var(--emerald); }
.brand small { display:block; margin-top:2px; color:var(--muted); font-size:10px; font-weight:500; letter-spacing:.2px; }
.brand-mark { display:grid; place-items:center; width:42px; height:42px; border-radius:13px 13px 13px 4px; color:white; background:var(--emerald); font-size:24px; }
.search-form { display:flex; flex:1; min-width:150px; height:46px; border:1px solid var(--line); border-radius:10px; overflow:hidden; background:#fff; }
.search-form select { max-width:150px; padding:0 12px; border:0; border-right:1px solid var(--line); color:var(--deep); background:#f9fcfb; }
.search-form input { width:100%; min-width:0; padding:0 16px; border:0; outline:0; }
.search-form button { width:52px; border:0; color:white; background:var(--emerald); font-size:27px; cursor:pointer; }
.header-actions { display:flex; align-items:center; gap:18px; }
.header-action { position:relative; display:flex; flex-direction:column; align-items:center; gap:2px; font-size:20px; }
.header-action span,.header-action small { font-size:11px; }
.header-action b { position:absolute; top:-8px; right:-9px; display:grid; place-items:center; width:18px; height:18px; border-radius:50%; color:#fff; background:var(--emerald); font-size:10px; }
.menu-toggle { display:none; border:0; background:none; font-size:25px; cursor:pointer; }
.navigation { display:flex; align-items:center; gap:32px; padding:0 5.5%; min-height:48px; color:#fff; background:var(--deep); }
.navigation a { padding:15px 0; font-size:13px; }
.navigation a:hover,.navigation .active { color:#b9e8dc; }
.customer-only,.vendor-only,.admin-only { display:none !important; }
body[data-role="CUSTOMER"] .customer-only,
body[data-role="VENDOR"] .vendor-only,
body[data-role="ADMIN"] .admin-only { display:inline-flex !important; }
body[data-role="CUSTOMER"] .guest-only,
body[data-role="VENDOR"] .guest-only,
body[data-role="ADMIN"] .guest-only { display:none !important; }
.hero { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:30px; min-height:450px; padding:55px 8%; overflow:hidden; background:linear-gradient(110deg,#f1faf7,#f9fcfb); }
.eyebrow { margin:0 0 12px; color:var(--emerald); font-size:10px; font-weight:800; letter-spacing:2px; }
.hero h1 { margin:0; color:var(--deep); font-size:clamp(38px,5vw,66px); line-height:1.04; letter-spacing:-2.5px; }
.hero h1 em,.promo-banner h2 em { color:var(--emerald); font-family:Georgia,serif; font-weight:500; }
.hero-description { max-width:460px; margin:20px 0 25px; color:#627571; font-size:15px; line-height:1.8; }
.hero-buttons { display:flex; flex-wrap:wrap; gap:12px; }
.button { display:inline-flex; justify-content:center; align-items:center; min-height:46px; padding:0 22px; border-radius:7px; font-size:13px; font-weight:700; }
.button-primary { color:#fff; background:var(--emerald); }
.button-primary:hover { background:var(--deep); }
.button-secondary { border:1px solid #cbded8; background:#fff; }
.hero-note { margin-top:24px; color:var(--muted); font-size:12px; }
.hero-note span { margin-right:7px; color:var(--emerald); font-weight:bold; }
.hero-art { position:relative; display:grid; place-items:center; min-height:320px; }
.art-circle { position:absolute; width:min(32vw,340px); aspect-ratio:1; border-radius:50%; background:#d8eee7; }
.shopping-bag { position:relative; display:grid; place-content:center; width:180px; height:205px; margin-top:48px; transform:rotate(-7deg); border-radius:18px 18px 35px 35px; color:#fff; background:var(--emerald); box-shadow:0 28px 35px #123e3a24; text-align:center; font-size:28px; line-height:1.05; }
.bag-handle { position:absolute; top:-48px; left:47px; width:86px; height:75px; border:12px solid var(--emerald); border-bottom:0; border-radius:50px 50px 0 0; }
.shopping-bag strong { z-index:1; }
.art-card { position:absolute; display:grid; place-items:center; width:110px; height:125px; border:7px solid #fff; border-radius:13px; color:var(--deep); background:#fff; box-shadow:var(--shadow); font-size:35px; }
.art-card small { color:var(--muted); font-size:10px; }
.art-card-one { top:30px; left:8%; transform:rotate(-12deg); }
.art-card-two { right:4%; bottom:20px; transform:rotate(11deg); color:var(--emerald); }
.art-spark { position:absolute; color:var(--emerald); font-size:40px; }
.spark-one { top:18px; right:18%; }.spark-two { bottom:32px; left:17%; }
.benefits { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; padding:26px 7%; border-bottom:1px solid var(--line); }
.benefits article { display:flex; align-items:center; gap:13px; }
.benefit-icon { display:grid; place-items:center; width:42px; height:42px; flex-shrink:0; border-radius:12px; color:var(--emerald); background:var(--mint); font-size:24px; }
.benefits strong,.benefits small { display:block; }
.benefits strong { font-size:12px; }.benefits small { margin-top:5px; color:var(--muted); font-size:10px; }
.section { padding:65px 7%; }
.section-heading { display:flex; justify-content:space-between; align-items:end; gap:18px; margin-bottom:25px; }
.section-heading h2 { margin:0; color:var(--deep); font-size:clamp(25px,3vw,34px); letter-spacing:-1px; }
.text-link { color:var(--emerald); font-size:12px; font-weight:700; }
.category-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:14px; }
.category-card { display:flex; flex-direction:column; align-items:flex-start; min-height:160px; padding:18px; border:1px solid var(--line); border-radius:12px; background:var(--pale); transition:transform .2s,box-shadow .2s; }
.category-card:hover,.product-card:hover,.vendor-card:hover { transform:translateY(-4px); box-shadow:var(--shadow); }
.category-card > span { display:grid; place-items:center; width:48px; height:48px; margin-bottom:17px; border-radius:14px; color:var(--emerald); background:#fff; font-size:27px; }
.category-card strong { font-size:13px; }.category-card small { margin-top:5px; color:var(--muted); font-size:11px; }
.category-fashion { background:#f5f0eb; }.category-tech { background:#eef4fb; }.category-home { background:#f3f4ec; }.category-beauty { background:#f9eef2; }.category-sport { background:#edf5ed; }.category-gifts { background:#f5f0fa; }
.product-section { background:#fbfdfc; }
.product-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:18px; }
.product-card { min-width:0; overflow:hidden; border:1px solid var(--line); border-radius:12px; background:#fff; transition:transform .2s,box-shadow .2s; }
.product-image { position:relative; display:grid; place-items:center; height:210px; overflow:hidden; background:#f4f8f6; }
.product-image img { width:100%; height:100%; object-fit:contain; mix-blend-mode:multiply; }
.image-placeholder { color:#9ccbc0; font-size:65px; }
.wishlist-button { position:absolute; top:12px; right:12px; display:grid; place-items:center; width:34px; height:34px; border:0; border-radius:50%; color:var(--deep); background:#fff; cursor:pointer; font-size:20px; }
.wishlist-button.is-saved { color:#fff; background:var(--emerald); }
.discount-tag { position:absolute; top:12px; left:12px; padding:5px 8px; border-radius:5px; color:var(--emerald); background:var(--mint); font-size:10px; font-weight:800; }
.product-info { padding:15px; }
.product-vendor { margin:0 0 7px; color:var(--muted); font-size:10px; }
.product-info h3 { min-height:34px; margin:0 0 12px; font-size:14px; }
.product-meta { display:flex; justify-content:space-between; align-items:center; margin-bottom:13px; }
.product-meta strong { color:var(--deep); font-size:16px; }.rating { color:#bd8b32; font-size:11px; }
.add-cart-button { width:100%; min-height:38px; border:1px solid #b8d8ce; border-radius:6px; color:var(--emerald); background:#fff; font-size:12px; font-weight:700; cursor:pointer; }
.add-cart-button:hover { color:#fff; background:var(--emerald); }
.empty-state { padding:40px 20px; border:1px dashed #cbded8; border-radius:12px; text-align:center; }
.empty-state > span { color:var(--emerald); font-size:30px; }.empty-state h3 { margin:10px 0; color:var(--deep); }.empty-state p { color:var(--muted); font-size:13px; }.empty-state.compact { margin-top:10px; padding:20px; }
.promo-banner { display:flex; justify-content:space-between; align-items:center; gap:25px; margin:0 7%; padding:45px 6%; border-radius:18px; color:#fff; background:var(--deep); overflow:hidden; }
.promo-banner .eyebrow { color:#9dd8c9; }.promo-banner h2 { margin:0; font-size:clamp(27px,4vw,42px); line-height:1.15; }.promo-banner h2 em { color:#a5e1d2; }.promo-banner p:not(.eyebrow) { color:#c5dcd6; font-size:13px; line-height:1.7; }
.button-light { margin-top:8px; color:var(--deep); background:#fff; }
.promo-decoration { display:grid; place-items:center; width:180px; height:180px; flex-shrink:0; border:1px solid #ffffff42; border-radius:50%; color:#c2e7dd; font-size:70px; }
.promo-decoration small { margin-top:-40px; font-size:12px; font-weight:800; letter-spacing:4px; text-align:center; }
.vendor-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
.vendor-card { display:flex; align-items:center; gap:15px; padding:20px; border:1px solid var(--line); border-radius:12px; background:#fff; transition:transform .2s,box-shadow .2s; }
.vendor-avatar { display:grid; place-items:center; width:54px; height:54px; flex-shrink:0; border-radius:16px; color:var(--emerald); background:var(--mint); font-size:24px; font-weight:800; }
.vendor-card h3 { margin:0 0 6px; font-size:14px; }.vendor-card p { margin:0 0 10px; color:var(--muted); font-size:11px; }
.stats-strip { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin:0 7% 65px; padding:25px; border-radius:12px; background:var(--mint); text-align:center; }
.stats-strip strong,.stats-strip span { display:block; }.stats-strip strong { color:var(--emerald); font-size:27px; }.stats-strip span { margin-top:5px; color:var(--deep); font-size:12px; }
.footer { padding:50px 7% 0; color:#d7e8e3; background:#102f2c; }
.footer-main { display:grid; grid-template-columns:1.5fr 1fr 1fr 1.4fr; gap:35px; padding-bottom:40px; }
.brand-footer { color:#fff; }.brand-footer small { color:#b4cec7; }
.footer-brand p,.footer-main p { max-width:260px; color:#b4cec7; font-size:12px; line-height:1.7; }
.footer-main h3 { margin:0 0 16px; color:#fff; font-size:13px; }
.footer-main > div:not(:first-child) > a { display:block; margin:10px 0; color:#b4cec7; font-size:12px; }
.newsletter-form { display:flex; height:40px; border-radius:6px; overflow:hidden; background:#fff; }
.newsletter-form input { width:100%; min-width:0; padding:0 10px; border:0; outline:0; font-size:11px; }
.newsletter-form button { width:45px; border:0; color:#fff; background:var(--emerald); cursor:pointer; }
#newsletterMessage { display:block; margin-top:8px; color:#a5e1d2; font-size:11px; }
.footer-bottom { display:flex; justify-content:space-between; gap:15px; padding:18px 0; border-top:1px solid #ffffff20; color:#a9c5bd; font-size:11px; }
@media (max-width:1050px) {
    .main-header { gap:16px; }.header-actions { gap:12px; }.header-action span { display:none; }
    .category-grid { grid-template-columns:repeat(3,1fr); }.product-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
    .benefits { grid-template-columns:repeat(2,1fr); }.footer-main { grid-template-columns:repeat(2,1fr); }
}
@media (max-width:700px) {
    .announcement { padding:9px 5%; }.announcement div { display:none; }
    .main-header { position:relative; flex-wrap:wrap; padding:15px 5%; gap:13px; }
    .brand { font-size:22px; }.brand-mark { width:38px; height:38px; }
    .search-form { order:3; flex-basis:100%; height:43px; }
    .search-form select { max-width:112px; padding:0 6px; font-size:11px; }
    .header-actions { margin-left:auto; gap:12px; }.header-action { font-size:18px; }.header-action small { display:none; }
    .menu-toggle { display:block; }
    .navigation { display:none; flex-direction:column; align-items:stretch; gap:0; padding:5px 5%; }
    .navigation.open { display:flex; }.navigation a { padding:13px 0; border-bottom:1px solid #ffffff18; }
    .hero { grid-template-columns:1fr; padding:40px 6% 25px; gap:5px; }
    .hero h1 { font-size:45px; }.hero-art { min-height:260px; }.shopping-bag { transform:scale(.82) rotate(-7deg); }
    .art-card-one { left:12%; }.art-card-two { right:12%; }
    .benefits { grid-template-columns:repeat(2,1fr); gap:18px 12px; padding:22px 6%; }
    .benefits article { gap:9px; }.benefit-icon { width:35px; height:35px; }
    .section { padding:45px 5%; }.section-heading { align-items:start; }
    .category-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .category-card { min-height:135px; padding:14px; }
    .product-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .product-image { height:155px; }.product-info { padding:11px; }.product-info h3 { font-size:12px; }
    .promo-banner { margin:0 5%; padding:30px 7%; }.promo-decoration { width:100px; height:100px; font-size:40px; }
    .promo-decoration small { margin-top:-20px; font-size:8px; }
    .vendor-grid { grid-template-columns:1fr; }.stats-strip { margin:0 5% 45px; padding:20px 10px; }
    .stats-strip strong { font-size:21px; }.stats-strip span { font-size:10px; }
    .footer { padding:40px 5% 0; }.footer-main { grid-template-columns:1fr 1fr; gap:25px 18px; }
}
@media (max-width:390px) {
    .header-actions { gap:8px; }.header-action { font-size:16px; }
    .hero h1 { font-size:39px; }.hero-buttons .button { padding:0 13px; font-size:12px; }
    .benefits { grid-template-columns:1fr; }.section-heading { flex-direction:column; }
    .product-image { height:130px; }.promo-decoration { display:none; }
    .footer-main { grid-template-columns:1fr; }
}