<form th:action="@{/products}" method="get" class="filter-bar">

    <input
        type="text"
        name="keyword"
        placeholder="Search products..."
        th:value="${keyword}"
    >

    <select name="category">
        <option value="">All categories</option>
        <option
            th:each="categoryName : ${categories}"
            th:value="${categoryName}"
            th:text="${categoryName}"
            th:selected="${categoryName == selectedCategory}">
        </option>
    </select>

    <select name="vendorId">
        <option value="">All vendors</option>
        <option
            th:each="vendor : ${vendors}"
            th:value="${vendor.userId}"
            th:text="${vendor.businessName != null ? vendor.businessName : vendor.firstName}"
            th:selected="${vendor.userId == selectedVendorId}">
        </option>
    </select>

    <select name="sort">
        <option value="newest" th:selected="${selectedSort == 'newest'}">Newest</option>
        <option value="price-low" th:selected="${selectedSort == 'price-low'}">Price: Low to High</option>
        <option value="price-high" th:selected="${selectedSort == 'price-high'}">Price: High to Low</option>
    </select>

    <button type="submit">Apply</button>
</form>