
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');

:root {
    --emerald: #087e78;
    --dark-green: #123e3a;
    --mint: #e5f4f0;
    --light-bg: #f8fbfa;
    --white: #ffffff;
    --text: #354b48;
    --muted: #71817e;
    --border: #e3ece9;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'DM Sans', Arial, sans-serif;
    color: var(--dark-green);
    background: var(--white);
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    display: block;
    width: 100%;
    object-fit: cover;
}

/* Navigation */

.navbar {
    min-height: 82px;
    padding: 18px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.logo {
    font-size: 29px;
    font-weight: 700;
    letter-spacing: -1.5px;
    color: var(--dark-green);
}

.logo span {
    color: var(--emerald);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 35px;
}

.nav-links a {
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s;
}

.nav-links a:hover,
.nav-links .active {
    color: var(--emerald);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    font-weight: 600;
}

.login-btn {
    color: var(--dark-green);
}

.signup-btn {
    background: var(--emerald);
    color: var(--white);
    padding: 11px 24px;
    border-radius: 6px;
    transition: background 0.2s;
}

.signup-btn:hover,
.primary-btn:hover {
    background: var(--dark-green);
}

/* Hero */

.hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 55px;
    padding: 65px 7%;
    background: var(--mint);
}

.hero-content {
    max-width: 580px;
}

.eyebrow {
    color: var(--emerald);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

.hero h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(38px, 4.5vw, 62px);
    line-height: 1.15;
    letter-spacing: -1.5px;
    margin: 20px 0;
    color: var(--dark-green);
}

.hero-content > p {
    max-width: 480px;
    font-size: 15px;
    color: var(--text);
    margin-bottom: 30px;
    line-height: 1.9;
}

.primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 27px;
    background: var(--emerald);
    color: var(--white);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s;
}

.hero-features {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 35px;
    color: var(--text);
    font-size: 12px;
}

.hero-image {
    height: 440px;
    overflow: hidden;
    border-radius: 10px;
}

.hero-image img {
    height: 100%;
    transition: transform 0.5s;
}

.hero-image:hover img {
    transform: scale(1.04);
}

/* Common sections */

.section {
    padding: 75px 7%;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.section-heading h2,
.vendor-content h2,
.seller-banner h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(27px, 3vw, 38px);
    line-height: 1.3;
    margin: 10px 0;
}

.section-heading p {
    color: var(--muted);
    font-size: 14px;
}

/* Categories */

.category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.category-card {
    position: relative;
    height: 310px;
    overflow: hidden;
    border-radius: 9px;
    background: var(--mint);
}

.category-card img {
    height: 100%;
    transition: transform 0.4s;
}

.category-card:hover img {
    transform: scale(1.07);
}

.category-info {
    position: absolute;
    inset: auto 0 0;
    padding: 45px 20px 20px;
    color: white;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
}

.category-info h3 {
    font-size: 21px;
    margin-bottom: 5px;
}

.category-info span {
    font-size: 12px;
}

/* Products */

.featured-section {
    background: var(--light-bg);
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.product-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 9px;
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(18, 62, 58, 0.09);
}

.product-image {
    position: relative;
    height: 240px;
    overflow: hidden;
    background: var(--mint);
}

.product-image img {
    height: 100%;
    transition: transform 0.4s;
}

.product-card:hover .product-image img {
    transform: scale(1.05);
}

.product-label {
    position: absolute;
    top: 13px;
    left: 13px;
    background: var(--mint);
    color: var(--emerald);
    font-size: 10px;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: 4px;
}

.product-info {
    padding: 18px;
}

.product-category {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 5px;
}

.product-info h3 {
    font-size: 15px;
    margin-bottom: 8px;
}

.price {
    font-size: 17px;
    font-weight: 700;
    color: var(--emerald);
    margin-bottom: 15px;
}

.product-btn {
    display: block;
    text-align: center;
    padding: 10px;
    border: 1px solid var(--emerald);
    border-radius: 5px;
    color: var(--emerald);
    font-size: 12px;
    font-weight: 600;
    transition: background 0.2s, color 0.2s;
}

.product-btn:hover {
    background: var(--emerald);
    color: white;
}

/* Vendor banner */

.vendor-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
    padding: 75px 7%;
}

.vendor-content > p {
    max-width: 440px;
    margin: 15px 0 25px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
}

.vendor-image {
    height: 350px;
    border-radius: 9px;
    overflow: hidden;
}

.vendor-image img {
    height: 100%;
}

/* Vendor cards */

.vendor-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.vendor-card {
    border: 1px solid var(--border);
    border-radius: 9px;
    overflow: hidden;
    background: white;
}

.vendor-card > img {
    height: 230px;
    transition: transform 0.4s;
}

.vendor-card:hover > img {
    transform: scale(1.03);
}

.vendor-card-info {
    padding: 20px;
}

.vendor-card-info h3 {
    font-size: 17px;
    margin-bottom: 5px;
}

.vendor-card-info p {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 15px;
}

.vendor-card-info a {
    color: var(--emerald);
    font-size: 13px;
    font-weight: 600;
}

/* Seller call to action */

.seller-banner {
    margin: 0 7% 75px;
    padding: 45px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    background: var(--mint);
    border-radius: 10px;
}

.seller-banner p {
    color: var(--text);
    font-size: 14px;
}

/* Footer */

.footer {
    background: var(--dark-green);
    color: white;
    padding: 55px 7% 20px;
}

.footer-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 45px;
}

.footer .logo {
    color: white;
}

.footer-brand p {
    max-width: 260px;
    color: #c3d7d3;
    font-size: 13px;
    margin-top: 15px;
    line-height: 1.8;
}

.footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.footer-links h4 {
    font-size: 14px;
    margin-bottom: 5px;
}

.footer-links a {
    color: #c3d7d3;
    font-size: 12px;
    transition: color 0.2s;
}

.footer-links a:hover {
    color: white;
}

.footer-bottom {
    border-top: 1px solid #315a55;
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #c3d7d3;
    font-size: 11px;
}

/* Responsive layout */

@media (max-width: 1000px) {
    .hero {
        gap: 30px;
        padding: 50px 5%;
    }

    .section,
    .vendor-section {
        padding: 55px 5%;
    }

    .category-grid,
    .product-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .category-card {
        height: 280px;
    }

    .product-image {
        height: 280px;
    }
}

@media (max-width: 650px) {
    .navbar {
        padding: 18px 5%;
        flex-wrap: wrap;
        gap: 15px;
    }

    .logo {
        font-size: 25px;
    }

    .nav-links {
        order: 3;
        width: 100%;
        justify-content: center;
        gap: 25px;
    }

    .nav-actions {
        gap: 15px;
    }

    .hero,
    .vendor-section {
        grid-template-columns: 1fr;
        padding: 40px 5%;
    }

    .hero-image {
        height: 300px;
    }

    .hero-features {
        gap: 10px;
    }

    .section {
        padding: 45px 5%;
    }

    .category-grid,
    .product-grid,
    .vendor-grid {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .category-card {
        height: 230px;
    }

    .product-image {
        height: 180px;
    }

    .product-info {
        padding: 12px;
    }

    .product-info h3 {
        font-size: 13px;
    }

    .vendor-grid .vendor-card:last-child {
        grid-column: span 2;
    }

    .vendor-image {
        height: 270px;
    }

    .seller-banner {
        margin: 0 5% 45px;
        padding: 28px;
        flex-direction: column;
        align-items: flex-start;
    }

    .footer-main {
        grid-template-columns: 1fr 1fr;
        gap: 30px;
    }

    .footer-bottom {
        flex-direction: column;
    }
}
