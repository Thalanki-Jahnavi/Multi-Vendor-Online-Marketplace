:root {
  --emerald: #087e78;
  --deep-green: #123e3a;
  --mint: #e5f4f0;
  --soft-grey: #f5f7f6;
  --border: #e1e9e5;
  --muted: #71817c;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--deep-green);
  background: var(--soft-grey);
  font-family: Arial, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  min-height: 78px;
  display: flex;
  align-items: center;
  gap: 30px;
  padding: 14px 6%;
  background: white;
  border-bottom: 1px solid var(--border);
}

.brand {
  flex-shrink: 0;
  font-size: 27px;
  font-weight: 800;
  letter-spacing: -1px;
}

.brand span {
  color: var(--emerald);
}

.search {
  display: flex;
  flex: 1;
  max-width: 620px;
  height: 44px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: #f8fbf9;
}

.search input {
  flex: 1;
  min-width: 0;
  padding: 0 15px;
  border: 0;
  outline: 0;
  background: transparent;
  font: inherit;
}

.search button {
  width: 48px;
  border: 0;
  color: white;
  background: var(--emerald);
  font-size: 24px;
  cursor: pointer;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 20px;
  white-space: nowrap;
  font-size: 14px;
  font-weight: 700;
}

.nav-actions a:hover {
  color: var(--emerald);
}

.cart-count {
  display: inline-grid;
  place-items: center;
  width: 21px;
  height: 21px;
  margin-left: 3px;
  border-radius: 50%;
  color: white;
  background: var(--emerald);
  font-size: 11px;
}

main {
  width: min(1180px, 92%);
  margin: 0 auto;
}

.category-strip {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 34px;
  padding: 20px 10px;
  color: #526761;
  font-size: 14px;
  font-weight: 700;
}

.category-strip a:hover {
  color: var(--emerald);
}

.hero {
  min-height: 360px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 30px;
  padding: 45px 7%;
  overflow: hidden;
  border-radius: 20px;
  background: linear-gradient(115deg, #e5f4f0, #f7fbf9);
}

.eyebrow {
  margin: 0 0 13px;
  color: var(--emerald);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.8px;
}

.hero h1 {
  margin: 0;
  font-size: clamp(34px, 4vw, 52px);
  line-height: 1.08;
  letter-spacing: -1.8px;
}

.hero-copy {
  margin: 18px 0 25px;
  color: var(--muted);
  line-height: 1.6;
}

.hero-button {
  display: inline-block;
  padding: 13px 20px;
  border-radius: 8px;
  color: white;
  background: var(--emerald);
  font-size: 14px;
  font-weight: 700;
}

.hero-button:hover {
  background: #066b66;
}

.hero-art {
  position: relative;
  min-height: 240px;
}

.art-card {
  position: absolute;
  width: 190px;
  padding: 23px;
  border: 1px solid rgba(18, 62, 58, 0.08);
  border-radius: 16px;
  background: white;
  box-shadow: 0 15px 35px rgba(18, 62, 58, 0.1);
  line-height: 1.6;
}

.card-one {
  top: 20px;
  left: 10%;
  transform: rotate(-8deg);
}

.card-two {
  right: 4%;
  bottom: 15px;
  transform: rotate(7deg);
}

.art-circle {
  position: absolute;
  top: 65px;
  left: 42%;
  display: grid;
  place-items: center;
  width: 95px;
  height: 95px;
  border: 10px solid #c5e8df;
  border-radius: 50%;
  color: white;
  background: var(--emerald);
  font-size: 24px;
  font-weight: 800;
}

.products-section {
  padding: 48px 0 55px;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.section-heading h2 {
  margin: 0;
  font-size: 28px;
  letter-spacing: -0.7px;
}

.section-heading > span {
  color: var(--muted);
  font-size: 13px;
}

.category-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 17px;
}

.category-card {
  min-height: 155px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 9px;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: white;
  transition: transform 0.2s, box-shadow 0.2s;
}

.category-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(18, 62, 58, 0.08);
}

.category-card span {
  color: var(--emerald);
  font-size: 12px;
  font-weight: 800;
}

.category-card strong {
  font-size: 18px;
}

.category-card small {
  color: var(--muted);
  font-size: 12px;
}

footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 24px 6%;
  border-top: 1px solid var(--border);
  background: white;
}

footer p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

@media (max-width: 850px) {
  .topbar {
    flex-wrap: wrap;
    gap: 15px;
  }

  .search {
    order: 3;
    flex-basis: 100%;
    max-width: none;
  }

  .nav-actions {
    margin-left: auto;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .hero-art {
    min-height: 200px;
  }

  .category-cards {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 520px) {
  .nav-actions {
    gap: 12px;
    font-size: 12px;
  }

  .category-strip {
    gap: 16px;
  }

  .hero {
    padding: 32px 25px;
  }

  .hero-art {
    display: none;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .category-cards {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .category-card {
    min-height: 130px;
    padding: 15px;
  }

  footer {
    align-items: flex-start;
    flex-direction: column;
  }
}