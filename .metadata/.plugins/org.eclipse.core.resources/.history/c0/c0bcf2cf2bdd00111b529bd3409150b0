
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Store | OneCart Seller Center</title>

    <link rel="stylesheet" th:href="@{/css/vendor-dashboard.css}">
    <link rel="stylesheet" th:href="@{/css/vendor-store.css}">
</head>

<body>

<div class="dashboard-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">

        <!-- BRAND -->
        <div class="brand">
            <div class="brand-icon">O</div>

            <div>
                <h2>OneCart</h2>
                <span>SELLER CENTER</span>
            </div>
        </div>

        <!-- STORE INFORMATION -->
        <div class="store-info">

            <div class="store-avatar">🏪</div>

            <div class="store-text">
                <strong th:text="${vendor.businessName != null and !vendor.businessName.isEmpty() ? vendor.businessName : 'My Store'}">
                    My Store
                </strong>

                <small>Vendor Account</small>
            </div>

        </div>

        <!-- SIDEBAR NAVIGATION -->
        <nav class="sidebar-nav">

            <p class="nav-heading">MAIN MENU</p>

            <a th:href="@{/vendor/dashboard}" class="nav-link">
                <span class="nav-icon">▦</span>
                Dashboard
            </a>

            <p class="nav-heading">STORE MANAGEMENT</p>

            <a th:href="@{/vendor/store}" class="nav-link active">
                <span class="nav-icon">🏬</span>
                My Store
            </a>

            <a th:href="@{/vendor/products}" class="nav-link">
                <span class="nav-icon">▣</span>
                Products
            </a>

            <!-- ADD PRODUCT REMOVED FROM SIDEBAR -->

            <a th:href="@{/vendor/inventory}" class="nav-link">
                <span class="nav-icon">▤</span>
                Inventory
            </a>

            <p class="nav-heading">BUSINESS</p>

			
			<a th:href="@{/vendor/orders}" class="nav-link">
			    <span class="nav-icon">▧</span>
			    Orders
			</a>


            <a href="#" class="nav-link disabled-link">
                <span class="nav-icon">↗</span>
                Sales &amp; Reports
                <span class="coming-soon">Soon</span>
            </a>

            <p class="nav-heading">ACCOUNT</p>

            <a th:href="@{/vendor/profile}" class="nav-link">
                <span class="nav-icon">♙</span>
                My Profile
            </a>

        </nav>

        <!-- SIDEBAR BOTTOM -->
        <div class="sidebar-bottom">

            <div class="help-card">
                <div class="help-icon">?</div>

                <strong>Need help?</strong>

                <p>Manage your store with OneCart Seller Center.</p>
            </div>

            <form th:action="@{/logout}" method="post">
                <button type="submit" class="logout-button">
                    ↪ Logout
                </button>
            </form>

        </div>

    </aside>


    <!-- MAIN CONTENT -->
    <main class="main-content">

        <!-- TOPBAR -->
        <header class="topbar">

            <div class="topbar-left">

                <button class="menu-toggle"
                        id="menuToggle"
                        type="button"
                        aria-label="Toggle menu">
                    ☰
                </button>

                <div>
                    <h2>My Store</h2>
                    <p>Manage your store identity and appearance.</p>
                </div>

            </div>

            <div class="topbar-right">

                <div class="profile-area">

                    <div class="profile-avatar">
                        <span th:text="${vendor.firstName != null and !vendor.firstName.isEmpty() ? #strings.substring(vendor.firstName, 0, 1).toUpperCase() : 'V'}">
                            V
                        </span>
                    </div>

                    <div class="profile-details">
                        <strong th:text="${(vendor.firstName != null ? vendor.firstName : '') + ' ' + (vendor.lastName != null ? vendor.lastName : '')}">
                            Vendor Name
                        </strong>

                        <small>Vendor</small>
                    </div>

                </div>

            </div>

        </header>


        <!-- PAGE CONTENT -->
        <section class="page-content store-page-content">

            <!-- PAGE INTRO -->
            <div class="store-page-intro">

                <div>

                    <span class="store-eyebrow">
                        SELLER CENTER / STORE MANAGEMENT
                    </span>

                    <h1>
                        Your store, <span>your identity.</span>
                    </h1>

                    <p>
                        Customize your store appearance and make your business
                        recognizable to OneCart customers.
                    </p>

                </div>

                <div class="store-account-pill">
                    <span></span>
                    Vendor account
                </div>

            </div>


            <!-- SUCCESS MESSAGE -->
            <div class="store-alert store-alert-success"
                 th:if="${success}"
                 th:text="${success}"
                 role="status">
            </div>


            <!-- ERROR MESSAGE -->
            <div class="store-alert store-alert-error"
                 th:if="${error}"
                 th:text="${error}"
                 role="alert">
            </div>


            <!-- STORE FORM -->
            <form th:action="@{/vendor/store/update}"
                  method="post"
                  enctype="multipart/form-data"
                  class="store-form">

                <div class="store-layout-grid">


                    <!-- STORE PREVIEW -->
                    <section class="store-preview-card">

                        <div class="store-card-heading">

                            <div>
                                <span class="store-section-kicker">
                                    CUSTOMER VIEW
                                </span>

                                <h2>Store preview</h2>
                            </div>

                            <span class="preview-label">
                                Live preview
                            </span>

                        </div>


                        <!-- CLEAN BANNER PREVIEW -->
                        <div class="store-cover-art"
                             id="storeBannerPreview">

                            <img id="storeBannerPreviewImage"
                                 class="stored-banner-image"
                                 th:src="${vendor.storeBanner}"
                                 th:style="${vendor.storeBanner != null and !#strings.isEmpty(vendor.storeBanner) ? 'display:block' : 'display:none'}"
                                 alt="Store banner preview">

                            <!-- Decorative circles only -->
                            <span class="cover-orbit orbit-one"></span>
                            <span class="cover-orbit orbit-two"></span>

                            <span class="cover-spark spark-one">✦</span>
                            <span class="cover-spark spark-two">✧</span>

                        </div>


                        <!-- STORE LOGO AND NAME -->
                        <div class="store-preview-identity">

                            <div class="store-logo-preview">

                                <img id="storeLogoPreviewImage"
                                     th:src="${vendor.storeLogo}"
                                     th:style="${vendor.storeLogo != null and !#strings.isEmpty(vendor.storeLogo) ? 'display:block' : 'display:none'}"
                                     alt="Store logo preview">

                                <span id="storeLogoInitial"
                                      th:style="${vendor.storeLogo != null and !#strings.isEmpty(vendor.storeLogo) ? 'display:none' : 'display:block'}"
                                      th:text="${vendor.businessName != null and !vendor.businessName.isEmpty() ? #strings.substring(vendor.businessName, 0, 1).toUpperCase() : 'S'}">
                                    S
                                </span>

                            </div>

                            <div class="store-preview-name-wrap">

                                <span class="store-preview-label">
                                    STORE NAME
                                </span>

                                <h3 id="storeNamePreview"
                                    th:text="${vendor.businessName != null and !vendor.businessName.isEmpty() ? vendor.businessName : 'Your store name'}">
                                    Your store name
                                </h3>

                                <p>OneCart vendor</p>

                            </div>

                            <span class="store-preview-check">✓</span>

                        </div>


                        <!-- PREVIEW NOTE -->
                        <div class="preview-footnote">

                            <span class="preview-footnote-icon">i</span>

                            This is a preview of your store identity.

                        </div>

                    </section>


                    <!-- STORE INFORMATION -->
                    <section class="store-details-card">

                        <div class="store-card-heading">

                            <div>
                                <span class="store-section-kicker">
                                    STORE IDENTITY
                                </span>

                                <h2>Store information</h2>
                            </div>

                            <span class="edit-icon">✎</span>

                        </div>


                        <!-- STORE NAME -->
                        <div class="store-field">

                            <label for="businessName">
                                Business / Store name <span>*</span>
                            </label>

                            <input type="text"
                                   id="businessName"
                                   name="businessName"
                                   th:value="${vendor.businessName}"
                                   placeholder="Enter your store name"
                                   maxlength="255"
                                   required>

                            <small>
                                This is the name customers will recognize on OneCart.
                            </small>

                        </div>


                        <!-- LOGO UPLOAD -->
                        <div class="store-field upload-field">

                            <label for="logoFile">
                                Store logo
                            </label>

                            <div class="upload-box">

                                <div class="upload-symbol">▧</div>

                                <div class="upload-content">

                                    <strong>
                                        Upload your store logo
                                    </strong>

                                    <small>
                                        Square image recommended. JPG, PNG or WEBP.
                                        Maximum 2 MB.
                                    </small>

                                </div>

                                <input type="file"
                                       id="logoFile"
                                       name="logoFile"
                                       accept="image/jpeg,image/png,image/webp">

                            </div>

                        </div>


                        <!-- BANNER UPLOAD -->
                        <div class="store-field upload-field">

                            <label for="bannerFile">
                                Store banner
                            </label>

                            <div class="upload-box">

                                <div class="upload-symbol">▱</div>

                                <div class="upload-content">

                                    <strong>
                                        Upload your store banner
                                    </strong>

                                    <small>
                                        Wide image recommended. JPG, PNG or WEBP.
                                        Maximum 5 MB.
                                    </small>

                                </div>

                                <input type="file"
                                       id="bannerFile"
                                       name="bannerFile"
                                       accept="image/jpeg,image/png,image/webp">

                            </div>

                        </div>


                        <!-- STORE OWNER -->
                        <div class="store-field">

                            <label for="ownerName">
                                Store owner
                            </label>

                            <input type="text"
                                   id="ownerName"
                                   th:value="${(vendor.firstName != null ? vendor.firstName : '') + ' ' + (vendor.lastName != null ? vendor.lastName : '')}"
                                   readonly>

                            <small>
                                Update your personal name from My Profile.
                            </small>

                        </div>


                        <!-- REGISTERED EMAIL -->
                        <div class="store-field">

                            <label for="storeEmail">
                                Registered email
                            </label>

                            <input type="email"
                                   id="storeEmail"
                                   th:value="${vendor.email}"
                                   readonly>

                            <small>
                                Your registered login email is shown here.
                            </small>

                        </div>


                        <!-- FORM ACTIONS -->
                        <div class="store-form-actions">

                            <a class="store-cancel-button"
                               th:href="@{/vendor/dashboard}">
                                Back to dashboard
                            </a>

                            <button type="submit"
                                    class="store-save-button">
                                Save store details <span>→</span>
                            </button>

                        </div>

                    </section>

                </div>

            </form>


            <!-- STORE GUIDANCE -->
            <section class="store-guidance-card">

                <div class="guidance-icon">✦</div>

                <div class="guidance-copy">

                    <span class="store-section-kicker">
                        STORE MANAGEMENT
                    </span>

                    <h2>Build a recognizable storefront</h2>

                    <p>
                        Use a clear logo and an attractive banner to help
                        customers recognize your business on OneCart.
                    </p>

                </div>

                <div class="guidance-side-note">

                    <strong>Store appearance</strong>

                    <span>Logo and banner</span>
                    <span>Business name</span>

                </div>

            </section>


            <!-- FOOTER -->
            <footer class="footer">
                © 2026 OneCart. Vendor Seller Center.
            </footer>

        </section>

    </main>

</div>


<!-- LIVE IMAGE AND STORE NAME PREVIEW -->
<script>
(() => {

    const nameInput =
        document.getElementById("businessName");

    const previewName =
        document.getElementById("storeNamePreview");

    const previewLogoInitial =
        document.getElementById("storeLogoInitial");

    const logoInput =
        document.getElementById("logoFile");

    const logoPreview =
        document.getElementById("storeLogoPreviewImage");

    const bannerInput =
        document.getElementById("bannerFile");

    const bannerPreview =
        document.getElementById("storeBannerPreviewImage");

    let logoObjectUrl = null;
    let bannerObjectUrl = null;


    // Live store name preview
    if (nameInput && previewName && previewLogoInitial) {

        nameInput.addEventListener("input", () => {

            const value = nameInput.value.trim();

            previewName.textContent =
                value || "Your store name";

            if (!logoInput.files.length) {

                previewLogoInitial.textContent =
                    value ? value.charAt(0).toUpperCase() : "S";

            }

        });

    }


    // Image preview and validation
    function previewImage(
        input,
        preview,
        maxSize,
        imageType
    ) {

        input.addEventListener("change", () => {

            const file = input.files[0];

            if (!file) {
                return;
            }

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type)) {

                alert(
                    "Please select a JPG, PNG or WEBP image."
                );

                input.value = "";
                return;
            }

            if (file.size > maxSize) {

                alert(imageType + " image is too large.");

                input.value = "";
                return;
            }


            // Release the previous temporary preview
            if (imageType === "logo" && logoObjectUrl) {
                URL.revokeObjectURL(logoObjectUrl);
            }

            if (imageType === "banner" && bannerObjectUrl) {
                URL.revokeObjectURL(bannerObjectUrl);
            }


            // Display selected image
            const imageUrl = URL.createObjectURL(file);

            preview.src = imageUrl;
            preview.style.display = "block";


            if (imageType === "logo") {

                logoObjectUrl = imageUrl;

                previewLogoInitial.style.display = "none";

            } else {

                bannerObjectUrl = imageUrl;

            }

        });

    }


    // Logo preview: 2 MB maximum
    previewImage(
        logoInput,
        logoPreview,
        2 * 1024 * 1024,
        "logo"
    );


    // Banner preview: 5 MB maximum
    previewImage(
        bannerInput,
        bannerPreview,
        5 * 1024 * 1024,
        "banner"
    );

})();
</script>

<script th:src="@{/js/vendor-dashboard.js}"></script>

</body>
</html>
