:root {
    --emerald: #087e78;
    --deep-green: #123e3a;
    --mint: #e5f4f0;
    --page-bg: #f5fbf9;
    --text: #173d39;
    --muted: #68817e;
    --border: #d7ebe6;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--page-bg);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

.site-header {
    min-height: 82px;
    padding: 0 7.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: #fff;
    border-bottom: 1px solid var(--border);
}

.brand {
    font-size: 28px;
    font-weight: 800;
    color: var(--deep-green);
    white-space: nowrap;
}

.brand span {
    color: var(--emerald);
}

.main-nav {
    display: flex;
    align-items: center;
    gap: 32px;
}

.main-nav a {
    padding: 30px 0 27px;
    font-size: 15px;
    font-weight: 700;
}

.main-nav a.active {
    color: var(--emerald);
    border-bottom: 3px solid var(--emerald);
}

.sign-out {
    padding: 13px 24px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--deep-green);
    font-weight: 700;
    cursor: pointer;
}

.page {
    max-width: 1420px;
    margin: 0 auto;
    padding: 28px 28px 60px;
}

.breadcrumb {
    display: flex;
    gap: 12px;
    margin: 0 0 26px;
    font-size: 14px;
}

.breadcrumb a {
    color: var(--emerald);
}

.page-intro {
    min-height: 140px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
}

.page-intro h1 {
    margin: 0 0 12px;
    color: var(--deep-green);
    font-size: clamp(30px, 3vw, 40px);
}

.page-intro p {
    margin: 0;
    color: var(--muted);
    font-size: 18px;
}

.shopping-art {
    width: 150px;
    height: 120px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #ccece5;
    font-size: 62px;
}

.filter-bar {
    display: grid;
    grid-template-columns: minmax(220px, 2fr) minmax(150px, 1fr) minmax(160px, 1fr) auto;
    align-items: end;
    gap: 18px;
    margin: 10px 0 30px;
    padding: 18px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 20px;
}

.filter-bar input,
.filter-bar select {
    width: 100%;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: #fff;
    color: var(--text);
    font-size: 14px;
}

.filter-bar label {
    display: grid;
    gap: 7px;
    font-size: 13px;
    font-weight: 700;
}

.filter-bar button,
.add-to-cart {
    min-height: 44px;
    padding: 0 24px;
    border: 0;
    border-radius: 12px;
    background: var(--emerald);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.product-card {
    overflow: hidden;
    padding: 14px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 20px;
}

.product-image-wrap {
    position: relative;
    overflow: hidden;
    height: 210px;
    border-radius: 13px;
    background: var(--mint);
}

.product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.wishlist-button {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--deep-green);
    font-size: 25px;
    cursor: pointer;
}

.product-info {
    padding: 14px 2px 2px;
}

.product-info h2 {
    margin: 0 0 8px;
    font-size: 18px;
    color: #142d2a;
}

.vendor-name {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 14px;
}

.product-price {
    display: block;
    margin-bottom: 14px;
    color: var(--emerald);
    font-size: 23px;
}

.add-to-cart {
    width: 100%;
}

.empty-state {
    padding: 55px 20px;
    text-align: center;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 20px;
}

.empty-state p {
    color: var(--muted);
}

.empty-state a {
    color: var(--emerald);
    font-weight: 700;
}

@media (max-width: 1050px) {
    .site-header {
        padding: 0 4%;
    }

    .main-nav {
        gap: 16px;
    }

    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    .site-header {
        flex-wrap: wrap;
        padding: 18px 5%;
    }

    .main-nav {
        order: 3;
        width: 100%;
        overflow-x: auto;
    }

    .main-nav a {
        padding: 12px 0;
        white-space: nowrap;
    }

    .page {
        padding: 20px 16px 40px;
    }

    .shopping-art {
        display: none;
    }

    .filter-bar {
        grid-template-columns: 1fr;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .product-image-wrap {
        height: 250px;
    }
}